msgid "Directory"
msgstr "(en) Directory"

msgid "dir_CITY"
msgstr "Varsayılan Şehir"

msgid "dir_COMPANY"
msgstr "Varsayılan Şirket"

msgid "dir_DEPARTMENT"
msgstr "Varsayılan departman"

msgid "dir_DESCRIPTION"
msgstr "LDAP sunucusu kullanıcı hesapları ve sunucunuzda ağ kullanılabilir grup listesini vermektedir, Netscape Communicator Adres Defteri özelliği gibi bir LDAP istemci kullanılarak ulaşılabilir. LDAP istemcinizi sunucunuzun yerel IP adresi ile yapılandırın , port numarası 389 ve sunucu kök parametreleri aşağıda gösterilmiştir."

msgid "dir_DESC_DEPARTMENT"
msgstr "Bu alanlar kuruluşunuz için varsayılan LDAP bilgileridir. Yeni bir kullanıcı hesabı oluşturduğunuzda, bu bilgileri tekrar girmeniz istenecektir (bu bilgiler her kullanıcı için farklı olabilir), burada verilen bilgiler varsayılan olarak gösterilecektir. Bu işlem yeni kullanıcı hesabını daha hızlı oluşturmanızı sağlayacaktır."

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr "LDAP dizin erişimini kontrol edebilirsiniz: özel ayar seçildiğinde sadece yerel ağınızdan erişilebilir, herkese açık ayar seçildiğinde internet dahil her yerden erişim sağlanır."

msgid "dir_DESC_EXISTING"
msgstr "Var olan kullanıcı hesaplarını olduğu gibi bırakabilirsiniz, varsayılan bilgiler sadece yeni kullanıcılara uygulanır veya mevcut kullanıcılar dahil bütün kullanıcı hesapları için bu varsayılan bilgileri atayabilirsiniz."

msgid "dir_DIRECTORY_ACCESS"
msgstr "LDAP dizin erişimi"

msgid "dir_EXISTING"
msgstr "Mevcut kullanıcılar"

msgid "dir_FORM_TITLE"
msgstr "LDAP dizin ayarlarını değiştirin"

msgid "dir_LABEL_ROOT"
msgstr "Sunucu ana dizini"

msgid "dir_LEAVE"
msgstr "Olduğu gibi bırak"

msgid "dir_PHONE"
msgstr "(en) dir_PHONE"

msgid "dir_PHONENUMBER"
msgstr "Varsayılan Telefon numarası"

msgid "dir_STREET"
msgstr "Varsayılan Sokak"

msgid "dir_SUCCESS"
msgstr "Yeni LDAP varsayılan değerleri kaydedildi."

msgid "dir_UPDATE"
msgstr "Yeni varsayılan bilgileri kullanarak güncelle"

msgid "dom_FORM_TITLE"
msgstr "(en) dom_FORM_TITLE"

