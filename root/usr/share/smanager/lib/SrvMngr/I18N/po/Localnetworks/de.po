msgid "Local networks"
msgstr "Lokale Netzwerke"

msgid "ln_ADD_DESC"
msgstr "  Jeder Parameter muß in Form von #.#.#.# eingegeben werden (wobei jede # eine Zahl zwischen 0 und 255 ist). Die Server-Software wird die letzten Stellen automatisch mit 0 ersetzen (Host Identifier), um mit Hilfe der Subnetz-Maske eine korrekte Netzwerk-Definition zu garantieren. <p> \"Router\" sollte die IP-Adresse des Routers im lokalen Netzwerk sein, über welchen weitere Netzwerke wie das Internet erreicht werden. </p> "

msgid "ln_ADD_TITLE"
msgstr "Lokales Netzwerk hinzufügen"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "Es ist ein Fehler beim Erstellen des Netzwerks aufgetreten."

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "Fehler beim Löschen des Netzwerks aufgetreten."

msgid "ln_FIRSTPAGE_DESC"
msgstr "Aus Sicherheitsgründen sind einige Funktionen auf Ihrem Server nur für das interne Netzwerk verfügbar. Trotzdem können Sie die Zugänge für unten aufgeführte zusätzliche lokale Netzwerksegmente freigeben, indem Sie diese unten aufführen. Bei den meisten Installationen sollten Sie dieses Feld leer lassen. <p> <a class=\"button-like\" href=\"localnetworks?page=0&page_stack=&next=next&wherenext=add\">Netzwerk hinzufügen</a> </p> "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "Ungültige IP-Adresse"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Ungültige Netzwerk-Maske"

msgid "ln_LOCAL NETWORKS"
msgstr "Lokale Netzwerke"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Netzwerk hinzufügen"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "FEHLER: Netzwerk %1 (abgeleitet vom Netzwerk %2 und Subnetz-Maske %3) wurde bereits hinzugefügt. Neues Netzwerk wurde nicht erstellt."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "FEHLER: Netzwerk %1 (abgeleitet vom Netzwerk %2 und Subnetz-Maske %3) wird bereits als Lokal angesehen. Neues Netzwerk wurde nicht erstellt."

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "FEHLER: Auf die Router-Adresse %1 kann nicht vom lokalen Netz zugegriffen werden. Das Netzwerk wurde nicht erstellt."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Anzahl der Hosts"

msgid "ln_REMOVE_DESC"
msgstr "Sie sind dabei, das folgende lokale Netzwerk zu entfernen."

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "Lokale Hosts wurden gefunden, die im zu löschenden Netzwerkliegen. Diese werden standardmäßig mit gelöscht. Deaktivieren Sie diese Auswahl, wenn sie diesen Löschvorgang nicht wünschen. Beachten Sie aber, dass diese Hosts nicht mehr als lokal behandelt werden und dadurch nicht mehr erreichbar sind, nachdem das Netzwerksegment gelöscht wurde."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "Hosts vom Netzwerk entfernen"

msgid "ln_REMOVE_TITLE"
msgstr "Lokales Netzwerk entfernen"

msgid "ln_SUBNET_MASK"
msgstr "Subnetz-Maske"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "Netzwerk %1/%2wurde erfolgreich über den Router %3 hinzugefügt. Ihr Server stellt den lokalen Zugang für %4 IP-Adressen von %5 bis %6 zur Verfügung."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "Netzwerk %1/%2 wurde erfolgreich über den Router %3 hinzugefügt. <p> Ihr Server stellt den lokalen Zugang für %1 in einem IP-Adressbereich von %2 bis %3 zur Verfügung. </p> <p> Warnung: Der ProFTPd FTP Server kann die nicht standardmäßige Subnetz-Maske nicht verwenden. Die einfachere Angabe <b>%1</b> wird statt dessen benutzt. </p> "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "Netzwerk %1/%2 über den Router %3 wurde erfolgreich entfernt."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "Netzwerk %1/%2wurde erfolgreich über den Router %3 hinzugefügt. Ihr Server stellt den lokalen Zugang für eine einzelne IP-Adresse %4zur Verfügung."
