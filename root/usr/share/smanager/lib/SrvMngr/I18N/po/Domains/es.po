msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Agregar dominio"

msgid "dom_CONTENT"
msgstr "i-bay %1"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "Para el sitio web, usted puede escoger el sitio web primario o cualquier i-bay como contenido."

msgid "dom_CREATE_TITLE"
msgstr "Crear un nuevo dominio"

msgid "dom_CURRENT_DOMAINS"
msgstr "Lista actual de dominios"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Si este servidor no tiene acceso a Internet, o usted tiene requerimientos especiales para la resolución de DNS, ingrese aquí la dirección IP del servidor de DNS. Estos campos pueden dejarse en blanco a menos que tenga una razón específica para configurar otros servidores de DNS. No debe ingresar aquí la dirección de DNS de su ISP, debido a que el servidor es capaz de resolver todos los nombres de DNS de Internet sin ninguna configuración adicional."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr " Configuración de DNS Corporativa "

msgid "dom_DESC_NAMESERVERS"
msgstr "Puede seleccionar si este dominio es resuelto localmente, por el servidor corporativo de DNS, o resolverlo por medio de un servidor DNS de Internet. El predeterminado será el correcto para la mayoría de las redes."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Modificar la configuración de DNS corporativa"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Error: caracteres erróneos o faltantes en la descripción del dominio %1. No se creó el nuevo dominio."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Error: el dominio %1 ya está en uso. No se creó el nuevo dominio."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Error: caracteres erróneos o faltantes en el nombre del dominio %1. El nombre del dominio debe contener una o más letras, números, puntos y signos menos. No es posible crear el nuevo dominio."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Error: falla interna al eliminar el dominio %1."

msgid "dom_FORM_DESCRIPTION"
msgstr " Cuando crea un dominio, el servidor queda habilitado para recibir correo electrónico para ese dominio y también puede alojar un sitio web para ese dominio.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Agregar dominio</a> "

msgid "dom_FORM_TITLE"
msgstr "Administrar dominios"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Servidor Primario corporativo de DNS"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Servidor Secundario corporativo de DNS"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Servidores DNS de dominio"

msgid "dom_MODIFY_TITLE"
msgstr "Modificar dominio"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Error: %1 no es un dominio existente."

msgid "dom_PRIMARY_SITE"
msgstr "sitio primario"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  Está a punto de eliminar el dominio %1 (%2). \n\n  <p> <b>¿Está seguro de que desea eliminar este dominio?</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Eliminar dominio"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Se creó con éxito el dominio %1. Ahora se está reiniciando el servidor web. Los vínculos en esta página estarán inactivos hasta que se complete el reinicio del servidor web."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Se eliminó con éxito el dominio %1. Ahora se está reiniciando el servidor web. Los vínculos en esta página estarán inactivos hasta que se complete el reinicio del servidor web."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Se modificó con éxito el dominio %1. Ahora se está reiniciando el servidor web. Los vínculos en esta página estarán inactivos hasta que se complete el reinicio del servidor web."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Error: el dominio %1 es el nombre del dominio de su sistema. No puede tener un dominio con el mismo nombre. No se creó el nuevo dominio."

msgid "dom_corporate"
msgstr "Servidor DNS corporativo"

msgid "dom_internet"
msgstr "Servidores DNS de Internet"

msgid "dom_localhost"
msgstr "Resolver localmente"

