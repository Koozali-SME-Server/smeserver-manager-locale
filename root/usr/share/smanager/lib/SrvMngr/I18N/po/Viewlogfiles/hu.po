msgid "LOG_LIVESTREAM"
msgstr "(en) Live stream"

msgid "log_END_DESC"
msgstr "Egy ideig eltarthat míg elkészülnek ezek a lekérdezések."

msgid "log_ERR_NOEXIST_FILE"
msgstr "(en) Err noexist file"

msgid "log_ERR_NOOPEN_FILE"
msgstr "(en) Err noopen file"

msgid "log_FILENAME_ERROR"
msgstr " Hiba történt a naplófájl nevének meghatározásakor.\n\n  <p>Érvénytelen lekérdezés típus a \"[_1]\".</p>\n\n  "

msgid "log_FILTER_PATTERN_DESC"
msgstr " Opcionálisan meghatározhat egy szűrési feltételt, hogy csak azok a sorok látszódjanak a naplófájlból amelyek megfelelnek a szűrési feltételnek. Ha ezt a mezőt üresen hagyja, minden sor látható lesz. Ez az opció nem működik a naplófájl letöltésekor.\n\n  "

msgid "log_FILTER_PATTERN_HINT"
msgstr "(en) The pattern is case insensitive, but enclosing it in \"/\" will result in it being treated as a regex."

msgid "log_FILTER_PATTERN_LABEL"
msgstr "Szűrési feltétel (opcionális)"

msgid "log_FIRSTPAGE_DESC"
msgstr " Ez a panel lehetővé teszi, hogy megtekintse, vagy letöltse a szolgáltatások által generált naplófájlokat. "

msgid "log_FORM_TITLE"
msgstr "Naplófájlok megtekintése"

msgid "log_HIGHLIGHT_HEADER"
msgstr "A \"[_1]\" feltételre illeszkedő sorok kiemelése."

msgid "log_LOG_FILE_EMPTY"
msgstr "A \"[_1]\" naplófájl üres!"

msgid "log_LOG_FILE_SELECT_DESC"
msgstr "Válasszon egy naplófájlt a megtekintéshez"

msgid "log_MATCH_HEADER"
msgstr "A \"[_1]\" feltételre illeszkedő sorok mutatása."

msgid "log_MATCH_PATTERN_DESC"
msgstr " Opcionálisan meghatározhat egy kiemelési feltételt, hogy azok a sorok ki legyenek emelve a naplófájban amelyek megfelelnek a kiemelési feltételnek. Ez az opció nem működik a naplófájl letöltésekor.\n\n  "

msgid "log_MATCH_PATTERN_LABEL"
msgstr "Kiemelési feltétel (opcionális)"

msgid "log_NO_MATCHING_LINES"
msgstr "Nincsenek megjeleníthető sorok."

msgid "log_OP_DESC"
msgstr " Választania kell, hogy megnézi-e a naplófájlt a böngészőben, vagy letölti azt a számítógépére. Ha a naplófájl különösen nagy, letöltheti azt a gépére, ahelyett, hogy a böngészőben nézné meg mivel annak megjelenítése néhány böngészőnél problémát okozhat.\n\n  "

msgid "log_OP_LABEL"
msgstr "Használat"

msgid "log_REFRESH"
msgstr "Naplófájl frissítése"

msgid "log_VIEW"
msgstr "Naplófájl megtekintése"

msgid "log_VIEWING_TIME"
msgstr "Megtekintve [_1] -kor"

