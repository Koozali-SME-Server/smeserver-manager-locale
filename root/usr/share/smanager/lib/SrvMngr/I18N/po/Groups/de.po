msgid "DELETE_ERROR"
msgstr "(en) DELETE_ERROR"

msgid "grp_ACCOUNT_CONFLICT"
msgstr "FEHLER: Die Gruppe \"[_1]\" kann nicht angelegt werden, da bereits ein [_2] Konto mit dem gleichen Namen besteht."

msgid "grp_CREATED_GROUP"
msgstr "Gruppe wurde erfolgreich angelegt"

msgid "grp_CREATE_ERROR"
msgstr "Ein Fehler ist beim Anlegen der Benutzergruppe aufgetreten."

msgid "grp_CURRENT_LIST"
msgstr "  Aktuelle Liste der Benutzergruppen\n\n  "

msgid "grp_DELETED_GROUP"
msgstr "Gruppe wurde erfolgreich gelöscht"

msgid "grp_DELETE_DESCRIPTION"
msgstr " Sie löschen gerade die Benutzergruppe \"[_1]\" "

msgid "grp_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "grp_FORM_TITLE"
msgstr "Anlegen, Ändern und Löschen von Benutzergruppen"

msgid "grp_GROUP_DESC"
msgstr "Kurzbeschreibung/Windows Gruppen Alias"

msgid "grp_GROUP_DESC_EXPL"
msgstr "Geben Sie unten eine möglichst sinnvolle Kurzbeschreibung für diese Gruppe ein. Diese ist dann auch im Windows-Netzwerk sichtbar."

msgid "grp_GROUP_HAS_MEMBERS"
msgstr "Diese Gruppe enthält folgende Mitglieder:"

msgid "grp_GROUP_NAMING"
msgstr " Der Gruppenname darf nur Kleinbuchstaben, Zahlen, Punkte, Bindestriche und Unterstriche enthalten und sollte mit einem Kleinbuchstaben beginnen. Zum Beispiel sind \"vertrieb\", \"abteilung5\" oder \"vertriebs_kunden\" gültige Namen, aber \"2tes-Event\", \"Marketing Team\" und \"verloren&gefunden\" sind nicht gültig. "

msgid "grp_GROUP_TOO_LONG"
msgstr "FEHLER: Der Gruppenname ist zu lang. Die max. Länge ist [_1] Zeichen."

msgid "grp_IBAYS_WILL_BE_CHANGED"
msgstr "Die folgenden i-bays wurden dieser Gruppe hinzugefügt und werden auf die Administrator Gruppe geändert (Sie können dies später ändern):"

msgid "grp_MODIFIED_GROUP"
msgstr "Gruppe wurde erfolgreich geändert"

msgid "grp_MODIFY_ERROR"
msgstr "Ein Fehler ist beim Ändern der Benutzergruppe aufgetreten."

msgid "grp_NOT_A_GROUP"
msgstr "FEHLER: Dies ist kein bestehendes Gruppenkonto."

msgid "grp_NO_MEMBERS"
msgstr "FEHLER: Keine Mitglieder in der Gruppe. Neue Gruppe wurde nicht angelegt."
