msgid "iba_ACCOUNT_EXISTS"
msgstr "Das Konto \"%1\" ist ein existierendes %2 Konto."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " Das Konto \"%1\" kollidiert mit den Pseudonymangaben für %2 Konto \"%3\". %1 ist ein Pseudonym für %3. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "Der i-bay Name \"%1\" enthält ungültige Zeichen. Der i-bay Name darf nur Kleinbuchstaben, Nummern, Punkte, Unterstriche und Bindestriche enthalten und muß mit einem Kleinbuchstaben beginnen."

msgid "iba_ADD_IBAY"
msgstr "I-bay hinzufügen"

msgid "iba_ADD_TITLE"
msgstr "i-bay anlegen oder ändern"

msgid "iba_ALLOW_DYNAMIC_CONTENT"
msgstr "Ausführung dynamischer Inhalte(CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "Kann das neue Konto für %1 nicht anlegen (Besteht es bereits?)"

msgid "iba_CANT_FIND_IBAY"
msgstr "Kann das Konto für %1 nicht finden (Wurde es angelegt?)"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "Gesamtes Internet (Kennwort wird nicht benötigt)"

msgid "iba_ENTIRE_INTERNET_PASSWORD"
msgstr "Gesamtes Internet (Kennwort wird benötigt)"

msgid "iba_ENTIRE_INTERNET_PASSWORD_REMOTE"
msgstr "Gesamtes Internet (Kennwort außerhalb des lokalen Netzwerks benötigt)"

msgid "iba_ERROR_WHILE_CREATING_IBAY"
msgstr "Ein Fehler ist beim Anlegen des i-bays aufgetreten."

msgid "iba_ERROR_WHILE_DELETING_IBAY"
msgstr "Ein Fehler ist beim Löschen des i-bays aufgetreten."

msgid "iba_ERROR_WHILE_MODIFYING_IBAY"
msgstr "Ein Fehler ist beim Ändern des i-bays aufgetreten."

msgid "iba_ERROR_WHILE_RESETTING_PASSWORD"
msgstr "Fehler beim Zurücksetzen des Kennworts."

msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "  i-bay anlegen \n\n   Information-Bays (i-bays) sind eine Spezialität des SME-Servers. Sie können i-bays löschen oder das Kennwort des i-bays zurücksetzen, indem Sie das entsprechende Kommando neben dem i-bay anklicken. Wenn das i-bay in rot angezeigt wird, wurde das Standard-Kennwort noch nicht geändert und sollte sobald wie möglich neu eingegeben werden \n\n  "

msgid "iba_FORM_TITLE"
msgstr "Anlegen, Ändern oder Löschen von i-bays"

msgid "iba_HTTPS_Only"
msgstr "Sichere Verbindung erzwingen"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "Die Kennwörter stimmen nicht überein."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Lokales Netzwerk (Kennwort wird nicht benötigt)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "Lokales Netzwerk (Kennwort wird benötigt)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "Der i-bay Name \"%1\" ist zu lang. Die maximale Länge beträgt %1 Zeichen."

msgid "iba_NAME_FIELD_DESC"
msgstr "Der i-bay Name darf nur Kleinbuchstaben, Zahlen, Punkte, Unterstriche und Bindestriche enthalten und sollte immer mit einem Kleinbuchstaben beginnen. Zum Beispiel \"susan\", \"h.müller\" und \"hans-josef\" sind zulässige i-bay Namen, jedoch \"3freunde\", \"Heinz-Müller\" oder \"heinz!müller\" werden nicht akzeptiert. Der Name darf max. %1 Zeichen enthalten."

msgid "iba_NAME_LABEL"
msgstr "i-bay Name"

msgid "iba_NONE"
msgstr "Kein Zugriff"

msgid "iba_NO_IBAYS"
msgstr "Zur Zeit sind keine i-bays konfiguriert."

msgid "iba_PASSWORD_DESC"
msgstr "Sie ändern gerade das Kennwort für das i-bay %1."

msgid "iba_PUBLIC_ACCESS"
msgstr "Öffentlicher Zugang über Web oder anonymous FTP"

msgid "iba_REMOVE_DESC"
msgstr "  Sie löschen gerade das i-bay \"%1\" (%2). \n\n   Alle Dateien im i-bay werden gelöscht. \n\n   <b>Sind Sie sicher, daß Sie das i-bay löschen wollen?</b> \n\n  "

msgid "iba_REMOVE_TITLE"
msgstr "i-bay löschen"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "i-bay wurde erfolgreich angelegt."

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "i-bay erfolgreich gelöscht."

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "i-bay wurde erfolgreich geändert."

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "Kennwort erfolgreich zurückgesetzt."

msgid "iba_USER_ACCESS"
msgstr "Benutzerzugang über freigegebene Ordner oder FTP mit Login"

msgid "iba_VHOST_MESSAGE"
msgstr " Die folgenden virtuellen Domänen benutzten dieses i-bay, und ihr Inhalt wird auf die primäre Webseite geändert (Sie können dies anschließend ändern): %1 "

