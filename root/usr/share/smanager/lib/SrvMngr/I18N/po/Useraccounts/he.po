msgstr "Error: the account \"[_1]\" can't be created because there is already a [_2] account of that name."

msgid "usr_ACCOUNT_NAME"
msgstr "שם החשבון"

msgid "usr_ACCOUNT_TOO_LONG"
msgstr "Error: account name is too long. The maximum is [_1] characters."

msgid "usr_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "The account name \"[_1]\" contains invalid characters. Account names must start with a lower case letter and contain only lower case letters, numbers, hyphens, periods and underscores."

