msgid "DELETE_ERROR"
msgstr "(en) DELETE_ERROR"

msgid "grp_ACCOUNT_CONFLICT"
msgstr "Erro: o grupo \"%1\" não pode ser criado porque já existe a conta %2 com esse nome."

msgid "grp_CREATED_GROUP"
msgstr "Grupo de usuários criado com sucesso"

msgid "grp_CREATE_ERROR"
msgstr "Um erro ocorreu enquanto criava grupo de usuários."

msgid "grp_CURRENT_LIST"
msgstr "Lista atual de grupos de usuários\n\n  "

msgid "grp_DELETED_GROUP"
msgstr "Grupo de usuários removido com sucesso"

msgid "grp_DELETE_DESCRIPTION"
msgstr " Voce está prestes a remover o grupo de usuários \"%1\" "

msgid "grp_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

