msgid "Reboot or shutdown"
msgstr "(en) Reboot or shutdown"

msgid "rbo_DESCRIPTION"
msgstr " You can reboot, shut down your server or perform a full system reconfiguration from this screen. You must perform a shutdown before switching the power off. All of these functions take several minutes to complete. When you click ביצוע הפעולה יתחיל מיד אז היה מוכן ! "

msgid "rbo_DESC_REBOOT"
msgstr "השרת שלך יזם תהליך הפעלה מחדש."

msgid "rbo_DESC_RECONFIGURE"
msgstr "השרת שלך יזם שינוי תצורה מלא והפעלה מחדש."

msgid "rbo_DESC_SHUTDOWN"
msgstr "השרת שלך יזם תהליך כיבוי. התהליך יארך מספר דקות עד להשלמתו, לאחר מכן ניתן לכבות את מקור המתח."

msgid "rbo_FORM_TITLE"
msgstr "כיבוי או הפעלה מחדש"

msgid "rbo_LABEL_REBOOT"
msgstr "בחר כיבוי, הפעלה מחדש או שינוי תצורה"

msgid "rbo_REBOOT"
msgstr "הפעלה מחדש"

msgid "rbo_REBOOT_SUCCEEDED"
msgstr "בקשת הפעלה מחדש הופעלה בהצלחה."

msgid "rbo_RECONFIGURE_SUCCEEDED"
msgstr "בקשת שינוי התצורה הופעלה בהצלחה."

msgid "rbo_SHUTDOWN_SUCCEEDED"
msgstr "(en) Shutdown request initiated successfully."

