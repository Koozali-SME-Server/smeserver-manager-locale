msgid "mai_DESC_VIRUS_SCAN"
msgstr "Kereshet vírusokat a ki és bejövő levelekben. Ha a víruskeresés engedélyezve van, és vírust észlel, a levél vissza lesz dobva a feladónak."

msgid "mai_DESC_WEBMAIL"
