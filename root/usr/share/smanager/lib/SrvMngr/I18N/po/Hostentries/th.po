msgid "Hostnames and addresses"
msgstr "ชื่อโฮสต์และที่อยู่"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "ช่วงหมายเลขที่ใช้ของ dynamic DHCP"

msgid "hos_ADD_HOSTNAME"
msgstr " เพิ่มชื่อโฮสต์ "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "สร้างหรือแก้ไขชื่อโฮสต์"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "รายการชื่อโฮสต์ปัจจุบันของ [_1]"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "เกิดข้อผิดพลาดขึ้นระหว่างการสร้างชื่อโฮสต์"

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "เกิดข้อผิดพลาดขึ้นระหว่างการลบชื่อโฮสต์"

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "เกิดข้อผิดพลาดขึ้นระหว่างการแก้ไขชื่อโฮสต์"

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "ผิดพลาด: หมายเลข IP จะเป็นหมายเลขของเซิร์ฟเวอร์หรือหมายเลขของเกตเวย์ไม่ได้"

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "ผิดพลาด: หมายเลข IP นี้ไม่ได้เป็นหมายเลขที่อยู่ในเครือข่ายท้องถิ่นแห่งนี้"

msgid "hos_ETHERNET_ADDRESS"
msgstr "หมายเลขอีเธอร์เน็ต"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "หมายเลขอีเธอร์เน็ต (ethernet address) เป็นตัวเลือก และเป็นการเจาะจงให้เซอร์ฟเวอร์ DHCP ทำการกำนด (bind) เลข IP ภายในที่แน่นอนให้แก่เครื่องที่มีหมายเลขอีเธอร์เน็ตที่ระบุ หากจะกำหนดให้กำหนดให้อยู่ในรูปแบบ \"AA:BB:CC:DD:EE:FF\" โดยแต่ละหลักต้องเป็นตัวเลข 0-9 และตัวอักษร A-F เท่านั้น"

msgid "hos_FORM_TITLE"
msgstr "ชื่อโฮสต์และที่อยู่"

msgid "hos_HOSTNAME"
msgstr "ชื่อโฮสต์"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "ผิดพลาด: มีตัวอักษรที่ไม่ถูกต้องในชื่อโฮสต์: \"[_1].[_2]\" ชื่อโฮสต์ต้องมีเฉพาะตัวอักษร ตัวเลข ยัติภังค์ (-) และต้องเริ่มต้นด้วยตัวอักษรหรือตัวเลขเท่านั้น"

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "ชื่อโฮสต์ต้องเป็นตัวอักษร (ภาษาอังกฤษ), ตัวเลข, จุด (.), และ ยติภังค์ (-) และจะเริ่มต้องต้นด้วยตัวอักษรเท่านั้น"

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "ผิดพลาด: ชื่อ [_1] ถูกใช้เป็นเป็นชื่อของ [_2] ไปแล้ว (need clear)"

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "ผิดพลาด: มีตัวอักษรที่ไม่ถูกต้องในชื่อโฮสต์: \"[_1].[_2]\" ชื่อโฮสต์ต้องมีเฉพาะตัวอักษร ตัวเลข ยัติภังค์ (-) และต้องเริ่มต้นด้วยตัวอักษรหรือตัวเลขเท่านั้น"

msgid "hos_HOSTTYPE"
msgstr "ที่ตั้ง"

msgid "hos_LOCAL_IP"
msgstr "IP ภายในเครื่อง"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "หมายเลข IP ของเครื่องอื่นในเครือข่ายท้องถิ่นนี้, โปรดกรอกหมายเลข IP ที่ถูกต้องในรูปแบบ \"aaa.bbb.ccc.ddd\""

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "กรุณากรอกรายละเอียดเพิ่มเติมของโฮสต์ท้องถิ่น:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "แก้ไขชื่อโฮสต์"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "กรุณากรอกรายละเอียดเพิ่มเติมของรีโมทโฮสต์:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " คุณกำลังจะลบชื่อโฮสต์ \"[_1].[_2]\".   คุณแน่ใจหรือว่าต้องการลบชื่อโฮสต์นี้ ? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "ลบชื่อโฮสต์"

