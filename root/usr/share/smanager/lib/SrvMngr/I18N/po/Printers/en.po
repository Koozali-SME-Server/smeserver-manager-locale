msgid "Printers"
msgstr "Printers"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "You are about to remove the printer: "

msgid "prt_ARE_YOU_SURE"
msgstr "Are you sure you wish to remove this printer?"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "Successfully created printer: "

msgid "prt_CREATE_NETWORK_DESC"
msgstr "Please enter the address and name of the network printer"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "Create a new network printer"

msgid "prt_CREATE_NEW_DESC"
msgstr "Please choose a unique name for the printer and enter a brief\ndescription. The printer name should contain only lower-case\nletters and numbers, and should start with a lower-case\nletter. For example \"hplaser\", \"epsonlp\", and\n\"canonbj\" are valid choices, but \"HP Laser Jet\", \n\"Canon BubbleJet\", and\n\"HP JetDirect Printer\" are not.\nAvoid names and descriptions that contain these terms, \n\"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\",\n\"paper\", \"error\" and \"responding\". "

msgid "prt_CREATE_NEW_PRINTER"
msgstr "Create a new printer"

msgid "prt_CURRENT_LIST"
msgstr "Current List of printers"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "Successfully deleted printer: "

msgid "prt_ERR_EXISTS"
msgstr "Error: An account with the same name exists with type: "

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "Error: internal failure while removing printer: "

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "Error: invalid network address. Did not create new printer."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "Error: invalid network printer name. Did not create new printer."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "Error: unexpected or missing characters in description. \nDid not create new printer."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr "Error: unexpected characters in printer name.\n<P>The printer name should contain only lower-case \nletters and numbers, and should start with a lower-case \nletter. For example \"hplaser\", \"epsonlp\", and \n\"canonbj\" are valid names.</P>"

msgid "prt_FIRST_USB_PRINTER"
msgstr "First USB attached printer"

msgid "prt_FORM_TITLE"
msgstr "Add or remove printers"

msgid "prt_HOSTNAME_OR_IP"
msgstr "Hostname or IP address of the network printer"

msgid "prt_INITIAL_BTN"
msgstr "Add printer"

msgid "prt_LOCAL_PRINTER_0"
msgstr "Local printer port 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "Local printer port 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "Local printer port 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "Must be a valid hostname or IP number"

msgid "prt_NET_PRINTER"
msgstr "Network printer ..."

msgid "prt_NO_PRINTERS"
msgstr "There are no printers in the system."

msgid "prt_PRINTER_NAME"
msgstr "Printer name"

msgid "prt_REMOTE_ADDRESS"
msgstr "Remote address"

msgid "prt_REMOTE_NAME"
msgstr "Remote name"

msgid "prt_REMOTE_NAME_DESC"
msgstr "Network printer name (enter raw if not sure)"

msgid "prt_REMOVE_PRINTER"
msgstr "Remove printer"

msgid "prt_SECOND_USB_PRINTER"
msgstr "Second USB attached printer"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "All the spool files for this printer will be deleted."
