msgid "Reboot or shutdown"
msgstr "(en) Reboot or shutdown"

msgid "rbo_DESCRIPTION"
msgstr " Ezen az oldalon leállíthatja, újraindíthatja, vagy újrakonfigurálhatja a rendszert. Gép lekapcsolása előtt szabályosan le kell állítania a rendszert. Ezek a folyamatok akár több percig is eltarthatnak. Amikor a Végrehajtás-ra kattint, a művelet azonnal végrehajtódik, ezért legyen óvatos! "

msgid "rbo_DESC_REBOOT"
msgstr "A szerver elindította az újraindítási folyamatot."

msgid "rbo_DESC_RECONFIGURE"
msgstr "A szerver elindította a teljes rendszer újrakonfigurálását és újraindítását."

msgid "rbo_DESC_SHUTDOWN"
msgstr "A szerver elindította leállítási folyamatot. A folyamat befejezése akár több percig is eltarthat, amely után lekapcsolhatja a gépet."

msgid "rbo_FORM_TITLE"
msgstr "Leállítás vagy újraindítás"

msgid "rbo_LABEL_REBOOT"
msgstr "Válasszon Leállítást, Újraindítást, vagy Újrakonfigurálást"

msgid "rbo_REBOOT"
msgstr "Újraindítás"

msgid "rbo_REBOOT_SUCCEEDED"
msgstr "Újraindítási kérelem feldolgozva."

msgid "rbo_RECONFIGURE_SUCCEEDED"
msgstr "Újrakonfigurálási kérelem feldolgozva."

msgid "rbo_SHUTDOWN_SUCCEEDED"
msgstr "(en) Shutdown request initiated successfully."

