msgid "Local networks"
msgstr "本地网络"

msgid "ln_ADD_DESC"
msgstr " 每个参数的格式为 #.#.#.# (每一个 # 为0到255之间的数字)。 服务器会根据子网掩码将网络地址的最后一位（作为主机标识）重置为零。  \"Router\" 应该是本地网络上的路由器的IP地址，通过此地址外部网络可以访问本地网络。 "

msgid "ln_ADD_TITLE"
msgstr "添加一个本地网络"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "尝试创建网络时出错。"

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "尝试删除网络地址时出错。"

msgid "ln_FIRSTPAGE_DESC"
msgstr " 基于安全因素，服务器的一些服务只在本地网络有效。然而，您可以通过下面的列表赋予其他网络访问本地网络的权限。大部分的情况会将此列表留空。 添加网络地址 "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "无效的IP地址"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "无效的子网掩码"

msgid "ln_LOCAL NETWORKS"
msgstr "本地网络"

msgid "ln_LOCALNETWORK_ADD"
msgstr "添加网络"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "错误：网络[_1] （由网络[_2]和子网掩码[_3]衍生而来）已被添加。无法添加新网络。"

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "错误：网络[_1] （由网络[_2]和子网掩码[_3]衍生而来）已被视为本地网络。无法添加新网络。"

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "错误：从本地网络无法访问路由地址[_1]。无法添加这个网络。"

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "主机数量"

msgid "ln_REMOVE_DESC"
msgstr "即将删除以下本地网络。"

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "您要删除的本地主机的网络配置已经被检测到。默认情况下，它们也需要被移除。如果出于某种原因，您不希望发生这种事情，可以取消。请注意，当这个网络被移除后，他们不会被视为本地主机，甚至有可能不能访问。"

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "删除主机，位于网络"

msgid "ln_REMOVE_TITLE"
msgstr "删除本地网络"

msgid "ln_SUBNET_MASK"
msgstr "子网掩码"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "成功添加网络 [_1]/[_2] 通过路由器 [_3]。服务器将赋予在[_4] 和[_5]之间的[_6]个IP地址访问本地网络的权限。"

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "  成功添加网络 [_1]/[_2] 通过路由器 [_3]。 \n\n  <p> 服务器将赋予在[_1] 和[_2]之间的[_3]个IP地址访问本地网络的权限。 </p>\n\n  <p> 警告:ProFTPd FTP 服务器不能处理这种非标准的子网掩码。 简单的说明 <b>[_1]</b> 将会被替代。 </p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "成功添加网络 [_1]/[_2] 通过路由器 [_3]。"

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "成功添加网络 [_1]/[_2] 通过路由器 [_3]。服务器将赋予IP地址[_4]访问本地网络的权限。"
