msgid "LOG_LIVESTREAM"
msgstr "(en) Live stream"

msgid "log_END_DESC"
msgstr "Prosim pocakaj ta operacija lahko traja, da zgenerira porocilo."

msgid "log_ERR_NOEXIST_FILE"
msgstr "(en) Err noexist file"

msgid "log_ERR_NOOPEN_FILE"
msgstr "(en) Err noopen file"

msgid "log_FILENAME_ERROR"
msgstr " Napaka pri procesiranju LOG datoteke.\n\n  <p>Napacen tip porocila \"%1\".</p>\n\n  "

msgid "log_FILTER_PATTERN_DESC"
msgstr " Tu lahko dolocis nastavitve filtra, ki ti izpise samo zapise, ki se ujemajo z besedami v filtru. Ce ostane to polje prazno bodo prikazani vsi zapisi v datoteki. Pazi pri opciji prenosa LOG datoteke ta opcija ne velja. \n\n  "

msgid "log_FILTER_PATTERN_HINT"
msgstr "(en) The pattern is case insensitive, but enclosing it in \"/\" will result in it being treated as a regex."

msgid "log_FILTER_PATTERN_LABEL"
msgstr "Nastavitev filtra (opcija)"

msgid "log_FIRSTPAGE_DESC"
msgstr " Ta funkcija ti omogoca pregled ali prenos LOG datotek, ki so jih zapisali procesi, ki tecejo na Strezniku. "

msgid "log_FORM_TITLE"
msgstr "Ogled dnevniških datotek"

msgid "log_HIGHLIGHT_HEADER"
msgstr "Ojacani zapisi, ki se ujemajo: \"%1\"."

msgid "log_LOG_FILE_EMPTY"
msgstr "LOG datoteka \"%1\" je brez zapisov!"

msgid "log_LOG_FILE_SELECT_DESC"
msgstr "Izberi LOG datoteko za ogled"

msgid "log_MATCH_HEADER"
msgstr "Izpis zapisov, ki se ujemajo: \"%1\"."

msgid "log_MATCH_PATTERN_DESC"
msgstr " Lahko izberes tudi opcijo poudarjeno besedilo, ki bo poudarilo vrstico zapisa, ki se ujema z izbranim besedilom. Pazi pri opciji prenosa LOG datoteke ta opcija ne velja. \n\n  "

msgid "log_MATCH_PATTERN_LABEL"
msgstr "Poudarjeno besedilo (opcija)"

msgid "log_NO_MATCHING_LINES"
msgstr "Ni zapisov za prikazNo matching lines displayed."

msgid "log_OP_DESC"
msgstr " Izbrati moras med ogledom datoteke v brkljalniku ali med prenosom LOG datoteke na svoj racunalnik. Ce je LOG datoteka izredno velika, jo bos morda raje prenesel dol namesto da si jo ogledas z brkljalnikom, ker je za nekatere brkljalnike to lahko problem.\n\n  "

msgid "log_OP_LABEL"
msgstr "Postopek"

msgid "log_REFRESH"
msgstr "Osvezi LOG datoteko"

msgid "log_VIEW"
msgstr "Poglej LOG datoteko"

msgid "log_VIEWING_TIME"
msgstr "Pogledano %1."

