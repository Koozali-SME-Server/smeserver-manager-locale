msgid "Hostnames and addresses"
msgstr "Direcciones y nombres de host"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "La dirección está dentro del rango dinámico asignado por DHCP"

msgid "hos_ADD_HOSTNAME"
msgstr " Agregar nombre de host "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Crear o modificar el nombre de host"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Lista actual de nombres de host para [_1]"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Ocurrió un error al crear el nombre de host."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Ocurrió un error al eliminar el nombre de host."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Ocurrió un error al modificar el nombre de host."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Error: La IP no puede ser la IP del servidor o de la puerta de enlace."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Error: Esta dirección IP no existe en nuestra red local."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Dirección Ethernet"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "La dirección ethernet es opcional y permite que el servidor DHCP conecte de manera estática la dirección IP local al ordenador con esta dirección ethernet. Si se especifica, debe tener la forma \"AA:BB:CC:DD:EE:FF\" y debe contener sólo los números del 0-9 y las letras A-F."

msgid "hos_FORM_TITLE"
msgstr "Nombres de host y direcciones"

msgid "hos_HOSTNAME"
msgstr "Nombre de host"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Error: caracteres erróneos en el nombre de host: \"[_1].[_2]\". El nombre de host debe contener sólo letras, números y guiones y debe comenzar con una letra o un número."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "El nombre de host debe contener sólo letras, números y guiones y debe comenzar con una letra o un número."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Error: la cuenta [_1] corresponde a un nombre de host [_2] existente."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Error: caracteres erróneos en el nombre de host: \"[_1].[_2]\". El nombre de host debe contener sólo letras, números y guiones y debe comenzar con una letra o un número."

msgid "hos_HOSTTYPE"
msgstr "Ubicación"

msgid "hos_LOCAL_IP"
msgstr "IP local"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "La dirección IP local es la dirección IP de otro equipo en la red local. Escriba una dirección IP válida en el formato \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Escriba los siguientes detalles adicionales para un host local:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Modificar el nombre de host"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Escriba los siguientes detalles adicionales para un host remoto:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Está a punto de eliminar el nombre de host \"[_1].[_2]\".   ¿Está seguro de que desea eliminar este nombre de host? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Eliminar nombre de host"

