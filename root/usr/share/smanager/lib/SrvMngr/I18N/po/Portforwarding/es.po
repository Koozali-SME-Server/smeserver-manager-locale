msgid "Port forwarding"
msgstr "Reenvío de puerto"

msgid "pf_ALLOW_HOSTS"
msgstr "Permitir Hosts"

msgid "pf_CREATE_RULE"
msgstr "Crear regla de reenvío de puerto"

msgid "pf_ERR_BADAHOST"
msgstr "Esta no parece ser una lista válida de direcciones IP. ej: 192.168.0.1,192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "Ésta no parece ser una dirección IP. Debe utilizar notación cuádruple punteada y cada uno de los cuatro números debe ser inferior a 256. ej: 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "Los puertos deben ser un entero positivo inferior a 65536."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "El evento devolvió un valor de retorno diferente de cero."

msgid "pf_ERR_PORT_COLLISION"
msgstr "ERROR: El puerto o rango de puertos entra en conflicto con una regla existente. Modifique esta regla o elimine la antigua."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  Usted puede utilizar este panel para modificar las reglas de su firewall como también para abrir un puerto específico de su servidor y reenviarlo a otro puerto de otro host. Si lo hace, podrá permitir al tráfico entrante acceder directamente a un host privado en particular de su LAN. \n\n  <p> ADVERTENCIA: El mal uso de esta función puede comprometer seriamente la seguridad de su red. No utilice esta función ligeramente o sin entender totalmente las consecuencias de sus acciones. </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Configurar Reenvío de Puerto"

msgid "pf_IN_SERVERONLY"
msgstr "Este servidor está actualmente en el modo solo-servidor y el reenvío de puerto sólo es posible al localhost."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Dirección IP del Host de Destino"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Puerto(s) de destino"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protocolo"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Puerto(s) de origen"

msgid "pf_NO_FORWARDS"
msgstr "Actualmente, no hay puertos reenviados en el sistema."

msgid "pf_RULE_COMMENT"
msgstr "Comentario de la Regla"

msgid "pf_SHOW_FORWARDS"
msgstr "A continuación, encontrará una tabla que resume las reglas actuales de reenvío de puerto instaladas en este servidor. Haga click en el vínculo &quot;Eliminar&quot; para eliminar la regla correspondiente."

msgid "pf_SUCCESS"
msgstr "Los cambios a las reglas de reenvío de puerto se guardaron con éxito."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "La siguiente tabla resume la regla de reenvío de puerto que está a punto de agregar. Si está satisfecho con la regla, haga click en el botón &quot;Agregar&quot;. De lo contrario, haga click en el botón &quot;Cancelar&quot;."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "La siguiente tabla resume la regla de reenvío de puerto que está a punto de eliminar. Si está seguro de que desea eliminar la regla, haga click en el botón &quot;Eliminar&quot;. De lo contrario, haga click en el botón &quot;Cancelar&quot;."

