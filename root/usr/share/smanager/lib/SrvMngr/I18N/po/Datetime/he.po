msgstr "שגיאה: שעה אינה תקינה:"

msgid "dat_INVALID_MINUTE"
msgstr "שגיאה: דקות לא תקינות:"

msgid "dat_INVALID_NTP_SERVER"
msgstr " שרת NTP לא תקין, השרת לא ינסה לסנכרן משרת זמן רשתי. "

msgid "dat_INVALID_SECOND"
msgstr "שגיאה: שניות לא תקינות"

msgid "dat_Invalid_date"
msgstr "תאריך לא חוקי"

msgid "dat_NTP_CONFIGURE_DESC"
msgstr "מעת לעת השרת מסנכרן את שעון המערכת מול שרת פרוטוקול הזמן ברשת (NTP) המצויין למטה. כדי לסנכרן לשרת NTP שונה, הזן שם אחר או כתובת IP בשדה למטה."

msgid "dat_NTP_DISABLE_DESC"
msgstr "בחר באפשרות זו כדי להפסיק את סנכרון שעון המערכת מול שרת NTP. כאשר שירות ה NTP מושבת, ניתן להגדיר זמן מערכת באופן ידני בדף זה."

msgid "dat_NTP_ENABLE_DESC"
msgstr "השרת יכול לסנכרן את שעון המערכת מדי פעם מול שרת זמן רשתי (שרת NTP) . אם אפשרות זו נבחרה, נא להכניס את שם השרת או את כתובת הIP של שרת NTP למטה."

msgid "dat_NTP_Server_URL"
msgstr "כתובת URL של שרת NTP:"

msgid "dat_SETTINGS_CHANGED"
msgstr "הגדרות שרת זמן רשתי שונו בהצלחה"

