msgid "Local networks"
msgstr "Jaringan lokal"

msgid "ln_ADD_DESC"
msgstr " Tiap parameter harus dalam bentuk #.#.#.# (tiap # adalah angka dari 0 s.d 255). Server akan mengubah akhir (pengenal host) bagian dari alamat jaringan sesuai dengan subnet mask, untuk memastikan bahwa alamat network valid.  \"Router\" adalah alamat IP dari router dalam jaringan lokal anda untuk mencapai jaringan tambahan tersebut. "

msgid "ln_ADD_TITLE"
msgstr "Tombah jaringan lokal"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "Gagal saat membuat jaringan"

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "Terjadi error saat menghapus jaringan."

msgid "ln_FIRSTPAGE_DESC"
msgstr " For security reasons, several services on your server are available only to your local network. However you can grant these local access privileges to additional networks by listing them below. Most installations should leave this list empty. Add network "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "IP address cacat"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Subnet mask cacat"

msgid "ln_LOCAL NETWORKS"
msgstr "Jaringan lokal"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Tambahkan jaringan"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "Error: jaringan %1 (diturunkan dari jaringan%2 dan subnet mask %3) sudah pernah ditambah. Jaringan baru tidak ditambah."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "Error: jaringan %1 (diturunkan dari jaringan%2 dan subnet mask %3) telah dianggap lokal. Jaringan baru tidak ditambah."

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "Error: alamat router %1 tidak dapat diakses dari jaringan lokal. Jaringan tidak ditambah."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Jumlah host"

msgid "ln_REMOVE_DESC"
msgstr "Anda akan menghapus jaringan lokal sebagai berikut"

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "Host lokal yang ada dalam jaringan yang akan anda hapus telah terdeteksi. Secara default, mereka juga akan dihapus. Uncheck kotak ini jika, dengan beberapa alasan, anda tidak ingin hal ini terjadi. Harap dicatat bahwa mereka tidak akan diperlakukan sebagai lokal, bahkan mungkin tidak dapat dihubungi setelah network ini dihapus."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "Hapus host dalam jaringan"

msgid "ln_REMOVE_TITLE"
msgstr "Hapus jaringan lokal"

msgid "ln_SUBNET_MASK"
msgstr "Subnet mask"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "Berhasil menambah jaringan %1/%2 melalui router %3. Server anda akan mengabulkan hak akses lokal ke %4 alamat IP dalam range %5 s.d %6."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "  Berhasil menambah jaringan %1/%2 melaluirouter %3. \n\n  <p> Server anda akan mengabulkan hak akses lokal ke %1 alamat IP dalam range %2 s.d %3. </p>\n\n  <p> Peringatan: Server FTP ProFTPd tidak dapat menangani subnet mask nonstandard ini. Spesifikasi yang lebih sederhana <b>%1</b> akan digunakan. </p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "Berhasil menghapus jaringan %1/%2 lewat router %3."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "Berhasil menambah jaringan %1/%2 melalui router %3. Server anda akan mengabulkan hak akses lokal ke alamat IP tunggal %4."
