msgid "rma_VALIDFROM_DESC"
msgstr " [_1] Tu je mozno dolociti oddaljeno omrezje za dostop do Upravljalca Streznika (server-manager). Uporabi masko podomrezja 255.255.255.255, da omogocis dostop samo izbranemu gostitelju (host-u). Vsak gostitelj v izbranem obmocju bo imel dostop do Upravljalca Streznika preko HTTPS povezave.. "

msgid "rma_VALIDFROM_TITLE"
msgstr "[_1]"

