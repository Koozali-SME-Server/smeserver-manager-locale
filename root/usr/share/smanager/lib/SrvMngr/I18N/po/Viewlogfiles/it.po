msgid "LOG_LIVESTREAM"
msgstr "(en) Live stream"

msgid "log_END_DESC"
msgstr "Notare che potrebbe essere necessario attendere alcuni minuti per la generazione del rapporto."

msgid "log_ERR_NOEXIST_FILE"
msgstr "(en) Err noexist file"

msgid "log_ERR_NOOPEN_FILE"
msgstr "(en) Err noopen file"

msgid "log_FILENAME_ERROR"
msgstr " Errore nel nome del file di log.\n\n  <p>Tipo rapporto non valido \"%1\".</p>\n\n  "

msgid "log_FILTER_PATTERN_DESC"
msgstr " E' possibile specificare un filtro che visualizzi solo le linee del log che soddisfano certi criteri. Lasciando vuoto il campo verranno mostrate tutte le linee del log. Notare che l'opzione viene ignorata in caso di download del log.\n\n  "

msgid "log_FILTER_PATTERN_HINT"
msgstr "(en) The pattern is case insensitive, but enclosing it in \"/\" will result in it being treated as a regex."

msgid "log_FILTER_PATTERN_LABEL"
msgstr "Filtro (opzionale)"

msgid "log_FIRSTPAGE_DESC"
msgstr " Questa pagina permette di visualizzare o scaricare i file di log generati dai servizi che girano sul server. "

msgid "log_FORM_TITLE"
msgstr "Visualizza i file di log"

msgid "log_HIGHLIGHT_HEADER"
msgstr "Vengono evidenziate le linee che comprendono: \"%1\"."

msgid "log_LOG_FILE_EMPTY"
msgstr "Il log \"%1\" è vuoto!"

msgid "log_LOG_FILE_SELECT_DESC"
msgstr "Selezionare un file di log da visualizzare"

msgid "log_MATCH_HEADER"
msgstr "Vengono mostrate le linee che comprendono: \"%1\"."

msgid "log_MATCH_PATTERN_DESC"
msgstr " E' possibile specificare un filtro che evidenzi in grassetto le linee corrispondenti a certi criteri. I criteri di evidenziazione vengono applicati alle linee che già soddisfano i criteri di filtro. Notare che questa opzione viene ignorata in caso di download del log.\n\n  "

msgid "log_MATCH_PATTERN_LABEL"
msgstr "Filtro Evidenziazione (opzionale)"

msgid "log_NO_MATCHING_LINES"
msgstr "Nessuna linea corrispondente al filtro."

msgid "log_OP_DESC"
msgstr " E' necessario scegliere se visualizzare il log nel browser oppure scaricarlo sul computer. Se il file di log è particolarmente grande, è preferibile scaricarlo invece di aprirlo nel browser, perché alcuni browser hanno problemi con file molto grandi.\n\n  "

msgid "log_OP_LABEL"
msgstr "Operazione"

msgid "log_REFRESH"
msgstr "Aggiorna questo log"

msgid "log_VIEW"
msgstr "Visualizza log"

msgid "log_VIEWING_TIME"
msgstr "Visualizzato alle %1."

