msgid "iba_ACCOUNT_EXISTS"
msgstr "I-list \"[_1]\" je obstojeci [_2] racun."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " Ime i-liste \"[_1]\" se ujema s psevdonimom podrobnosti za [_2] racun \"[_3]\". [_1] je psevdonim za [_3]. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "Ime i-liste \"[_1]\" vsebuje neveljavne znake. Imena I-liste se morajo zaceti z majhno crko in morajo vsebovati samo majhne crke, stevilke in vezaje."

msgid "iba_ADD_IBAY"
msgstr "Dodaj i-bay"

msgid "iba_ADD_TITLE"
msgstr "Dodaj ali uredi i-list"

msgid "iba_ALLOW_DYNAMIC_CONTENT"
msgstr "Izvajanje dinamicnih vsebin (CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "Ne morem dodati novega i-lista z imenom [_1] (ali to ime morda ze obstaja?)"

msgid "iba_CANT_FIND_IBAY"
msgstr "Ne najdem i-lista [_1] (ne obstaja?)"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "Celoten internet (brez gesla)"

msgid "iba_ENTIRE_INTERNET_PASSWORD"
msgstr "Celoten internet (zahteva geslo)"

msgid "iba_ENTIRE_INTERNET_PASSWORD_REMOTE"
msgstr "Celoten internet (zahteva geslo samo zunaj lokalnega omrezja)"

msgid "iba_ERROR_WHILE_CREATING_IBAY"
msgstr "Pri ustvarjanju i-lista je prislo do napake."

msgid "iba_ERROR_WHILE_DELETING_IBAY"
msgstr "Pri odstranjevanju I-lista je prislo do napake."

msgid "iba_ERROR_WHILE_MODIFYING_IBAY"
msgstr "Pri posodobitvi i-lista je prislo do napake."

msgid "iba_ERROR_WHILE_RESETTING_PASSWORD"
msgstr "Pri ponastavljanju gesla je prislo do napake."

msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "  Dodaj i-list \n\n   Odstranite lahko vsak informacijski list ali ponastaavite njegovo geslo s klikom na ustrezno povezavo ukaza zraven imena informacijskega lista. Ce je ime informacijskega lista izpisano rdece pomeni, da se niste zamenjali gesla s privzete vrednosti in bi ga bilo smiselno zamenjati cim prej. \n\n  "

msgid "iba_FORM_TITLE"
msgstr "Ustvari, posodobi ali odstrani i-list"

msgid "iba_HTTPS_Only"
msgstr "Prisili varne povezave"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "Gesli se ne ujemata."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Lokalno omrezje (brez gesla)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "Lokalno omrezje (zahteva geslo)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "Ime i-liste \"[_1]\" je predolgo. Maksimalno stevilo znakov je [_1]."

msgid "iba_NAME_FIELD_DESC"
msgstr "Ime informacijskega lista sme vsebovati samo majhne crke, stevilke, pike, vezaje in podcrtaje, ter se zacne z majno crko. Npr. \"novak\", \"inter\" in \"just4.you\" so veljavna imena, imena \"5tica\", \"Janez Novak\" in \"Novi!Partner\" pa ne. Ime je omejeno na maksimalno [_1] znakov."

msgid "iba_NAME_LABEL"
msgstr "Ime informacijskega lista"

msgid "iba_NONE"
msgstr "Brez dostopa"

msgid "iba_NO_IBAYS"
msgstr "Trenutno ni nobenega i-lista v sistemu."

msgid "iba_PASSWORD_DESC"
msgstr "Ste tik pred tem, da spremenite geslo za i-list [_1]."

msgid "iba_PUBLIC_ACCESS"
msgstr "Javen spletni dostop ali anonimen FTP"

msgid "iba_REMOVE_DESC"
msgstr "  Ste tik pred tem, da odstranite informacijski list \"[_1]\" ([_2]). \n\n   Vse datoteke v tem informacijskem listu bodo izbrisane. \n\n   Ali ste prepricani, da zelite odstraniti ta informacijski list? \n\n  "

msgid "iba_REMOVE_TITLE"
msgstr "Odstrani informacijski list"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "I-list je bil uspesno ustvarjen."

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "I-list je bil uspesno odstranjen."

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "I-list je bil uspesno posodobljen."

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "Geslo je bilo uspesno ponastavljeno."

msgid "iba_USER_ACCESS"
msgstr "Uporabniski dostop v skupni rabi ali ftp"

msgid "iba_VHOST_MESSAGE"
msgstr "  Naslednje navidezne domene uporabljajo vsebino tega i-lista za spletno stran. Sedaj bo uporabljena vsebina primarne spletne strani. (kasneje lahko to poljubno spremenite):\n\n  <ul>[_1]</ul> "

