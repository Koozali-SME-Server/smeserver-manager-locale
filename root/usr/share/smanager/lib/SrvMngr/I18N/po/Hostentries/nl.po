msgid "Hostnames and addresses"
msgstr "Hostnamen en adressen"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "Het adres ligt binnen het DHCP toegewezen dynamisch bereik"

msgid "hos_ADD_HOSTNAME"
msgstr " Hostnaam toevoegen "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Hostnaam toevoegen of wijzigen"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Huidige lijst met hostnamen voor %1"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Er is een fout opgetreden tijdens het toevoegen van de hostnaam."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Er is een fout opgetreden tijdens het verwijderen van de hostnaam."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Er is een fout opgetreden tijdens het wijzigen van de hostnaam."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Fout: IP kan niet gelijk zijn aan server IP of Gateway IP."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Fout: Dit IP adres maakt geen deel uit van een van de lokale netwerken."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Ethernet adres"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "Het ethernet adres is optioneel en zorgt er voor dat de DHCP server het lokale IP adres statisch verbindt aan de computer met dit ethernet adres. Indien opgegeven, dient dit te gebeuren in het formaat \"AA:BB:CC:DD:FF\" en mag het enkel de cijfers 0-9 en de letters A-F bevatten."

msgid "hos_FORM_TITLE"
msgstr "Hostnamen en adressen"

msgid "hos_HOSTNAME"
msgstr "Hostnaam"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Fout: onverwachtte tekens in de beschrijving van \"%1.%2\". De beschrijving mag alleen letters, spaties, cijfers, punten, komma's, onderstrepingstekens en koppeltekens bevatten en moet beginnen met een letter of een cijfer."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "De hostnaam kan alleen letter, cijfers en koppeltekens bevatten en dient te beginnen met een letter of cijfer."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Fout: De account %1 is een bestaande %2 host naam."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Fout: onverwachtte tekens in de hostnaam: \"%1.%2\". De hostnaam mag alleen letters, cijfers en koppeltekens bevatten en moet beginnen met een letter of een cijfer."

msgid "hos_HOSTTYPE"
msgstr "Locatie"

msgid "hos_LOCAL_IP"
msgstr "Lokaal IP"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "Het lokale IP adres is het IP adres van een andere machine binnen het lokale netwerk. Geef een geldig IP adres op in het formaat \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Geef de volgende details op voor de lokale host:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Hostnaam wijzigen"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "A.u.b. de volgende details voor de host elders opgeven:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " U staat op het punt de systeemnaam \"%1.%2\" te verwijderen.   Weet u zeker dat u deze systeemnaam wilt verwijderen? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Hostnaam verwijderen"

