msgid "rma_NUMBER_OF_PPTP_CLIENTS_MUST_BE_LESSER_THAN_NUMBER_OF_IP_IN_DHCP_RANGE"
msgstr "Die Anzahl der PPTP Clients ist größer als die Anzahl der für DHCP reservierten IP-Adressen. Sie sollten eine kleinere Anzahl einstellen."

msgid "rma_NUM_OF_HOSTS"
