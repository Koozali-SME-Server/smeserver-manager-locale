msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en) Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Ajouter un domaine"

msgid "dom_CONTENT"
msgstr "i-bay %1"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "Pour le contenu du site Web, vous pouvez sélectionner votre site primaire ou toute baie d'information :"

msgid "dom_CREATE_TITLE"
msgstr "Créer un domaine"

msgid "dom_CURRENT_DOMAINS"
msgstr "Liste actuelle des domaines"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Si ce serveur n'a pas d'accès à Internet ou que vous avez une contrainte spécifique pour la résolution DNS, tapez ici les adresses IP de vos serveurs DNS. Laissez ces champs vides à moins que vous n'ayez une raison incontournable d'utiliser d'autres serveurs DNS. Ne tapez pas ici l'adresse du serveur DNS de votre FAI (ISP) : ce serveur est capable de résoudre les noms de domaine Internet sans configuration supplémentaire."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr "Paramètres DNS de votre organisation"

msgid "dom_DESC_NAMESERVERS"
msgstr "Vous pouvez choisir si ce domaine doit être résolu localement, géré par les serveurs DNS de votre organisation, ou résolu par les serveurs DNS de l'Internet. La valeur par défaut conviendra à la plupart des réseaux."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Modifier les paramètres DNS de votre organisation"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "ERREUR : caractères inattendus ou manquants dans la description du domaine \"%1\". Le domaine n'a pas été créé."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "ERREUR : le domaine \"%1\" existe déjà. Le domaine n'a pas été créé."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "ERREUR : caractères inattendus ou manquants dans le nom du domaine \"%1\". Le nom du domaine doit contenir au moins une lettre, des chiffres, des points et des traits d'union. Le domaine n'a pas été créé."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "ERREUR : une erreur s'est produite lors de la suppression du domaine \"%1\"."

msgid "dom_FORM_DESCRIPTION"
msgstr " Si vous créez un domaine, le serveur pourra recevoir des courriels et héberger un site Web pour ce domaine."

msgid "dom_FORM_TITLE"
msgstr "Gestion des domaines"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Serveur DNS primaire de votre organisation"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Serveur DNS secondaire de votre organisation"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Serveurs DNS du domaine"

msgid "dom_MODIFY_TITLE"
msgstr "Modifier le domaine"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "ERREUR : le domaine \"%1\" est inexistant."

msgid "dom_PRIMARY_SITE"
msgstr "site primaire"

msgid "dom_REMOVE_DESCRIPTION"
msgstr " Vous êtes sur le point de supprimer le domaine \"%1\" (%2)..\n\n  <p><b>Voulez-vous vraiment supprimer ce domaine ?</b></p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Supprimer le domaine"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Le domaine \"%1\" a été créé avec succès. Votre service Web redémarre. Les liens de cette page seront inactifs jusqu'à la fin du redémarrage du service Web."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Le domaine \"%1\" a été supprimé avec succès. Votre service Web redémarre. Les liens de cette page seront inactifs jusqu'à la fin du redémarrage du service Web."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Le domaine \"%1\" a été modifié avec succès. Votre service Web redémarre. Les liens de cette page seront inactifs jusqu'à la fin du redémarrage du service Web."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "ERREUR : \"%1\" est le nom du domaine primaire de votre système. Il est impossible d'avoir un domaine avec le même nom. Le domaine n'a pas été créé."

msgid "dom_corporate"
msgstr "Serveurs DNS de votre organisation"

msgid "dom_internet"
msgstr "Serveurs DNS de l'Internet"

msgid "dom_localhost"
msgstr "Résolu localement"

