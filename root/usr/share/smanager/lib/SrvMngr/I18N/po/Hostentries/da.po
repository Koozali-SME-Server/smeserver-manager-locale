msgid "Hostnames and addresses"
msgstr "Værtsnavne og adresser"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "Adressen er indenfor DHCP-området"

msgid "hos_ADD_HOSTNAME"
msgstr " Tilføj værtsnavn "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Oprette eller ændre værtsnavn"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Aktuelle værtsnavne for [_1]"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Fejl under oprettelse af værtsnavn."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Fejl under sletning af værtsnavn."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Fejl under ændring af værtsnavn."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Fejl: IP-adressen må ikke være server- eller gateway IP-adressen."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Fejl: Denne IP-adresse er ikke på lokale netværk."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Netværksadresse"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "Netkortets mac-addresse er en mulighed, der indstiller DHCP server til statisk at binde den lokale IP-addresse til computeren med pågældende mac-addresse. Hvis mac-addressen angives, skal den have formen \"AA:BB:CC:DD:EE:FF\" og må kun indeholde tallene 0-9 og bogstaverne A-F."

msgid "hos_FORM_TITLE"
msgstr "Værtsnavne og adresser"

msgid "hos_HOSTNAME"
msgstr "Værtsnavn"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Fejl: Uventede tegn i kommentarfeltet til \"[_1].[_2]\". Kommentarerne må kun bestå af bogstaver, mellemrum, tal, punktum, komma, understregning og bindestreger og skal starte med et bogstav eller et tal."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Værtsnavnet må kun indeholde bogstaver, tal og bindestreger og skal starte med et bogstav eller et tal."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Fejl: kontoen [_1] findes i forvejen som [_2] værtsnavn."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Fejl: Uventede tegn i værtsnavn: \"[_1].[_2]\". Værtsnavnet må kun indeholde bogstaver, tal og bindestreger og skal starte med et bogstav eller et tal."

msgid "hos_HOSTTYPE"
msgstr "Placering"

msgid "hos_LOCAL_IP"
msgstr "Lokal IP"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "Den lokale IP-adresse er IP-adressen på en anden maskine på det lokale net. Venligst indtast en gyldig IP-adresse i formatet \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Venligst angiv følgende yderligere detaljer om din lokale vært:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Ændr værtsnavn"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Venligst angiv følgende yderligere detaljer om din fjerne vært:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Du er ved at fjerne værtsnavnet \"[_1].[_2]\".   Er du sikker på du ønsker det fjernet? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Fjern værtsnavn"

