msgid "Port forwarding"
msgstr "(en) Port forwarding"

msgid "pf_ALLOW_HOSTS"
msgstr "Kiszolgálók engedélyezése"

msgid "pf_CREATE_RULE"
msgstr "Port továbbítási szabály létrehozása"

msgid "pf_ERR_BADAHOST"
msgstr "Ez nem tűnik érvényes IP cím listának. Pl.: 192.168.0.1,192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "Ez nem úgy néz ki mint egy IP cím. Az IP cím négy pontokkal elválasztott számból áll és minden számnak 256-nál kisebbnek kell lennie. Például 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "A portszámoknak 65536-nál kisebb egész számoknak kell lenniük."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "A folyamat nem-nulla visszatérési értéket adott."

msgid "pf_ERR_PORT_COLLISION"
msgstr "HIBA: Ez a portszám, vagy port-tartomány ütközik egy létező szabállyal. Módosítsa az új szabályt, vagy távolítsa el a régit."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  Ezen az oldalon módosíthatja a tűzfalszabályokat, valamint megnyithat egy meghatározott portot a szerveren, amit továbbíthat egy másik gép valamely portjára. Egy ilyen beállítás a bejövő forgalmat közvetlenül átirányítja a belső hálózat gépére. \n\n  <p> Figyelem: Ennek a szolgáltatásnak a helytelen használatával komolyan veszélyeztetheti a belső hálózat biztonságát. Ne használja ezt a szolgáltatást felelőtlenül, vagy anélkül, hogy teljes mértékben tisztában lenne a tettei következményeivel. </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Port továbbítás konfigurálása"

msgid "pf_IN_SERVERONLY"
msgstr "Ez a szerver, csak szerver módban működik, ezért a port átirányítást csak a localhost-ra adhatja meg."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Célgép IP címe"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Cél Port(ok)"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protokoll"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Forrás Port(ok)"

msgid "pf_NO_FORWARDS"
msgstr "Nincsenek továbbított portok a rendszeren."

msgid "pf_RULE_COMMENT"
msgstr "Szabály leírása"

msgid "pf_SHOW_FORWARDS"
msgstr "Az alább látható táblázat összefoglalja a szerver jelenlegi port-továbbítási szabályait. Egy szabály eltávolításához kattintson a szabály melletti &quot;Eltávolítás&quot; gombra."

msgid "pf_SUCCESS"
msgstr "A port-továbbítási szabályok változásainak mentése megtörtént."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "A következőekben van összefoglalva az a port-továbbítási szabály, amelyet hozzá akar adni. Ha megfelelő a szabály kattintson a &quot;Hozzáadás&quot; gombra. Ellenkező esetben kattintson a &quot;Mégsem&quot; gombra."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "A következőekben van összefoglalva az a port-továbbítási szabály, amelyet el akar távolítani. Ha biztos benne, kattintson a &quot;Eltávolítás&quot; gombra. Ellenkező esetben kattintson a &quot;Mégsem&quot; gombra."

