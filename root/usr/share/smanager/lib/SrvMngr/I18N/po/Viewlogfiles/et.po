msgid "LOG_LIVESTREAM"
msgstr "(en) Live stream"

msgid "log_END_DESC"
msgstr "Ole kannatlik, raporti koostamine võib natuke aega võtta"

msgid "log_ERR_NOEXIST_FILE"
msgstr "(en) Err noexist file"

msgid "log_ERR_NOOPEN_FILE"
msgstr "(en) Err noopen file"

msgid "log_FILENAME_ERROR"
msgstr "(en)Error while specifying log file name.\n\n  <p>Invalid report type \"%1\".</p>"

msgid "log_FILTER_PATTERN_DESC"
msgstr "(en)You may optionally specify a filter pattern to display only the lines from the log file which match this pattern. If you leave this field blank, all available lines of the log file will be displayed. Note that this option is not used if you download the logfile."

msgid "log_FILTER_PATTERN_HINT"
msgstr "(en) The pattern is case insensitive, but enclosing it in \"/\" will result in it being treated as a regex."

msgid "log_FILTER_PATTERN_LABEL"
msgstr "Filtreeri Pattern (valikuline)"

msgid "log_FIRSTPAGE_DESC"
msgstr " Siit saad vaadata või allalaadida logifaile mille on koostanud erinevad teenused selles serveris. "

msgid "log_FORM_TITLE"
msgstr "Vaata logifaile"

msgid "log_HIGHLIGHT_HEADER"
msgstr "Esiletõstetakse read, mis vastavad: \"%1\"."

msgid "log_LOG_FILE_EMPTY"
msgstr "Logifail \"%1\" on tühi!"

msgid "log_LOG_FILE_SELECT_DESC"
msgstr "Vali logifail mida vaadata"

msgid "log_MATCH_HEADER"
msgstr "Kuvatakse read, mis vastavad: \"%1\"."

msgid "log_MATCH_PATTERN_DESC"
msgstr "(en)You may also optionally specify a highlight pattern to mark in bold any lines from the log file which match the highlight pattern. The highlight pattern is applied to any lines which have already matched the filter pattern. Note that this option is not used if you download the logfile."

msgid "log_MATCH_PATTERN_LABEL"
msgstr "Esiletõstmise muster (valikuline)"

msgid "log_NO_MATCHING_LINES"
msgstr "Ühtegi vastavat rida ei kuvata."

msgid "log_OP_DESC"
msgstr " Sa pead valima kas soovid vaadtat logifaili oma brauseris või salvestad logifaili oma arvutisse. Logifailid on tavaliselt üsna mahukad, seepärast on soovitatav logifail oma arvutisse salvestada. \n\n  "

msgid "log_OP_LABEL"
msgstr "Tegevus"

msgid "log_REFRESH"
msgstr "Värskenda seda logifaili"

msgid "log_VIEW"
msgstr "Vaata logifaile"

msgid "log_VIEWING_TIME"
msgstr "Vaadatud %1."

