msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Добавить домен"

msgid "dom_CONTENT"
msgstr "[_1] и-раздел"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "Для веб-сайта вы можете выбрать свой основной веб-сайт или любой и-блок, в качестве содержимого."

msgid "dom_CREATE_TITLE"
msgstr "Создать новый домен"

msgid "dom_CURRENT_DOMAINS"
msgstr "Текущий список доменов"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Если этот сервер не имеет доступа к интернету или у Вас есть особые требования к DNS разрешению имён, введите IP адрес DNS сервера здесь. Эти поля должны быть пустыми, пока у вас нет конкретных причины для настройки других серверов DNS. Вы не должны вводить адрес DNS-серверов вашего провайдера, так как сервер способен разрешать все DNS имена интернет без дополнительных настроек."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr " Параметры корпоративных DNS "

msgid "dom_DESC_NAMESERVERS"
msgstr "Вы можете выбрать, будет ли этот домен разрешаться локально, передаваться корпоративным DNS серверам, или разрешаться интернет DNS серверами. Умолчание будет правильным для большинства сетей."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Изменить корпоративные настройки DNS"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Ошибка: неожиданные или недостающие символы в описании домена [_1]. Новый домен не создать."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Ошибка: домен [_1] уже используется. Новый домен не создать."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Ошибка: неожиданные или недостающие символы в имени домена [_1]. Имя домена может содержать одну или более букв, цифр, точек и знаков минус. Новый домен не создать."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Ошибка: внутренний сбой при удалении домена [_1]."

msgid "dom_FORM_DESCRIPTION"
msgstr " При создании домена, ваш сервер будет иметь возможность получать электронную почту для этого домена, а также будет возможность разместить у себя веб-сайт для этого домена.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Добавить домен</a> "

msgid "dom_FORM_TITLE"
msgstr "Управление доменами"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Основной корпоративный сервер DNS"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Вторичный корпоративный сервер DNS"

msgid "dom_LABEL_NAMESERVERS"
msgstr "DNS серверы домена"

msgid "dom_MODIFY_TITLE"
msgstr "Изменить домен"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Ошибка: Домен [_1] не существует."

msgid "dom_PRIMARY_SITE"
msgstr "основной сайт"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  Вы собираетесь удалить домен [_1] ([_2]). \n\n  <p> <b>Вы действительно хотите удалить этот домен?</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Удалить домен"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Домен [_1] успешно создан. Ваш веб-сервер сейчас будет перезапущен. Ссылки на этой странице будут неактивны, пока перезапуск веб-сервера не завершится."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Домен [_1] успешно удалён. Ваш веб-сервер сейчас будет перезапущен. Ссылки на этой странице будут неактивны, пока перезапуск веб-сервера не завершится."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Домен [_1] успешно изменён. Ваш веб-сервер сейчас будет перезапущен. Ссылки на этой странице будут неактивны, пока перезапуск веб-сервера не завершится."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Ошибка: домен [_1] - доменное имя вашей системы. У вас не может быть домена с темм же именем. Новый домен не создать."

msgid "dom_corporate"
msgstr "Корпоративные серверы DNS"

msgid "dom_internet"
msgstr "Интернет серверы DNS"

msgid "dom_localhost"
msgstr "Разрешать имена локально"

