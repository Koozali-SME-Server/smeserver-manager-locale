msgid "Printers"
msgstr "打印机"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "即将删除打印机："

msgid "prt_ARE_YOU_SURE"
msgstr "您确信要删除这个打印机吗？"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "成功创建打印机。"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "请输入网络打印机的IP地址和名称"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "创建新的网络打印机"

msgid "prt_CREATE_NEW_DESC"
msgstr "请为打印机选择一个唯一的名称，并输入简要的描述。打印机名称应该只包含小写字母和数字，并且要以一个小写字母开头。例如，\"hplaser\"，\"epsonlp\"， 和\"canonbj\"是有效的，但是\"HP Laser Jet\"，\"Canon BubbleJet\"， 和\"HP JetDirect Printer\" 是无效的。要避免名称和描述中包含这些单词\"offline\"、\"disabled\"、 \"down\"、 \"off\"、 \"waiting\"、\"jam\"、\"paper\"、\"error\" 和 \"responding\"。"

msgid "prt_CREATE_NEW_PRINTER"
msgstr "创建新的打印机"

msgid "prt_CURRENT_LIST"
msgstr "当前打印机列表"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "成功删除打印机："

msgid "prt_ERR_EXISTS"
msgstr "错误：已有同名账号存在："

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "错误：删除打印机时出现内部故障："

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "错误：无效的网络地址。无法创建打印机。"

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "错误：无效的网络打印机名称。无法创建打印机。"

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "错误：在描述中包含无效字符。无法创建新打印机。"

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr " 错误: 打印机名称中包含无效字符。 打印机名称应该只包含小写字母和数字，并以一个小写字母开头。例如，\"hplaser\"，\"epsonlp\"， 和\"canonbj\"都是有效的名称。 "

msgid "prt_FIRST_USB_PRINTER"
msgstr "第一个USB口打印机"

msgid "prt_FORM_TITLE"
msgstr "添加或者删除打印机"

msgid "prt_HOSTNAME_OR_IP"
msgstr "网络打印机的主机名或者IP地址"

msgid "prt_INITIAL_BTN"
msgstr "添加打印机"

msgid "prt_LOCAL_PRINTER_0"
msgstr "本地打印机端口0(LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "本地打印机端口1(LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "本地打印机端口2(LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "必须是一个合法的主机名或IP"

msgid "prt_NET_PRINTER"
msgstr "网络打印机..."

msgid "prt_NO_PRINTERS"
msgstr "系统中暂无打印机。"

msgid "prt_PRINTER_NAME"
msgstr "打印机名称"

msgid "prt_REMOTE_ADDRESS"
msgstr "远程地址"

msgid "prt_REMOTE_NAME"
msgstr "远程名称"

msgid "prt_REMOTE_NAME_DESC"
msgstr " 网络打印机名称（如果不确定请输入raw）"

msgid "prt_REMOVE_PRINTER"
msgstr "删除打印机"

msgid "prt_SECOND_USB_PRINTER"
msgstr "第二个USB口打印机"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "打印机的所有脱机文件将被删除。"

