msgid "Directory"
msgstr "(en) Directory"

msgid "dir_CITY"
msgstr "預設城市"

msgid "dir_COMPANY"
msgstr "預設公司"

msgid "dir_DEPARTMENT"
msgstr "預設部門"

msgid "dir_DESCRIPTION"
msgstr "LDAP伺服器讓您在伺服器主機上，提供可在網路上表列的使用者帳戶與群組，並且可讓Netscape Communicator通訊錄般的LDAP客戶端來存取。"

msgid "dir_DESC_DEPARTMENT"
msgstr "這些區塊是您組織裡的LDAP預設值。每當您建立新使用者帳戶，您將受提示輸入所有區塊（每位使用者的區塊內容可能不一樣），但是您於該區塊的設定將被視為預設值。這種方便可以加速建立使用者帳戶。"

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr "您可對LDAP名錄進行存取控管：「私有」設定僅允許從您的區網進行存取，而「公開」設定允許來自網路上各地的存取。"

msgid "dir_DESC_EXISTING"
msgstr "您既能讓現任使用者維持原貌、讓新用戶採用預設值，亦或可讓所有現任用戶採用上述預設值。"

msgid "dir_DIRECTORY_ACCESS"
msgstr "存取LDAP名錄"

msgid "dir_EXISTING"
msgstr "現任用戶"

msgid "dir_FORM_TITLE"
msgstr "改變LDAP名錄設定"

msgid "dir_LABEL_ROOT"
msgstr "伺服器根目錄"

msgid "dir_LEAVE"
msgstr "維持原貌"

msgid "dir_PHONE"
msgstr "(en) dir_PHONE"

msgid "dir_PHONENUMBER"
msgstr "預設電話"

msgid "dir_STREET"
msgstr "預設街道住址"

msgid "dir_SUCCESS"
msgstr "新的LDAP預設值已存檔"

msgid "dir_UPDATE"
msgstr "新的預設值更新"

msgid "dom_FORM_TITLE"
msgstr "(en) dom_FORM_TITLE"

