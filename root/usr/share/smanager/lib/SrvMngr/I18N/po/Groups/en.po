msgid "grp_GROUP_NAMING"
msgstr "The group name should contain only lower-case\nletters, numbers, hyphens, periods, and underscores, \nand should start with a lower-case letter. For \nexample \"sales\", \"beta5\", and \"reseller_partners\" are\nall valid group names, but \"3rd-event\", \"Marketing Team\"\nand \"lost&found\" are not."

msgid "grp_GROUP_TOO_LONG"
msgstr "Error: group name is too long. The maximum is [_1] characters."

msgid "grp_IBAYS_WILL_BE_CHANGED"
msgstr "The following information bays were assigned to this group and\nwill be changed to the Administrator group (you can change them to\nsomething else afterward):"

