msgid "Port forwarding"
msgstr "(en) Port forwarding"

msgid "pf_ALLOW_HOSTS"
msgstr "Tillat vert"

msgid "pf_CREATE_RULE"
msgstr "Opprette portvideresendings regel"

msgid "pf_ERR_BADAHOST"
msgstr "Dette ser ikke ut til å være en gyldig IP adresse list. f.eks: 192.168.0.1,192.168.1.1/2"

msgid "pf_ERR_BADIP"
msgstr "Dette ser ikke ut til å være en IP adresse. adressen må bestå av fire nummerrekker under 256 adskilt med punktum f.eks: 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "Portene må være et positiv tall mindre en 65536."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "Hendelsen returnerte ikke en nullverdi."

msgid "pf_ERR_PORT_COLLISION"
msgstr "Feil: porten eller portområdet er i konflikt med en eksisterende regel. Endre den nye reglen, eller fjerne den gamle."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  Du kan bruke dette panelet til å endre brannmur reglene som å åpne en spesifisert port på serveren, og videresende den til en annen port på en annen maskin. Ved å gjøre dette tillater du traffikken å få direkte tilgang til en maskin på det lokale nettverket. \n\n  <p> ADVARSEL: Misbruk av denne funksjonen vil kan redusere sikkerheten på ditt nettverk. Bruk funksjonen med forsiktighet, og ikke bruk den hvis du ikke er helt sikker på hva du gjør. </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Sett opp Port Videresending"

msgid "pf_IN_SERVERONLY"
msgstr "Serveren er satt opp som kun server modus og portvirderesending er ikke mulig bare til lokalhost."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Målmaskinens IP adresse"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Målport(er)"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protokoll"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Kildeport(er)"

msgid "pf_NO_FORWARDS"
msgstr "Det er ingen videresendte porter på systemet."

msgid "pf_RULE_COMMENT"
msgstr "Regel Kommentar"

msgid "pf_SHOW_FORWARDS"
msgstr "Under vil du finne en tabell med oppsummering over gjeldende port videresendings regler som er satt opp på serveren. Klikk på &quot;Fjern&quot; linken for å fjerne tilhørende regel."

msgid "pf_SUCCESS"
msgstr "Din endring på port videresending reglene er lagret."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "Følgende oppsummerer port vidersenings reglen du er i ferd med å legge til. Hvis du er fornøyd med reglen, klikker du på &quot;Legg til&quot; knappen. Hvis ikke klikker du på &quot;Avbryt&quot; knappen."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "Følgende oppsummerer port vidersenings reglen du er i ferd med å fjerne. Hvis du er sikker på at du vil fjerne reglen, klikker du på &quot;Fjerne&quot; knappen. Hvis ikke klikker du på &quot;Avbryt&quot; knappen."

