msgid "COULD_NOT_GET_UID"
msgstr "(en) COULD_NOT_GET_UID"

msgid "Quotas"
msgstr "Cuotas"

msgid "quo_ABS_LIMIT"
msgstr "Límite absoluto"

msgid "quo_ABS_LIMIT_MB"
msgstr "Límite absoluto (MB)"

msgid "quo_ACCOUNT_IS_TYPE"
msgstr "Es una cuenta del tipo:"

msgid "quo_CURRENTLY_HAS"
msgstr "actualmente tiene:"

msgid "quo_CURRENT_USAGE"
msgstr "Uso actual (MB)"

msgid "quo_CURRENT_USAGE_AND_SETTINGS"
msgstr "Ajustes y Uso Actual de Cuota"

msgid "quo_ERR_HARD_LT_SOFT"
msgstr "Error: el límite absoluto debe ser mayor al límite con período de gracia."

msgid "quo_ERR_MODIFYING"
msgstr "Ocurrió un error al modificar el usuario."

msgid "quo_ERR_NOT_A_USER_ACCT"
msgstr "Error: la cuenta no es una cuenta de usuario:"

msgid "quo_ERR_NO_SUCH_ACCT"
msgstr "Error: no existe una cuenta con el nombre:"

msgid "quo_FILES"
msgstr "archivos"

msgid "quo_FORM_TITLE"
msgstr "Crear, modificar o eliminar cuotas de la cuenta de usuario"

msgid "quo_HARD_VAL_MUST_BE_NUMBER"
msgstr "Error: los límites absolutos deben ser en números enteros, seguidos opcionalmente por uno de los sufijos de unidad K, M, G o T."

msgid "quo_INSTRUCTIONS"
msgstr "Introduzca la cuota como un número entero con los sufijos de unidad opcionales 'K' para kilobytes, 'M' para megabytes, 'G' para gigabytes o 'T' para terabytes. Se asume que las entradas sin sufijo están en megabytes. Si ambos límites se configuran en '0', se deshabilitarán esos límites para el usuario correspondiente."

msgid "quo_LIMIT_WITH_GRACE"
msgstr "Límite con período de gracia"

msgid "quo_LIMIT_WITH_GRACE_MB"
msgstr "Límite con período de gracia (MB)"

msgid "quo_MEGABYTES"
msgstr "megabytes"

msgid "quo_MODIFY_USER_TITLE"
msgstr "Modificar los límites de cuota del usuario"

msgid "quo_OCCUPYING"
msgstr "ocupando:"

msgid "quo_QUOTA_DESC"
msgstr " Usted puede configurar cuotas de espacio en disco para los usuarios del sistema, haga click en el botón \"Modificar\", que está junto al usuario que desea actualizar. Si el usuario excede el \"Límite con período de gracia\", se generarán advertencias. Si se excede este límite por más de una semana o si se alcanza el \"Límite absoluto\", el usuario no podrá almacenar más archivos ni recibir más correos electrónicos. Si ambos límites se configuran en '0', se deshabilitarán esos límites para el usuario correspondiente. El espacio en el disco para cada usuario incluye el directorio principal, el correo electrónico y cualquier archivo que posea el usuario en las bahías de información. "

msgid "quo_SOFT_VAL_MUST_BE_NUMBER"
msgstr "Error: los límites con período de gracia deben ser en números enteros, seguidos opcionalmente por uno de los sufijos de unidad K, M, G o T."

msgid "quo_SUCCESSFULLY_MODIFIED"
msgstr "Cuota modificada con éxito para la cuenta de usuario:"

msgid "quo_USER"
msgstr "Usuario:"

