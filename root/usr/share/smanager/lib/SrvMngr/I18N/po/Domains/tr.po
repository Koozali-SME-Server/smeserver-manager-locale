msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Alan adı ekle"

msgid "dom_CONTENT"
msgstr "[_1] i-bay"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "Web sitesi için birincil sitenizi veya herhangi bir i-bay içerik olarak seçebilirsiniz."

msgid "dom_CREATE_TITLE"
msgstr "Yeni alan adı oluştur"

msgid "dom_CURRENT_DOMAINS"
msgstr "Mevcut alan adları listesi"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Bu sunucu internete bağlı değilse veya DNS çözümlemesi özel ayarlara ihtiyacınız varsa, buraya DNS sunucuların IP adresini girebilirsiniz. Özel durumlar dışında boş bırakmanız önerilir. Sunucu bu ek bir yapılandırmaya gerek kalmadan tüm internet DNS adlarını çözme yeteneğine sahiptir, bıraya ISP'nizin DNS adreslerini girmenize gerek yoktur."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr " Kurumsal DNS Ayarları "

msgid "dom_DESC_NAMESERVERS"
msgstr "Bu alan adı çözümlemesini yerel olarak, kurumsal DNS sunucusunda veya internet DNS sunucusunda yapabilirsiniz. Pek çok ağ için varsayılanı kullanmak en doğrusudur."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Kurumsal DNS ayarlarını değiştir"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Hata: [_1] alan adı açıklamasi geçersiz karakter içriyor. Yeni alan adı olşturulamadı."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Hata: alan adı [_1] zaten kullanımda. Yeni alan adı olşturulamadı."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Hata: [_1] alan adı geçersiz karakter içriyor. Alanı adı bir veya daha fazla harf, rakam, nokta ve eksi işaretleri içermelidir"

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Hata: [_1] silinirken iç hata oluştu."

msgid "dom_FORM_DESCRIPTION"
msgstr " Bu sistemde bir alan adı oluşturulduğunda, bu alana bağlı e-posta alabilir ve web sitesini barındırabilirsiniz.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Alan adı ekle</a> "

msgid "dom_FORM_TITLE"
msgstr "Alan adlarını yönet"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Birincil kurumsal DNS sunucusu"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "İkincil kurumsal DNS sunucusu"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Alan adı DNS sunucuları"

msgid "dom_MODIFY_TITLE"
msgstr "Alan adını düzenle"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Hata: [_1] mevcut bir alan değildir."

msgid "dom_PRIMARY_SITE"
msgstr "birincil site"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  [_1] ([_2]) alan daını silmek üzeresiniz. \n\n  <p> <b>Bu alan adını silmek istediğinizden eminmisiniz?</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Alan adı Sil"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "[_1] alan adı başarıyla oluşturuldu. Sunucunuz şimdi yeniden başlatılacak. Web sunucunuz tekrar açılana kadar aşağıdaki bağlantılar etkin olmayacaklar."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "[_1] başarıyla silindi. Web sunucunuz şimdi yeniden başlatılacaktır. Sunucu yeniden başlatılana kadar aşağıdaki bağlantılar etkinleşmeyecektir."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "[_1] alan adı ayarları uygulandı. Web sunucunuz şimdi yeniden başlatılacaktır. Sunucu yeniden başlatılana kadar aşağıdaki bağlantılar etkinleşmeyecektir."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Hata: alan adı [_1] sizin sistem adan adınızla aynı. Aynı isme sahip bir alan adı oluşturulamaz. Yeni alan adı olşturulamadı."

msgid "dom_corporate"
msgstr "Kurumsal DNS kullanarak çözümle"

msgid "dom_internet"
msgstr "İnternet DNS kullanarak çözümle"

msgid "dom_localhost"
msgstr "Yerel olarak çözümle"

