msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Προσθήκη τομέα"

msgid "dom_CONTENT"
msgstr "[_1] i-bay"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "Ως περιεχόμενο ιστοτόπου, μπορείτε να επιλέξετε τον πρωτεύοντα ιστότοπο ή οποιοδήποτε i-bay."

msgid "dom_CREATE_TITLE"
msgstr "Δημιουργία νέου τομέα"

msgid "dom_CURRENT_DOMAINS"
msgstr "Τρέχουσα λίστα τομέων"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Εάν ο συγκεκριμένος διακομιστής δεν έχει πρόσβαση στο διαδίκτυο ή έχετε ειδικές απαιτήσεις για την επίλυση της ονομασίας DNS, πληκτρολογήστε την IP διεύθυνση του διακομιστή εδώ. Τα πεδία αυτά θα πρέπει να παραμείνουν κενά εκτός αν έχετε κάποιον ειδικό λόγο να ορίσετε άλλους διακομιστές DNS. Δεν πρέπει να πληκτρολογήσετε την διεύθυνση του διακομιστή DNS του παρόχου σας συνδεσιμότητας διαδικτύου (ISP) μιας και ο διακομιστής είναι ικανός να επιλύει όλες τις διαδικτυακές ονομασίες DNS χωρίς αυτήν την πρόσθετη ρύθμιση παραμέτρων συστήματος."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr " Ρυθμίσεις Εταιρικού Διακομιστή DNS "

msgid "dom_DESC_NAMESERVERS"
msgstr "Μπορείτε να επιλέξετε εάν η επίλυση της ονομασίας του συγκεκριμένου τομέα θα γίνει τοπικά, θα μεταβιβαστεί στους εταιρικούς διακομιστές DNS, ή θα επιλυθεί από τον διαδικτυακό διακομιστή DNS. Η αρχική ρύθμιση αποτελεί και τη σωστή επιλογή για τα περισσότερα δίκτυα."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Τροποποίηση ρυθμίσεων εταιρικού DNS"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Σφάλμα: μη-αναμενόμενοι ή ελλείποντες χαρακτήρες στην περιγραφή του τομέα [_1]. Δεν δημιουργήθηκε νέος τομέας."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Σφάλμα: ο τομέας [_1] χρησιμοποιείται ήδη. Δεν δημιουργήθηκε νέος τομέας."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Σφάλμα: μη-αναμενόμενοι ή ελλείποντες χαρακτήρες στην ονομασία τομέα [_1]. Η ονομασία τομέα πρέπει να περιλαμβάνει ένα ή περισσότερα γράμματα, αριθμούς, τελείες και παύλες. Δεν δημιουργήθηκε νέος τομέας."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Σφάλμα: εσωτερική αστοχία κατά την διαγραφή του τομέα [_1]."

msgid "dom_FORM_DESCRIPTION"
msgstr " Κατά τη δημιουργία ενός τομέα, ο διακομιστής σας θα μπορεί να λαμβάνει ηλεκτρονική αλληλογραφία και επίσης να φιλοξενεί ιστοτόπους για τον τομέα αυτό.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Προσθήκη τομέα</a> "

msgid "dom_FORM_TITLE"
msgstr "Διαχείριση τομέων"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Πρωτεύων εταιρικός διακομιστής DNS"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Δευτερεύων εταιρικός διακομιστής DNS"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Διακομιστές DNS του τομέα"

msgid "dom_MODIFY_TITLE"
msgstr "Τροποποίηση τομέα"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Σφάλμα: Ο [_1] δεν είναι υφιστάμενος τομέας."

msgid "dom_PRIMARY_SITE"
msgstr "πρωτεύων τόπος"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  Πρόκειται να διαγράψετε τον τομέα [_1] ([_2]). \n\n  <p> <b>Είστε σίγουροι ότι θέλετε να διαγράψετε το συγκεκριμένο τομέα;</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Διαγραφή τομέα"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Επιτυχής δημιουργία τομέα [_1]. Ο διακομιστής ιστοσελίδων σας εκτελεί επανεκκίνηση. Οι σύνδεσμοι στην παρούσα σελίδα θα παραμείνουν ανενεργοί έως ότου ολοκληρωθεί η επανεκκίνηση."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Επιτυχής διαγραφή τομέα [_1]. Ο διακομιστής ιστοσελίδων σας εκτελεί επανεκκίνηση. Οι σύνδεσμοι στην παρούσα σελίδα θα παραμείνουν ανενεργοί έως ότου ολοκληρωθεί η επανεκκίνηση."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Επιτυχής τροποποίηση τομέα [_1]. Ο διακομιστής ιστοσελίδων σας εκτελεί επανεκκίνηση. Οι σύνδεσμοι στην παρούσα σελίδα θα παραμείνουν ανενεργοί έως ότου ολοκληρωθεί η επανεκκίνηση."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Σφάλμα: τομέας [_1] είναι η ονομασία του τομέα του συστήματός σας. Δεν μπορείτε να έχετε τομέα με το ίδιο όνομα. Δεν δημιουργήθηκε νέος τομέας."

msgid "dom_corporate"
msgstr "Εταιρικός διακομιστής DNS"

msgid "dom_internet"
msgstr "Διαδικτυακοί διακομιστές DNS"

msgid "dom_localhost"
msgstr "Επίλυση ονόματος τοπικά"

