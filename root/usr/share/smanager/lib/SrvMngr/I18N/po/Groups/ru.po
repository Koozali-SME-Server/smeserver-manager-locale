msgid "DELETE_ERROR"
msgstr "(en) DELETE_ERROR"

msgid "grp_ACCOUNT_CONFLICT"
msgstr "Ошибка: группа \"[_1]\" не может быть создана, т.к. уже есть [_2] учётная запись с таким именем."

msgid "grp_CREATED_GROUP"
msgstr "Группа пользователей успешно создана"

msgid "grp_CREATE_ERROR"
msgstr "Произошла ошибка при создании группы пользователей."

msgid "grp_CURRENT_LIST"
msgstr "Текущий список групп пользователей\n\n  "

msgid "grp_DELETED_GROUP"
msgstr "Группа пользователей успешно удалена"

msgid "grp_DELETE_DESCRIPTION"
msgstr " Вы собираетесь удалить группу пользователей \"[_1]\" "

msgid "grp_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "grp_FORM_TITLE"
msgstr "Создание, изменение или удаление групп пользователей"

msgid "grp_GROUP_DESC"
msgstr "Короткое описание/Windows псевдоним группы"

msgid "grp_GROUP_DESC_EXPL"
msgstr "Введите короткое описание в поле ниже. Это поле так же обозначает имя группы видимое Windows клиентам."

msgid "grp_GROUP_HAS_MEMBERS"
msgstr "Члены этой группы:"

msgid "grp_GROUP_NAMING"
msgstr " Имя группы должны содержать только прописные буквы, цифры, дефисы, точки и подчёркивания и начинаться с прописной буквы. Например,\"sales\", \"beta5\" и \"reseller_partners\" - правильные имена групп, но \"3rd-event\", \"Marketing Team\" и \"lost&found\" - неверные. "

msgid "grp_GROUP_TOO_LONG"
msgstr "Ошибка: слишком длинное имя группы. Максимум [_1] символов."

msgid "grp_IBAYS_WILL_BE_CHANGED"
msgstr "Следующие информационные блоки были назначены этой группе и могут быть изменены администратором группы (вы можете изменить их на что-то еще позже):"

msgid "grp_MODIFIED_GROUP"
msgstr "Группа пользователей успешно изменена"

msgid "grp_MODIFY_ERROR"
msgstr "Произошла ошибка при изменении группы пользователей."

msgid "grp_NOT_A_GROUP"
msgstr "Ошибка: Несуществующая учётная запись группы."

msgid "grp_NO_MEMBERS"
msgstr "Ошибка: нет членов в группе. Новая группа не создана."
