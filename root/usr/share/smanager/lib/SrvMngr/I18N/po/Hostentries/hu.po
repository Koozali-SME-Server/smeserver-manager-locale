msgstr "Hiba: Az IP cím nem lehet a szerver vagy az átjáró IP címe."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Hiba: Ez az IP cím nem tartozik ehhez a hálózathoz."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Fizikai cím"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "A fizikai cím megadása opcionális, ilyen esetben a DHCP szerver a számítógép IP címét statikusan rögzíti a fizikai címhez. Amennyiben megadja a fizikai címet, azt \"AA:BB:CC:DD:EE:FF\" formátumban kell megadnia és csak 0-tól 9-ig tartalmazhat számot, valamint A-tól F-ig betűt."

msgid "hos_FORM_TITLE"
msgstr "Gépnevek és címek"

msgid "hos_HOSTNAME"
msgstr "Kiszolgálónév"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Hiba: érvénytelen karakterek a \"[_1].[_2]\" kiszolgálónévben. A kiszolgálónév csak betűket, számokat, és kötőjeleket tartalmazhat, valamint betűvel, vagy számmal kell kezdődnie."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "A kiszolgálónév csak betűket, számokat, és kötőjeleket tartalmazhat és betűvelvagy számmal kell kezdődnie."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Hiba: a [_1] fióknév egy létező [_2] kiszolgálónév."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Hiba: érvénytelen karakterek a \"[_1].[_2]\" kiszolgálónévben. A kiszolgálónév csak betűket, számokat, és kötőjeleket tartalmazhat, valamint betűvel, vagy számmal kell kezdődnie."

msgid "hos_HOSTTYPE"
msgstr "Hely"

msgid "hos_LOCAL_IP"
msgstr "Helyi IP cím"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "A helyi IP cím a helyi fálózaton lévő másik gép IP címe. Kérem adjon meg egy érvényes címet az \"aaa.bbb.ccc.ddd\" formátumban."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Kérem adja meg a helyi kiszolgáló további részleteit:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Gépnév módosítása"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Kérem adja meg a távoli kiszolgáló további részleteit:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " A \"[_1].[_2]\" kiszolgálónév eltávolítására készül.   Biztos benne, hogy eltávolítja ezt a kiszolgálónevet? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Gépnév eltávolítása"

