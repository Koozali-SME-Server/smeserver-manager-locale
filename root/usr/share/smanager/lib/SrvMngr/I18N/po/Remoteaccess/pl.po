msgid "rma_LABEL_SSH_ADMIN"
msgstr "(en)Allow administrative command line access over secure shell"

msgid "rma_LABEL_SSH_PASSWORD_ACCESS"
msgstr "(en)Allow secure shell access using standard passwords"

