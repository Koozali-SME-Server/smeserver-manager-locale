msgid "iba_ACCOUNT_EXISTS"
msgstr "החשבון \"[_1]\" הוא חשבון [_2] קיים."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " החשבון \"[_1]\" מתנגש עם תיאור השם הנרדף עבור [_2] חשבון \"[_3]\". [_1] הוא שם נרדף עבור [_3]. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "שם הi-bay \"[_1]\" מכיל סימנים לא חוקיים. שמות i-bay חייבים להתחיל באות קטנה ולהכיל אך ורק אותיות קטנות, מספרים ומקפים."

msgid "iba_ADD_IBAY"
msgstr "הוסף i-bay"

msgid "iba_ADD_TITLE"
msgstr "יצירה או שינוי i-bay"

msgid "iba_ALLOW_DYNAMIC_CONTENT"
msgstr "החרגה של תוכן דינמי (CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "לא ניתן ליצור חשבון חדש עבור [_1] (ייתכן שהוא כבר קיים ?)"

msgid "iba_CANT_FIND_IBAY"
msgstr "לא ניתן למצוא חשבון עבור [_1] (האם הוא קיים ?)"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "כל האינטרנט (סיסמא לא נדרשת)"

msgid "iba_ENTIRE_INTERNET_PASSWORD"
msgstr "כל האינטרנט (דרושה סיסמא)"

msgid "iba_ENTIRE_INTERNET_PASSWORD_REMOTE"
msgstr "כל האינטרנט (דרושה סיסמא מחוץ לרשת המקומית)"

msgid "iba_ERROR_WHILE_CREATING_IBAY"
msgstr "קרתה תקלה בזמן יצירת הi-bay."

msgid "iba_ERROR_WHILE_DELETING_IBAY"
msgstr "שגיאה במחיקת i-bay."

msgid "iba_ERROR_WHILE_MODIFYING_IBAY"
msgstr "קרתה שגיאה בזמן שינוי הi-bay."

msgid "iba_ERROR_WHILE_RESETTING_PASSWORD"
msgstr "שגיאה בעת איפוס סיסמא."

msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "הוספת i-bay   ניתן להסיר כל i-bay או לאפס את סיסמתו על ידי לחיצה על הפקודה המתאימה ליד הi-bay. אם הi-bay מוצג באדום, זה מכיוון שהסיסמה עדיין לא שונתה מברירת המחדל ועליך לשנותה בקרוב.  "

msgid "iba_FORM_TITLE"
msgstr "יצירה, שינוי או הסרת i-bayים"

msgid "iba_HTTPS_Only"
msgstr "שחזר הגדרות שרת"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "הסיסמאות אינן תואמות זו לזו."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "רשתות מקומיות (סיסמא לא נדרשת)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "רשתות מקומיות (דרושה סיסמא)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "שם הi-bay \"[_1]\"ארוך מדי. המקסימום הוא [_1] תווים."

msgid "iba_NAME_FIELD_DESC"
msgstr "שם מפרץ המידע צריך להכיל אך ורק אותיות קטנות, מספרים, נקודות, מקפים וקווים תחתיים וחייב להתחיל באות קטנה. למשל, \"johnson\", \"intar\" ו- \"cust3.prj12\" הינם כולם שמות חוקיים, אך \"3associates\", \"John Smith\" ו- \"Bus!Partner\" אינם. השם מוגבל עד ל[_1] תווים."

msgid "iba_NAME_LABEL"
msgstr "שם מפרץ מידע"

msgid "iba_NONE"
msgstr "ללא גישה"

msgid "iba_NO_IBAYS"
msgstr "אין כרגע i-bay מוגדר."

msgid "iba_PASSWORD_DESC"
msgstr "את\\ה עומד\\ת לשנות את סיסמת i-bay [_1]."

msgid "iba_PUBLIC_ACCESS"
msgstr "גישה פומבית דרך האינטרנט או דרך ftp אנונימי"

msgid "iba_REMOVE_DESC"
msgstr "  אתה עומד להסיר את מפרץ המידע \"[_1]\" ([_2]). \n\n   כל הקבצים השייכים למרץ מידע זה ימחקו. \n\n   האם אתה בטוח שברצונך להסיר מפרץ מידע זה? \n\n  "

msgid "iba_REMOVE_TITLE"
msgstr "הסרת מפרץ מידע"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "i-bay נוצר בהצלחה."

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "i-bay נמחק בהצלחה."

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "הi-bay שונה בהצלחה."

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "סיסמא אופסה בהצלחה."

msgid "iba_USER_ACCESS"
msgstr "גישת משתמש דרך שיתוף קבצים או ftp של משתמש"

msgid "iba_VHOST_MESSAGE"
msgstr " The following virtual domains were using this information bay as their content and will be changed to the primary web site (you can change them to something else afterward): [_1] "

msgid "iba_WARG"
msgstr "כתיבה = admin, קריאה = group"

msgid "iba_WGRE"
msgstr "כתיבה = group, קריאה = everyone"

msgid "iba_WGRG"
msgstr "כתיבה = group, קריאה = group"

