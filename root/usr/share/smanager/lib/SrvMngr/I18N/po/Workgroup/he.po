msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "האם על שרת זה לתפקד כמנהל קבוצת עבודה ודומיין ברשת Windows שלך ? עליך להשאיר את הסימון בNo במידה ושרת אחר באותה רשת כבר מבצע תפקידים אלו."

msgid "wkg_DESC_ROAM"
msgstr "האם שרת זה צריך לתמוך בפרופילים נודדים ? אתה צריך לעזוב את זה מוגדר כברירת מחדל של  לא  אלא אם יש לך ניסיון בניהול פרופילי נדידה בשרת מבוסס Windows ואתה יודע כי זו תכונה נדרשת. "

msgid "wkg_DESC_SERVERNAME"
msgstr "הקלד את השם בו ישתמש שרת זה עבור שיתוף קבצים ב Windows וב Macintosh."

msgid "wkg_DESC_WORKGROUP"
msgstr "הזן את שם קבוצת העבודה של Windows ששרת זה אמור להופיע בה"

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "שנה הגדרות קבוצת עבודה"

msgid "wkg_INVALID_SERVERNAME"
msgstr "שם השרת חייב להתחיל באות אנגלית (גדולה או קטנה), ואחריה כל צירוף של אותיות, מספרים, ומקפים תחתונים."

msgid "wkg_INVALID_WORKGROUP"
msgstr "שם קבוצעת העבודה חייב להתחיל באות אנגלית (גדולה או קטנה), לאחריה כל קומבינציה של אותיות אנגליות, מספרים, קווים תחתיים, נקודות ומקפים."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "שמות השרתים וקבוצת העבודה זהים כאשר משווים אותם באותיות קטנות. ערכים אלה חייבים להיות שונים על מנת שניתן יהיה להפעיל שיתוף קבצים."

msgid "wkg_LABEL_PDC"
msgstr "מנהל קבוצת עבודה ודומיין"

msgid "wkg_LABEL_ROAM"
msgstr "פרופילים נודדים"

msgid "wkg_LABEL_SERVERNAME"
msgstr "שם שרת"

msgid "wkg_LABEL_WORKGROUP"
msgstr "קבוצת עבודה של Windows"

msgid "wkg_SUCCESS"
msgstr "הגדרות קבוצת העבודה החדשות נשמרו"
