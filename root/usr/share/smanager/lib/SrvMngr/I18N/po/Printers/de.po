msgid "Printers"
msgstr "Drucker"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "Sie entfernen gerade den Drucker:"

msgid "prt_ARE_YOU_SURE"
msgstr "Sind Sie sicher, dass Sie diesen Drucker entfernen wollen ?"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "Drucker erfolgreich erstellt:"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "Bitte geben Sie die Adresse und den Namen des Netzwerkdruckers ein"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "Neuen Netzwerkdrucker erstellen"

msgid "prt_CREATE_NEW_DESC"
msgstr " Bitte wählen Sie einen unverwechselbaren Namen für Ihren Drucker und geben Sie eine Kurzbeschreibung ein. Der Druckername darf nur Kleinbuchstaben und Zahlen enthalten und sollte mit einem Kleinbuchstaben beginnen. Zum Beispiel sind \"hplaser\", \"epsonlp\" und \"canonbj\" erlaubt, jedoch wird \"HP Laser Jet\", \"Canon BubbleJet\" oder \"HP JetDirect Printer\" nicht akzeptiert. Vermeiden Sie Namen und Beschreibungen die die folgenden Terme enthalten: \"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\", \"paper\", \"error\" und \"responding\". "

msgid "prt_CREATE_NEW_PRINTER"
msgstr "Neuen Drucker erstellen"

msgid "prt_CURRENT_LIST"
msgstr "Aktuelle Liste der Drucker"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "Drucker wurde erfolgreich gelöscht:"

msgid "prt_ERR_EXISTS"
msgstr "FEHLER: Ein Konto mit gleichem Namen besteht bereits mit Typ:"

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "FEHLER: Interner Fehler beim Entfernen des Druckers:"

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "FEHLER: Ungültige Netzwerkadresse. Neuer Drucker wurde nicht angelegt."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "FEHLER: Ungültiger Netzwerk-Druckername. Neuer Drucker wurde nicht angelegt."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "FEHLER: Ungültiges oder fehlendes Zeichen in der Druckerbeschreibung. Neuer Drucker wurde nicht angelegt."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr "  FEHLER: Ungültiges Zeichen im Druckernamen.   Der Druckername darf nur Kleinbuchstaben und Zahlen enthalten und sollte mit einem Kleinbuchstaben beginnen. Zum Beispiel sind \"hplaser\", \"epsonlp\" und \"canonbj\" erlaubt, jedoch wird \"HP Laser Jet\", \"Canon BubbleJet\" oder \"HP JetDirect Printer\" nicht akzeptiert.  "

msgid "prt_FIRST_USB_PRINTER"
msgstr "Erster an USB angeschlossener Drucker"

msgid "prt_FORM_TITLE"
msgstr "Hinzufügen oder Entfernen von Druckern"

msgid "prt_HOSTNAME_OR_IP"
msgstr "Hostname oder IP-Adresse des Netzwerkdruckers"

msgid "prt_INITIAL_BTN"
msgstr "Drucker hinzufügen"

msgid "prt_LOCAL_PRINTER_0"
msgstr "Lokaler Druckeranschluss 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "Lokaler Druckeranschluss 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "Lokaler Druckeranschluss 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "Es muss ein gültiger Hostname oder eine gültige IP-Adresse sein"

msgid "prt_NET_PRINTER"
msgstr "Netzwerkdrucker ..."

msgid "prt_NO_PRINTERS"
msgstr "Es sind keine Drucker am System angeschlossen."

msgid "prt_PRINTER_NAME"
msgstr "Druckername"

msgid "prt_REMOTE_ADDRESS"
msgstr "Remote Adresse"

msgid "prt_REMOTE_NAME"
msgstr "Remote-Name"

msgid "prt_REMOTE_NAME_DESC"
msgstr " Netzwerkdruckername (geben Sie raw ein, wenn Sie nicht sicher sind) "

msgid "prt_REMOVE_PRINTER"
msgstr "Drucker entfernen"

msgid "prt_SECOND_USB_PRINTER"
msgstr "Zweiter an USB angeschlossener Drucker"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "Alle Dateien in der Zwischenablage für diesen Drucker werden gelöscht."

