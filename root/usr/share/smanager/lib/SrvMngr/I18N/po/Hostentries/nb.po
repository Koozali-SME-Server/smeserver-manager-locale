msgid "Hostnames and addresses"
msgstr "Vertsnavn og adresser"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "Adressen er innenfor DHCP serverens dynamiske område"

msgid "hos_ADD_HOSTNAME"
msgstr " Legg til maskinnavn "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Opprett eller endre maskinnavn"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Gjeldende liste over maskinnavn på %1"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "En feil oppsto under opprettelse av maskinnavn."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "En feil oppsto under sletting av maskinnavn. "

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "En feil oppsto under endring av maskinnavn."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Feil: IP kan ikke være server IP eller Gateway IP."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Feil: IP adressen er ikke på noen av våre lokale nettverk."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Ethernet adresse"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "Eternet adresen er valgfiri og gjør at DHCP serveren knytter den lokale IP adressen til maskinen med denne eternet adressen. Hvis den spesifiseres må den være i fomatet \"AA:BB:CC:DD:EE:FF\" og må bare inneholde tallene 0-9 og bokstavene A-F."

msgid "hos_FORM_TITLE"
msgstr "Vertsnavn og adresser"

msgid "hos_HOSTNAME"
msgstr "Maskinnavn"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Feil: uventede tegn i maskinnavnet : \"%1.%2\". Navnet kan bare inneholde bokstaver, tall, og bindestreker, og må starte med en bokstav eller et tall."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Maskinnavnet kan bare inneholde bokstaver, tall og bindestreker, og må starte med en bokstav eller et tall."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Feil: kontoen %1 er et eksisterende %2 maskinnavn."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Feil: uventede tegn i maskinnavnet : \"%1.%2\". Navnet kan bare inneholde bokstaver, tall, og bindestreker, og må starte med en bokstav eller et tall."

msgid "hos_HOSTTYPE"
msgstr "Lokasjon"

msgid "hos_LOCAL_IP"
msgstr "Lokal IP"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "Den lokale IP adressen er den samme som en annen maskin på det lokale nettverket.Skriv inn en gyldig IP adresse i formatet \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Oppgi følgende tilleggsdetaljer for lokal maskin: "

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Endre vertsnavn"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Oppgi følgende tilleggsdetaljer for fjern maskin:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Du er i ferd med å fjerne maskinnavnet \"%1.%2\".   Er du sikker på at du vil fjerne maskinnavnet? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Fjern vertsnavn"

