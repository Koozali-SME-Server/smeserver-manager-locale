msgid "Groups"
msgstr "(en) Groups"

msgid "Packages"
msgstr "(en) Packages"

msgid "Start"
msgstr "(en) Start"

msgid "yum_1DAILY"
msgstr "יומי"

msgid "yum_2WEEKLY"
msgstr "שבועי"

msgid "yum_3MONTHLY"
msgstr "Monthly"

msgid "yum_AutoInstallUpdates"
msgstr "(en) Autoinstallupdates"

msgid "yum_BUTTON_CONFIGURATION"
msgstr "שנה את הגדרות מתקין התוכנה"

msgid "yum_BUTTON_INSTALL_AVAILABLE"
msgstr "התקן תוכנות נוספות"

msgid "yum_BUTTON_INSTALL_UPDATES"
msgstr "הצג עדכונים זמינים"

msgid "yum_BUTTON_REMOVE"
msgstr "הסר תוכנה מותקנת"

msgid "yum_DESC_AVAILABLE_GROUPS"
msgstr "(en)You can select software groups to install from the list below."

msgid "yum_DESC_AVAILABLE_PACKAGES"
msgstr "(en)You can also select individual packages to install from the list below."

msgid "yum_DESC_AVAILABLE_UPDATES"
msgstr "(en)The following updates are available for your system. You should normally install all available updates. If there are updates you do not wish to install, de-select them from the list below."

msgid "yum_DESC_ENABLED_REPOSITORIES"
msgstr "(en)The software installer can install software from any of enabled repositories. To enable a repository, select it from the list. To disable a repository, de-select it from the list. By default, only stable, tested software is available for installation."

msgid "yum_DESC_INSTALLED_GROUPS"
msgstr "(en)You can select software groups to remove from the list below."

msgid "yum_DESC_INSTALLED_PACKAGES"
msgstr "(en)You can also select individual packages you wish to remove from the list below."

msgid "yum_DESC_UPDATES_AVAILABLE"
msgstr "(en)There are updates available for your system. These updates should be installed as soon as possible."

msgid "yum_DESC_UPTODATE"
msgstr "כל העדכונים הותקנו."

msgid "yum_DESC_YUM_AUTOINSTALLUPDATES"
msgstr "(en)If enabled this will take precedence over the simple check for updates notification and predownload features. Instead it will install the available updates from enabled repositories. For more information refer to yum and yum-cron manual page."

msgid "yum_DESC_YUM_DELTARPMPROCESS"
msgstr "(en)A deltarpm contains the difference between an old and a new version of a rpm, which can save bandwith. The drawback is that update operations consume considerably more CPU cycles"

msgid "yum_DESC_YUM_PACKAGEFUNCTIONS"
msgstr "(en)The software installer can manage groups of related package or individual packages. By default, only groups of packages are presented. If you wish to manage individual packages, enable this option. This should only be done by experienced administrators."

msgid "yum_DeltaRpmProcess"
msgstr "(en) Deltarpmprocess"

msgid "yum_DownloadOnly"
msgstr "(en) Downloadonly"

msgid "yum_ERROR_UPDATING_CONFIGURATION"
msgstr "(en) Error updating configuration"

msgid "yum_FORM_TITLE"
msgstr "מתקין תוכנה"

msgid "yum_HEADER_AVAILABLE_SOFTWARE"
msgstr "(en)The following software is available to be installed onto your system. You should only install additional software onto this system if you are aware of the consequences of doing so."

msgid "yum_HEADER_INSTALLED_SOFTWARE"
msgstr "(en)The following software is installed on this system. You should only remove software from this system if you are aware of the consequences of doing so."

msgid "yum_HEADER_POSTUPGRADE_REQUIRED"
msgstr "(en)The system needs to be reconfigured after adding or removing software, or applying updates. <p> Please click on the Reconfigure button at the bottom of this page to start the reconfiguration process. <b>An automatic reboot will be initiated as part of this reconfiguration process</b> </p>"

msgid "yum_INSTALL_SOFTWARE"
msgstr "Install"

msgid "yum_INSTALL_UPDATES"
msgstr "התקן את העדכונים שנבחרו"

msgid "yum_LABEL_AVAILABLE_GROUPS"
msgstr "קבוצות זמינות"

msgid "yum_LABEL_AVAILABLE_PACKAGES"
msgstr "חבילות זמינות"

msgid "yum_LABEL_AVAILABLE_UPDATES"
msgstr "עדכונים זמינים"

msgid "yum_LABEL_ENABLED_REPOSITORIES"
msgstr "מאגרי תוכנה מופעלים"

msgid "yum_LABEL_INSTALLED_GROUPS"
msgstr "קבוצות מותקנות"

msgid "yum_LABEL_INSTALLED_PACKAGES"
msgstr "חבילות מותקנות"

msgid "yum_LABEL_YUM_AUTOINSTALLUPDATES"
msgstr "התקן עדכונים באופן אוטומטי"

msgid "yum_LABEL_YUM_DELTARPMPROCESS"
msgstr "עדכון דלתא סל״ד"

msgid "yum_LABEL_YUM_DOWNLOADONLY"
msgstr "הפרטים האישיים עודכנו"

msgid "yum_LABEL_YUM_DOWNLOADONLY_DESCRIPTION"
msgstr "(en)The rpm updates can be downloaded during the night, this will ease and give faster the dnf update process (only enabled repositories will be used)."

msgid "yum_LABEL_YUM_PACKAGEFUNCTIONS"
msgstr "נהל חבילות בודדות"

msgid "yum_LABEL_YUM_STATUS"
msgstr "בדוק עדכונים"

msgid "yum_MULTI_SELECT"
msgstr "(en) <strong>Ctrl/Cmd-click</strong> toggles individual items and <strong>Shift-click</strong> selects ranges.\n<br /><strong>Case-insensitive</strong> search unless you enter a <strong>regex</strong> in <i>/pattern/flags</i> form (e.g. /maria.*client/i).."

msgid "yum_Please_Wait_-_dnf_Running"
msgstr "אנא המתן - dnf פועל"

msgid "yum_SUCCESS"
msgstr "(en)The new settings have been saved."

msgid "yum_UPDATE_SUCCESS"
msgstr "(en)The requested changes have been successfully implemented."

msgid "yum_check4updates"
msgstr "(en) Check4updates"

