msgid "hos_ETHERNET_ADDRESS"
msgstr "Ethernet adresi"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "Ethernet adresi isteğe bağlıdır ve bilgisayarı yerel ağ bağlamak için DHCP sunucusunu bu ethernete kalıcı bir IP vermeye zorlar. Belirtmek için \"AA:BB:CC:DD:EE:FF\" şeklinde 0 ile 9 arası rakamlar ve A ile F arası harfler kullanılır."

msgid "hos_FORM_TITLE"
msgstr "Ana bilgisayar adları ve adresler"

msgid "hos_HOSTNAME"
msgstr "Alan adı"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Hata: alan adında geçersiz karakter: \"%1.%2\". Alan adları sadece harfler, rakamlar ve noktadan oluşturulabilir ve harf veya sayıyla başlamalıdır."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Alan adı sadece harfler, sayılar ve tire içermelidirve bir harf veya sayı ile başlamalıdır."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Hata: %1 adı, mevcut %2 alan adıyla aynıdır."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Hata: alan adında geçersiz karakter: \"%1.%2\". Alan adları sadece harfler, rakamlar ve noktadan oluşturulabilir ve harf veya sayıyla başlamalıdır."

msgid "hos_HOSTTYPE"
msgstr "Konum"

msgid "hos_LOCAL_IP"
msgstr "Yerel IP"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "Yerel IP adresleri ağınızdaki diğer sistemlere ait IP adreslernin ifade eder. Lütfen \"aaa.bbb.ccc.ddd\" şeklinde geçerli bi IP adresi girin."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Lütfen yerel host için aşağıdaki bilgileri doldurun:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Ana bilgisayar adını değiştir"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Lütfen uzaktaki sunucu için aşağıdaki bilgileri doldurun:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " \"%1.%2\" alan adını silmek üzeresiniz.   Bu alan adını silmek istediğinizden eminmisiniz? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Ana bilgisayar adını kaldır"

