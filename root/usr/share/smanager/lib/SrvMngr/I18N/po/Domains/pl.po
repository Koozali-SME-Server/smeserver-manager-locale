msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Dodaj domenę"

msgid "dom_CONTENT"
msgstr "[_1] i-bay"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "(en)For the web site, you may choose your primary web site or any i-bay as the content."

msgid "dom_CREATE_TITLE"
msgstr "Utwórz nową domenę"

msgid "dom_CURRENT_DOMAINS"
msgstr "Aktualna lista domen"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "(en)If this server does not have access to the Internet, or you have special requirements for DNS resolution, enter the DNS server IP addresses here. These fields should be left blank unless you have a specific reason to configure other DNS servers. You should not enter the address of your ISP's DNS servers here, as the server is capable of resolving all Internet DNS names without this additional configuration."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr "Ustawienia firmowego DNS"

msgid "dom_DESC_NAMESERVERS"
msgstr "(en)You can select whether this domain is resolved locally, passed to the corporate DNS servers, or resolved by the Internet DNS servers. The default will be correct for most networks."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Modyfikuj ustawienia firmowego DNS"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "(en)Error: unexpected or missing characters in domain description [_1]. Did not create new domain."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "(en)Error: domain [_1] is already in use. Did not create new domain."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Error: unexpected or missing characters in domain name [_1]. The domain name should contain one or more letters, numbers, periods and minus signs. Did not create new domain."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "(en)Error: internal failure while removing domain [_1]."

msgid "dom_FORM_DESCRIPTION"
msgstr " When you create a domain, your server will be able to receive e-mail for that domain and will also be able to host a web site for that domain.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Add domain</a> "

msgid "dom_FORM_TITLE"
msgstr "Zarządzaj domenami"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Podstawowy korporacyjny serwer DNS"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Drugorzędowy firmowy serwer DNS"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Serwery DNS domeny"

msgid "dom_MODIFY_TITLE"
msgstr "Modyfikuj domenę"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "(en)Error: [_1] is not an existing domain."

msgid "dom_PRIMARY_SITE"
msgstr "główna witryna"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  You are about to remove the domain [_1] ([_2]). \n\n  <p> <b>Are you sure you wish to remove this domain?</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Usuń domenę"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Successfully created domain [_1]. Your web server is now being restarted. The links on this page will be inactive until the web server restart is complete."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "(en)Successfully deleted domain [_1]. Your web server is now being restarted. The links on this page will be inactive until the web server restart is complete."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Successfully modified domain [_1]. Your web server is now being restarted. The links on this page will be inactive until the web server restart is complete."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "(en)Error: domain [_1] is your system domain name. You cannot have a domain with the same name. Did not create new domain."

msgid "dom_corporate"
msgstr "Firmowe serwery DNS"

msgid "dom_internet"
msgstr "Internetowe serwery DNS"

msgid "dom_localhost"
msgstr "Rozwiąż lokalnie"

