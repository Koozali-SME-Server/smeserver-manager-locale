msgid "LOG_LIVESTREAM"
msgstr "(en) Live stream"

msgid "log_END_DESC"
msgstr "Merk at det kan ta lang tid å generere rapportene."

msgid "log_ERR_NOEXIST_FILE"
msgstr "(en) Err noexist file"

msgid "log_ERR_NOOPEN_FILE"
msgstr "(en) Err noopen file"

msgid "log_FILENAME_ERROR"
msgstr " Feil ved spesifisering av loggfilnavnet.\n\n  <p>Ugyldig rapport type \"[_1]\".</p>\n\n  "

msgid "log_FILTER_PATTERN_DESC"
msgstr " Du kan velge å spesifisere et filtrengings mønster, som gjør at bare linjer fra loggfilen vises som stemmer med filteret. Hvis du lar dette feltet stå tomt, vil alle linjene vises. Merk at denne muligheten ikke brukes dersom du laster ned loggfilen.\n\n  "

msgid "log_FILTER_PATTERN_HINT"
msgstr "(en) The pattern is case insensitive, but enclosing it in \"/\" will result in it being treated as a regex."

msgid "log_FILTER_PATTERN_LABEL"
msgstr "Filter mønster (valgfritt)"

msgid "log_FIRSTPAGE_DESC"
msgstr " Dette panelet gir deg muligheten til å se eller laste ned loggfiler generert av tjenester som kjører på serveren. "

msgid "log_FORM_TITLE"
msgstr "Vis loggfiler"

msgid "log_HIGHLIGHT_HEADER"
msgstr "Viser linjer som stemmer med: \"[_1]\"."

msgid "log_LOG_FILE_EMPTY"
msgstr "Loggfilen \"[_1]\" er tom!"

msgid "log_LOG_FILE_SELECT_DESC"
msgstr "Velg en loggfil å vise"

msgid "log_MATCH_HEADER"
msgstr "Viser linjer som stemmer med: \"[_1]\"."

msgid "log_MATCH_PATTERN_DESC"
msgstr " Du kan velge å merke ut et mønster med fet skrift, som gjør at alle linjer merkes med fet skrift dersom linjene stemmer med filtrerings mønsteret. fet skrift mønsteret påføres en hver linje som allerede stemmer med mønsteret. Merk at denne muligheten ikke brukes dersom du laster ned loggfilen.\n\n  "

msgid "log_MATCH_PATTERN_LABEL"
msgstr "Fet Skrift Mønster (valgfritt)"

msgid "log_NO_MATCHING_LINES"
msgstr "Ingen linjer som ligner er vist."

msgid "log_OP_DESC"
msgstr " Du må velge mellom å se på loggfilen i nettleseren, eller å laste ned loggfilen til din datamaskin. Hvis loggfilen er spesiellt stor, bør du velge å laste den ned, da store filer kan være et problem for noen nettlesere.\n\n  "

msgid "log_OP_LABEL"
msgstr "Funksjon"

msgid "log_REFRESH"
msgstr "Oppfrisk loggfilen"

msgid "log_VIEW"
msgstr "Vis loggfil"

msgid "log_VIEWING_TIME"
msgstr "Vist[_1]."

