msgid "Hostnames and addresses"
msgstr "Имена хостов и адреса"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "Адрес находится внутри назначенного динамического диапазона DHCP"

msgid "hos_ADD_HOSTNAME"
msgstr " Добавить имя хоста "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Создать или изменить имя хоста"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Текущий список имен хостов для [_1]"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Ошибка при создании имени хоста."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Ошибка при удалении имени хоста."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Ошибка при изменении имени хоста."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Ошибка: IP не может быть IP сервера или IP-шлюза."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Ошибка: Этот IP-адрес не находится ни в одной из ваших локальных сетей."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Ethernet адрес"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "(en)The ethernet address is optional and causes the DHCP server to statically bind the local IP address to the computer with this ethernet address. If specified, it must be of the form \"AA:BB:CC:DD:EE:FF\" and must contain only the numbers 0-9 and the letters A-F."

msgid "hos_FORM_TITLE"
msgstr "Имена хостов и адреса"

msgid "hos_HOSTNAME"
msgstr "Имя хоста"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Имя хоста должно содержать только буквы, цифры и дефисы, и должно начинаться с буквы или цифры."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Имя хоста должно содержать только буквы, цифры и дефисы, и должно начинаться с буквы или цифры."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Ошибка: учетная запись [_1] - существующее [_2] имя узла."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Имя хоста должно содержать только буквы, цифры и дефисы, и должно начинаться с буквы или цифры."

msgid "hos_HOSTTYPE"
msgstr "Расположение"

msgid "hos_LOCAL_IP"
msgstr "Локальный IP"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "(en)The Local IP address is the IP address of another machine on the local network. Please enter a valid IP address in the format \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Пожалуйста, введите следующие дополнительные детали для локального хоста:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Изменить имя хоста"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Пожалуйста, введите следующие дополнительные детали для удалённого хоста:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Вы собираетесь удалить имя хоста \"[_1].[_2]\".   Вы действительно хотите удалить это имя хоста? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Удалить имя хоста"

