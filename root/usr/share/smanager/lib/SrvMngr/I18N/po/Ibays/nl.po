msgid "iba_ACCOUNT_EXISTS"
msgstr "De account \"[_1]\" is een bestaande [_2] account."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " De account \"[_1]\" heeft een conflict met pseudoniem details voor [_2] account \"[_3]\". [_1] is een pseudoniem voor [_3]. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "De informatie-baai naam \"[_1]\" bevat ongeldige tekens. Informatie-baai namen dienen te starten met een kleine letter en mogen enkel kleine letters, cijfers en koppeltekens bevatten."

msgid "iba_ADD_IBAY"
msgstr "I-bay toevoegen"

msgid "iba_ADD_TITLE"
msgstr "Toevoegen of wijzigen van een informatie-baai"

msgid "iba_ALLOW_DYNAMIC_CONTENT"
msgstr "Uitvoeren van dynamische inhoud (CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "Kan geen nieuw account toevoegen voor [_1] (bestaat deze al?)"

msgid "iba_CANT_FIND_IBAY"
msgstr "Kan geen account vinden voor [_1] (bestaat deze account?)"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "Gehele Internet (geen wachtwoord vereist)"

msgid "iba_ENTIRE_INTERNET_PASSWORD"
msgstr "Gehele Internet (wachtwoord vereist)"

msgid "iba_ENTIRE_INTERNET_PASSWORD_REMOTE"
msgstr "Gehele Internet (wachtwoord vereist buiten het lokale netwerk)"

msgid "iba_ERROR_WHILE_CREATING_IBAY"
msgstr "Er is een fout opgetreden tijdens het aanmaken van de informatie-baai."

msgid "iba_ERROR_WHILE_DELETING_IBAY"
msgstr "Er is een fout opgetreden tijdens het verwijderen van de informatie-baai."

msgid "iba_ERROR_WHILE_MODIFYING_IBAY"
msgstr "Er is een fout opgetreden tijdens het wijzigen van de informatie-baai."

msgid "iba_ERROR_WHILE_RESETTING_PASSWORD"
msgstr "Fout tijdens het wijzigen van het wachtwoord."

msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "   informatie-baai toevoegen \n\n   Elke informatie-baai kan worden verwijderd of het wachtwoord kan worden hersteld door op het corresponderende commando te klikken achter de betreffende informatie-baai. Als de informatie-baai in het rood wordt aangegeven betekend dit dat het standaard wachtwoord nog niet is aangepast en dat dit op korte termijn nog dient te gebeuren. \n\n  "

msgid "iba_FORM_TITLE"
msgstr "Informatie-baaien toevoegen, wijzigen of verwijderen"

msgid "iba_HTTPS_Only"
msgstr "Forceer beveiligde verbindingen"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "De wachtwoorden zijn niet gelijk."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Lokaal netwerk (geen wachtwoord vereist)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "Lokaal netwerk (wachtwoord vereist)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "De informatie-baai naam \"[_1]\" is te lang. Demaximale lengte is [_1] tekens."

msgid "iba_NAME_FIELD_DESC"
msgstr "De informatie-baai naam mag enkel bestaan uit kleine letters, cijfers, punten, koppeltekens en lage streepjes en dient te beginnen met een kleine letter. Bijvoorbeeld \"johnson\", \"intra\" en \"cust3.prj12\" zijn correcte namen, maar \"3vrienden\", \"Jan Smit\" en \"Bus!Partner\" zijn dit niet. De lengte van de naam is gelimiteerd tot [_1] tekens."

msgid "iba_NAME_LABEL"
msgstr "Informatie-baai naam"

msgid "iba_NONE"
msgstr "Geen toegang"

msgid "iba_NO_IBAYS"
msgstr "Er zijn momenteel geen informatie-baaien geconfigureerd."

msgid "iba_PASSWORD_DESC"
msgstr "U staat op het punt om het wachtwoord te veranderen voor de informatie-baai [_1]."

msgid "iba_PUBLIC_ACCESS"
msgstr "Publiekelijke toegang via internet of anonieme ftp"

msgid "iba_REMOVE_DESC"
msgstr "  U staat op het punt om de informatie-baai\"[_1]\" ([_2]) te verwijderen. \n\n   Alle bestanden welke zich in deze informatie-baai bevinden zullen verloren gaan. \n\n   Weet u zeker dat u deze informatie-baai wilt verwijderen? \n\n  "

msgid "iba_REMOVE_TITLE"
msgstr "Informatie-baai verwijderen"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "Informatie-baai is met succes toegevoegd."

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "Informatie-baai is met succes verwijderd."

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "Informatie-baai is met succes gewijzigd."

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "Wachtwoord is met succes gewijzigd."

msgid "iba_USER_ACCESS"
msgstr "Gebruikers toegang via bestandsdeling of gebruikers-ftp"

msgid "iba_VHOST_MESSAGE"
msgstr " De volgende virtuele domeinen gebruikten deze informatie-baai voor hun inhoud, dit zal worden aangepast naar de primaire web site (dit kan achteraf worden aangepast):\n\n  <ul>[_1]</ul> "

msgid "iba_WARG"
msgstr "Schrijven = beheerder, Lezen = groep"

msgid "iba_WGRE"
msgstr "Schrijven = groep, Lezen = iedereen"

msgid "iba_WGRG"
msgstr "Schrijven = groep, Lezen = groep"

