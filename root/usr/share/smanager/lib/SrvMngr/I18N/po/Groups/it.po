msgid "grp_GROUP_NAMING"
msgstr " Il nome del gruppo può contenere solo lettere minuscole, numeri, trattini, punti e trattino basso (underscore) e deve iniziare con una lettera minuscola. Per esempio \"vendite\", \"beta3\" e \"riv_net\" sono nomi validi, mentre \"3d\", \"Ufficio Vendite\" e \"q&a\" non lo sono. "

