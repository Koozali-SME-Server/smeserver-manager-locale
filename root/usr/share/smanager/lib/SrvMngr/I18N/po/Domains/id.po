msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Tambahkan domain"

msgid "dom_CONTENT"
msgstr "%1 i-bay"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "Untuk situs web anda dapat memilih situs primary atau i-bay manapun sebagai konten."

msgid "dom_CREATE_TITLE"
msgstr "Buat domain baru"

msgid "dom_CURRENT_DOMAINS"
msgstr "Daftar domain saat ini"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Jika server ini tidak memiliki akses keInternet, atau jika anda memiliki aturan khusus untuk resolusi DNS, masukkan alamat IP DNS server disini. Kosongkan Field tersebut kecuali anda memiliki alasan khusus untuk mengkonfigurasi server DNS lain. Jangan isikan DNS servers ISP anda disini, karena server dapat mencari semua nama DNS Internet tanpa konfigurasi tambahan ini."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr "Pengaturan DNS Perusahaan"

msgid "dom_DESC_NAMESERVERS"
msgstr "Anda dapat memilih apakah domain di-resolve secara lokal, melewati server DNS korporat, atau di-resolve oleh server DNS Internet. Sebagian besar network akan dapat bekerja pada pilihan Default "

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Ubah pengaturan DNS perusahaan"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Error: terdapat karakter yang tidak dibolehkan atau hilang dalam deskripsi domain %1. . Gagal membuat domain baru."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Error: domain %1 sudah digunakan. Gagal membuat domain baru."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Error: terdapat karakter yang tidak dibolehkan atau hilang dalam nama domain %1. Nama domain hanya boleh terdiri dari satu atau lebih huruf, angka, titik dan tanda minus. Gagal membuat domain baru."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Error: gagal saat menghapus domain %1."

msgid "dom_FORM_DESCRIPTION"
msgstr " Saat anda membuat sebuah domain, server anda akan dapatmenerima e-mail untuk domain tersebut dan juga bisa sebagai tuan rumah bagi situs web untuk domain tersebut.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Tambah domain</a> "

msgid "dom_FORM_TITLE"
msgstr "Pengaturan domain"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "DNS server primer korporat "

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "DNS server sekunder korporat "

msgid "dom_LABEL_NAMESERVERS"
msgstr "Server DNS domain"

msgid "dom_MODIFY_TITLE"
msgstr "Ubah domain"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Error: %1 tidak ada."

msgid "dom_PRIMARY_SITE"
msgstr "Situs primary"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  Anda akan menghapusdomain %1 (%2). \n\n  <p> <b>Anda yakin menghapus domain ini?</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Hapus domain"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Berhasil membuat domain %1. Web server anda sedang di-restart. Link pada halaman ini akan tidak aktif sampai proses restart web server selesai."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Sukses menghapus domain %1. Web server anda sedang di-restart. Link pada halaman ini akan nonaktif sampai proses restart web server selesai."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Sukses mengubah domain %1. Web server sedang di-restart. Link di halaman ini akan akan nonaktif sampai prosest restart web server selesai."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Error: domain %1 adalah nama domain dari sistem anda. Anda tidak dapat memiliki domain dengan nama rangkap. Gagal membuat doamin baru."

msgid "dom_corporate"
msgstr "Alamat server DNS perusahaan"

msgid "dom_internet"
msgstr "DNS Server Internet"

msgid "dom_localhost"
msgstr "Resolve secara lokal"

