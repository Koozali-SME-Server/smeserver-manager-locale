msgid "dat_UPDATING_CLOCK"
msgstr " Jam system sedang dimutakhirkan. Silakan tunggu beberapa detik, kemudian klikdisini untuk memeriksa perubahan. "

msgid "dat_manually_set"
msgstr "Atur secara manual"

