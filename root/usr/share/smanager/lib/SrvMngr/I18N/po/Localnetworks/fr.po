msgid "Local networks"
msgstr "Gestion des réseaux locaux"

msgid "ln_ADD_DESC"
msgstr "Chaque valeur doit être de la forme #.#.#.# (où # est un nombre entier compris entre 0 et 255). Le serveur supprime les zéros de la partie finale (identificateur de l'hôte) de l'adresse réseau en fonction du masque de sous-réseau, afin d'assurer la validité de l'adresse réseau.\n\n  <p>Le champ 'Routeur' doit contenir l'adresse IP du routeur local assurant la liaison vers le réseau supplémentaire.</p>\n\n  "

msgid "ln_ADD_TITLE"
msgstr "Ajouter un réseau local"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "Une erreur s'est produite lors de la création du réseau."

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "Une erreur est survenue lors de la suppression du réseau."

msgid "ln_FIRSTPAGE_DESC"
msgstr "Par mesure de sécurité, plusieurs services du serveur ne sont disponibles que pour votre réseau local. Mais il vous est possible d'accorder ces privilèges d'accès local à d'autres réseaux en les ajoutant à la liste ci-dessous. Dans la plupart des cas, vous devriez laisser cette liste vide."

msgid "ln_Failed to find network in Db"
msgstr "(en) Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "Adresse IP non valide."

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Masque de sous-réseau non valide."

msgid "ln_LOCAL NETWORKS"
msgstr "Gestion des réseaux locaux"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Créer un réseau"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "ERREUR : le réseau %1 (dérivé du réseau %2 et du masque de sous-réseau %3) a déjà été ajouté. Le réseau n'a pas été ajouté."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "ERREUR : le réseau %1 (dérivé du réseau %2 et du masque de sous-réseau %3) est déjà considéré comme local. Le réseau n'a pas été ajouté."

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "ERREUR : adresse du routeur %1 inaccessible depuis le réseau local. Le réseau n'a pas été ajouté."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en) Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Nombre d'hôtes"

msgid "ln_REMOVE_DESC"
msgstr "Vous êtes sur le point de supprimer le réseau local suivant :"

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "Le système a détecté la présence d'hôtes locaux configurés sur le réseau que vous vous apprêtez à supprimer. Par défaut, ils seront également supprimés. Décochez cette case si vous souhaitez les conserver. Veuillez noter qu'ils ne seront pas considérés comme locaux et qu'ils risquent de ne plus être joignables après la suppression du réseau."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "Supprimer des hôtes du réseau."

msgid "ln_REMOVE_TITLE"
msgstr "Supprimer le réseau local"

msgid "ln_SUBNET_MASK"
msgstr "Masque de sous-réseau"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "Le réseau %1/%2 accessible via le routeur %3 a été ajouté avec succès. Votre serveur accordera des privilèges d'accès local aux %4 adresses IP comprises dans l'intervalle %5 à %6."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr " Le réseau %1/%2 accessible via le routeur %3 a été ajouté avec succès.\n\n  <p>Votre serveur accordera des privilèges d'accès local aux %1 adresses IP comprises dans l'intervalle %2 à %3.</p>\n\n  <p>ATTENTION : le serveur FTP ProFTPd ne peut pas traiter ce masque de sous-réseau non standard. Le masque simplifié <b>%1</b> sera utilisé à la place.</p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "Le réseau %1/%2 accessible via le routeur %3 a été supprimé avec succès."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "Le réseau %1/%2 accessible via le routeur %3 a été ajouté avec succès. Votre serveur accordera des privilèges d'accès local à l'unique adresse IP %4."
