msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "Skall denna server kontrollera arbetsgruppen och domänen i ditt Windowsnätverk? Du bör ange denna inställning till Nej om någon annan server redan har denna roll i ditt nätverk."

msgid "wkg_DESC_ROAM"
msgstr " Skall denna server stödja serverbaserade profiler (roaming profiles)? Du bör ange denna inställning till det förvalda Nej om du inte har erfarenhet i administrationen av serverbaserade Windows profiler och vet att denna tjänst efterfrågas. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Ange namnet som servern skall använda vid fildelning med Windows och Macintosh."

msgid "wkg_DESC_WORKGROUP"
msgstr " Ange namnet på den Windowsarbetsgrupp som denna server skall tillhöra. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Ändra inställningarna för arbetsgruppen"

msgid "wkg_INVALID_SERVERNAME"
msgstr "Namnet på servern måste börja med en bokstav (versal eller gemen), följt av en kombination av bokstäver, siffror, understreck eller bindestreck."

msgid "wkg_INVALID_WORKGROUP"
msgstr "Namnet på arbetsgruppen måste börja med en bokstav (versal eller gemen), följt av en kombination av bokstäver, siffror, understreck, punkter eller bindestreck."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "Servernamnet och arbetsgruppsnamnet matchar när man jämför dessa som gemener. Dessa värden måste vara olika för att fildelning skall kunna fungera."

msgid "wkg_LABEL_PDC"
msgstr "Arbetsgrupp och domänkontroll"

msgid "wkg_LABEL_ROAM"
msgstr "Serverbaserade profiler"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Servernamn"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Windowsarbetsgrupp"

msgid "wkg_SUCCESS"
msgstr "De nya inställningarna har sparats"
