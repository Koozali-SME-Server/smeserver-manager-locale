msgid "dom_ABOUT_TO_REMOVE"
msgstr "Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Add domain"

msgid "dom_CONTENT"
msgstr "%1 i-bay"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "For the web site, you may choose your primary web site or any i-bay as the content."

msgid "dom_CREATE_TITLE"
msgstr "Create a new domain"

msgid "dom_CURRENT_DOMAINS"
msgstr "Current list of domains"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "If this server does not have access to the Internet, or you have special requirements for DNS resolution, enter the DNS server IP addresses here. These fields should be left blank unless you have a specific reason to configure other DNS servers. You should not enter the address of your ISP's DNS servers here, as the server is capable of resolving all Internet DNS names without this additional configuration."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr "Corporate DNS Settings"

msgid "dom_DESC_NAMESERVERS"
msgstr "You can select whether this domain is resolved locally, passed to the corporate DNS servers, or resolved by the Internet DNS servers. The default will be correct for most networks."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Modify corporate DNS settings"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Error: unexpected or missing characters in domain description %1. Did not create new domain."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Error: domain %1 is already in use. Did not create new domain."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Error: unexpected or missing characters in domain name %1.The domain name should contain one or more letters, numbers, periods and minus signs. Did not create new domain."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Error: internal failure while removing domain %1."

msgid "dom_FORM_DESCRIPTION"
msgstr "When you create a domain, your server will be able to receive e-mail for that domain and will also be able to host a web site for that domain."

msgid "dom_FORM_TITLE"
msgstr "Manage domains"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Primary corporate DNS server"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Secondary corporate DNS server"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Domain DNS servers"

msgid "dom_MODIFY_TITLE"
msgstr "Modify domain"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Error: %1 is not an existing domain."

msgid "dom_PRIMARY_SITE"
msgstr "primary site"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "You are about to remove the domain \"%1\" (%2)."

msgid "dom_REMOVE_TITLE"
msgstr "Remove domain"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Successfully created domain %1.Your web server is now being restarted. The links on this page will be inactive until the web server restart is complete."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Successfully deleted domain %1. Your web server is now being restarted. The links on this page will be inactive until the web server restart is complete."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Successfully modified domain %1.Your web server is now being restarted. The links on this page will be inactive until the web server restart is complete."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Error: domain %1 is your system domain name. You cannot have a domain with the same name. Did not create new domain."

msgid "dom_corporate"
msgstr "Corporate DNS servers"

msgid "dom_internet"
msgstr "Internet DNS servers"

msgid "dom_localhost"
msgstr "Resolve locally"
