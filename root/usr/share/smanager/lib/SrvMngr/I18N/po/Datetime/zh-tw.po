msgid "dat_FORM_TITLE"
msgstr "日期和時間設定"

msgid "dat_INITIAL_DESC"
msgstr "這裡是您設定本伺服器日期與時間之處。您可以使用現存的網路校時伺服器，或依據所在時區自行設定日期與時間。"

msgid "dat_INVALID_HOUR"
msgstr "錯誤：小時數目不符："

msgid "dat_INVALID_MINUTE"
msgstr "錯誤：分鐘數目不符："

msgid "dat_INVALID_NTP_SERVER"
msgstr " 無效的網路校時伺服器之位址，該系統 將無法 試著從網路校時伺服器同步時間。 "

msgid "dat_INVALID_SECOND"
msgstr "錯誤：秒數不符"

msgid "dat_Invalid_date"
msgstr "日期無效"

msgid "dat_NTP_CONFIGURE_DESC"
msgstr "本伺服器預先同步系統時間的網路校時伺服器指定如下。倘若要使用不同的網路校時伺服器，請在下方輸入不同的主機名稱或網路位址。"

msgid "dat_NTP_DISABLE_DESC"
msgstr "選擇該選項以停止系統時間同步到網路校時伺服器。當網路校時伺服器的服務停止時，您可以從本頁手動設定系統的日期與時間。"

msgid "dat_NTP_ENABLE_DESC"
msgstr "本伺服器可以與網路校時伺服器來預先同步系統時間。倘若您選定該選項，請在下方輸入網路校時伺服器的主機名稱或網路位址。"

msgid "dat_NTP_Server_URL"
msgstr "NTP 伺服器 URL："

msgid "dat_SETTINGS_CHANGED"
msgstr "網路校時伺服器設定已修改成功"

msgid "dat_TZ"
msgstr "時區："

msgid "dat_Test_Server"
msgstr "測試 NTP 伺服器"

msgid "dat_The_time_is_currently"
msgstr "目前時間為："

msgid "dat_Time_Configuration"
msgstr "時間設定"

msgid "dat_Time_Setting_Mode"
msgstr "時間設定模式"

msgid "dat_UPDATING_CLOCK"
msgstr "系統時間正將更新。請等候幾秒鐘，然後點選 此處 來確認變更。"

msgid "dat_manually_set"
msgstr "手動設定"

msgid "dat_ntp_server"
msgstr "NTP 伺服器"

