msgid "Groups"
msgstr "(en) Groups"

msgid "Packages"
msgstr "(en) Packages"

msgid "Start"
msgstr "(en) Start"

msgid "yum_1DAILY"
msgstr "Ogni giorno"

msgid "yum_2WEEKLY"
msgstr "Ogni settimana"

msgid "yum_3MONTHLY"
msgstr "Ogni mese"

msgid "yum_AutoInstallUpdates"
msgstr "(en) Autoinstallupdates"

msgid "yum_BUTTON_CONFIGURATION"
msgstr "Modifica le impostazioni dell'installatore software"

msgid "yum_BUTTON_INSTALL_AVAILABLE"
msgstr "Installa software aggiuntivo"

msgid "yum_BUTTON_INSTALL_UPDATES"
msgstr "Elenca gli aggiornamenti disponibili"

msgid "yum_BUTTON_REMOVE"
msgstr "Rimuovi il software installato"

msgid "yum_DESC_AVAILABLE_GROUPS"
msgstr "E' possibile selezionare gruppi di software da installare dalla lista sottostante."

msgid "yum_DESC_AVAILABLE_PACKAGES"
msgstr "E' possibile selezionare pacchetti individuali da installare dalla lista sottostante."

msgid "yum_DESC_AVAILABLE_UPDATES"
msgstr "Di seguito sono riportati gli aggiornamenti disponibili. Tutti gli aggiornamenti disponibili dovrebbero esssere installati. Se ci sono degli aggiornamenti che non si desidera installare, deselezionarli dalla lista sottostante."

msgid "yum_DESC_ENABLED_REPOSITORIES"
msgstr "Installazione software può installare pacchetti da diversi repository. Per abilitare un repository, selezionarlo dalla lista. Per dibasilitarlo deselezionarlo dalla lista. Di default, solo il sofware stabile è disponibile per l'installazione."

msgid "yum_DESC_INSTALLED_GROUPS"
msgstr "E' possibile selezionare gruppi da rimuovere dalla lista sottostante."

msgid "yum_DESC_INSTALLED_PACKAGES"
msgstr "E' possibile selezionare pacchetti singoli da rimuovere dalla lista sottostante."

msgid "yum_DESC_UPDATES_AVAILABLE"
msgstr "(en)There are updates available for your system. These updates should be installed as soon as possible."

msgid "yum_DESC_UPTODATE"
msgstr "Tutti gli aggiornamenti sono stati installati."

msgid "yum_DESC_YUM_AUTOINSTALLUPDATES"
msgstr "(en)If enabled this will take precedence over the simple check for updates notification and predownload features. Instead it will install the available updates from enabled repositories. For more information refer to yum and yum-cron manual page."

msgid "yum_DESC_YUM_DELTARPMPROCESS"
msgstr "(en)A deltarpm contains the difference between an old and a new version of a rpm, which can save bandwith. The drawback is that update operations consume considerably more CPU cycles"

msgid "yum_DESC_YUM_PACKAGEFUNCTIONS"
msgstr "Installazione software può gestire gruppi di pacchetti o pacchetti singoli. Per default, vengono gestiti solo gruppi di pacchetti. Se si desidera gestire pacchetti singoli abilitare questa opzione. L'opzione andrebbe usata solo da amministratori esperti."

msgid "yum_DeltaRpmProcess"
msgstr "(en) Deltarpmprocess"

msgid "yum_DownloadOnly"
msgstr "(en) Downloadonly"

msgid "yum_ERROR_UPDATING_CONFIGURATION"
msgstr "(en) Error updating configuration"

msgid "yum_FORM_TITLE"
msgstr "Programma di installazione del software"

msgid "yum_HEADER_AVAILABLE_SOFTWARE"
msgstr "E' possibile installare il seguente software addizionale. Non installare software addizionale se non si è sicuri di quello che si sta facendo."

msgid "yum_HEADER_INSTALLED_SOFTWARE"
msgstr "Elenco dei pacchetti installati nel sistema. Non rimuovere pacchetti se non si è sicuri di quello che si sta facendo."

msgid "yum_HEADER_POSTUPGRADE_REQUIRED"
msgstr "Il sistema deve essere riconfigurato dopo aver aggiunto o rimosso software o applicato aggiornamenti. <p> Fare clic sul pulsante Riconfigura in fondo a questa pagina per iniziare la procedura di riconfigurazione. <b>Il sistema verrà riavviato automaticamente al termine della riconfigurazione</b> </p>"

msgid "yum_INSTALL_SOFTWARE"
msgstr "Installa"

msgid "yum_INSTALL_UPDATES"
msgstr "Installa aggiornamenti selezionati"

msgid "yum_LABEL_AVAILABLE_GROUPS"
msgstr "Gruppi disponibili"

msgid "yum_LABEL_AVAILABLE_PACKAGES"
msgstr "Pacchetti disponibili"

msgid "yum_LABEL_AVAILABLE_UPDATES"
msgstr "Aggiornamenti disponibili"

msgid "yum_LABEL_ENABLED_REPOSITORIES"
msgstr "Repository abilitati"

msgid "yum_LABEL_INSTALLED_GROUPS"
msgstr "Gruppi installati"

msgid "yum_LABEL_INSTALLED_PACKAGES"
msgstr "Pacchetti installati"

msgid "yum_LABEL_YUM_AUTOINSTALLUPDATES"
msgstr "Installazione automatica aggiormanenti"

msgid "yum_LABEL_YUM_DELTARPMPROCESS"
msgstr "Aggiornamento Delta RPM"

msgid "yum_LABEL_YUM_DOWNLOADONLY"
msgstr "Dettagli personali aggiornati"

msgid "yum_LABEL_YUM_DOWNLOADONLY_DESCRIPTION"
msgstr "(en)The rpm updates can be downloaded during the night, this will ease and give faster the dnf update process (only enabled repositories will be used)."

msgid "yum_LABEL_YUM_PACKAGEFUNCTIONS"
msgstr "Gestione dei singoli pacchetti"

msgid "yum_LABEL_YUM_STATUS"
msgstr "Verifica presenza aggiornamenti ogni giorno"

msgid "yum_MULTI_SELECT"
msgstr "(en) <strong>Ctrl/Cmd-click</strong> toggles individual items and <strong>Shift-click</strong> selects ranges.\n<br /><strong>Case-insensitive</strong> search unless you enter a <strong>regex</strong> in <i>/pattern/flags</i> form (e.g. /maria.*client/i).."

msgid "yum_Please_Wait_-_dnf_Running"
msgstr "Attendere prego - dnf in esecuzione"

msgid "yum_SUCCESS"
msgstr "La nuova configurazione è stata salvata."

msgid "yum_UPDATE_SUCCESS"
msgstr "(en)The requested changes have been successfully implemented."

msgid "yum_check4updates"
msgstr "(en) Check4updates"

