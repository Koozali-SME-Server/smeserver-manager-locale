msgid "Reboot or shutdown"
msgstr "Herstarten of afsluiten"

msgid "rbo_DESCRIPTION"
msgstr " U kunt herstarten, afsluiten of een volledige herconfiguratie van uw server uitvoeren via dit scherm. U moet het systeem afsluiten voordat u de stroomtoevoer afkoppelt. Al deze functies nemen enige minuten in beslag. Als u op uitvoeren klikt wordt deze actie direct uitgevoerd, wees er dus klaar voor! "

msgid "rbo_DESC_REBOOT"
msgstr "Uw server heeft het herstart proces in gang gezet."

msgid "rbo_DESC_RECONFIGURE"
msgstr "Uw server heeft een volwaardige systeem herconfiguratie en herstart in gang gezet."

msgid "rbo_DESC_SHUTDOWN"
msgstr "Uw server heeft het afsluit proces in gang gezet. Dit proces neemt enige minuten om af te ronden, aansluitend kunt u de stroomtoevoer afkoppelen."

msgid "rbo_FORM_TITLE"
msgstr "Afsluiten of herstarten"

msgid "rbo_LABEL_REBOOT"
msgstr "Kies Afsluiten, Herstarten of Herconfigureren"

msgid "rbo_REBOOT"
msgstr "Herstarten"

msgid "rbo_REBOOT_SUCCEEDED"
msgstr "Herstart verzoek met succes gestart."

msgid "rbo_RECONFIGURE_SUCCEEDED"
msgstr "Herconfiguratie verzoek met succes gestart."

msgid "rbo_SHUTDOWN_SUCCEEDED"
msgstr "(en) Shutdown request initiated successfully."
