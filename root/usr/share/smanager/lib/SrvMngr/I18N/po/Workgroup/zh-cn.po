msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "是否要将服务器在windows网络中作为工作组和域控器来使用？如果网络中已存在域控器，您应该选择 否。"

msgid "wkg_DESC_ROAM"
msgstr " 此服务器是否支持来宾账户？您应该选择默认设置 否， 除非您在基于服务器的Windows来宾账户方面有很好的管理经验，并且知道必须启用来宾帐户. "

msgid "wkg_DESC_SERVERNAME"
msgstr "请输入为Windows和Macintosh文件共享使用的名称。"

msgid "wkg_DESC_WORKGROUP"
msgstr " 输入服务器所在的Windows工作组名称 "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "修改工作组设置"

msgid "wkg_INVALID_SERVERNAME"
msgstr "服务器名称必须以字母开头（不区分大小写），由任意的字母组合，数字，下划线和连字符组成。"

msgid "wkg_INVALID_WORKGROUP"
msgstr "工作组名称必须以字母开头（大写或小写），由任意的字母组合，数字，下划线，句号和连字符组成。"

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "使用小写字母时，服务器和工作组名称应互相匹配。为了打开文件共享功能，这些值必须不相同。"

msgid "wkg_LABEL_PDC"
msgstr "工作组和域控制器"

msgid "wkg_LABEL_ROAM"
msgstr "来宾账户"

msgid "wkg_LABEL_SERVERNAME"
msgstr "服务器名称"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Windows 工作组"

msgid "wkg_SUCCESS"
msgstr "新的工作组设置已被保存"
