msgid "iba_ACCOUNT_EXISTS"
msgstr "L'account \"[_1]\" è un account [_2] esistente."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " L'account \"[_1]\" è in conflitto con i dettagli dello pseudonimo per \"[_3]\". [_1] è uno pseudonimo per [_3]. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "Il nome dell'i-bay \"[_1]\" contiene caratteri non validi. I nome delle i-bay devono iniziare con una lettera minuscola e contenere solo lettere minuscole, numeri e trattini."

msgid "iba_ADD_IBAY"
msgstr "Aggiungi i-bay"

msgid "iba_ADD_TITLE"
msgstr "Crea o modifica una i-bay"

msgid "iba_ALLOW_DYNAMIC_CONTENT"
msgstr "Esecuzione di contenuti dinamici (CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "Impossibile creare nuovo account per [_1] (già esistente?)"

msgid "iba_CANT_FIND_IBAY"
msgstr "Impossibile trovare l'account per [_1] (esiste?)"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "Intera Internet (password non richiesta)"

msgid "iba_ENTIRE_INTERNET_PASSWORD"
msgstr "Intera Internet (password richiesta)"

msgid "iba_ENTIRE_INTERNET_PASSWORD_REMOTE"
msgstr "Intera Internet (password richiesta fuori rete locale)"

msgid "iba_ERROR_WHILE_CREATING_IBAY"
msgstr "Errore durante la creazione della i-bay."

msgid "iba_ERROR_WHILE_DELETING_IBAY"
msgstr "Errore durante la rimozione della i-bay."

msgid "iba_ERROR_WHILE_MODIFYING_IBAY"
msgstr "Errore durante la creazione della i-bay."

msgid "iba_ERROR_WHILE_RESETTING_PASSWORD"
msgstr "Errore durante la modifica della password."

msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "  Aggiungi i-bay \n\n   E' possibile rimuovere una i-bay o cambiare la password facendo clic sul corrispondente comando a fianco dell'i-bay. Se l'i-bay appare in rosso significa che la password non è ancora stata cambiata dal default e dovrebbe essere cambiata subito. \n\n  "

msgid "iba_FORM_TITLE"
msgstr "Crea, modifica o rimuovi i-bay"

msgid "iba_HTTPS_Only"
msgstr "Forza connessioni sicure (HTTPS)"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "Le password non coincidono."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Rete locale (password non richiesta)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "Rete locale (password richiesta)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "Il nome della i-bay \"[_1]\" è troppo lungo. Il massimo è [_1] caratteri."

msgid "iba_NAME_FIELD_DESC"
msgstr "Il nome dell'i-bay può contenere solo lettere minuscole, numeri, punti, trattini e underscore e deve iniziare con una lettera minuscola. Per esempio \"brambilla\", \"intra\" e \"prog.soft\" sono tutti nomi validi, mentre \"2dipicche\", \"Mario Rossi\" e \"go!web\" non lo sono. Il nome è limitato a [_1] caratteri."

msgid "iba_NAME_LABEL"
msgstr "Nome i-bay"

msgid "iba_NONE"
msgstr "Nessun accesso"

msgid "iba_NO_IBAYS"
msgstr "Non ci sono i-bay configurate."

msgid "iba_PASSWORD_DESC"
msgstr "Inserire la password per l'i-bay [_1]."

msgid "iba_PUBLIC_ACCESS"
msgstr "Accesso pubblico via web o ftp anonimo"

msgid "iba_REMOVE_DESC"
msgstr "  Sta per essere rimossa la i-bay \"[_1]\" ([_2]). \n\n   Tutti i file contenuti in questa i-bay verranno cancellati. \n\n   Siete sicuri di voler rimuovere questa i-bay? \n\n  "

msgid "iba_REMOVE_TITLE"
msgstr "Rimuovi i-bay"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "i-bay creata con successo."

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "i-bay rimossa con successo."

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "i-bay modificata con successo."

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "Password modificata con successo."

msgid "iba_USER_ACCESS"
msgstr "Accesso utente via condivisione file o ftp"

msgid "iba_VHOST_MESSAGE"
msgstr " I seguenti domini virtuali usavano questa i-bay e verranno redirezionati al sito web primario (sarà possibile modificarli in seguito):\n\n  <ul>[_1]</ul> "

msgid "iba_WARG"
msgstr "Scrittura = admin, Lettura = gruppo"

msgid "iba_WGRE"
msgstr "Scrittura = gruppo, Lettura = tutti"

msgid "iba_WGRG"
msgstr "Scrittura = gruppo, Lettura = gruppo"

