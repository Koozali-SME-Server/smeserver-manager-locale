msgid "Hostnames and addresses"
msgstr "Имена на хостове и адреси"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "Адресът попада в зададен динамичен DHCP обхват"

msgid "hos_ADD_HOSTNAME"
msgstr " Добави име на хост "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Създаване и промяна на имена на хостове"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Списък на имената на хостове за домейна [_1]"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Възникна грешка при създаването на името на хоста."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Възникна грешка при изтриването на името на хоста."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Възникна грешка при промяната на името на хоста."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Грешка: IP адресът не може да бъде IP адреса на сървъра или шлюза."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Грешка: Този IP адрес не е в никоя от нашите локални мрежи."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Ethernet адрес"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "Ethernet адресът е по желание и ще накара DHCP сървъра да свърже статично локалния IP адрес с компютъра имащ този Ethernet адрес. Ако бъде зададен, той трябва да бъде в следния формат \"AA:BB:CC:DD:EE:FF\" и трябва да съдържа цифрите от 0 до 9 и буквите от А до F на латиница."

msgid "hos_FORM_TITLE"
msgstr "Имена на хостове и адреси"

msgid "hos_HOSTNAME"
msgstr "Име на хоста"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Грешка: неочаквани символи в името на хоста: \"[_1].[_2]\". Името на хоста трябва да съдържа само букви, цифри и тирета и трябва да започва с буква или цифра."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Името на хоста трябва да съдържа само букви, цифри и тирета, и трябва да започва с буква или цифра."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Грешка: записът за [_1] съществува за хост от тип [_2]."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Грешка: неочаквани символи в името на хоста: \"[_1].[_2]\". Името на хоста трябва да съдържа само букви, цифри и тирета и трябва да започва с буква или цифра."

msgid "hos_HOSTTYPE"
msgstr "Разположение"

msgid "hos_LOCAL_IP"
msgstr "Локален IP"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "Локалния IP адрес е IP адрес на друга машина в локалната мрежа. Моля въведете валиден IP адрес във формат \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Моля, въведете следната допълнителна информация за локалния хост:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Промяна на името на хоста"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Моля, въведете следната допълнителна информация за отдалечения хост:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Вие възнамеряване да премахнете име на хост \"[_1].[_2]\".   Сигурни ли сте, че искате да премахнете това име на хост? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Премахване на името на хоста"

