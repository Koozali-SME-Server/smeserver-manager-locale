msgid "iba_ACCOUNT_EXISTS"
msgstr "Contul \"[_1]\" este deja cont de tip [_2] "

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " Contul \"[_1]\" este ăn conflict cu detaliile pseudonimului contulrui de tip [_2] \"[_3]\". [_1] este pseudonim pentru [_3]. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "(en)The i-bay name \"[_1]\" contains invalid characters. I-bay names must start with a lower case letter and contain only lower case letters, numbers, and hyphens."

msgid "iba_ADD_IBAY"
msgstr "Adaugă i-bay"

msgid "iba_ADD_TITLE"
msgstr "Creează sau modifică un i-bay"

msgid "iba_ALLOW_DYNAMIC_CONTENT"
msgstr "(en)Execution of dynamic content (CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "(en)Can't create new account for [_1] (does it already exist?)"

msgid "iba_CANT_FIND_IBAY"
msgstr "(en)Can't find account for [_1] (does it exist?)"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "Entire Internet (no password required)"

msgid "iba_ENTIRE_INTERNET_PASSWORD"
msgstr "Entire Internet (password required)"

msgid "iba_ENTIRE_INTERNET_PASSWORD_REMOTE"
msgstr "Entire Internet (password required outside local network)"

msgid "iba_ERROR_WHILE_CREATING_IBAY"
msgstr "(en)An error occurred while creating the i-bay."

msgid "iba_ERROR_WHILE_DELETING_IBAY"
msgstr "(en)An error occurred while deleting the i-bay."

msgid "iba_ERROR_WHILE_MODIFYING_IBAY"
msgstr "(en)An error occurred while modifying the i-bay."

msgid "iba_ERROR_WHILE_RESETTING_PASSWORD"
msgstr "Eroare la resetarea parolei."

msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "  Add i-bay \n\n   You can remove any information bay or reset its password by clicking on the corresponding command next to the information bay. If the information bay shows up in red, that means that the password has not yet been changed from the default, and should be changed soon. \n\n  "

msgid "iba_FORM_TITLE"
msgstr "Creați, modificați sau eliminați i-bay-uri"

msgid "iba_HTTPS_Only"
msgstr "Permiteți conexiuni directe SMTP"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "Parolele nu se potrivesc."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Local network (no password required)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "Local network (password required)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "The i-bay name \"[_1]\" is too long. The maximum is [_1] characters."

msgid "iba_NAME_FIELD_DESC"
msgstr "(en)The information bay name should contain only lower-case letters, numbers, periods, hyphens and underscores, and should start with a lower-case letter. For example \"johnson\", \"intra\", and \"cust3.prj12\" are all valid names, but \"3associates\", \"John Smith\" and \"Bus!Partner\" are not. The name is limited to [_1] characters."

msgid "iba_NAME_LABEL"
msgstr "Numele compartimentului de informații"

msgid "iba_NONE"
msgstr "No access"

msgid "iba_NO_IBAYS"
msgstr "(en)There are no i-bays currently configured."

msgid "iba_PASSWORD_DESC"
msgstr "(en)You are about to change the password for the i-bay [_1]."

msgid "iba_PUBLIC_ACCESS"
msgstr "(en)Public access via web or anonymous ftp"

msgid "iba_REMOVE_DESC"
msgstr "  You are about to remove the information bay \"[_1]\" ([_2]). \n\n   All files belonging to this information bay will be deleted. \n\n   Are you sure you wish to remove this information bay? \n\n  "

msgid "iba_REMOVE_TITLE"
msgstr "Elimină panoul de informații"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "i-bay a fost creat cu succes."

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "i-bay a fost șters cu succes."

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "I-bay modificat cu succes."

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "Parola a fost resetată cu succes."

msgid "iba_USER_ACCESS"
msgstr "(en)User access via file sharing or user ftp"

msgid "iba_VHOST_MESSAGE"
msgstr " The following virtual domains were using this information bay as their content and will be changed to the primary web site (you can change them to something else afterward): [_1] "

msgid "iba_WARG"
msgstr "Write = admin, Read = group"

msgid "iba_WGRE"
msgstr "Write = group, Read = everyone"

msgid "iba_WGRG"
msgstr "Write = group, Read = group"

