msgstr "Configuración de la hora"

msgid "dat_Time_Setting_Mode"
msgstr "Modo de configuración de hora"

msgid "dat_UPDATING_CLOCK"
msgstr " Se está actualizando el reloj del sistema. Espere algunos segundos y luego haga clic aquí para verificar los cambios. "

msgid "dat_manually_set"
msgstr "Configurar manualmente"

