msgstr "(en) COULD_NOT_GET_UID"

msgid "Quotas"
msgstr "(en) Quotas"

msgid "quo_ABS_LIMIT"
msgstr "абсолютен лимит"

msgid "quo_ABS_LIMIT_MB"
msgstr "абсолютен лимит (МБ)"

msgid "quo_ACCOUNT_IS_TYPE"
msgstr "То е сметка от тип:"

msgid "quo_CURRENTLY_HAS"
msgstr "в момента има:"

msgid "quo_CURRENT_USAGE"
msgstr "използвани (МБ)"

msgid "quo_CURRENT_USAGE_AND_SETTINGS"
msgstr "Текущи стойности за използваната квота и настройки"

msgid "quo_ERR_HARD_LT_SOFT"
msgstr "Грешка: абсолютния лимит трябва да е по-голям лимит с гратисен период."

msgid "quo_ERR_MODIFYING"
msgstr "Възникна грешка при промяната на потребителя."

msgid "quo_ERR_NOT_A_USER_ACCT"
msgstr "Грешка: посоченото не е потребител:"

msgid "quo_ERR_NO_SUCH_ACCT"
msgstr "Грешка: няма потребител:"

msgid "quo_FILES"
msgstr "файлове"

msgid "quo_FORM_TITLE"
msgstr "Създаване, промяна или премахване на потребителски квоти"

msgid "quo_HARD_VAL_MUST_BE_NUMBER"
msgstr "Грешка: абсолютния лимит трябва да бъде число, евентуално последвано от един от следните суфикси K, M, G или Т."

msgid "quo_INSTRUCTIONS"
msgstr "Въведете квотата, като може да добавите суфикс за мярката - 'K' за КБайта, 'M' за МБайта, 'G' за ГБайта, 'T' за ТБайта. Въведеното без суфикс ще бъде прието за МБайта. Стойност '0' за кой да е от лимитите ще изключи този лимит за съответния потребител."

msgid "quo_LIMIT_WITH_GRACE"
msgstr "лимит с гратисен период"

msgid "quo_LIMIT_WITH_GRACE_MB"
msgstr "лимит с гратисен период (МБ)"

msgid "quo_MEGABYTES"
msgstr "мбайта"

msgid "quo_MODIFY_USER_TITLE"
msgstr "Промяна на потребителски лимити за квоти"

msgid "quo_OCCUPYING"
msgstr "заема:"

msgid "quo_QUOTA_DESC"
msgstr " Можете да задавате квоти върху файловата система за потребителите на системата като щракнете на бутона \"Промени\" в страни от потребителя, който искате да актуализирате. Ако потребителя надвиши \"лимита с гратисен период\", ще бъдат генерирани предупреждения. Ако този лимит бъде надвишен за повече от седмица или ако бъде надвишен \"абсолютния лимит\", потребителя няма да може повече да съхранява файлове или да получава поща. Задавайки '0' за кой да е от лимитите изключва този лимит за съответния потребител. Дисковото пространство за всеки потребител включва домашната папка на потребителя, електронната поща и всеки файл, чийто собственик е потребителя в информационните слотове. "

msgid "quo_SOFT_VAL_MUST_BE_NUMBER"
msgstr "Грешка: лимита с гратисен период трябва да бъде число, евентуално последвано от един от следните суфикси K, M, G или Т."

msgid "quo_SUCCESSFULLY_MODIFIED"
msgstr "Успешно бе променена квотата за потребител:"

msgid "quo_USER"
msgstr "Потребител:"

