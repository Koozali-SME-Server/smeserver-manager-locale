msgid "Workgroup"
msgstr "Gruppo di lavoro"

msgid "wkg_DESC_PDC"
msgstr "Il server sarà il controller di dominio sulla rete Windows? Lasciare No se un altro server ricopre già questa funzione sulla rete locale."

msgid "wkg_DESC_ROAM"
msgstr " Il server supporterà i profili roaming? Lasciare il valore di default No se non si possiede sufficiente esperienza di amministrazione di profili roaming su server Windows e si è sicuri che questa caratteristica è necessaria. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Inserire il nome che questo server userà per la condivisione file Windows e Macintosh."

msgid "wkg_DESC_WORKGROUP"
msgstr " Inserire il nome del gruppo di lavoro Windows in cui deve apparire questo server. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Cambia impostazioni gruppo di lavoro"

msgid "wkg_INVALID_SERVERNAME"
msgstr "Il nome del server deve iniziare con una lettera (maiuscola o minuscola), seguita da qualsiasi combinazione di lettere, numeri, underscore e trattini."

msgid "wkg_INVALID_WORKGROUP"
msgstr "Il nome del gruppo di lavoro deve iniziare con una lettera (maiuscola o minuscola), seguita da qualsiasi combinazione di lettere, numeri, underscore, punti e trattini."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "I nomi del serve e del gruppo di lavoro sono uguali in minuscolo. Questi campi devono essere diversi per attivare e funzioni di condivisione file."

msgid "wkg_LABEL_PDC"
msgstr "Controller di Dominio"

msgid "wkg_LABEL_ROAM"
msgstr "Profili roaming"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Nome Server"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Gruppo di lavoro Windows"

msgid "wkg_SUCCESS"
msgstr "Le nuove impostazioni del gruppo di lavoro sono state salvate"
