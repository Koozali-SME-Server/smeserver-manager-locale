msgid "Printers"
msgstr "Printerid"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "Soovid eemaldada printeri:"

msgid "prt_ARE_YOU_SURE"
msgstr "Oled kindel, et tahad seda printerit eemaldada?"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "Lisati printer:"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "Palun sisesta võrguprinteri aadress ja nimi"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "Lisa uus võrguprinter"

msgid "prt_CREATE_NEW_DESC"
msgstr "Vali kordumatu nimi pirinterile ja lisa kirjeldus. Printeri nimi võib sisaldada ainult väiketähti ja numbreid. Näiteks \"hplaser\" aga \"HP Laser\" ei sobi. Avoid names and descriptions that contain these terms, \"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\", \"paper\", \"error\" and \"responding\"."

msgid "prt_CREATE_NEW_PRINTER"
msgstr "Lisa uus printer"

msgid "prt_CURRENT_LIST"
msgstr "Lisatud prinerite nimekiri"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "Kustutati edukalt printer:"

msgid "prt_ERR_EXISTS"
msgstr "Viga: An account with the same name exists with type:"

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "Viga: sisemine viga printeri eemaldamisel:"

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "Viga: sobimatu võrguaadress. Uut printerit ei lisatud."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "Viga: sobimatu võrguprinterinimi. Uut printerit ei lisatud."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "Viga: Sobimatu sümbol kirjelduses. Printerit ei lisatud."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr " Viga: Sobimatud sümbolid printeri nimes. Printeri nimi võib sisaldada ainult väiketähti ja numbreid. Näiteks \"hplaser\" aga \"HP Laser\" ei sobi. "

msgid "prt_FIRST_USB_PRINTER"
msgstr "Esimene USB-ga ühendatud printer"

msgid "prt_FORM_TITLE"
msgstr "Lisa või eemalda printereid"

msgid "prt_HOSTNAME_OR_IP"
msgstr "Võrguprinteri hostinimi või IP aadress "

msgid "prt_INITIAL_BTN"
msgstr "Lisa printer"

msgid "prt_LOCAL_PRINTER_0"
msgstr "Lokaalne printeriport 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "Kohaliku printeri port 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "Kohaliku printeri port 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "Peab olema sobiv hostinimi või IP number"

msgid "prt_NET_PRINTER"
msgstr "Võrguprinter..."

msgid "prt_NO_PRINTERS"
msgstr "Printereid pole lisatud"

msgid "prt_PRINTER_NAME"
msgstr "Printeri nimi "

msgid "prt_REMOTE_ADDRESS"
msgstr "Remote aadress"

msgid "prt_REMOTE_NAME"
msgstr "Remote nimi"

msgid "prt_REMOTE_NAME_DESC"
msgstr " Võrguprinteri nimi (enter raw if not sure) "

msgid "prt_REMOVE_PRINTER"
msgstr "Eemalda printer"

msgid "prt_SECOND_USB_PRINTER"
msgstr "Teine USB-ga ühendatud printer"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "Kõik spuulitud failid on kustutatud selles printeris."

