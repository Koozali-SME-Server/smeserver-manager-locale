msgid "quo_FORM_TITLE"
msgstr "Anlegen, Ändern oder Entfernen von Speicherlimits von Benutzerkonten"

msgid "quo_HARD_VAL_MUST_BE_NUMBER"
msgstr "Fehler: Das \"Absolute Limit\" muss als ganze Zahl eingegeben werden und kann die Zusätze K, M, G oder T enthalten."

msgid "quo_INSTRUCTIONS"
msgstr "Geben Sie das Speicherlimit an, optional mit nachfolgendem Zeichen 'K' für Kilobytes, 'M' für Megabytes, 'G' für Gigabytes oder 'T' für Terabyte. Eingaben ohne zusätzliches Zeichen werden als Megabyte gewertet. Eingabe '0' schaltet das jeweilige Limit für diesen Benutzer ab."

msgid "quo_LIMIT_WITH_GRACE"
msgstr "Limit mit Gnadenfrist"

msgid "quo_LIMIT_WITH_GRACE_MB"
