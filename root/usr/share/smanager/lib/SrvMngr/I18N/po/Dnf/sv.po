msgid "Groups"
msgstr "(en) Groups"

msgid "Packages"
msgstr "(en) Packages"

msgid "Start"
msgstr "(en) Start"

msgid "yum_1DAILY"
msgstr "En gång varje dag"

msgid "yum_2WEEKLY"
msgstr "Varje vecka"

msgid "yum_3MONTHLY"
msgstr "Månadsvis"

msgid "yum_AutoInstallUpdates"
msgstr "(en) Autoinstallupdates"

msgid "yum_BUTTON_CONFIGURATION"
msgstr "Ändra inställningar för programinstallationen"

msgid "yum_BUTTON_INSTALL_AVAILABLE"
msgstr "Installera ytterligare programvara"

msgid "yum_BUTTON_INSTALL_UPDATES"
msgstr "Lista tillgängliga uppdateringar"

msgid "yum_BUTTON_REMOVE"
msgstr "Ta bort installerad programvara"

msgid "yum_DESC_AVAILABLE_GROUPS"
msgstr "Du kan välja programvarugrupper att installera från listan nedan."

msgid "yum_DESC_AVAILABLE_PACKAGES"
msgstr "Du kan också välja enstaka paket för installation i listan nedan."

msgid "yum_DESC_AVAILABLE_UPDATES"
msgstr "Följande uppdateringar finns för ditt system. Du bör normal installera alla tillgängliga uppdateringar. Om det är någon(ra) uppdatering(ar) som du inte önskar installera, avmarkera den(de) från listan nedan."

msgid "yum_DESC_ENABLED_REPOSITORIES"
msgstr "Installationshanteraren för programvara kan installera programvara från alla de tillåtna förråden. För att tillåta ett förråd, välj det från listan. För att ej tillåta ett förråd, avmarkera det från listan. Förvalt är att endast stabila, testade programvaror är tillåtna för installation."

msgid "yum_DESC_INSTALLED_GROUPS"
msgstr "Du kan välja en programvarugrupp för radering i listan nedan."

msgid "yum_DESC_INSTALLED_PACKAGES"
msgstr "Du kan också välja individuella paket som du önskar radera, från listan nedan."

msgid "yum_DESC_UPDATES_AVAILABLE"
msgstr "  Det finns uppdateringar tillgängliga för ditt system. Dessa uppdateringar bör installeras så fort som möjligt."

msgid "yum_DESC_UPTODATE"
msgstr "  Alla uppdateringar har installerats."

msgid "yum_DESC_YUM_AUTOINSTALLUPDATES"
msgstr "(en)If enabled this will take precedence over the simple check for updates notification and predownload features. Instead it will install the available updates from enabled repositories. For more information refer to yum and yum-cron manual page."

msgid "yum_DESC_YUM_DELTARPMPROCESS"
msgstr "(en)A deltarpm contains the difference between an old and a new version of a rpm, which can save bandwith. The drawback is that update operations consume considerably more CPU cycles"

msgid "yum_DESC_YUM_PACKAGEFUNCTIONS"
msgstr "Installationshanteraren för programvara kan hantera grupper av relaterade paket eller individuella paket. Förvalt är att grupper av paket presenteras. om du önskar att hantera individuella paket, tillåt denna möjlighet. Detta bör endast göras av erfarna administratörer."

msgid "yum_DeltaRpmProcess"
msgstr "(en) Deltarpmprocess"

msgid "yum_DownloadOnly"
msgstr "(en) Downloadonly"

msgid "yum_ERROR_UPDATING_CONFIGURATION"
msgstr "(en) Error updating configuration"

msgid "yum_FORM_TITLE"
msgstr "Installationsprogram"

msgid "yum_HEADER_AVAILABLE_SOFTWARE"
msgstr "Följande programvara finns tillgängliga för installation i ditt system. Du bör endast installera ytterligare programvara i detta system om du är medveten om konsekvenserna av detta."

msgid "yum_HEADER_INSTALLED_SOFTWARE"
msgstr "Följande programvara är installerat på ditt system. Du bör endast radera programvara från detta system om du är medveten om konsekvenserna av detta."

msgid "yum_HEADER_POSTUPGRADE_REQUIRED"
msgstr " Systemet behöver om omkonfigureras efter installation, radering av programvara, eller uppdatering av programvara. <p> Klicka på omkonfigureringsknappen i slutet på denna sida för att starta omkonfigureringsprocesen. <b>En automatisk omstart kommer att initieras som en del av denna omkonfigureringsprocess</b> </p> "

msgid "yum_INSTALL_SOFTWARE"
msgstr "Installera"

msgid "yum_INSTALL_UPDATES"
msgstr "Installera valda uppdateringar"

msgid "yum_LABEL_AVAILABLE_GROUPS"
msgstr "Tillgängliga grupper"

msgid "yum_LABEL_AVAILABLE_PACKAGES"
msgstr "Tillgängliga paket"

msgid "yum_LABEL_AVAILABLE_UPDATES"
msgstr "Uppdateringar finns tillgängliga"

msgid "yum_LABEL_ENABLED_REPOSITORIES"
msgstr "Tillåt förråd (repositories)"

msgid "yum_LABEL_INSTALLED_GROUPS"
msgstr "Installerade grupper"

msgid "yum_LABEL_INSTALLED_PACKAGES"
msgstr "Installerade paket"

msgid "yum_LABEL_YUM_AUTOINSTALLUPDATES"
msgstr "Installera uppdateringar automatiskt"

msgid "yum_LABEL_YUM_DELTARPMPROCESS"
msgstr "Delta varvtalsuppdatering"

msgid "yum_LABEL_YUM_DOWNLOADONLY"
msgstr "Personlig information har uppdaterats"

msgid "yum_LABEL_YUM_DOWNLOADONLY_DESCRIPTION"
msgstr "(en)The rpm updates can be downloaded during the night, this will ease and give faster the dnf update process (only enabled repositories will be used)."

msgid "yum_LABEL_YUM_PACKAGEFUNCTIONS"
msgstr "Hantera paket individuellt"

msgid "yum_LABEL_YUM_STATUS"
msgstr "Kontrollera om det finns uppdateringar"

msgid "yum_MULTI_SELECT"
msgstr "(en) <strong>Ctrl/Cmd-click</strong> toggles individual items and <strong>Shift-click</strong> selects ranges.\n<br /><strong>Case-insensitive</strong> search unless you enter a <strong>regex</strong> in <i>/pattern/flags</i> form (e.g. /maria.*client/i).."

msgid "yum_Please_Wait_-_dnf_Running"
msgstr "Vänta – dnf körs"

msgid "yum_SUCCESS"
msgstr "De nya inställningarna har sparats."

msgid "yum_UPDATE_SUCCESS"
msgstr "(en)The requested changes have been successfully implemented."

msgid "yum_check4updates"
msgstr "(en) Check4updates"

