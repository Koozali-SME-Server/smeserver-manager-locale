msgid "NO_SUCH_USER"
msgstr "(en) There does not appear to be any such user"

msgid "pwd_ACCOUNT_PASSWORD_CHANGE"
msgstr "Changer le mot de passe du compte"

msgid "pwd_DESCRIPTION"
msgstr "Pour modifier le mot de passe de votre compte, remplissez le formulaire suivant. Vous devez taper votre nom d'utilisateur, votre ancien mot de passe et le nouveau mot de passe souhaité (que vous devrez taper deux fois).\n\n  <p>Si vous ne pouvez pas modifier votre mot de passe parce que vous avez oublié l'ancien, l'administrateur de votre serveur peut le réinitialiser à l'aide du <em>gestionnaire du serveur</em>.</p>\n\n  "

msgid "pwd_DESCRIPTION_RESET"
msgstr "Pour réinitialiser le mot de passe de votre compte, remplissez le formulaire suivant. Vous devez taper le nouveau mot de passe souhaité (que vous devrez taper deux fois).\n\n  <p>En cas de problème, l'administrateur de votre serveur peut le réinitialiser à l'aide du <em>gestionnaire du serveur</em>.</p>\n\n  "

msgid "pwd_ERROR_PASSWORD_CHANGE"
msgstr "Une erreur s'est produite pendant la modification de votre mot de passe. Veuillez vous assurer de l'exactitude de l'ancien mot de passe tapé."

msgid "pwd_ERR_OCCURRED_MODIFYING_PASSWORD"
msgstr "(en) Err occurred modifying password"

msgid "pwd_FIELDS_REQUIRED"
msgstr "Tous les champs doivent être saisis"

msgid "pwd_INTERMEDIATE_PASSWORD_DESCRIPTION"
msgstr "(en)The password must be composed of at least %1 characters with uppercase and lowercase letters and must pass a dictionary check."

msgid "pwd_INVALID_REQUEST"
msgstr "(en) Invalid request"

msgid "pwd_NONE_PASSWORD_DESCRIPTION"
msgstr "(en)The password must be composed of at least %1 characters."

msgid "pwd_NORMAL_PASSWORD_DESCRIPTION"
msgstr "(en)The password must be composed of at least %1 characters with uppercase and lowercase letters."

msgid "pwd_OK_FOR_RESET"
msgstr "(en) Ok for reset"

msgid "pwd_PASSWORD_CHANGE"
msgstr "Changer le mot de passe"

msgid "pwd_PASSWORD_CHANGE_SUCCESS"
msgstr "Le mot de passe a été modifié avec succès."

msgid "pwd_PASSWORD_INVALID_CHARS"
msgstr "Le mot de passe que vous avez tapé contient des caractères non valides."

msgid "pwd_PASSWORD_NEW"
msgstr "Nouveau mot de passe"

msgid "pwd_PASSWORD_OLD"
msgstr "Ancien mot de passe"

msgid "pwd_PASSWORD_OLD_INVALID_CHARS"
msgstr "L'ancien mot de passe que vous avez tapé contient des caractères non valides."

msgid "pwd_PASSWORD_RESET"
msgstr "Réinitialiser le mot de passe"

msgid "pwd_PASSWORD_VERIFY_ERROR"
msgstr "Les nouveaux mots de passe ne concordent pas."

msgid "pwd_PASSWORD_VERIFY_NEW"
msgstr "Nouveau mot de passe (vérification)"

msgid "pwd_PASSWORD_WIKI"
msgstr "(en)If you want to know more about passwords, then please refer to the <a href='https://wiki.koozali.org/SME_Server:Documentation:Administration_Manual:Chapter9#Changing_User_Passwords'>Wiki</a>"

msgid "pwd_STRONG_PASSWORD_DESCRIPTION"
msgstr "(en)The password must be composed of at least %1 characters with uppercase and lowercase letters, numbers and special characters and must pass a dictionary check."

msgid "pwd_TAINTED_PASSWORD"
msgstr "(en)The new password starts with invalid characters."

msgid "pwd_TAINTED_USER"
msgstr "(en)The account name \"%1\" contains invalid characters."

msgid "pwd_YOUR_ACCOUNT"
msgstr "Votre compte utilisateur:"
