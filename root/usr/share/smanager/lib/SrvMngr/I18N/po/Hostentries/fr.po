msgid "Hostnames and addresses"
msgstr "Gestion des noms d hôte et des adresses"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en) Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "L'adresse est comprise dans la plage d'allocation dynamique d'adresses DHCP."

msgid "hos_ADD_HOSTNAME"
msgstr "Ajouter un nom d'hôte"

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Créer ou modifier un nom d'hôte"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Liste actuelle des noms d'hôte pour le domaine local \"%1\" :"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Une erreur est survenue pendant la création du nom d'hôte."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Une erreur est survenue pendant la suppression du nom d'hôte."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Une erreur est survenue pendant la modification du nom d'hôte."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "ERREUR : l'adresse IP ne peut être celle du serveur ou de la passerelle."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "ERREUR : cette adresse IP n'appartient à aucun de vos réseaux locaux."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Adresse Ethernet"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "L'adresse Ethernet est facultative et permet au serveur DHCP d'attribuer une adresse IP fixe locale à l'ordinateur possédant cette adresse Ethernet. Si elle est spécifiée, elle doit être de la forme \"AA:BB:CC:DD:EE:FF\" et ne contenir que des chiffres entre 0 et 9 et des lettres entre A et F."

msgid "hos_FORM_TITLE"
msgstr "Gestion des noms d'hôte et des adresses"

msgid "hos_HOSTNAME"
msgstr "Nom d'hôte"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "ERREUR : caractères inattendus dans le nom d'hôte \"%1.%2\". Un nom d'hôte ne doit contenir que des lettres, des chiffres, des points, des virgules, des underscores, des traits d'union et doit commencer par une lettre ou un chiffre."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Le nom d'hôte ne doit contenir que des lettres, chiffres et traits d'union et commencer par une lettre ou un chiffre."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "ERREUR : le nom d'hôte \"%1\" ne peut être créé car il existe déjà un compte %2 avec ce nom."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "ERREUR : caractères inattendus dans le nom d'hôte \"%1.%2\". Un nom d'hôte ne doit contenir que des lettres, des chiffres et des traits d'union et doit commencer par une lettre ou un chiffre."

msgid "hos_HOSTTYPE"
msgstr "Emplacement"

msgid "hos_LOCAL_IP"
msgstr "Adresse IP locale"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "L'adresse IP locale est l'adresse IP d'une autre machine du réseau local. Veuillez taper une adresse IP valide de la forme \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Veuillez entrer les éléments supplémentaires suivants pour un hôte local :"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "(en) Modify hostname"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Veuillez entrer les éléments supplémentaires suivants pour un hôte distant :"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Vous êtes sur le point de supprimer le nom d'hôte \"%1.%2\".\n\n  <p><b>Voulez-vous vraiment supprimer ce nom d'hôte ?</b></p>\n\n  "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "(en) Remove hostname"

