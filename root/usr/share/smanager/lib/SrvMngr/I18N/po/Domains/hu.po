msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Domain hozzáadása"

msgid "dom_CONTENT"
msgstr "%1 Adattár"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "A weboldalhoz kiválaszthatja az elsődleges webhelyet, vagy bármely adattárat."

msgid "dom_CREATE_TITLE"
msgstr "Új domain létrehozása"

msgid "dom_CURRENT_DOMAINS"
msgstr "A domainek aktuális listája"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Ha ennek a szervernek nincs kapcsolata az Internethez, vagy különleges követelményei vannak a DNS névfeloldással kapcsolatban, írja be ide a külső DNS szerver IP címeit. Hagyja üresen ezeket a mezőket, ha nincs szüksége külső DNS szerverre. Nem kell ide beírnia az Internet szolgáltatója DNS címét sem, mivel ez a szerver enélkül is fel tudja oldani az internetes DNS neveket."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr " Vállalati DNS beállítások "

msgid "dom_DESC_NAMESERVERS"
msgstr "Beállíthatja, hogy ebben a domain-ben helyileg legyen a névfeloldás, át legyen adva egy vállalati DNS szervernek, vagy az Internet DNS szerverei végezzék a névfeloldást. Az alapértelmezett beállítás a legtöbb hálózat számára megfelelő. "

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Vállalati DNS-beállítások módosítása"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Hiba: Helytelen vagy hiányzó karakterek vannak a %1 domain leírásában. A domain nem jött létre."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Hiba: a %1 domain név már használatban van. A domain nem jött létre."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Hiba: Helytelen vagy hiányzó karakterek vannak a %1 domain névben. A domain név egy vagy több betűt, számokat, pontokat és kötőjeleket tartalmazhat. A domain nem jött létre."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Hiba: probléma a %1 domain eltávolításakor."

msgid "dom_FORM_DESCRIPTION"
msgstr " Amikor létrehoz egy új domain-t, a szerver képes lesz az arra a domain-re küldött levelek fogadására, valamint weboldalt közzéteni az adott domain alatt az Interneten.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Domain hozzáadása</a> "

msgid "dom_FORM_TITLE"
msgstr "Domain-ek kezelése"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Elsődleges vállalati DNS szerver"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Másodlagos vállalati DNS szerver"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Domain DNS szerverek"

msgid "dom_MODIFY_TITLE"
msgstr "Domain módosítása"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Hiba: A %1 nem létező domain név."

msgid "dom_PRIMARY_SITE"
msgstr "elsődleges webhely"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  Most készül eltávolítani a %1 (%2) nevű domain-t. \n\n  <p> <b>Biztos benne, hogy törölni akarja?</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Domain eltávolítása"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "A %1 domain sikeresen létrejött. A webszerver újraindul. A hivatkozások ezen a weboldalon nem működnek addig, míg az újraindítás be nem fejeződik."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Sikeresen törölte a %1 nevű domain-t. A webszerver most újraindul. A hivatkozások ezen a weboldalon nem működnek addig, míg az újraindítás be nem fejeződik."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Sikeresen módosította a %1 -nevű domain-t. A szerver most újraindul. A hivatkozások ezen a weboldalon nem működnek addig, míg az újraindítás be nem fejeződik."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Hiba: a %1 domain az ön rendszerének a domain neve. Nem hozhat létre új domaint ugyanezzel a névvel. A domain nem jött létre."

msgid "dom_corporate"
msgstr "Vállalati DNS szerver"

msgid "dom_internet"
msgstr "Internetes névfeloldás"

msgid "dom_localhost"
msgstr "Helyi névfeloldás"

