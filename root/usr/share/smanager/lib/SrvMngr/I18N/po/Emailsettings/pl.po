msgid "mai_DESC_STATE_RECEPTION_BUTTON"
msgstr "Zmień ustawienia odbioru wiadomości e-mail"

msgid "mai_DESC_UNKNOWN"
msgstr " Unknown Users Selecting Reject (recommended setting) will configure the server to only accept mail for valid email addresses (for example users, groups, pseudonyms). Mail for other addresses will be rejected. "

msgid "mai_DESC_VIRUS_SCAN"
msgstr "(en)You can scan incoming and outgoing e-mail for viruses. If scanning is enabled and a virus is detected, the e-mail will be rejected and returned to the sender."

msgid "mai_DESC_WEBMAIL"
msgstr "You can enable or disable webmail on this system. Webmail allows users to access their mail through a regular web browser by pointing the browser to https://%1/webmail, and logging in to their account."

