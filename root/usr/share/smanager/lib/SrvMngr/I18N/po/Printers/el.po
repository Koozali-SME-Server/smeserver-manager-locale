msgid "Printers"
msgstr "Εκτυπωτές"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "Πρόκειται να αφαιρέσετε τον εκτυπωτή:"

msgid "prt_ARE_YOU_SURE"
msgstr "Είστε σίγουροι ότι επιθυμείτε να αφαιρέσετε το συγκεκριμένο εκτυπωτή;"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "Επιτυχής δημιουργία εκτυπωτή:"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "Παρακαλώ εισάγετε τη διεύθυνση και την ονομασία του εκτυπωτή δικτύου"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "Δημιουργήστε έναν νέο εκτυπωτή δικτύου"

msgid "prt_CREATE_NEW_DESC"
msgstr "Παρακαλώ επιλέξτε μία μοναδική ονομασία για τον εκτυπωτή και εισάγετε μια σύντομη περιγραφή. Η ονομασία του εκτυπωτή πρέπει να περιέχει μόνο πεζά γράμματα και αριθμούς και να αρχίζει με πεζό γράμμα. Για παράδειγμα οι ονομασίες \"hplaser\", \"epsonlp\", καί \"canonbj\" αποτελούν έγκυρες επιλογές, ενώ οι \"HP Laser Jet\", \"Canon BubbleJet\", και \"HP JetDirect Printer\" όχι. Αποφύγετε ονομασίες και περιγραφές που περιλαμβάνουν τους ακόλουθους όρους \"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\", \"paper\", \"error\" και \"responding\"."

msgid "prt_CREATE_NEW_PRINTER"
msgstr "Δημιουργία νέου εκτυπωτή"

msgid "prt_CURRENT_LIST"
msgstr "Τρέχουσα λίστα εκτυπωτών"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "Επιτυχής διαγραφή του εκτυπωτή:"

msgid "prt_ERR_EXISTS"
msgstr "Σφάλμα: Υπάρχει λογαριασμός με την ίδια ονομασία και με τύπο:"

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "Σφάλμα: εσωτερική αποτυχία κατά την αφαίρεση του εκτυπωτή:"

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "Σφάλμα: μη-έγκυρη δικτυακή διεύθυνση. Δεν δημιουργήθηκε νέος εκτυπωτής."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "Σφάλμα: μη-έγκυρο όνομα εκτυπωτή δικτύου. Δεν δημιουργήθηκε νέος εκτυπωτής."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "Σφάλμα: μη-αναμενόμενοι ή ελλείποντες χαρακτήρες στην περιγραφή. Δεν δημιουργήθηκε νέος εκτυπωτής."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr " Σφάλμα: μη-αναμενόμενοι χαρακτήρες στην ονομασία εκτυπωτή.\n\n  <p>Η ονομασία του εκτυπωτή πρέπει να περιέχει μόνο πεζά γράμματα και αριθμούς και να αρχίζει με πεζό γράμμα. Για παράδειγμα οι ονομασίες \"hplaser\", \"epsonlp\", καί \"canonbj\" αποτελούν έγκυρες επιλογές.</p>\n\n  "

msgid "prt_FIRST_USB_PRINTER"
msgstr "Πρώτος εκτυπωτής συνδεδεμένος σε USB"

msgid "prt_FORM_TITLE"
msgstr "Προσθήκη ή διαγραφή εκτυπωτών"

msgid "prt_HOSTNAME_OR_IP"
msgstr "Δικτυακή ονομασία ή IP διεύθυνση του εκτυπωτή δικτύου"

msgid "prt_INITIAL_BTN"
msgstr "Προσθήκη εκτυπωτή"

msgid "prt_LOCAL_PRINTER_0"
msgstr "Τοπική θύρα εκτυπωτή 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "Τοπική θύρα εκτυπωτή 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "Τοπική θύρα εκτυπωτή 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "Πρέπει να είναι μία έγκυρη δικτυακή ονομασία ή διεύθυνση IP"

msgid "prt_NET_PRINTER"
msgstr "Εκτυπωτής δικτύου ..."

msgid "prt_NO_PRINTERS"
msgstr "Δεν υπάρχουν εκτυπωτές στο σύστημα."

msgid "prt_PRINTER_NAME"
msgstr "Ονομασία εκτυπωτή"

msgid "prt_REMOTE_ADDRESS"
msgstr "Απομακρυσμένη διεύθυνση"

msgid "prt_REMOTE_NAME"
msgstr "Απομακρυσμένη ονομασία"

msgid "prt_REMOTE_NAME_DESC"
msgstr " Ονομασία εκτυπωτή δικτύου (εάν δεν είστε σίγουροι, εισάγετε raw) "

msgid "prt_REMOVE_PRINTER"
msgstr "Αφαίρεση εκτυπωτή"

msgid "prt_SECOND_USB_PRINTER"
msgstr "Δεύτερος εκτυπωτής συνδεδεμένος σε USB"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "Όλα τα αρχεία εκτυπώσεων για το συγκεκριμένο εκτυπωτή θα διαγραφούν."

