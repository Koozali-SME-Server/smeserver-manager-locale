msgid "Reboot or shutdown"
msgstr "(en) Reboot or shutdown"

msgid "rbo_DESCRIPTION"
msgstr " Você pode reiniciar ou desligar seu servidor dessa tela. Você tem que desligar o software linux do servidor antes de desligar o computador. Mas ao mandar o linux desligar, pode ser que o equipamento já seja desligado na sequência. Ambas as funções levam vários minutos para completar. Quando você clicar em executar a operação irá iniciar imediatamente, então esteja pronto! "

msgid "rbo_DESC_REBOOT"
msgstr "Seu servidor iniciou o processo de reinicialização."

msgid "rbo_DESC_RECONFIGURE"
msgstr "Seu servidor está fazendo uma reconfiguração completa do sistema e após terminar fará um reboot."

msgid "rbo_DESC_SHUTDOWN"
msgstr "Seu servidor iniciou o processo de desligamento. O processo levará alguns minutos para completar, depois você poderá desligar o computador. Ou este poderá já ser desligado automaticamente pelo processo."

msgid "rbo_FORM_TITLE"
msgstr "Desligar ou reiniciar"

msgid "rbo_LABEL_REBOOT"
msgstr "Selecione Desligar, Reiniciar ou Reconfigurar"

msgid "rbo_REBOOT"
msgstr "Reiniciar"

msgid "rbo_REBOOT_SUCCEEDED"
msgstr "Reinicialização iniciada com sucesso."

msgid "rbo_RECONFIGURE_SUCCEEDED"
msgstr "Pedido de reconfiguração iniciado com sucesso."

msgid "rbo_SHUTDOWN_SUCCEEDED"
msgstr "(en) Shutdown request initiated successfully."

