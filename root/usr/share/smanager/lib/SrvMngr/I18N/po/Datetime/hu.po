msgid "dat_INITIAL_DESC"
msgstr "Itt állíthatja be a dátumot és az időt a szerveren. Használhat egy létező hálózati időszervert, vagy manuálisan állítsa be a dátumot, az időt és az időzónát."

msgid "dat_INVALID_HOUR"
msgstr "Hiba: helytelenül megadott óra"

msgid "dat_INVALID_MINUTE"
msgstr "Hiba: helytelenül megadott perc"

msgid "dat_INVALID_NTP_SERVER"
msgstr " Érvénytelen NTP szerver. A szervernem fog szinkronizálni a távoli időszerverrel. "

msgid "dat_INVALID_SECOND"
msgstr "Hiba: helytelenül megadott másodperc"

msgid "dat_Invalid_date"
msgstr "Érvénytelen dátum"

msgid "dat_NTP_CONFIGURE_DESC"
msgstr "A szerver rendszeresen szinkronizálja a rendszerórát az alább megadott időszerverrel. Ha másik NTP időszervert kíván használni, adja meg annak hálózatnevét, vagy IP címét az alábbi mezőben."

msgid "dat_NTP_DISABLE_DESC"
msgstr "Válassza ezt az opciót, ha le akarja állítani a rendszeróra szinkronizálását az NTP szerverrel. Ha az NTP szolgáltatás le van tiltva, ezen az oldalon állíthatja be manuálisan a rendszeridőt."

msgid "dat_NTP_ENABLE_DESC"
msgstr "A szerver időközönként szinkronizálni tudja az óráját egy hálózati időszerverrel (NTP). Ha kiválasztja ezt az opciót, akkor adja meg az időszerver hálózatnevét, vagy IP címét."

msgid "dat_NTP_Server_URL"
msgstr "NTP-kiszolgáló URL-címe:"

msgid "dat_SETTINGS_CHANGED"
msgstr "Hálózati időszerver sikeresen beállítva"

