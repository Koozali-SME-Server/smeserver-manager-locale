msgid "Directory"
msgstr "(en) Directory"

msgid "dir_CITY"
msgstr "Linn vaikimisi"

msgid "dir_COMPANY"
msgstr "Allasutus vaikimisi"

msgid "dir_DEPARTMENT"
msgstr "Asutus vaikimisi"

msgid "dir_DESCRIPTION"
msgstr "The LDAP server provides a network-available listing of the user accounts and groups on your server, and can be accessed using an LDAP client such as the Address Book feature in Netscape Communicator. Configure your LDAP client with the local IP address of your server, port number 389, and the server root parameter shown below."

msgid "dir_DESC_DEPARTMENT"
msgstr "Need väljad on asutuse LDAP vaikimisi seaded. Kui sa lisad uut kasutajat siis palutakse täita kõik need väljad (need võivad igal kasutajal erinevad olla) kuid väärtused mis sa siin määrad näidatakse vaikimis seadetena, et oleks lihtsam kasutajate lisamine."

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr "Sa saad kontrollida oma LDAP kataloogile juurdepääsu. Privaatne juurdepääs lubab juurdepääsu lokaalvõrgust ja avalik juurdepääs lubab juurdepääsu üle interneti."

msgid "dir_DESC_EXISTING"
msgstr "Võid olemasolevad kasutajad jätta nii nagu on ja vaikimisi seaded rakendada uute kasutajate jaoks või muuta vaikimisi seadeid kõikidel kasutajatel."

msgid "dir_DIRECTORY_ACCESS"
msgstr "LDAP kataloogi juurdepääs"

msgid "dir_EXISTING"
msgstr "Olemasolevad kasutajad"

msgid "dir_FORM_TITLE"
msgstr "Muuda LDAP kataloogi seadeid"

msgid "dir_LABEL_ROOT"
msgstr "Serveri root"

msgid "dir_LEAVE"
msgstr "Jäta nii nagu on"

msgid "dir_PHONENUMBER"
msgstr "Telefon vaikimisi"

msgid "dir_STREET"
msgstr "Tänav vaikimisi"

msgid "dir_SUCCESS"
msgstr "Uued LDAP vaikimisi seaded on edukalt salvestatud."

msgid "dir_UPDATE"
msgstr "Rakenda kõikidele vaikimisi seaded"
