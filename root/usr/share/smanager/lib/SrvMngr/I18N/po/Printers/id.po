msgid "Printers"
msgstr "Printer"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "Anda akan menghapus printer:"

msgid "prt_ARE_YOU_SURE"
msgstr "Anda yakin menghapus printer ini?"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "Berhasil membuat printer:"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "Isi alamat dan nama printer jaringan"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "Tambah printer network"

msgid "prt_CREATE_NEW_DESC"
msgstr "Pilih nama yang unik untuk printer dan masukkan keterangan singkat. Nama printer hanya boleh terdiri dari huruf kecil dan angka, dan harus dimulai dengan huruf kecil. Contoh: \"hplaser\", \"epsonlp\", dan \"canonbj\" adalah pilihan yang benar, tapi \"HP Laser Jet\", \"Canon BubbleJet\", dan \"HP JetDirect Printer\" adalah salah. Nama dan keterangan tidak boleh mengandung kata: \"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\", \"paper\", \"error\" dan \"responding\"."

msgid "prt_CREATE_NEW_PRINTER"
msgstr "Tambah printer"

msgid "prt_CURRENT_LIST"
msgstr "Daftar Printer"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "Berhasil menghapus printer:"

msgid "prt_ERR_EXISTS"
msgstr "Error: Akun sudah ada dengan jenis:"

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "Error: gagal saat menghapus printer:"

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "Error: alamat network salah. Tidak membuat printer baru."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "Error: nama printer network salah. Tidak membuat printer baru."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "Error: terdapat karakter yang tidak dibolehkan atau hilang pada keterangan. Tidak menambah printer."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr " Error: terdapat karakter yang tidak dibolehkan pada nama printer.\n\n  <p>Nama printer hanya boleh terdiri dari huruf kecil dan angka, dan harus dimulai dengan huruf kecil. contoh \"hplaser\", \"epsonlp\", and \"canonbj\" adalah nama yang valid.</p>\n\n  "

msgid "prt_FIRST_USB_PRINTER"
msgstr "Printer terpasang pada USB pertama"

msgid "prt_FORM_TITLE"
msgstr "Tambah atau hapus printer"

msgid "prt_HOSTNAME_OR_IP"
msgstr "Hostname atau alamat IP printer jaringan"

msgid "prt_INITIAL_BTN"
msgstr "Tambahkan printer"

msgid "prt_LOCAL_PRINTER_0"
msgstr "Printer lokal port 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "Printer lokal port 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "Printer lokal port 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "Harus hostname atau alamat IP yang valid"

msgid "prt_NET_PRINTER"
msgstr "Printer jaringan ..."

msgid "prt_NO_PRINTERS"
msgstr "Tidak ada printer dalam sistem"

msgid "prt_PRINTER_NAME"
msgstr "Nama Printer"

msgid "prt_REMOTE_ADDRESS"
msgstr "Alamat remote"

msgid "prt_REMOTE_NAME"
msgstr "Nama remote"

msgid "prt_REMOTE_NAME_DESC"
msgstr " Nama printer jaringan (isikan raw jika tidak yakin) "

msgid "prt_REMOVE_PRINTER"
msgstr "Hapus printer"

msgid "prt_SECOND_USB_PRINTER"
msgstr "Printer terpasang pada USB kedua"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "Semua file antrian untuk printer ini akan dihapus"

