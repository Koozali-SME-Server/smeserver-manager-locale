msgid "Local networks"
msgstr "Lokale nettverk"

msgid "ln_ADD_DESC"
msgstr " Hvert parameter må være i formatet #.#.#.# (hver # er et nummer fra 0 til 255). Server programvaren vil nulle ut enden (maskin identifikator) delen av nettverk adressen i henhold til subnet masken, for å forsikre at nettverk adressen er gyldig.  \"Ruter\" bør være IP adressen til ruteren på ditt lokale nettverk som det ekstra nettverket kan nås. "

msgid "ln_ADD_TITLE"
msgstr "Legg til et lokalt nettverk"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "En feil oppsto under opprettelse av nettverk."

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "En feil oppsto under sletting av nettverk. "

msgid "ln_FIRSTPAGE_DESC"
msgstr " Av sikkerhetsmessige grunner er flere av tjenestene på serveren bare tilgjenglig på det lokale nettverket. Imidlertid kan du gi rettigheter for disse til flere nettverk ved å oppgi nettverkene nedenfor. De fleste installasjoner kan la listen være tom. Legg til nettverk "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "Ugyldig IP-adresse"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Ugyldig lokal subnettmaske"

msgid "ln_LOCAL NETWORKS"
msgstr "Lokale nettverk"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Legg til nettverk"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "Feil: nettverket [_1] (avledet fra nettverket [_2] og subnettmasken [_3]) er allerede lagt til. Nettverket ble ikke lagt til."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "Feil: nettverket [_1] (avledet fra nettverket [_2] og subnettmasken [_3])"

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "Feil: ruter adressen [_1] er ikke tilgjenglig fra det lokale nettverket. nettverket ble ikke lagt til."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Antall maskiner"

msgid "ln_REMOVE_DESC"
msgstr "Du er i ferd med å fjerne følgende lokale nettverk."

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "Lokale maskiner er satt opp på nettverket som du er i ferd med å fjerne. Som standard blir også disse fjernet. Hvis du av en eller annen grunn ikke vil fjerne disse fjerner du merket her. Merk at disse etterpå ikke vil bli sett på som lokale maskiner, og vil muligens ikke være tilgjenglige etter at nettverket er slettet."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "Fjern maskiner på nettverket"

msgid "ln_REMOVE_TITLE"
msgstr "Fjerne lokalt nettverk"

msgid "ln_SUBNET_MASK"
msgstr "Subnett maske"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "Nettverket[_1]/[_2] lagt til via router [_3].Serveren din vil gi lokale privilegier til den [_4] IP adressene i området [_5][_6] to [_7]."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "  Nettverket [_1]/[_2] lagt til via router [_3].Serveren din vil gi lokale privilegier til den [_4] IP adressene i området [_5] [_6] to [_7].\n\n  <p> Advarsel: ProFTPd FTP serveren kan ikke håndtere ikke standardiserte subnetmasker. Den enklere spesifikasjonen<b>[_1]</b> blir brukt isteden. </p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "Nettverket [_1]/[_2] lagt til via router [_3]."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "Nettverket [_1]/[_2] lagt til via router [_3].Serveren din vil gi lokale privilegier til den enkle IP adressen [_4]."
