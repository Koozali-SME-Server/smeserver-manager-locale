#. Port forwarding
msgid "Port forwarding"
msgstr ""

#. Allow Hosts
msgid "pf_ALLOW_HOSTS"
msgstr ""

#. Create portforwarding rule
msgid "pf_CREATE_RULE"
msgstr ""

#. This does not appear to be a valid IP address list.\n            ie: 192.168.0.1,192.168.1.1/24
msgid "pf_ERR_BADAHOST"
msgstr ""

#. This does not appear to be an IP address. You must use\n        dotted-quad notation, and each of the four numbers should be less\n        than 256. ie: 192.168.0.5
msgid "pf_ERR_BADIP"
msgstr ""

#. The ports must be a positive integer less than 65536.
msgid "pf_ERR_BADPORT"
msgstr ""

#. Event returned a non-zero return value.
msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr ""

#. ERROR: This port or port range conflicts with an existing\n            rule. Please modify this new rule, or remove the old rule.
msgid "pf_ERR_PORT_COLLISION"
msgstr ""

#. You can use this panel to modify your firewall rules so\n                as to open a specific port on this server and forward it\n                to another port on another host.  Doing so will permit\n                incoming traffic to directly access a private host on\n                your LAN.\n                WARNING: Misuse of this feature can seriously compromise the\n                security of your network. Do not use this feature\n                lightly, or without fully understanding the implications\n                of your actions.
msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr ""

#. Configure Port Forwarding
msgid "pf_FORM_TITLE"
msgstr ""

