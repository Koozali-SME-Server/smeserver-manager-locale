msgid "LOG_LIVESTREAM"
msgstr "(en) Live stream"

msgid "log_END_DESC"
msgstr "Notă: este posibil ca generarea raportului să dureze câteva minute."

msgid "log_ERR_NOEXIST_FILE"
msgstr "(en) Err noexist file"

msgid "log_ERR_NOOPEN_FILE"
msgstr "(en) Err noopen file"

msgid "log_FILENAME_ERROR"
msgstr " Eroare în numele fișierului de log.\n\n  <p>Tip de raport invalid \"[_1]\".</p>\n\n  "

msgid "log_FILTER_PATTERN_DESC"
msgstr " Puteți opta pentru un anume model de filtru în fișierul de evidență, numai liniile ce au modelul impus vor fi afișate . Dacă nu completați nimic toate înregistrările din fișierul de evidență vor fi afișate. Luați aminte că această opțiune nu este utilizată daca optați pentu tranferul fișierului.\n\n  "

msgid "log_FILTER_PATTERN_HINT"
msgstr "(en) The pattern is case insensitive, but enclosing it in \"/\" will result in it being treated as a regex."

msgid "log_FILTER_PATTERN_LABEL"
msgstr "Model filtru (opțional)"

msgid "log_FIRSTPAGE_DESC"
msgstr "Acest panou vă permite să vizualizați sau descărcați fișierele de log generate de server. "

msgid "log_FORM_TITLE"
msgstr "Vizualizați fișierele jurnal"

msgid "log_HIGHLIGHT_HEADER"
msgstr "Ingrosare linii conforme: \"[_1]\"."

msgid "log_LOG_FILE_EMPTY"
msgstr "Fișierul de log \"[_1]\" este gol!"

msgid "log_LOG_FILE_SELECT_DESC"
msgstr "Alege un fișier de evidență"

msgid "log_MATCH_HEADER"
msgstr "Listare linii conforme filtru: \"[_1]\"."

msgid "log_MATCH_PATTERN_DESC"
msgstr " Puteți specifica opțional un filtru ce va fi adus in atenție prin ingroșarea liniilor din log ce vor fi conforme filtrului. Filtrul va fi aplicat oricărei linii din log ce a fost identificata ca conformă. Notă: această opțiune nu se aplică la descărcarea logului.\n\n  "

msgid "log_MATCH_PATTERN_LABEL"
msgstr "Filtru de evidențiere (opțional) "

msgid "log_NO_MATCHING_LINES"
msgstr "Nici o linie nu e conforma cu filtrul."

msgid "log_OP_DESC"
msgstr " Trebuie să alegeți intre vizualizarea pe monitor sau descărcare pe computer. Dacă fișierul de log este foarte mare, probabil că doriți să îl descărcați decât să îl vizualizați direct, deoarece poate crea probleme unor browsere de internet.\n\n  "

msgid "log_OP_LABEL"
msgstr "Operație"

msgid "log_REFRESH"
msgstr "Actualizează acest fisier de log."

msgid "log_VIEW"
msgstr "Vizualizează log"

msgid "log_VIEWING_TIME"
msgstr "Vizualizat la [_1]."

