msgid "Local networks"
msgstr "Kohalikud võrgud"

msgid "ln_ADD_DESC"
msgstr "(en)Each parameter must be in the form #.#.#.# (each # is a number from 0 to 255). The server software will zero out the ending (host identifier) part of the network address according to the subnet mask, to ensure that the network address is valid.  \"Router\" should be the IP address of the router on your local network via which the additional network is reached."

msgid "ln_ADD_TITLE"
msgstr "Lisa lokaalne võrk"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "Võrgu loomisel ilmnes viga."

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "Võrgu kustutamisel ilmnes viga."

msgid "ln_FIRSTPAGE_DESC"
msgstr " Turvalisuse tagamiseks on mõned teenused kättesaadvad ainult kohtvõrgus. Kui soovid teenuseid ja juurdepääsu teha kättesaadvaks ka mõnes teises võrgus, siis lisa need siia. Tavaliselt jäetakse see täiendamata. Lisa võrk "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "Sobimatu IP aadress"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Sobimatu subnet mask"

msgid "ln_LOCAL NETWORKS"
msgstr "Kohalikud võrgud"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Lisa võrk"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "Error: network [_1] (derived from network [_2] and subnet mask [_3]) has already been added. Did not add new network."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "Error: network [_1] (derived from network [_2] and subnet mask [_3]) is already considered local. Did not add new network."

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "Viga: ruuteri aadress [_1] pole kohtvõrgust kättesaadav. Võrku ei lisatud."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Hostide arv"

msgid "ln_REMOVE_DESC"
msgstr "Oled kindel, et tahad seda võrku kustutada."

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "(en)Local hosts configured on the network you are about to remove have been detected. By default, they will also be removed. Uncheck this box if, for some reason, you do not wish this to happen. Note that they will not be treated as local, and may not even be reachable, after this network is removed."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "Eemalda võrgust hoste"

msgid "ln_REMOVE_TITLE"
msgstr "Eemalda lokaalne võrk"

msgid "ln_SUBNET_MASK"
msgstr "Alamvõrgu mask"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "(en)Successfully added network [_1]/[_2] via router [_3]. Your server will grant local access privileges to [_4] IP addresses in the range [_5] to [_6]."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "  Successfully added network [_1]/[_2] via router [_3]. \n\n  <p> Your server will grant local access privileges to [_1] IP addresses in the range [_2] to [_3]. </p>\n\n  <p> Warning: the ProFTPd FTP server cannot handle this nonstandard subnet mask. The simpler specification <b>[_1]</b> will be used instead. </p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "Kustutati järgmine võrk [_1]/[_2] via router [_3]."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "Lisati järgmine võrk [_1]/[_2] via router [_3]. Your server will grant local access privileges to the single IP address [_4]."
