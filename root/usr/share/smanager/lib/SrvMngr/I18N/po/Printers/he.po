msgid "Printers"
msgstr "מדפסות"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "(en)You are about to remove the printer:"

msgid "prt_ARE_YOU_SURE"
msgstr "(en)Are you sure you wish to remove this printer?"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "המדפסת נוצרה בהצלחה:"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "(en)Please enter the address and name of the network printer"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "צור מדפסת רשת חדשה"

msgid "prt_CREATE_NEW_DESC"
msgstr "(en)Please choose a unique name for the printer and enter a brief description. The printer name should contain only lower-case letters and numbers, and should start with a lower-case letter. For example \"hplaser\", \"epsonlp\", and \"canonbj\" are valid choices, but \"HP Laser Jet\", \"Canon BubbleJet\", and \"HP JetDirect Printer\" are not. Avoid names and descriptions that contain these terms, \"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\", \"paper\", \"error\" and \"responding\"."

msgid "prt_CREATE_NEW_PRINTER"
msgstr "צור מדפסת חדשה"

msgid "prt_CURRENT_LIST"
msgstr "רשימת המדפסות הנוכחית"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "המדפסת נמחקה בהצלחה:"

msgid "prt_ERR_EXISTS"
msgstr "(en)Error: An account with the same name exists with type:"

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "(en)Error: internal failure while removing printer:"

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "(en)Error: invalid network address. Did not create new printer."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "(en)Error: invalid network printer name. Did not create new printer."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "(en)Error: unexpected or missing characters in description. Did not create new printer."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr " Error: unexpected characters in printer name. The printer name should contain only lower-case letters and numbers, and should start with a lower-case letter. For example \"hplaser\", \"epsonlp\", and \"canonbj\" are valid names. "

msgid "prt_FIRST_USB_PRINTER"
msgstr "מדפסת ה-USB הראשונה שמחוברת"

msgid "prt_FORM_TITLE"
msgstr "הוסף או הסר מדפסות"

msgid "prt_HOSTNAME_OR_IP"
msgstr "(en)Hostname or IP address of the network printer"

msgid "prt_INITIAL_BTN"
msgstr "הוסף מדפסת"

msgid "prt_LOCAL_PRINTER_0"
msgstr "יציאת מדפסת מקומית 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "יציאת מדפסת מקומית 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "יציאת מדפסת מקומית 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "יש להזין כתובת מארח או כתובת IP תקפה"

msgid "prt_NET_PRINTER"
msgstr "מדפסת רשת..."

msgid "prt_NO_PRINTERS"
msgstr "(en)There are no printers in the system."

msgid "prt_PRINTER_NAME"
msgstr "שם המדפסת"

msgid "prt_REMOTE_ADDRESS"
msgstr "כתובת מרוחקת"

msgid "prt_REMOTE_NAME"
msgstr "שם מרוחק"

msgid "prt_REMOTE_NAME_DESC"
msgstr "(en)Network printer name (enter raw if not sure)"

msgid "prt_REMOVE_PRINTER"
msgstr "הסר מדפסת"

msgid "prt_SECOND_USB_PRINTER"
msgstr "מדפסת שנייה המחוברת ב-USB"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "(en)All the spool files for this printer will be deleted."

