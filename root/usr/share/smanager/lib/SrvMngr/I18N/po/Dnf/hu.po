msgstr "Naponta"

msgid "yum_2WEEKLY"
msgstr "Hetente"

msgid "yum_3MONTHLY"
msgstr "Havonta"

msgid "yum_AutoInstallUpdates"
msgstr "(en) Autoinstallupdates"

msgid "yum_BUTTON_CONFIGURATION"
msgstr "Szoftvertelepítő beállításainak módosítása"

msgid "yum_BUTTON_INSTALL_AVAILABLE"
msgstr "További szoftver telepítése"

msgid "yum_BUTTON_INSTALL_UPDATES"
msgstr "Elérhető frissítések listázása"

msgid "yum_BUTTON_REMOVE"
msgstr "Telepített szoftver eltávolítása"

msgid "yum_DESC_AVAILABLE_GROUPS"
msgstr "Az alábbi listában kiválaszthatja telepítésre a szoftvercsoportokat."

msgid "yum_DESC_AVAILABLE_PACKAGES"
msgstr "Az alábbi listában egyedi szoftvercsomagokat is kiválaszthat telepítésre."

msgid "yum_DESC_AVAILABLE_UPDATES"
msgstr "Az alábbi frissítések érhetők el az ön rendszeréhez. Ajánlatos az összes frissítést telepíteni. Ha vannak olyan frissítések, amelyeket nem akar telepíteni, akkor azokról vegye le a bejelölést az alábbi listában."

msgid "yum_DESC_ENABLED_REPOSITORIES"
msgstr "A szoftver telepítő bármelyik engedélyezett tárolóból tud szoftvert telepíteni. Egy tároló engedélyezéséhez jelölje azt be a listában. Tároló letiltásához távolítsa el a bejelölést. Alapesetben csak stabil, tesztelt szoftver érhető el a telepítéshez."

msgid "yum_DESC_INSTALLED_GROUPS"
msgstr "Az alábbi listában kiválaszthatja az eltávolításra szánt szoftvercsoportokat."

msgid "yum_DESC_INSTALLED_PACKAGES"
msgstr "Az alábbi listában egyedi szoftvercsomagokat is kiválaszthat eltávolításra."

msgid "yum_DESC_UPDATES_AVAILABLE"
msgstr "Frissítések érhetők el az ön rendszeréhez. Ajánlatos minél előbb telepíteni ezeket a frissítéseket."

msgid "yum_DESC_UPTODATE"
msgstr "Minden frissítés telepítve van."

msgid "yum_DESC_YUM_AUTOINSTALLUPDATES"
msgstr "(en)If enabled this will take precedence over the simple check for updates notification and predownload features. Instead it will install the available updates from enabled repositories. For more information refer to yum and yum-cron manual page."

msgid "yum_DESC_YUM_DELTARPMPROCESS"
msgstr "(en)A deltarpm contains the difference between an old and a new version of a rpm, which can save bandwith. The drawback is that update operations consume considerably more CPU cycles"

msgid "yum_DESC_YUM_PACKAGEFUNCTIONS"
msgstr "A szoftver telepítő egyedi csomagokat vagy összetartozó csomagok csoportjait tudja kezelni. Alapesetben csak a csomagcsoportok látszanak. Ha egyedi csomagokat szeretne kezelni, engedélyezze ezt az opciót. Ez csak tapasztalt rendszergazdáknak ajánlott."

msgid "yum_DeltaRpmProcess"
msgstr "(en) Deltarpmprocess"

msgid "yum_DownloadOnly"
msgstr "(en) Downloadonly"

msgid "yum_ERROR_UPDATING_CONFIGURATION"
msgstr "(en) Error updating configuration"

msgid "yum_FORM_TITLE"
msgstr "Szoftvertelepítő"

msgid "yum_HEADER_AVAILABLE_SOFTWARE"
msgstr "A következő szoftvert lehetősége van telepíteni a rendszerére. Csak akkor telepítsen további szoftvereket a rendszerre, ha tisztában van a következményekkel."

msgid "yum_HEADER_INSTALLED_SOFTWARE"
msgstr "A következő szoftvert feltelepült a rendszerére. Csak akkor távolítson el szoftvereket a rendszeréről, ha tisztában van a következményekkel."

msgid "yum_HEADER_POSTUPGRADE_REQUIRED"
msgstr " A rendszernek újrakonfigurálásra van szüksége miután programokat telepített, vagy eltávolított, vagy a frissítések telepítése után. <p> Kérem kattintson az Újrakonfigurálás gombra a lap alján, hogy elinduljon az újrakonfigurálási folyamat. <b>Az újrakonfigurálási folyamat részeként a szerver újra fog indulni</b> </p> "

msgid "yum_INSTALL_SOFTWARE"
msgstr "Telepítés"

msgid "yum_INSTALL_UPDATES"
msgstr "Kiválasztott frissítések telepítése"

msgid "yum_LABEL_AVAILABLE_GROUPS"
msgstr "Elérhető csoportok"

msgid "yum_LABEL_AVAILABLE_PACKAGES"
msgstr "Elérhető szoftvercsomagok"

msgid "yum_LABEL_AVAILABLE_UPDATES"
msgstr "Frissítések érhetők el"

msgid "yum_LABEL_ENABLED_REPOSITORIES"
msgstr "Engedélyezett tárolók"

msgid "yum_LABEL_INSTALLED_GROUPS"
msgstr "Telepített szoftvercsoportok"

msgid "yum_LABEL_INSTALLED_PACKAGES"
msgstr "Telepített csomagok"

msgid "yum_LABEL_YUM_AUTOINSTALLUPDATES"
msgstr "Automatikusan telepítse a frissítéseket"

msgid "yum_LABEL_YUM_DELTARPMPROCESS"
msgstr "Delta Rqm frissítés"

msgid "yum_LABEL_YUM_DOWNLOADONLY"
msgstr "Frissítések előtöltése"

msgid "yum_LABEL_YUM_DOWNLOADONLY_DESCRIPTION"
msgstr "(en)The rpm updates can be downloaded during the night, this will ease and give faster the dnf update process (only enabled repositories will be used)."

msgid "yum_LABEL_YUM_PACKAGEFUNCTIONS"
msgstr "Egyedi csomagok kezelése"

msgid "yum_LABEL_YUM_STATUS"
msgstr "Frissítések keresése"

msgid "yum_MULTI_SELECT"
msgstr "(en) <strong>Ctrl/Cmd-click</strong> toggles individual items and <strong>Shift-click</strong> selects ranges.\n<br /><strong>Case-insensitive</strong> search unless you enter a <strong>regex</strong> in <i>/pattern/flags</i> form (e.g. /maria.*client/i).."

msgid "yum_Please_Wait_-_dnf_Running"
msgstr "Kérjük, várjon – a dnf fut"

msgid "yum_SUCCESS"
msgstr "Az új beállítások lementődtek."

msgid "yum_UPDATE_SUCCESS"
msgstr "(en)The requested changes have been successfully implemented."

msgid "yum_check4updates"
msgstr "(en) Check4updates"

