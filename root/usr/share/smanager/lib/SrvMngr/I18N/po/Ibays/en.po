msgid "iba_ACCOUNT_EXISTS"
msgstr "The account \"%1\" is an existing %2 account."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr "The account \"%1\" clashes with pseudonym\ndetails for %2 account \"%3\".\n%1 is a pseudonym for %2."

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "The i-bay name \"%1\" contains invalid characters.\nI-bay names must start with a lower case letter and contain\nonly lower case letters, numbers, and hyphens."

msgid "iba_ADD_IBAY"
msgstr "Add i-bay"

msgid "iba_ADD_TITLE"
msgstr "Create or modify an i-bay"

msgid "iba_ALLOW_DYNAMIC_CONTENT"
msgstr "Execution of dynamic content (CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "Can't create new account for %1 (does it already exist?)"

msgid "iba_CANT_FIND_IBAY"
msgstr "Can't find account for %1 (does it exist?)"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "Entire Internet (no password required)"

msgid "iba_ENTIRE_INTERNET_PASSWORD"
msgstr "Entire Internet (password required)"

msgid "iba_ENTIRE_INTERNET_PASSWORD_REMOTE"
msgstr "Entire Internet (password required outside local network)"

msgid "iba_ERROR_WHILE_CREATING_IBAY"
msgstr "An error occurred while creating the i-bay."

msgid "iba_ERROR_WHILE_DELETING_IBAY"
msgstr "An error occurred while deleting the i-bay."

msgid "iba_ERROR_WHILE_MODIFYING_IBAY"
msgstr "An error occurred while modifying the i-bay."

msgid "iba_ERROR_WHILE_RESETTING_PASSWORD"
msgstr "Error while resetting password."

msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "You can remove any information bay or reset its password by\nclicking on the corresponding command\nnext to the information bay. If the information bay shows up\nin red, that means that the password has not\nyet been changed from the default, and should be changed\nsoon."

msgid "iba_FORM_TITLE"
msgstr "Create, modify, or remove i-bays"

msgid "iba_HTTPS_Only"
msgstr "Force secure connections"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "The passwords do not match."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Local network (no password required)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "Local network (password required)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "The i-bay name \"%1\" is too long. The maximum is \n%2 characters."

msgid "iba_NAME_FIELD_DESC"
msgstr "The information bay name should contain only lower-case\nletters, numbers, periods, hyphens and underscores, and\nshould start with a lower-case letter. For example\n\"johnson\", \"intra\", and \"cust3.prj12\" are all valid\nnames, but \"3associates\", \"John Smith\" and\n\"Bus!Partner\" are not. The name is limited to %1 characters."

msgid "iba_NAME_LABEL"
msgstr "Information bay name"

msgid "iba_NONE"
msgstr "No access"

msgid "iba_NO_IBAYS"
msgstr "There are no i-bays currently configured."

msgid "iba_PASSWORD_DESC"
msgstr "You are about to change the password for the i-bay %1."

msgid "iba_PUBLIC_ACCESS"
msgstr "Public access via web or anonymous ftp"

msgid "iba_REMOVE_DESC"
msgstr "You are about to remove the information bay %1 (%2).\nAll files belonging to this information bay will be deleted.\nAre you sure you wish to remove this information bay?"

msgid "iba_REMOVE_TITLE"
msgstr "Remove information bay"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "Successfully created i-bay."

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "Successfully deleted i-bay."

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "Successfully modified i-bay."

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "Successfully reset password."

msgid "iba_USER_ACCESS"
msgstr "User access via file sharing or user ftp"

msgid "iba_VHOST_MESSAGE"
msgstr "The following virtual domains were using this information bay \nas their content and will be changed to the primary web site \n(you can change them to something else afterward):"

msgid "iba_WARG"
msgstr "Write = admin, Read = group"

msgid "iba_WGRE"
msgstr "Write = group, Read = everyone"

msgid "iba_WGRG"
msgstr "Write = group, Read = group"
