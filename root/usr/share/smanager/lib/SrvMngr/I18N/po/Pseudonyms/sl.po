msgid "pse_VALID_PSEUDONYM_NAMES"
msgstr " Vzdevek lahko vsebuje samo male crke, stevilke, pike in podcrtaje in se mora zaceti z malo crko ali stevilko. Na primer \"prodaja\", \"marjan.glavni\", \"123\" in \"eposta-administrator\" so vse pravilni vzdevki. Vzdevki Marjan Glavni in Streznik Zavse pa niso pravilni. "
