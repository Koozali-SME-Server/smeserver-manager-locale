msgid "dat_NTP_CONFIGURE_DESC"
msgstr "De server synchroniseert de systeemklok periodiek met het netwerk tijd server protocol (NTP) hieronder weergegeven. Om te synchroniseren met een andere NTP server, vul dan een andere hostnaam of IP adres in het veld hieronder in."

msgid "dat_NTP_DISABLE_DESC"
msgstr "Kies deze optie als u wil stoppen met synchroniseren met de NTP server. Als de NTP dienst gedeactiveerd is kan u de syteemdatum en tijd manueel instellen vanaf deze pagina."

msgid "dat_NTP_ENABLE_DESC"
msgstr "De server kan periodiek de systeemklok synchroniseren met een netwerk tijd server protocol (NTP). Als u hiervoor kiest, vul dan de systeemnaam of het IP adres van deze NTP server hieronder in."

