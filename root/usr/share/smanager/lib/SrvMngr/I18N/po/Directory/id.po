msgid "Directory"
msgstr "(en) Directory"

msgid "dir_CITY"
msgstr "Kota default"

msgid "dir_COMPANY"
msgstr "Perusahaan default"

msgid "dir_DEPARTMENT"
msgstr "Departemen default"

msgid "dir_DESCRIPTION"
msgstr "Server LDAP menyediakan daftar akun pengguna dan grup di server anda , dan dapat diakses menggunakan sebuat LDAP client seperti fitur Address Book pada Netscape Communicator. Atur client LDAP anda dengan IP address local dari server anda, nomor port 389, dan parameter server root seperti dibawah ini."

msgid "dir_DESC_DEPARTMENT"
msgstr "Field ini adalah default dari LDAP untuk organisasi anda.Jika anda membuat akun pengguna baru, anda akan diajukan untuk mengisi field tersebut (bisa berbeda untuk setiap pengguna) tetapi nilai-nilai yang anda tetapkan disini akan muncul sebagai nilai default. Ini supaya lebih memudahkan dalam membuat akun pengguna.These fields are the LDAP defaults for your organization. "

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr "Anda dapat mengendalikan akses ke direktori LDAP anda: pengaturan privat membolehkan akses hanya dari jaringan lokal, dan pengaturan public membolehkan akses dari manapun di Internet."

msgid "dir_DESC_EXISTING"
msgstr "Anda bisa membiarkan akun pengguna yang telah ada apa adanya, menggunakan nilai-nilai default diatas hanya untuk pengguna baru, atau anda bisa menerapkan nilai-nilai default diatas kepada pengguna yang telah ada."

msgid "dir_DIRECTORY_ACCESS"
msgstr "Akses direktori LDAP"

msgid "dir_EXISTING"
msgstr "Pengguna yang ada"

msgid "dir_FORM_TITLE"
msgstr "Ubah setting direktori LDAP"

msgid "dir_LABEL_ROOT"
msgstr "Server root"

msgid "dir_LEAVE"
msgstr "Biarkan"

msgid "dir_PHONENUMBER"
msgstr "No telpon default"

msgid "dir_STREET"
msgstr "Alamat default"

msgid "dir_SUCCESS"
msgstr "Setting default LDAP telah disimpan."

msgid "dir_UPDATE"
msgstr "Mutakhirkan dengan nilai default"
