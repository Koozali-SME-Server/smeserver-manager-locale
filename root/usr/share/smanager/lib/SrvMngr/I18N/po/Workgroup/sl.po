msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "Ali naj streznik deluje kot domain in workgroup controller v omrezju Windows? To opcijo moras nastaviti na NE ce v omrezju to funkcijo opravlja drug streznik. "

msgid "wkg_DESC_ROAM"
msgstr " Ali naj ta Streznik podpira roaming profile ? Ta opcija naj ostane nastavljena na NE rezen ce imas dovolj izkusenj z administriranjem server-based Windows roaming profilov in ves, da je ta funkcija potrebna. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Vnesi ime ki ga bo Streznik uporabljal za Windows in Macintosh delitev datotek."

msgid "wkg_DESC_WORKGROUP"
msgstr " Vnesi ime DelovneSkupine v kateri se bo pojavil ta Streznik. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Spremeni nastavitve za DelovnoSkupino"

msgid "wkg_INVALID_SERVERNAME"
msgstr "Ime Streznika se mora zaceti z crko (veliko ali malo) in nadaljuje z kombinacijo crk in stevilk."

msgid "wkg_INVALID_WORKGROUP"
msgstr "Ime DelovneSkupine se mora zaceti z crko (malo ali veliko) in nadaljuje z kombinacijo crk in stevilk."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "Ime Streznika in DelovneSkupine sta enaka v primeru malih crk. Imeni morata biti razlicni, da se lahko vkljuci deljenje datotek."

msgid "wkg_LABEL_PDC"
msgstr "Domain in Workgroup Kontroler"

msgid "wkg_LABEL_ROAM"
msgstr "Roaming profili"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Ime Streznika"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Windows DelovnaSkupina"

msgid "wkg_SUCCESS"
msgstr "Nove nastavitve DelovneSkupine so shranjene."
