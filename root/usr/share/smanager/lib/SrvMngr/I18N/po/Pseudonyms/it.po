msgid "Pseudonyms"
msgstr "Pseudonimi"

msgid "pse_ABOUT_TO_REMOVE"
msgstr " Sta per essere rimosso lo pseudonimo: Siete sicuri di voler continuare ? "

msgid "pse_ACCOUNT_PSEUDONYM_NONE"
msgstr "(en) No Pseudonyms found for this account"

msgid "pse_CLICK_TO_CREATE"
msgstr "Aggiungi pseudonimo"

