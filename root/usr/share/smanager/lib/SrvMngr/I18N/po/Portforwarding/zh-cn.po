msgid "Port forwarding"
msgstr "(en) Port forwarding"

msgid "pf_ALLOW_HOSTS"
msgstr "允许的主机"

msgid "pf_CREATE_RULE"
msgstr "创建端口转发规则"

msgid "pf_ERR_BADAHOST"
msgstr "这似乎不是一个有效的IP地址，如：192.168.0.1,192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "这似乎不是一个IP地址。您必须使用点号，每个数字应该小于256，比如：192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "端口必须是小于65536的正整数。"

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "事件返回一个非零值。"

msgid "pf_ERR_PORT_COLLISION"
msgstr "错误：端口或者端口范围与一个已存在的规则有冲突。请修改这个新规则，或移除旧规则。"

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  可以使用这个面板来修改防火墙规则，用以开启服务器的特定端口，并将其转发到另一台主机上的端口。这样做将允许入站流量直接访问局域网上的一台私有主机。\n\n  <p> 警告：滥用此功能可能会严重威胁本地网络安全。如果您不完全理解操作将带来的后果，请不要轻易使用此功能， </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "配置端口转发"

msgid "pf_IN_SERVERONLY"
msgstr "服务器当前运行在serveronly模式，端口转发只能转发给localhost。"

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "目标主机IP地址"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "目标端口"

msgid "pf_LABEL_PROTOCOL"
msgstr "协议"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "源端口"

msgid "pf_NO_FORWARDS"
msgstr "当前系统中暂无转发端口。"

msgid "pf_RULE_COMMENT"
msgstr "规则注释"

msgid "pf_SHOW_FORWARDS"
msgstr "在下面表格中可以找到服务器上已存在的端口转发规则。点击 &quot;删除&quot; 链接将删除相应的规则。"

msgid "pf_SUCCESS"
msgstr "您的修改已被保存。"

msgid "pf_SUMMARY_ADD_DESC"
msgstr "以下概括了即将添加的端口转发规则，如果您对此规则很满意，请点击&quot;添加&quot;按钮；如果不满意，请点击 &quot;取消&quot; 按钮。"

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "以下概括了即将删除的端口转发规则，如果您真的要删除此规则，请点击&quot;删除&quot;按钮；如果不删除，请点击 &quot;取消&quot; 按钮。"

