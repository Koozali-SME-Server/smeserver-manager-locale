msgid "Directory"
msgstr "(en) Directory"

msgid "dir_CITY"
msgstr "Город по умолчанию"

msgid "dir_COMPANY"
msgstr "Компания по умолчанию"

msgid "dir_DEPARTMENT"
msgstr "Отдел по умолчанию"

msgid "dir_DESCRIPTION"
msgstr "LDAP сервер обеспечивает доступный в сети список учетных записей пользователей и групп на вашем сервере к которому можно получить доступ с помощью клиентов LDAP, таких, как адресная книга в Netscape Communicator. Настройте ваш LDAP клиент с локальным IP-адресом вашего сервера, номер порта 389, и корнем сервера показанным ниже."

msgid "dir_DESC_DEPARTMENT"
msgstr "Эти поля LDAP - умолчания для вашей организации. Когда вы создаете новую учетную запись пользователя, вам будет предложено заполнить все эти поля (они могут быть разными для каждого пользователя), но значения которые вы установите здесь будут отображаться по умолчанию. Это удобно для быстрого создания учетных записей пользователей."

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr "Вы можете контролировать доступ к вашему LDAP каталогу: частный - позволяет иметь доступ только из локальной сети, публичный - позволяет получить доступ из любой точки мира через Интернет."

msgid "dir_DESC_EXISTING"
msgstr "Вы можете оставить существующие учетные записи пользователей как есть, используя умолчания выше только для новых пользователей или можете применить умолчания для всех существующих пользователей."

msgid "dir_DIRECTORY_ACCESS"
msgstr "Доступ к LDAP каталогу"

msgid "dir_EXISTING"
msgstr "Существующие пользователи"

msgid "dir_FORM_TITLE"
msgstr "Изменить настройки LDAP каталога"

msgid "dir_LABEL_ROOT"
msgstr "Корень сервера"

msgid "dir_LEAVE"
msgstr "Оставить как есть"

msgid "dir_PHONE"
msgstr "(en) dir_PHONE"

msgid "dir_PHONENUMBER"
msgstr "Номер телефона по умолчанию"

msgid "dir_STREET"
msgstr "Улица по умолчанию"

msgid "dir_SUCCESS"
msgstr "Новые настройки LDAP по умолчанию сохранены."

msgid "dir_UPDATE"
msgstr "Обновить новыми настройками по умолчанию"

msgid "dom_FORM_TITLE"
msgstr "(en) dom_FORM_TITLE"

