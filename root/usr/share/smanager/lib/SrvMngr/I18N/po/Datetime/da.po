msgid "dat_NTP_CONFIGURE_DESC"
msgstr "Serveren synkronisere periodisk systemets ur med netværks tids protokol (NTP) serveren nedenfor. For at synkronisere med en anden server, indtast et andet værtsnavn eller en anden IPadresse i feltet nedenfor."

msgid "dat_NTP_DISABLE_DESC"
msgstr "Vælg denne mulighed for at stoppe synkronisering med NTPserveren. Når servicen er stoppet kan du indstille dato og tid manuelt fra denne side."

msgid "dat_NTP_ENABLE_DESC"
msgstr "Serveren kan periodisk synkronsere systemet ur med en Network Time Protocol (NTP) server. Vælger du denne mulighed, angiv værtsnavn eller IP-addresse nedenfor."

