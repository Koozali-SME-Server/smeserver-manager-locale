msgid "usr_LOCK_ACCOUNT_TITLE"
msgstr "Bloquear cuenta de usuario"

msgid "usr_LOCK_DESC"
msgstr "Está a punto de bloquear la cuenta de usuario"

msgid "usr_LOCK_DESC2"
msgstr " Se bloqueará esta cuenta de usuario. Esto significa que el usuario no podrá conectarse ni acumular correos electrónicos. No obstante, todos los correos electrónicos que lleguen se almacenarán y/o reenviarán a una dirección de correo electrónico externa, según esté configurado. Se puede activar la cuenta más adelante al establecer una contraseña nueva. La contraseña actual no se mantendrá.   ¿Está seguro de que desea bloquear esta cuenta? "

msgid "usr_MAX_user_NAME_LENGTH_ERROR"
msgstr "(en) Max user name length error"

