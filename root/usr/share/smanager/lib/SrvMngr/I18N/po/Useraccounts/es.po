msgid "usr_REMOVE_ACCOUNT_TITLE"
msgstr "Eliminar cuenta de usuario"

msgid "usr_REMOVE_DESC"
msgstr "Está a punto de eliminar la cuenta de usuario"

msgid "usr_REMOVE_DESC2"
msgstr " Se borrarán todos los archivos pertenecientes a esta cuenta de usuario. Además, se descartarán todos los correos electrónicos para esta cuenta de usuario que aún se mantengan en el servidor (por ej. que el usuario aún no haya recuperado).   ¿Está seguro de que desea eliminar esta cuenta? "

msgid "usr_RESET_DESC"
