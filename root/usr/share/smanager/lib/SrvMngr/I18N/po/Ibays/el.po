msgid "iba_ACCOUNT_EXISTS"
msgstr "Ο λογαριασμός \"[_1]\" είναι ένας υφιστάμενος [_2] λογαριασμός."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " Ο λογαριασμός \"[_1]\" έρχεται σε αντίθεση με τις λεπτομέρειες των ψευδωνύμων του λογαριασμού τύπου [_2]με την ονομασία \"[_3]\". Το [_1] αποτελεί ψευδώνυμο του [_3]. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "Η ονομασία του i-bay \"[_1]\" περιέχει άκυρους χαρακτήρες. Οι ονομασίες των i-bays πρέπει να αρχίζουν με μικρά γράμματα και να περιέχουν μόνο μικρά γράμματα, αριθμούς και παύλες."

msgid "iba_ADD_IBAY"
msgstr "Προσθήκη i-bay"

msgid "iba_ADD_TITLE"
msgstr "Δημιουργία ή τροποποίηση ενός i-bay"

msgid "iba_ALLOW_DYNAMIC_CONTENT"
msgstr "Εκτέλεση ενός δυναμικού περιεχομένου (CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "Δεν είναι δυνατή η δημιουργία νέου λογαριασμού για [_1] (μήπως υπάρχει ήδη;)"

msgid "iba_CANT_FIND_IBAY"
msgstr "Δεν βρίσκω λογαριασμο για [_1] (μήπως δεν υπάρχει;)"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "Ολόκληρο Διαδίκτυο (δεν απαιτείται κωδικός πρόσβασης)"

msgid "iba_ENTIRE_INTERNET_PASSWORD"
msgstr "Ολόκληρο Διαδίκτυο (απαιτείται κωδικός πρόσβασης)"

msgid "iba_ENTIRE_INTERNET_PASSWORD_REMOTE"
msgstr "Ολόκληρο Διαδίκτυο (εκτός τοπικού δικτύου απαιτείται κωδικός πρόσβασης)"

msgid "iba_ERROR_WHILE_CREATING_IBAY"
msgstr "Παρουσιάσθηκε σφάλμα κατά την δημιουργία του i-bay."

msgid "iba_ERROR_WHILE_DELETING_IBAY"
msgstr "Παρουσιάσθηκε σφάλμα κατά τη διαγραφή του το i-bay."

msgid "iba_ERROR_WHILE_MODIFYING_IBAY"
msgstr "Παρουσιάσθηκε σφάλμα κατά την τροποποίηση του i-bay."

msgid "iba_ERROR_WHILE_RESETTING_PASSWORD"
msgstr "Σφάλμα κατά την αρχικοποίηση του κωδικού πρόσβασης."

msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "  Προσθήκη i-bay \n\n   Μπορείτε να διαγράψετε οποιοδήποτε information bay ή να αρχικοποιήσετε (reset) τον κωδικό πρόσβασης κάνοντας κλικ στην αντίστοιχη εντολή δίπλα στο i-bay. Αν το information bay εμφανίζετε με κόκκινο, αυτό σημαίνει ότι ο κωδικός πρόσβασης δεν έχει ακόμη αλλάξει από τον αρχικό και απαιτείται σύντομα αλλαγή. \n\n  "

msgid "iba_FORM_TITLE"
msgstr "Δημιουργία, τροποποίηση ή διαγραφή i-bays"

msgid "iba_HTTPS_Only"
msgstr "Επιβολή ασφαλών συνδέσεων"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "Οι προσωπικοί κωδικοί πρόσβασης δεν ταυτίζονται."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Τοπικό δίκτυο (δεν απαιτείται κωδικός πρόσβασης)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "Τοπικό δίκτυο (απαιτείται κωδικός πρόσβασης)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "Η ονομασία του i-bay \"[_1]\" είναι πολύ μεγάλη. Το μέγιστο είναι [_1] χαρακτήρες."

msgid "iba_NAME_FIELD_DESC"
msgstr "Η ονομασία του i-bay πρέπει να περιέχει μόνο μικρά γράμματα, αριθμούς, τελείες, παύλες και παύλες υπογράμμισης, και θα πρέπει να ξεκινάει με μικρό γράμμα. Για παράδειγμα \"johnson\", \"intra\", και \"cust3.prj12\" είναι έγκυρες ονομασίες, αλλά \"3associates\", \"John Smith\" και \"Bus!Partner\" δεν είναι. Η ονομασία έχει περιορισμό μήκους [_1]χαρακτήρων."

msgid "iba_NAME_LABEL"
msgstr "Ονομασία i-bay"

msgid "iba_NONE"
msgstr "Καμία πρόσβαση"

msgid "iba_NO_IBAYS"
msgstr "Δεν υπάρχουν αυτή την στιγμή ρυθμισμένα i-bays."

msgid "iba_PASSWORD_DESC"
msgstr "Πρόκειται ν' αλλάξετε τον κωδικό πρόσβασης για το i-bay [_1]."

msgid "iba_PUBLIC_ACCESS"
msgstr "Δημόσια πρόσβαση μέσω ιστοσελίδας ή ανώνυμου ftp"

msgid "iba_REMOVE_DESC"
msgstr "  Πρόκειται να διαγράψετε το i-bay \"[_1]\" ([_2]). \n\n   Όλα τα αρχεία που ανήκουν σε αυτό το i-bay θα διαγραφούν. \n\n   Είστε σίγουροι ότι θέλετε να διαγράψετε το συγκεκριμένο i-bay; \n\n  "

msgid "iba_REMOVE_TITLE"
msgstr "Διαγραφή i-bay"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "Το i-bay δημιουργήθηκε με επιτυχία."

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "Επιτυχής διαγραφή i-bay."

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "Επιτυχής τροποποίηση i-bay."

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "Επιτυχής αρχικοποίηση κωδικού πρόσβασης."

msgid "iba_USER_ACCESS"
msgstr "Πρόσβαση χρηστών μέσω κοινής χρήσης αρχείων ή χρήστη ftp"

msgid "iba_VHOST_MESSAGE"
msgstr " Οι παρακάτω εικονικοί τομείς χρησιμοποιούσαν αυτό το information bay σαν περιεχόμενό τους και θα αλλαχθούν στον πρωτεύοντα ιστότοπο (στη συνέχεια μπορείτε να τους αλλάξετε σε κάτι άλλο):\n\n  <ul>[_1]</ul> "

msgid "iba_WARG"
msgstr "Εγγραφή = admin, ανάγνωση = ομάδα"

msgid "iba_WGRE"
msgstr "Εγγραφή = ομάδα, ανάγνωση = όλοι"

msgid "iba_WGRG"
msgstr "Εγγραφή = ομάδα, ανάγνωση = ομάδα"

