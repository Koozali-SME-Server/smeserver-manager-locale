msgid "Directory"
msgstr "Directory"

msgid "dir_CITY"
msgstr "Default City"

msgid "dir_COMPANY"
msgstr "Default company"

msgid "dir_DEPARTMENT"
msgstr "Default department"

msgid "dir_DESCRIPTION"
msgstr "The LDAP server provides a network-available listing of the user accounts \nand groups on your server, and can be accessed using an LDAP client such as the Address Book feature\n in Netscape Communicator. Configure your LDAP client with the local IP address of your server, \n port number 389, and the server root parameter shown below."

msgid "dir_DESC_DEPARTMENT"
msgstr "These fields are the LDAP defaults for your organization.\nWhenever you create a new user account, you will be prompted\nto enter all of these fields (they can be different for each\nuser) but the values you set here\nwill show up as defaults. This is a convenience to make it\nfaster to create user accounts."

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr " You can control access to your LDAP directory: \nthe private setting allows access only from your local network, and the public setting allows access from anywhere on the Internet. "

msgid "dir_DESC_EXISTING"
msgstr "You can either leave existing user accounts as they are, using the above defaults only for\nnew users, or you can apply the above defaults to all existing users as well."

msgid "dir_DIRECTORY_ACCESS"
msgstr "LDAP directory access"

msgid "dir_EXISTING"
msgstr "Existing users"

msgid "dir_FORM_TITLE"
msgstr "Change LDAP directory settings"

msgid "dir_LABEL_ROOT"
msgstr "Server root"

msgid "dir_LEAVE"
msgstr "Leave as they are"

msgid "dir_PHONE"
msgstr "dir_PHONE"

msgid "dir_PHONENUMBER"
msgstr "Default Phone Number"

msgid "dir_STREET"
msgstr "Default Street address"

msgid "dir_SUCCESS"
msgstr "The new LDAP default settings have been saved."

msgid "dir_UPDATE"
msgstr "Update with new defaults"

