msgid "Printers"
msgstr "Yazıcılar"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "Yazıcıyı silmek üzeresiniz:"

msgid "prt_ARE_YOU_SURE"
msgstr "Bu yazıcıyı kaldırmak istediğinizden eminmisiniz?"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "Yazıcı başarılı şekilde oluşturuldu:"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "Lütfen ağ yazıcısı adresi ve adını girin"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "Yeni ağ yazıcısı oluştur"

msgid "prt_CREATE_NEW_DESC"
msgstr "Yazıcı için özgün bir ad ve açıklama belirtin. Yazıcı adı sadece küçük harfler ve sayılar içermeli ve bir küçük harf ile başlamalıdır. Örneğin \"hplaser\", \"epsonlp\" ve \"canonbj\" geçerli isimlerdir, fakat \"HP Laser Jet\", \"Canon BubbleJet\" ve \"HP JetDirect Printer\" geçersizdir. Yazıcı adı veya açıklamalarında \"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\", \"paper\", \"error\" ve \"responding\" kelimeleri kullanılmamalıdır."

msgid "prt_CREATE_NEW_PRINTER"
msgstr "Yeni yazıcı oluştur"

msgid "prt_CURRENT_LIST"
msgstr "Yazıcılar Listesi"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "Yazıcı başarıyla kaldırıldı:"

msgid "prt_ERR_EXISTS"
msgstr "Hata: Aynı isme sahip hesap adı bulunuyor:"

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "Hata: yazıcı kaldırılırken iç hata oluştu:"

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "Hata: geçersiz ağ adresi. Yeni yazıcı oluşturulamadı."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "Hata: geçersiz ağ yazıcısı adı. Yeni yazıcı oluşturulamadı."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "Hata: açıklama geçersiz karakter içeriyor. Yazıcı oluşturulamadı."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr " Hata: yazıcı adında geçersiz karakter. Yazıcı adı sadece küçük harf ve rakamlardan oluşmalı ve küçük hrfle başlamalıdır. Örneğin \"hplaser\", \"epsonlp\" ve \"canonbj\" gibi. "

msgid "prt_FIRST_USB_PRINTER"
msgstr "USB bağlı ilk yazıcı"

msgid "prt_FORM_TITLE"
msgstr "Yazıcı ekle veya kaldır"

msgid "prt_HOSTNAME_OR_IP"
msgstr "Ağ yazıcısının alan adı veya IP adresi"

msgid "prt_INITIAL_BTN"
msgstr "Yazıcı ekle"

msgid "prt_LOCAL_PRINTER_0"
msgstr "Yerel yazıcı, port 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "Yerel yazıcı, port 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "Yerel yazıcı, port 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "Geçerli alan adı veya IP adresi içermelidir"

msgid "prt_NET_PRINTER"
msgstr "Ağ yazıcısı ..."

