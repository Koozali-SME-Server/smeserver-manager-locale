msgid "prt_SECOND_USB_PRINTER"
msgstr "USB bağlı ikinci yazıcı"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "Bu yazıcının tüm yazdırılmayı bekleyen dosyaları silinecektir."

