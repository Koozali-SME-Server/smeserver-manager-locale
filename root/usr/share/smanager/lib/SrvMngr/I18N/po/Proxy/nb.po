msgid "Proxy settings"
msgstr "Proxyinnstillinger"

msgid "prx_BLOCKED"
msgstr "Blokkert"

msgid "prx_ERR_NO_SQUID_REC"
msgstr "Feil: det er ingen squid oppføring i konfigurasjonsdatabasen"

msgid "prx_ERR_PROXY_UPDATE_FAILED"
msgstr "Feil: proxy-oppdatering hendelsen møtte på en feil."

msgid "prx_FIRST_PAGE_DESCRIPTION"
msgstr "Denne siden lar deg konfigurere serverens proxy innstillinger. serveren har en gjennomfiktig proxy og mellomlager for HTTP trafikk. Dette er slått på som standard, men blir ikke håndhevd hvis serveren er i &quot;serveronly&quot; modus. Hvis serveren opptrer som e-post server, vil tilkoblinger fra lokale maskiner på nettverket mot eksterne SMTP servere som standard bli videresendt til den lokale e-postserveren."

msgid "prx_HTTP_PROXY_STATUS_DESCRIPTION"
msgstr "Serverens HTTP proxy jobber for å redusere den totale opplastnings bruken ved å mellomlagre nylig besøkte sider. Den er gjennomsiktig for nettlesere som bruker denne serveren som gateway. Slå av eller på proxy med følgende bryter."

msgid "prx_HTTP_PROXY_STATUS_LABEL"
msgstr "(en)HTTP proxy status"

msgid "prx_Proxy"
msgstr "Proxy"

msgid "prx_SMTP_PROXY_STATUS_DESCRIPTION"
msgstr "Serverens gjennomsiktige SMTP proxy jobber for å redusere virustrafikk fra infiserte maskiner ved å tvinge all utgående SMTP trafikk gjennom serveren. Hvis du ønsker å bruke en annen SMTP server, og denne serveren er gatewayen til den, slår du av denne proxyen."

msgid "prx_SMTP_PROXY_STATUS_LABEL"
msgstr "(en)SMTP proxy status"

msgid "prx_SUCCESS"
msgstr "De nye proxy instillingene er lagt til."

msgid "prx_TITLE"
msgstr "Proxyinnstillinger"

