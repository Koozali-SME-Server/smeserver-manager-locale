msgid "Directory"
msgstr "(en) Directory"

msgid "dir_CITY"
msgstr "เมือง"

msgid "dir_COMPANY"
msgstr "บริษัท"

msgid "dir_DEPARTMENT"
msgstr "แผนก"

msgid "dir_DESCRIPTION"
msgstr "เซอร์ฟเวอร์ LDAP (LDAP server) นี้สามารถให้บริการเรียกดูข้อมูลบัญชีผู้ใช้และกลุ่มผู้ใช้ที่มีอยู่ได้ คุณเรียกใช้บริการนี้ได้นี้ผ่านซอร์ฟแวร์ LDAP client เช่น Address Book ของNetscape Communicator และการตั้งค่าซอร์ฟแวร์ LDAP client ได้โดยให้กรอกหมายเลข IP ของเซอร์ฟเวอร์นี้ และระบุหมายเลขพอร์ตเป็น 389 รวมทั้งพารามิเตอร์หลักต่างๆ ที่อยู่ด้านล่างนี้"

msgid "dir_DESC_DEPARTMENT"
msgstr "ค่าจะกำนดไว้เหล่านี้คือค่าปริยายที่ตั้งให้ไว้เมื่อคุณสร้างบัญชีผู้ใช้ใหม่ คุณสามารถเปลี่ยนแปลงได้อีกครั้งเมื่อคุณสร้างบัญชีผู้ใช้ใหม่ (และกำหนดให้แตกต่างกันได้ในแต่ละราย) แต่ค่า LDAP ที่ไว้ที่นี่จะปรากฏเป็นค่าตั้งต้นเมื่อทำการสร้างฯ จุดประสงค์เพื่อให้ง่ายและรวดเร็วในการสร้างบัญชีผู้ใช้ใหม่ในแต่ละราย"

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr "คุณสามารถกำหนดเข้าถึงไดเรกทอรี LDAP ได้: การตั้งให้เข้าถึงแบบ private จะให้เข้าถึงได้เฉพาะจากเครื่องจากเครือข่ายภายใน (local network) และแบบ public จะให้เข้าถึงได้จากทุกที่"

msgid "dir_DESC_EXISTING"
msgstr "คุณสามารถเลือกที่จะปล่อยให้ข้อมูลของบัญชีผู้ใช้ที่มีอยู่แล้วให้เป็นอย่างเดิมและให้ค่าปริยายนี้มีผลเฉพาะกับข้อมูล (ผู้ใช้) ที่จะสร้างใหม่หลังจากนี้เท่านั้น หรือจะให้เปลี่ยนแปลงข้อมูลของผู้ใช้จากข้อมูลเก่าเป็นข้อมูลใหม่ที่แก้ไขแล้วนี้ก็ได้"

msgid "dir_DIRECTORY_ACCESS"
msgstr "LDAP directory access"

msgid "dir_EXISTING"
msgstr "ผู้ใช้ที่มีอยู่ปัจจุบัน"

msgid "dir_FORM_TITLE"
msgstr "แก้ไขค่า LDAP directory"

msgid "dir_LABEL_ROOT"
msgstr "Server root"

msgid "dir_LEAVE"
msgstr "ปล่อยไว้เช่นเดิม"

msgid "dir_PHONENUMBER"
msgstr "โทร."

msgid "dir_STREET"
msgstr "ถนน"

msgid "dir_SUCCESS"
msgstr "ได้บันทึกการแก้ไขค่าปริยายของ LDAP แล้ว"

msgid "dir_UPDATE"
msgstr "ปรับปรุงให้เป็นไปตามค่าปริยายที่แก้ไขใหม่"
