msgid "Port forwarding"
msgstr "(en) Port forwarding"

msgid "pf_ALLOW_HOSTS"
msgstr "Tillad værter"

msgid "pf_CREATE_RULE"
msgstr "Opret en regel for port-viderestilling"

msgid "pf_ERR_BADAHOST"
msgstr "Dette ligner ikke en gyldig IP-adresse. Fx 192.168.0.1, 192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "er et tal mellem 0 og 255. Fx 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "Portnummer skal være et heltal mindre en 65536."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "Begivenheden returnerede ikke en nulværdi."

msgid "pf_ERR_PORT_COLLISION"
msgstr "FEJL: Denne port eller dette portområde er i konflikt med en eksisterende regel. Lav om på denne regel, eller fjern den gamle."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  Du kan bruge dette panel til, at ændre brandmurens regler, som at åbne en bestemt port på serveren og viderestille den til en anden port hos en anden vært. Det vil medføre at indkommende trafik får direkte adgang til en privat vært på lokalnet. \n\n  <p> ADVARSEL: Fejlagtig brug af denne funktion kan kompromittere dit netværks sikkerhed. Brug denne funktion med forsigtighed og ikke uden at forstå hvad det indebærer. </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Indstil port-viderestilling"

msgid "pf_IN_SERVERONLY"
msgstr "Denne server er sat op som kun server, hvorfor portviderestilling kun er muligt til lokalhost."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Målværts IP-adresse"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Mål port(e)"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protokol"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Kilde port(e)"

msgid "pf_NO_FORWARDS"
msgstr "Der er ingen viderestillede porte i systemet."

msgid "pf_RULE_COMMENT"
msgstr "Kommentarer"

msgid "pf_SHOW_FORWARDS"
msgstr "Nedenfor finder du en tabel, der sammenstiller de aktuelle regler for viderestilling af porte på denne server. Klik på &quot;Fjern&quot; knappen for at fjerne tilhørende regel."

msgid "pf_SUCCESS"
msgstr "Dine ændringer i reglen for portviderestilling er gemt."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "Det følgende er en regel for port-viderestilling, som du er ved at tilføje. Er du tilfreds med reglen, klik på &quot;Tilføj&quot; knappen. Er du ikke, klik på &quot;Fortryd&quot; knappen."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "Det følgende er en regel for port-viderestilling, som du er ved at fjerne. Er du sikker på at du vil fjerne reglen, klik på &quot;Fjern&quot; knappen. Hvis ikke, klik på &quot;Fortryd&quot; knappen."

