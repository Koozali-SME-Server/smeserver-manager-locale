msgid "Port forwarding"
msgstr "(en) Port forwarding"

msgid "pf_ALLOW_HOSTS"
msgstr "Wszystkie projekty"

msgid "pf_CREATE_RULE"
msgstr "Create portforwarding rule"

msgid "pf_ERR_BADAHOST"
msgstr "This does not appear to be a valid IP address list. ie: 192.168.0.1,192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "This does not appear to be an IP address. You must use dotted-quad notation, and each of the four numbers should be less than 256. ie: 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "The ports must be a positive integer less than 65536."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "Event returned a non-zero return value."

msgid "pf_ERR_PORT_COLLISION"
msgstr "ERROR: This port or port range conflicts with an existing rule. Please modify this new rule, or remove the old rule."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  You can use this panel to modify your firewall rules so as to open a specific port on this server and forward it to another port on another host. Doing so will permit incoming traffic to directly access a private host on your LAN. \n\n  <p> WARNING: Misuse of this feature can seriously compromise the security of your network. Do not use this feature lightly, or without fully understanding the implications of your actions. </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Configure Port Forwarding"

msgid "pf_IN_SERVERONLY"
msgstr "This server is currently in serveronly mode and portforwarding is possible only to localhost."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Destination Host IP Address"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Destination Port(s)"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protokół"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Source Port(s)"

msgid "pf_NO_FORWARDS"
msgstr "There are currently no forwarded ports on the system."

msgid "pf_RULE_COMMENT"
msgstr "Komentarze"

msgid "pf_SHOW_FORWARDS"
msgstr "Below you will find a table summarizing the current port-forwarding rules installed on this server. Click on the &quot;Remove&quot; link to remove the corresponding rule."

msgid "pf_SUCCESS"
msgstr "Your change to the port forwarding rules has been successfully saved."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "The following summarizes the port-forwarding rule that you are about to add. If you are satisfied with the rule, click the &quot;Add&quot; button. If you are not, click the &quot;Cancel&quot; button."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "The following summarizes the port-forwarding rule that you are about to remove. If you are sure you want to remove the rule, click the &quot;Remove&quot; button. If not, click the &quot;Cancel&quot; button."

