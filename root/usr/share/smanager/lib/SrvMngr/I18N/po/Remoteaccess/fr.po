msgstr "Le nombre de sessions PPTP est supérieur aux IP réservées pour le DHCP. Vous devez allouez moins de sessions PPTP"

msgid "rma_NUM_OF_HOSTS"
msgstr "Nombre d'hôtes"

msgid "rma_PASSWORD_LOGIN_PRIVATE"
msgstr "N'autoriser l'authentification que depuis les réseaux locaux"

msgid "rma_PASSWORD_LOGIN_PUBLIC"
msgstr "Permettre l'authentification depuis n'importe où"

msgid "rma_REMOTE_MANAGEMENT"
