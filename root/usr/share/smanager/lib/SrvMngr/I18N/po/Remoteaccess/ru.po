msgid "rma_VALIDFROM_DESC"
msgstr " [_1] Возможно разрешить узлам удаленной сети доступ управлению сервером путем ввода этих сетей здесь. Используйте маску подсети 255.255.255.255, чтобы ограничить доступ указанным узлом. Любой узел, в пределах указанного диапазона будет иметь доступ к управлению сервером, используя HTTPS. "

msgid "rma_VALIDFROM_TITLE"
msgstr "[_1]"

