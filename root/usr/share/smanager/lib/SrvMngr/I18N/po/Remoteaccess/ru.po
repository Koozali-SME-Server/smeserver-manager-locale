msgid "rma_LABEL_SSH"
msgstr "SSH доступ"

msgid "rma_LABEL_SSH_ADMIN"
msgstr "Разрешить доступ к административной командной строке через SSH"

msgid "rma_LABEL_SSH_PASSWORD_ACCESS"
msgstr "Разрешить SSH доступ с использованием стандартных паролей"

