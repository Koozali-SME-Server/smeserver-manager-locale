msgid "Local networks"
msgstr "Helyi hálózatok"

msgid "ln_ADD_DESC"
msgstr " Minden paramétert a #.#.#.# formában kell megadni (minden # egy szám 0 és 255 között). A szerver kinullázza a hálózati cím alhálózati maszk által meghatározott végét (gép azonosítót) hogy a hálózati cím érvényes legyen.  Az \"Átjáró\" annak az eszköznek az IP címe amelyen keresztül elérhetők a további külső hálózatok "

msgid "ln_ADD_TITLE"
msgstr "Helyi hálózat hozzáadása"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "Hiba történt a hálózat létrehozásakor."

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "Hiba történt a hálózat eltávolításakor."

msgid "ln_FIRSTPAGE_DESC"
msgstr " Biztonsági okokból a szerver néhány szolgáltatása csak hálózaton belül érhető el. Azonban lehetősége van ezen szolgáltatásokhoz hozzáférést adni további hálózatok számára, úgy hogy hozzáadja őket az alábbi listához. Más esetben hagyja üresen ezt a listát. Hálózat hozzáadása "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "Érvénytelen IP cím"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Érvénytelen alhálózati maszk"

msgid "ln_LOCAL NETWORKS"
msgstr "Helyi hálózatok"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Hálózat hozzáadása"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "Hiba: a %1 hálózat (%2 hálózati címből és %3 alhálózati maszkból képezve) már hozzá lett adva.A hálózat hozzáadása sikertelen."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "Hiba: a %1 hálózat (%2 hálózati címből és %3 alhálózati maszkból képezve) már helyinek számít. A hálózat hozzáadása sikertelen."

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "Hiba: a %1 átjáró címe nem érhető el a helyi hálózatból. A hálózat hozzáadása sikertelen."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Gépek száma"

msgid "ln_REMOVE_DESC"
msgstr "A következő helyi hálózatokat készül eltávolítani."

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "Az a hálózat amelyet eltávolítani készül, konfigurált gépeket tartalmaz. Alapesetben ezek is eltávolításra kerülnek. Ha valamilyen okból azt akarja, hogy ez ne történjen meg, vegye ki a jelölést a négyzetből. Miután a hálózatot eltávolítja, ezeknek a gépeknek már nem lesznek helyi jogosultságaik, sőt lehetséges, hogy nem lesznek elérhetők."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "A hálózat gépeinek eltávolítása"

msgid "ln_REMOVE_TITLE"
msgstr "Helyi hálózat eltávolítása"

msgid "ln_SUBNET_MASK"
msgstr "Alhálózati maszk"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "A %1 átjárón keresztüli %2/%3 hálózatot sikeresen hozzáadta. A szerver helyi jogosultságokat biztosít a %4 IP címeknek a %5 -tól %6 -ig terjedő címtartományban."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "  A %1 átjárón keresztüli %2/%3 hálózatot sikeresen hozzáadta. A szerver helyi jogosultságokat biztosít a %4 IP címeknek a %5 -tól %6 -ig terjedő címtartományban.. \n\n  <p> Figyelem: a ProFTPd FTP szerver nem tudja kezelni az ilyen fajta alhálózati maszkot. Az egyszerűbb <b>%1</b> lesz helyette használatban. </p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "A %1 átjárón keresztüli %2/%3 hálózatot sikeresen eltávolította."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "A %1 átjárón keresztüli %2/%3 hálózatot sikeresen hozzáadta. A szerver helyi jogosultságokat biztosít a %4 IP címnek."
