msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "Skal denne serveren opptre som arbeidsgruppe og domene kontroller på ditt Windows nettverk? Du bør la denne stå til Nei hvis en annen server allerede har denne rollen i nettverket."

msgid "wkg_DESC_ROAM"
msgstr " Skal denne serveren støtte roaming profiles? Du bør la denne være satt til standard som er Nei med mindre du har erfaring med administrering av server-basert Windows roaming profile og vet at egenskapen er påkrevd. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Skriv inn det navnet denne serveren skal bruke for Windows og Macintoch fildeling."

msgid "wkg_DESC_WORKGROUP"
msgstr " Skriv inn Windows arbeidsgruppenavnet som denne serveren skal vise seg i. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Endre arbeidsgruppe innstillinger"

msgid "wkg_INVALID_SERVERNAME"
msgstr "Servernavnet må begynne med en bokstav (stor eller liten bokstav), fulgt av en hver kombinasjon av bokstaver, tall, understreker, punktum, og bindestreker."

msgid "wkg_INVALID_WORKGROUP"
msgstr "Arbeidsgruppenavnet må begynne med en bokstav (stor eller liten bokstav), fulgt av en hver kombinasjon av bokstaver, tall, understreker, punktum, og bindestreker."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "Servernavnet og arbeidsgruppenavnet er likt når de sammenliknes i små bokstaver. de kan ikke være like dersom fildeling skal være slått på."

msgid "wkg_LABEL_PDC"
msgstr "Arbeidsgruppe og Domene Kontroller"

msgid "wkg_LABEL_ROAM"
msgstr "Roaming profiler"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Servernavn"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Windows arbeidsgruppe"

msgid "wkg_SUCCESS"
msgstr "De nye arbeisgruppe innstillingene er lagret."
