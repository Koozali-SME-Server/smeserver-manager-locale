msgid "Reboot or shutdown"
msgstr "(en) Reboot or shutdown"

msgid "rbo_DESCRIPTION"
msgstr " Din acest meniu puteți reporni, opri serverul sau să faceti reconfigurarea completă a sistemului. Trebuie sa utilizati procedura de oprire înainte de a tăia alimentarea cu energie electrică. Aceste proceduri durează câteva minute. Când apăsați efectuează procedurile vor fi inițiate imediat, deci fiți pregătiți! "

msgid "rbo_DESC_REBOOT"
msgstr "Serverul procesează solicitarea de repornire"

msgid "rbo_DESC_RECONFIGURE"
msgstr "Serverul procesează solicitarea de reconfigurare a sistemului urmată de repornire"

msgid "rbo_DESC_SHUTDOWN"
msgstr "Serverul rulează procedurile de inchidere. După cateva minute puteti inchide și alimentarea de la buton."

msgid "rbo_FORM_TITLE"
msgstr "Închidere sau repornire"

msgid "rbo_LABEL_REBOOT"
msgstr "Alegeți Închidere, Repornire sau Reconfigurare"

msgid "rbo_REBOOT"
msgstr "Repornire"

msgid "rbo_REBOOT_SUCCEEDED"
msgstr "S-a initiat cu succes procedura de repornire a serverului"

msgid "rbo_RECONFIGURE_SUCCEEDED"
msgstr "S-a inițiat cu succes procedura de reconfigurare"

msgid "rbo_SHUTDOWN_SUCCEEDED"
msgstr "(en) Shutdown request initiated successfully."

