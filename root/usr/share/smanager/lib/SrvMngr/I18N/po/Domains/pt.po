msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Adicionar domínio"

msgid "dom_CONTENT"
msgstr "compartilhamento [_1]"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "Para o web site, você pode escolher o web site primário ou qualquer compartilhamento como conteúdo."

msgid "dom_CREATE_TITLE"
msgstr "Criar um novo domínio virtual"

msgid "dom_CURRENT_DOMAINS"
msgstr "Lista atual de domínios"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Se seu servidor não possui acesso direto a Internet ou você tiver requerimentos especiais para resolução de DNS, entre com endereço IP do servidor DNS aqui. Estes campos devem ser deixados em branco a não ser que você tenha uma razão específica para configurar outro servidor DNS. Você não deve entrar o endereço IP do servidor DNS do seu provedor aqui, pois o servidor é capaz de resolver todos os nomes DNS da Internet sem configuração adicional."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr " Configuração de DNS corporativo "

msgid "dom_DESC_NAMESERVERS"
msgstr "Você pode selecionar se, este domínio será resolvido localmente, por meio dos servidores DNS corporativos, ou resolvidos por servidores DNS da Internet. O padrão será correto para a maioria das redes."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Modificar definições de DNS corporativo"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Erro: caracter inesperado ou faltando na descrição do domínio [_1]. Não criou novo domínio."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Erro: domínio [_1] já está em uso. Não criou novo domínio."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Erro: caracter inesperado ou faltando no nome de domínio [_1]. O nome do domínio deve conter uma ou mais letras, números, pontos e sinal de menos. Não criou novo domínio."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Erro: falha interna enquanto removia o domínio virtual [_1]."

msgid "dom_FORM_DESCRIPTION"
msgstr " Quando criar um domínio virtual, seu servidor será capaz de receber e-mail para este domínio e também ser um hospedeiro de páginas web para este domínio.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Add domain</a> "

msgid "dom_FORM_TITLE"
msgstr "Gerenciar domínios"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Servidor primário de DNS corporativo"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Servidor secundário de DNS corporativo"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Servidores de domínio DNS"

msgid "dom_MODIFY_TITLE"
msgstr "Modificar domínio virtual"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Erro: [_1] não é um domínio existente."

msgid "dom_PRIMARY_SITE"
msgstr "site primário"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  Você está prestes a remover o domínio virtual [_1] ([_2]). \n\n  <p> <b>Tem certeza que deseja remover este domínio?</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Remover domínio virtual"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Domínio virtual [_1] criado com sucesso. Seu servidor web está sendo reinicializado. Os liks desta página estarão inativos até que a reinicialização do servidor de complete."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Removeu o domínio virtual [_1] com sucesso. Seu servidor web está sendo reinicializado. Os liks desta página estarão inativos até que a reinicialização do servidor de complete."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Domínio virtual [_1] modificado com sucesso. Seu servidor web está sendo reinicializado. Os liks desta página estarão inativos até que a reinicialização do servidor de complete."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Erro: domínio [_1] é o nome de domínio seu sistema. Você não pode ter um domínio virtual com o mesmo nome. Novo domínio não criado."

msgid "dom_corporate"
msgstr "Servidores DNS corporativos"

msgid "dom_internet"
msgstr "Servidores DNS da Internat"

msgid "dom_localhost"
msgstr "Resolver localmente"

