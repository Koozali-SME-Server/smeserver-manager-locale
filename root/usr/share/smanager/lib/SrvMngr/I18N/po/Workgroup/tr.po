msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "Bu sunucu Windows ağında çalışma grubu ve etki alanı denetleyicisi olarak görev alsın mı? Bu ağda bu işlevi başka bir sunucu yerine getiriyorsa Hayır seçmelisiniz."

msgid "wkg_DESC_ROAM"
msgstr " Bu sunucu dolaşım profilleri denetlesin mi? Bu seçeneği varsayılan olarak Hayır seçmeniz önerilir, ancak sunucu tabnlı Windows dolaşım profiller yönticisi konularunda uzamn kişiler buradaki ayrları yapılandırabilir. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Bu sistem Windows ve Macintosh ağlarında hangi isimle görülsün."

msgid "wkg_DESC_WORKGROUP"
msgstr " Bu sunucunun Windows çalışma gurubundaki adını girin. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Çalışma gurubu ayrlarını değiştir"

msgid "wkg_INVALID_SERVERNAME"
msgstr "Sunucu adı harf ile başlamalıdır ( büyük veya küçük harf ), devamında harfler, sayılar, alt çizgi ve tire kullanılabilir."

msgid "wkg_INVALID_WORKGROUP"
msgstr "Çalışma gurubu adı harf ile başlamalıdır ( büyük veya küçük harf ), devamında harfler, sayılar, alt çizgi, nokta ve tire kullanılabilir."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "Sunucu ve çalışma grubu adları küçük harf olarak kaşılaştırıldığında aynıdır. Dosya paylaşımın yapılabilmesi için bu iki isim bir birinden farklı olmalıdır."

msgid "wkg_LABEL_PDC"
msgstr "Çalışma gurubu ve Etki Alanı Denetleyicisi"

msgid "wkg_LABEL_ROAM"
msgstr "Dolaşım profilleri"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Sunucu Adı"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Windows çalışma gurubu"

msgid "wkg_SUCCESS"
msgstr "Yeni çalışma gurubu ayarları kaydedildi"
