msgid "Reboot or shutdown"
msgstr "Riavvio o arresto"

msgid "rbo_DESCRIPTION"
msgstr " E' possibile spegnere o riavviare il server. E' obbligatorio arrestare il sistema prima di spegnere il server. Entrambe le funzioni impiegano alcuni minuti. Facendo clic su Esegui l'operazione inizierà immediatamente! "

msgid "rbo_DESC_REBOOT"
msgstr "Il server ha appena iniziato la procedura di riavvio."

msgid "rbo_DESC_RECONFIGURE"
msgstr "Il server ha iniziato la procedura di riconfigurazione e reboot."

msgid "rbo_DESC_SHUTDOWN"
msgstr "Il server ha appena iniziato la procedura di arresto. L'operazione si completerà entro alcuni minuti, al termine sarà possibile spegnere il server togliendo l'alimentazione."

msgid "rbo_FORM_TITLE"
msgstr "Arresto o riavvio"

msgid "rbo_LABEL_REBOOT"
msgstr "Selezionare Arresto o Riavvio"

msgid "rbo_REBOOT"
msgstr "Riavvio"

msgid "rbo_REBOOT_SUCCEEDED"
msgstr "Richiesta di riavvio inviata con successo."

msgid "rbo_RECONFIGURE_SUCCEEDED"
msgstr "Richiesta di riavvio inviata con successo."

msgid "rbo_SHUTDOWN_SUCCEEDED"
msgstr "(en) Shutdown request initiated successfully."
