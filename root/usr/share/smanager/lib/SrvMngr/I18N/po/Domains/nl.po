msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Domein toevoegen"

msgid "dom_CONTENT"
msgstr "[_1] informatie-baai"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "Voor de website, mag u uw primaire website als inhoud kiezen of een van de informatie-baaien."

msgid "dom_CREATE_TITLE"
msgstr "Voeg een nieuw domein toe"

msgid "dom_CURRENT_DOMAINS"
msgstr "Huidige lijst met domeinen"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Als deze server geen verbinding met het Internet heeft, of u heeft speciale eisen voor de DNS bepaling, geef het DNS server IP adres hier op. Deze velden moeten leeg gelaten worden tenzij u specifieke redenen hebt om andere DNS servers te configureren. U moet hier niet de Internet DNS servers van uw ISP ingeven omdat de server alle Internet DNS namen zelf kan opzoeken zonder bijkomende configuratie."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr " Ondernemings DNS instellingen "

msgid "dom_DESC_NAMESERVERS"
msgstr "U kan kiezen of dit domein lokaal wordt opgezocht, doorgegeven naar de DNS servers, of opgezocht door de Internet DNS servers. De standaard is voor de meeste netwerken correct."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "DNS-instellingen van het bedrijf wijzigen"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Fout: Onverwachte of missende tekens in de domein beschrijving [_1]. Het nieuw domein is niet toegevoegd."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Fout: domein [_1] is reeds in gebruik. Het nieuw domein is niet toegevoegd."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Fout: Onverwachte of missende tekens in domeinnaam [_1]. De domeinnaam moet uit een of meer letters, cijfers, punten of koppeltekens bestaan. Het nieuw domein is niet toegevoegd."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Fout: interne fout opgetreden tijdens verwijderen van domein [_1]."

msgid "dom_FORM_DESCRIPTION"
msgstr " Wanneer u een domein toevoegd zal uw server e-mail kunnen ontvangen voor dat domein en zal de server ook een website kunnen hosten voor dat domein.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Voeg domein toe</a> "

msgid "dom_FORM_TITLE"
msgstr "Beheer domeinen"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Primaire DNS server"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Secundaire DNS server"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Domein DNS servers"

msgid "dom_MODIFY_TITLE"
msgstr "Wijzig domein"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Fout: [_1] is geen bestaand domein."

msgid "dom_PRIMARY_SITE"
msgstr "primaire site"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  U staat op het punt het domein [_1] ([_2]) te verwijderen. \n\n  <p> <b>Bent u zeker dat u dit domein wil verwijderen?</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Domein verwijderen"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Domein [_1] is met succes toegevoegd. Uw webserver wordt nu herstart. De links op deze pagina zullen inactief blijven totdat de webserver herstart voltooid is."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Domein [_1] is met succes verwijderd. Uw webserver wordt nu herstart. De links op deze pagina zullen inactief blijven totdat de webserver herstart voltooid is."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Domein [_1] is met succes gewijzigd. Uw webserver wordt nu herstart. De links op deze pagina zullen inactief blijven totdat de webserver herstart voltooid is."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Fout: Domein [_1] is uw systeems domein naam. U kan geen domein hebben met dezelfde naam. Het nieuw domein is niet toegevoegd."

msgid "dom_corporate"
msgstr "Ondernemings DNS servers"

msgid "dom_internet"
msgstr "Internet DNS-servers"

msgid "dom_localhost"
msgstr "Zoek lokaal op"

