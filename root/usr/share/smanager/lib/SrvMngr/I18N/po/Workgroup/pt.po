msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "Este servidor deverá agir como grupo de trabalho e controlador de domínio em sua rede Windows? Você deverá deixar em branco para Não se outro servidor já estiver fazendo esse papel em sua rede."

msgid "wkg_DESC_ROAM"
msgstr " Este servidor deve suportar roaming profiles? Você deverá deixar este campo como padrão para Não a não ser que tenha experiência em administrar um servidor Windows usando roaming profiles e saiba que esta opção é requerida. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Entrar com o nome que esee servidor deverá usar para conpartilhar arquivos com Windows e Macintosh."

msgid "wkg_DESC_WORKGROUP"
msgstr " Entrar com o nome do grupo de trabalho do windows que este servidor deverá aparecer. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Trocar configuração de grupos de trabalho"

msgid "wkg_INVALID_SERVERNAME"
msgstr "O nome do servidor tem que começar com uma letra (maiúscula ou minúscula), seguida de qualquer combinação de letras, números, barras em baixo, pontos e hifens."

msgid "wkg_INVALID_WORKGROUP"
msgstr "O nome do grupo de trabalho tem começar com uma letra (maiúscula ou minúscula), seguida de qualquer combinação de letras, números, barras em baixo, pontos e hifens."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "Os nomes do grupo de trabalho e servidor coincidem, quando comparados em letras minúsculas. Esses valores tem que ser diferentes para que o compartilhamento de arquivos seja ligado."

msgid "wkg_LABEL_PDC"
msgstr "Grupo de trbalho e Controlador de Domínio"

msgid "wkg_LABEL_ROAM"
msgstr "Perfis móveis"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Nome do Servidor"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Grupo de trabalho do windows"

msgid "wkg_SUCCESS"
msgstr "O novo grupo de trabalho foi salvo com sucesso"
