msgid "Local networks"
msgstr "Lokalna omrežja"

msgid "ln_ADD_DESC"
msgstr "(en)Each parameter must be in the form #.#.#.# (each # is a number from 0 to 255). The server software will zero out the ending (host identifier) part of the network address according to the subnet mask, to ensure that the network address is valid.  \"Router\" should be the IP address of the router on your local network via which the additional network is reached."

msgid "ln_ADD_TITLE"
msgstr "Dodaj lokalno omrezje"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "Prišlo je do napake pri ustvarjanju omrežja."

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "Pri brisanju omrežja je prišlo do napake."

msgid "ln_FIRSTPAGE_DESC"
msgstr " Iz varnostnih razlogov, je nekaj storitev omogocenih samo s strani lokalnega omrezja. Kljub temu lahko zunanjim uporabnikom omogocite te storitve tako, da jih dodate na seznam lokalnih (varnih) uporabnikov. (Najveckrat pustimo to prazno.)  Dodaj omrezje "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "Neveljaven IP naslov"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Nepravilna podomrezna maska"

msgid "ln_LOCAL NETWORKS"
msgstr "Lokalna omrežja"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Dodaj omrežje"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "Error: network %1 (derived from network %2 and subnet mask %3) has already been added. Did not add new network."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "Error: network %1 (derived from network %2 and subnet mask %3) is already considered local. Did not add new network."

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "Error: router address %1 is not accessible from local network. Did not add network."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Stevilo gostiteljev (host)"

msgid "ln_REMOVE_DESC"
msgstr "(en)You are about to remove the following local network."

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "(en)Local hosts configured on the network you are about to remove have been detected. By default, they will also be removed. Uncheck this box if, for some reason, you do not wish this to happen. Note that they will not be treated as local, and may not even be reachable, after this network is removed."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "Odstrani gostitelje v omrežju"

msgid "ln_REMOVE_TITLE"
msgstr "Odstrani lokalno omrežje"

msgid "ln_SUBNET_MASK"
msgstr "Podomrezna maska"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "(en)Successfully added network %1/%2 via router %3. Your server will grant local access privileges to %4 IP addresses in the range %5 to %6."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "  Successfully added network %1/%2 via router %3. \n\n  <p> Your server will grant local access privileges to %1 IP addresses in the range %2 to %3. </p>\n\n  <p> Warning: the ProFTPd FTP server cannot handle this nonstandard subnet mask. The simpler specification <b>%1</b> will be used instead. </p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "Uspešno dodal omrežje %1/%2 skozi router %3."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "Successfully added network %1/%2 via router %3. Your server will grant local access privileges to the single IP address %4."
