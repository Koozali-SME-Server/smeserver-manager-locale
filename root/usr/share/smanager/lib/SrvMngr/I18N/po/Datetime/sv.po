msgid "dat_INVALID_MINUTE"
msgstr "Fel: ogiltig minut:"

msgid "dat_INVALID_NTP_SERVER"
msgstr " Ogiltig NTP-server. Servern kommer inte att försöka synkronisera med en tidsserver. "

msgid "dat_INVALID_SECOND"
msgstr "Fel: ogiltig sekund"

msgid "dat_Invalid_date"
msgstr "Ogiltigt datum"

msgid "dat_NTP_CONFIGURE_DESC"
msgstr "Servern synkroniserar periodiskt systemklockan med en tidsserver, med protokoller (NTP), som angetts nedan. För att synkronisera med en annan NTP-server, ange en annat värdnamn eller IP-adress i fältet nedan."

msgid "dat_NTP_DISABLE_DESC"
msgstr "Detta val avslutar synkroniseringen av systemklockan med NTP servern. När NTP-tjänsten ej är tillåten, kan du ställa in systemdatum och tid manuellt från denna sida."

msgid "dat_NTP_ENABLE_DESC"
msgstr "Servern kan periodiskt synkronisera systemklockan med en tidsserver med protokollet (NTP). Om du gör detta val, ange värdnamn eller IP-adress för NTP-servern nedan."

