msgid "iba_FIRSTPAGE_DESC"
msgstr "  Skapa i-bay \n\n   Du kan radera vilken information bay som helst eller återställa dess lösenord genom att klicka på tillhörande kommando vid sidan om information bay. Om information bay visas i rött betyder detta att lösenordet inte har ändrats från förvalda. Lösenordet måste bytas snarast. \n\n  "

msgid "iba_FORM_TITLE"
msgstr "Skapa, ändra eller radera i-bays"

msgid "iba_HTTPS_Only"
msgstr "Tvinga till säkra anslutningar"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "Lösenorden stämmer inte överens."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Lokalt nätverk (inget lösenord krävs)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
