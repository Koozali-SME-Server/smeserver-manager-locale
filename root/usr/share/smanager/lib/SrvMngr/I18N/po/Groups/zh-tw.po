msgid "DELETE_ERROR"
msgstr "(en) DELETE_ERROR"

msgid "grp_ACCOUNT_CONFLICT"
msgstr "錯誤：群組 \"[_1]\" 無法被建立，因為因為已經有相同名稱 [_2] 的帳號。"

msgid "grp_CREATED_GROUP"
msgstr "成功建立使用者群組"

msgid "grp_CREATE_ERROR"
msgstr "建立使用者群組時產生錯誤"

msgid "grp_CURRENT_LIST"
msgstr "即時使用者群組列表\n\n  "

msgid "grp_DELETED_GROUP"
msgstr "成功移除使用者群組"

msgid "grp_DELETE_DESCRIPTION"
msgstr " 您將要移除使用者群組 \"[_1]\" "

msgid "grp_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "grp_FORM_TITLE"
msgstr "建立、修正，或移除使用者群組"

msgid "grp_GROUP_DESC"
msgstr "簡短描述／視窗群組別名"

msgid "grp_GROUP_DESC_EXPL"
msgstr "請於下方欄位輸入群組簡短描述。此欄位在視窗客戶端可由指定的群組名稱來檢視。"

msgid "grp_GROUP_HAS_MEMBERS"
msgstr "此群組包含以下成員："

msgid "grp_GROUP_NAMING"
msgstr "群組名稱僅能使用小寫字母、數字、連字符，句號，和下底線，並且應當由小寫字母起頭。例如： \"sales\", \"beta5\", and \"reseller_partners\" 皆為認可的群組名稱，但是, \"3rd-event\", \"Marketing Team\" and \"lost&found\" 無法認可。"

msgid "grp_GROUP_TOO_LONG"
msgstr "錯誤：群組名稱太長。最多 [_1] 字元。"

msgid "grp_IBAYS_WILL_BE_CHANGED"
msgstr "下列訊息被指定到此群組，而且將被改成管理員群組（您隨後可修改）："

msgid "grp_MODIFIED_GROUP"
msgstr "成功變更使用者群組"

msgid "grp_MODIFY_ERROR"
msgstr "變更使用者群組時產生錯誤"

msgid "grp_NOT_A_GROUP"
msgstr "錯誤：此非既有群組帳號。"

msgid "grp_NO_MEMBERS"
msgstr "錯誤：群組中無成員。勿建立新群組。"
