msgid "Local networks"
msgstr "Lokala nätverk"

msgid "ln_ADD_DESC"
msgstr " Varje parameter måste vara i formatet #.#.#.# (där varje # är ett tal från 0 till 255). Serverns mjukvara kommer att ta bort den avslutande delen (värdidentifieraren) av nätverksadressen enligt subnätmasken för att försäkra att nätverksadressen är giltig.  \"Router\" skall vara den IP-adress på ditt lokala nätverk som det ytterligare nätverket nås via. "

msgid "ln_ADD_TITLE"
msgstr "Lägg till lokalt nätverk"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "Fel inträffade vid skapandet av nätverk."

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "Ett fel inträffade vid radering av nätverk."

msgid "ln_FIRSTPAGE_DESC"
msgstr " Av säkerhetsskäl finns vissa tjänster på din server endast åtkomliga på ditt lokala nätverk. Du kan emellertid ge lokal åtkomst till ytterligare nätverk genom att ange dem nedan. De flesta installationer bör lämna denna lista tom Lägg till nätverk "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "Ogiltig IP-adress"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Ogiltig subnätmask"

msgid "ln_LOCAL NETWORKS"
msgstr "Lokala nätverk"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Lägg till nätverk"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "Fel: Nätverk %1 (tagen ur nätverk %2 och subnätmask %3) har redan lagts till. Nätverk lades inte till."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "Fel: Nätverk %1 (tagen ur nätverk %2 och subnätmask %3) anses redan vara lokal. Nätverket lades inte till."

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "Fel: router-adressen %1 är inte tillgänglig på det lokala nätverket. Nätverket lades inte till."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Antal värdar"

msgid "ln_REMOVE_DESC"
msgstr "Du håller på att radera följande lokal nätverk."

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "Lokala värdar som är konfigurerade på nätverket och som du håller på att ta bort, har upptäckts. De kommer att bli raderade. Avmarkera denna ruta om du, av något skäl, inte vill att detta skall ske. Notera att de kommer att bli behandlade som lokala och att de kanske inte ens bli nåbara, efter det att detta nätverk har raderats."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "Radera värdar på nätverket"

msgid "ln_REMOVE_TITLE"
msgstr "Radera lokalt nätverk"

msgid "ln_SUBNET_MASK"
msgstr "Subnätmask"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "Lagt till nätverket %1/%2 via router %3. Din server tillåter lokala åtkomstprivilegier till %4 IP-adresser inom intervallet %5 till %6."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "  Lagt till nätverk %1/%2 via router %3. \n\n  <p> Din server tillåter lokala åtkomstprivilegier till %1 IP-adresser inom intervallet %2 till %3. </p>\n\n  <p> Varning: ProFTPd FTP-server kan inte hantera denna icke standardiserade nätverksmask. Den enklare specifikationen <b>%1</b> kommer att användas istället. </p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "Radera nätverk %1/%2 via router %3."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "Lagt till nätverket %1/%2 via router %3. Din server tillåter lokala åtkomstprivilegier till den enstaka nätverksadressen %4."
