msgid "NO_SUCH_USER"
msgstr "(en) There does not appear to be any such user"

msgid "pwd_ACCOUNT_PASSWORD_CHANGE"
msgstr "Spremeni geslo računa"

msgid "pwd_DESCRIPTION"
msgstr "  Za zamenjavo gesla vasemu uporabniskemu imenu, uporabite spodnji obrazec. vpisati boste morali vase <b>uporabnisko ime</b> vase sedanje geslo in zeljeno novo geslo. (Novo geslo morate zaradi varnosti vpisati dva krat.)\n\n  <p> Ce ste vase staro geslo pozabili in zaradi tega ne morete zamenjati gesla, vam lahko geslo ponastavi vas skrbnik streznika z uporabo <em>spletne nadzorne plosce</em>.</p>\n\n  "

msgid "pwd_DESCRIPTION_RESET"
msgstr "(en)To reset your account password, please fill out the following form. You will need to provide your desired new password. (You must type it twice.)In cas of problem, your local system administrator can reset your password using the <EM>server manager</EM>."

msgid "pwd_ERROR_PASSWORD_CHANGE"
msgstr "(en)An error occurred while attempting to change your password. Please make sure that the old password entered is correct. Old and new passwords should be different."

msgid "pwd_ERR_OCCURRED_MODIFYING_PASSWORD"
msgstr "(en) Err occurred modifying password"

msgid "pwd_FIELDS_REQUIRED"
msgstr "Vsa polja so obvezna"

msgid "pwd_INTERMEDIATE_PASSWORD_DESCRIPTION"
msgstr "(en)The password must be composed of at least [_1] characters with uppercase and lowercase letters and must pass a dictionary check."

msgid "pwd_INVALID_REQUEST"
msgstr "(en) Invalid request"

msgid "pwd_NONE_PASSWORD_DESCRIPTION"
msgstr "(en)The password must be composed of at least [_1] characters."

msgid "pwd_NORMAL_PASSWORD_DESCRIPTION"
msgstr "(en)The password must be composed of at least [_1] characters with uppercase and lowercase letters."

msgid "pwd_OK_FOR_RESET"
msgstr "(en) Ok for reset"

msgid "pwd_PASSWORD_CHANGE"
msgstr "Spremeni geslo"

msgid "pwd_PASSWORD_CHANGE_SUCCESS"
msgstr "(en)Your password has been successfully changed."

msgid "pwd_PASSWORD_INVALID_CHARS"
msgstr "(en)The password you entered contained invalid characters."

msgid "pwd_PASSWORD_NEW"
msgstr "Novo geslo:"

msgid "pwd_PASSWORD_OLD"
msgstr "Staro geslo:"

msgid "pwd_PASSWORD_OLD_INVALID_CHARS"
msgstr "(en)The old password you entered contained invalid characters."

msgid "pwd_PASSWORD_RESET"
msgstr "Ponastavi geslo"

msgid "pwd_PASSWORD_VERIFY_ERROR"
msgstr "(en)The new passwords you entered did not match."

msgid "pwd_PASSWORD_VERIFY_NEW"
msgstr "Novo geslo (potrditev):"

msgid "pwd_PASSWORD_WIKI"
msgstr "(en)If you want to know more about passwords, then please refer to the <a href='https://wiki.koozali.org/SME_Server:Documentation:Administration_Manual:Chapter9#Changing_User_Passwords'>Wiki</a>"

msgid "pwd_STRONG_PASSWORD_DESCRIPTION"
msgstr "(en)The password must be composed of at least [_1] characters with uppercase and lowercase letters, numbers and special characters and must pass a dictionary check."

msgid "pwd_TAINTED_PASSWORD"
msgstr "(en)The new password starts with invalid characters."

msgid "pwd_TAINTED_USER"
msgstr "(en)The account name \"[_1]\" contains invalid characters."

msgid "pwd_YOUR_ACCOUNT"
msgstr "Vaš račun:"
