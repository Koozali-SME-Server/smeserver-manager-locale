msgid "Hostnames and addresses"
msgstr "Nama host dan alamat"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "Alamat berada dalam jangkauan alamat yang telah ditentukan bagi alamat dinamis DHCP."

msgid "hos_ADD_HOSTNAME"
msgstr " Buat hostname "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Buat atau ubah hostname"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Daftar hostname saat ini untuk %1"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Terjadi kesalahan pada saat membuat hostname."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Terjadi kesalahan pada saat menghapus hostname."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Terjadi kesalahan pada saat mengubah hostname."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Error: IP tidak boleh alamat IP server atau alamat IP Gateway."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Error : Alamat IP ini tidak termasuk dalam jaringan lokal ini."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Alamat Ethernet"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "Alamat ethernet adalah opsional dan akan menyebabkan server DHCP memberikan alamat IP lokal tersebut secara tetap kepada komputer yang memiliki alamat ethernet ini. Jika diisi, harus dalam format \"AA:BB:CC:DD:EE:FF\" dan hanya boleh berisi angka0-9 dan huruf A-F."

msgid "hos_FORM_TITLE"
msgstr "Nama host dan alamat"

msgid "hos_HOSTNAME"
msgstr "Nama host"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Error: karakter yang tidak diperbolehkan dalam host name: \"%1.%2\". nama host hanya boleh terdiri dari huruf, angka, dan hyphens harus dimulai dengan huruf atau angka."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Hostname hanya boleh terdiri dari huruf, angka, hyphen dan harus dimulai dengan huruf dan angka."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Error: akun %1 adalah nama host%2 yang sudah ada."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Error: karakter yang tidak diperbolehkan dalam host name: \"%1.%2\". nama host hanya boleh terdiri dari huruf, angka, dan hyphens harus dimulai dengan huruf atau angka."

msgid "hos_HOSTTYPE"
msgstr "Lokasi"

msgid "hos_LOCAL_IP"
msgstr "IP Lokal"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "Alamat IP adalah alamt IP computer lain didalam jaringan lokal. Silakan isi alamat IP yang valid dalam format \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Silakan masukkan detil tambahan berikut pada local host:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Ubah nama host"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Silakan masukkan detil tambahan berikut pada remote host:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Anda akan menghapus nama host \"%1.%2\".   Anda yakin menghapus hostname ini? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Hapus nama host"

