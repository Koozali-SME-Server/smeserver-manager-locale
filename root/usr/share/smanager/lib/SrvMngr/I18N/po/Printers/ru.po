msgid "Printers"
msgstr "Принтеры"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "Вы собираетесь удалить принтер:"

msgid "prt_ARE_YOU_SURE"
msgstr "Вы действительно хотите удалить принтер?"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "Принтер успешно создан:"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "Пожалуйста, введите адрес и имя сетевого принтера"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "Создать новый сетевой принтер"

msgid "prt_CREATE_NEW_DESC"
msgstr "Пожалуйста, выберите уникальное имя для принтера и введите краткое описание. Имя принтера должно содержать только строчные буквы и цифры, и должно начинаться со строчной буквы. Например, \"hplaser\", \"epsonlp\", and \"canonbj\" - правильный выбор, а \"HP Laser Jet\", \"Canon BubbleJet\" и \"HP JetDirect Printer\" - нет. Избегайте имён и описаний, которые содержат эти термины: \"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\", \"paper\", \"error\" и \"responding\"."

msgid "prt_CREATE_NEW_PRINTER"
msgstr "Создать новый принтер"

msgid "prt_CURRENT_LIST"
msgstr "Текущий список принтеров"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "Принтер успешно удалён:"

msgid "prt_ERR_EXISTS"
msgstr "Ошибка: учётная запись с таким именем существует, тип:"

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "Ошибка: внутрениий сбой при удалении принтера:"

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "Ошибка: неверный сетевой адрес. Новый принтер не создан."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "Ошибка: неверное сетевое имя принтера. Новый принтер не создан."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "Ошибка: неожиданные или отсутствующие символы в описании. Новый принтер не создан."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr " Ошибка: неожиданные символы в имени принтера. Имя принтера должно содержать только строчные буквы и цифры, и должно начинаться с буквы в нижнем регистре. Например, \"hplaser\", \"epsonlp\" и \"canonbj\" допустимые имена. "

msgid "prt_FIRST_USB_PRINTER"
msgstr "Первый, подключённый по USB, принтер"

msgid "prt_FORM_TITLE"
msgstr "Добавление и удаление принтеров"

msgid "prt_HOSTNAME_OR_IP"
msgstr "Имя узла или IP адрес сетевого принтера"

msgid "prt_INITIAL_BTN"
msgstr "Добавить принтер"

msgid "prt_LOCAL_PRINTER_0"
msgstr "Локальный порт принтера 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "Локальный порт принтера 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "Локальный порт принтера 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "Должно быть правильное имя узла или IP адрес"

msgid "prt_NET_PRINTER"
msgstr "Сетевой принтер ..."

msgid "prt_NO_PRINTERS"
msgstr "Ни один принтер не установлен."

msgid "prt_PRINTER_NAME"
msgstr "Имя принтера"

msgid "prt_REMOTE_ADDRESS"
msgstr "Удалённый адрес"

msgid "prt_REMOTE_NAME"
msgstr "Удалённое имя"

msgid "prt_REMOTE_NAME_DESC"
msgstr " Имя сетевого принтера (если не уверены, введите raw) "

msgid "prt_REMOVE_PRINTER"
msgstr "Удалить принтер"

msgid "prt_SECOND_USB_PRINTER"
msgstr "Второй, подключённый по USB, принтер"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "Все спул-файлы этого принтера будут удалены."

