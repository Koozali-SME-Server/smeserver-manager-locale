msgid "Printers"
msgstr "Printere"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "Du er ved at fjerne printeren:"

msgid "prt_ARE_YOU_SURE"
msgstr "Er du sikker på du vil fjerne denne printer?"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "Har oprettet printer:"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "Venligst indtast adresse og navn for netværksprinteren"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "Opret ny netværksprinter"

msgid "prt_CREATE_NEW_DESC"
msgstr "Vælg et unikt navn for printeren og angiv en kort beskrivelse. Navnet skal starte med et lille bogstav og må kun indeholde små bogstaver og tal. Fx \"hplaser\", \"epsonlp\", og \"canonbj\" er gyldige, men \"HP Laser Jet\", \"Canon BubbleJet\", og \"HP JetDirect Printer\" er ikke. Undgå navne og beskrivelser, der indeholder følgende udtryk: \"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\", \"paper\", \"error\" og \"responding\"."

msgid "prt_CREATE_NEW_PRINTER"
msgstr "Opret en ny printer"

msgid "prt_CURRENT_LIST"
msgstr "Aktuel printerliste"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "Har slettet printer:"

msgid "prt_ERR_EXISTS"
msgstr "Fejl: En konto ved samme navn findes allerede som:"

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "Fejl: Der opstod en intern fejl under fjernelse af printeren:"

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "Fejl: Ugyldig netadresse. Printeren blev ikke oprettet."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "Fejl: Ugyldigt netprinternavn. Printeren blev ikke oprettet."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "Fejl: Uventede eller manglende anslag i beskrivelsen. Printeren blev ikke oprettet."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr " Fejl: Uventede anslag i printernavn. Printernavne må kun indeholde små bogstaver og tal og skal starte med et lille bogstav. F.eks. er \"hplaser\", \"epsonlp\" og \"canonbj\" gyldige navne. "

msgid "prt_FIRST_USB_PRINTER"
msgstr "1. USB-printer"

msgid "prt_FORM_TITLE"
msgstr "Tilføj eller fjern printere"

msgid "prt_HOSTNAME_OR_IP"
msgstr "Værtsnavn og IP-adresse for netprinteren"

msgid "prt_INITIAL_BTN"
msgstr "Tilføj printer"

msgid "prt_LOCAL_PRINTER_0"
msgstr "Lokal printer port 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "Lokal printer port 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "Lokal printer port 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "Skal være gyldigt værtsnavn eller IP-nummer"

msgid "prt_NET_PRINTER"
msgstr "Netværksprinter ..."

msgid "prt_NO_PRINTERS"
msgstr "Der er ingen printere i systemet."

msgid "prt_PRINTER_NAME"
msgstr "Printernavn"

msgid "prt_REMOTE_ADDRESS"
msgstr "Fjern adresse"

msgid "prt_REMOTE_NAME"
msgstr "Fjern navn"

msgid "prt_REMOTE_NAME_DESC"
msgstr " Netvæksprinters navn (indtast raw, hvis du er i tvivl) "

msgid "prt_REMOVE_PRINTER"
msgstr "Fjern printer"

msgid "prt_SECOND_USB_PRINTER"
msgstr "2. USB-printer"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "Alle til denne printer hørende filer vil blive slettet."

