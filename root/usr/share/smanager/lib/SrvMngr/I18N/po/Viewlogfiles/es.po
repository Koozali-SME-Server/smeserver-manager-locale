msgid "LOG_LIVESTREAM"
msgstr "(en) Live stream"

msgid "log_END_DESC"
msgstr "Observe que puede demorar varios minutos en generar esos informes."

msgid "log_ERR_NOEXIST_FILE"
msgstr "(en) Err noexist file"

msgid "log_ERR_NOOPEN_FILE"
msgstr "(en) Err noopen file"

msgid "log_FILENAME_ERROR"
msgstr " Ocurrió un error al especificar el nombre del archivo de registro.\n\n  <p>Tipo de informe inválido \"[_1]\".</p>\n\n  "

msgid "log_FILTER_PATTERN_DESC"
msgstr " Opcionalmente, puede especificar un patrón de filtro para mostrar sólo las líneas del archivo de registro que coincidan con este patrón. Si deja este campo en blanco, se mostrarán todas las líneas disponibles del archivo de registro. Tenga presente que esta opción no tiene ningún efecto si usted elige descargar el archivo.\n\n  "

msgid "log_FILTER_PATTERN_HINT"
msgstr "(en) The pattern is case insensitive, but enclosing it in \"/\" will result in it being treated as a regex."

msgid "log_FILTER_PATTERN_LABEL"
msgstr "Patrón de Filtro (opcional)"

msgid "log_FIRSTPAGE_DESC"
msgstr " Este panel le permite ver o descargar los archivos de registro generados por los servicios que se ejecutan en el servidor. "

msgid "log_FORM_TITLE"
msgstr "Ver archivos de registro"

msgid "log_HIGHLIGHT_HEADER"
msgstr "Destacar las líneas que coincidan con: \"[_1]\"."

msgid "log_LOG_FILE_EMPTY"
msgstr "¡El archivo de registro \"[_1]\" está vacío!"

msgid "log_LOG_FILE_SELECT_DESC"
msgstr "Elija el archivo de registro que desea ver"

msgid "log_MATCH_HEADER"
msgstr "Mostrar las líneas que coincidan con: \"[_1]\"."

msgid "log_MATCH_PATTERN_DESC"
msgstr " Opcionalmente, también puede especificar un patrón de resaltado para marcar en negrita cualquier línea del archivo de registro que concuerde con dicho patrón. El patrón de resaltado se aplica a todas las líneas que ya coincidan con el patrón de filtro. Tenga presente que esta opción no tiene ningún efecto si usted elige descargar el archivo.\n\n  "

msgid "log_MATCH_PATTERN_LABEL"
msgstr "Patrón de Resaltado (opcional)"

msgid "log_NO_MATCHING_LINES"
msgstr "No hay líneas que coincidan."

msgid "log_OP_DESC"
msgstr " Debe elegir entre ver el archivo de registro en su navegador o descargarlo a su ordenador. Si el archivo de registro es particularmente grande, puede descargarlo en lugar de tratar de abrirlo en el navegador, pues esto representa un problema para algunos navegadores.\n\n  "

msgid "log_OP_LABEL"
msgstr "Operación"

msgid "log_REFRESH"
msgstr "Actualizar"

msgid "log_VIEW"
msgstr "Ver archivo de registro"

msgid "log_VIEWING_TIME"
msgstr "Visto a las [_1]."

