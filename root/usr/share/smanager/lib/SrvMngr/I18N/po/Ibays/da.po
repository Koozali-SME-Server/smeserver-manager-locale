msgid "iba_ACCOUNT_EXISTS"
msgstr "Kontoen \"%1\" er en eksisterende %2 konto."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " Kontoen \"%1\" er i konflikt med pseudonym detaljer for %2 konto \"%3\". %1 er pseudonym for %3. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "I-bay navnet \"%1\" indehold ulovlige tegn. I-bay navne skal starte med et lille bogstav og må kun indeholde små bogstaver, tal og bindestreger."

