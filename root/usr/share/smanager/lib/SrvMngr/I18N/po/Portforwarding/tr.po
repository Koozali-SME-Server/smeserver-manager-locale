msgid "Port forwarding"
msgstr "(en) Port forwarding"

msgid "pf_ALLOW_HOSTS"
msgstr "Kabul edilen hostlar"

msgid "pf_CREATE_RULE"
msgstr "Port yönlendirme kuralı oluştur"

msgid "pf_ERR_BADAHOST"
msgstr "Bu geçerli IP adres listesi değil. örn: 192.168.0.1,192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "Bu IP adresine benzemiyor. Noktalarla ayrılmış dörtlü sayı grupları kullanılmalı, bunlar 255'ten köçük sayılar olmalıdır. örn: 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "Port numarası 65536 dan küçük pozitif tamsayı olmalıdır."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "Olay sıfır olmayan sonuç döndürdü."

msgid "pf_ERR_PORT_COLLISION"
msgstr "HATA: Bu port aralığı mevcut kurallarla çakıştı. Lütfen bu yeni kuralı değiştirin veya eski kuralı silin."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  Bu paneli ateş duvarı ayarlarını yapmak için kullanabilirsiniz buradan özel port açma veya başka hosta yönlendirme tanımlanabilir. Bunu yapmakla özel sunucunuza AĞDAN doğrudan rişim sağlayabilirsiniz. \n\n  <p> DİKKAT: Bu yerel ağınızsa sızmalara sebep olabilir. Bu işlemin sonuçlarını tam anlamadan kullanmamanız önerilir. </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Port Yönlendirmeyi Ayarla"

msgid "pf_IN_SERVERONLY"
msgstr "Bu sunucu \"sadece sunucu\" modunda çalışıyor ve port yönlendirme sadece localhost için geçerli olacaktır."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Varış Hostun IP Adresi"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Varış Port(ları)"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protokol"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Kaynak Port(lar)"

msgid "pf_NO_FORWARDS"
msgstr "Bu sistemde tanımlı port yönlendirme bulunmamaktadır."

msgid "pf_RULE_COMMENT"
msgstr "Kural Açıklamaları"

msgid "pf_SHOW_FORWARDS"
msgstr "Aşağıda, bu sunucuda tanımlı port yönlendirme kurallarını görebilirsiniz. İlgili kuralı silmek için &quot;Sil&quot; butonuna basın."

msgid "pf_SUCCESS"
msgstr "Port yönlendirme kurallarınız başarıyla kaydedildi."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "Eklenecek port yönlendirme kuralları özeti. Bunu uygulamak için &quot;Ekle&quot; butonuna basın. İstemiyorsanız &quot;İptal&quot; butonuna basın."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "Silinecek port yönlendirme kuralları özeti. Bu kuralı silmek için &quot;Sil&quot; butonuna basın. Vazgeçmek için &quot;İptal&quot; butonuna basın."

