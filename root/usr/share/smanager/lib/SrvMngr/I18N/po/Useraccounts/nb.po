msgid "usr_ACCOUNT_CONFLICT"
msgstr "Feil: kontoen \"%1\" kan ikke opprettes fordi det allerede er en %2konto med det navnet."

msgid "usr_ACCOUNT_NAME"
msgstr "Kontonavn"

msgid "usr_ACCOUNT_TOO_LONG"
msgstr "Feil: kontonavnet er for langt. maksimal lengde er %1 tegn."

msgid "usr_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "Kontonavnet \"%1\" inneholder ugyldige tegn. Kontonavn må starte med liten bokstav og bare inneholde små bokstaver, tall, bindestrek, punktum og understreker."

msgid "usr_ADD_USER"
msgstr "Legg til brukerkonto"

msgid "usr_CANNOT_CONTAIN_WHITESPACE"
msgstr "Dette feltet kan ikke inneholde tomme tegn"

msgid "usr_CANNOT_MODIFY_USER"
msgstr "Feil: en intern feil oppsto under forsøk på å endre brukeren \"%1\"."

msgid "usr_CANNOT_MODIFY_USER_GROUPS"
msgstr "(en) Error: an internal error occurred while attempting to modify the group \"%1\" for user \"%2\"."

msgid "usr_CITY"
msgstr "By"

msgid "usr_COMPANY"
msgstr "Firma"

msgid "usr_CREATE_MODIFY_DESC"
msgstr "  Kontonavnet må bare inneholde små bokstaver, tall, bindestreker, punktum, understreker og må starte med liten bokstav. For eksempel \"betty\", \"hjohnson\", og \"mary-jane\" er gyldige kontonavn, men \"3friends\", \"John Smith\", og \"henry:miller\" er ikke. \n\n  <p> Merk at to spesielle pseudonymer vil bli opprettet for hver nye konto. Disse pseudonymene gir muligheten til å ha alternative e-post kontoer for den brukeren som inneholder fornavn og etternavn adskilt med punktum(.) og understrek (_). Så, for kontoen \"betty\" med fornavnet \"Betty\" og etternavnet \"Rubble\" blit to pseudonymer opprettet som betty.rubble og betty_rubble. </p>\n\n  <p> Adressebokinformasjonen (avdeling, firma, osv.)kan bli endret fra standard vist nedenfor. Endringene vil kun gjelde for denne brukeren. </p>\n\n  "

msgid "usr_CURRENT_SYSTEM_PASSWORD"
msgstr "Gjeldene systempassord"

msgid "usr_DELIVER_AND_FORWARD"
msgstr "Lever både lokalt, og videresend"

msgid "usr_DELIVER_EMAIL_LOCALLY"
msgstr "Lever e-post lokalt"

msgid "usr_DEPARTMENT"
msgstr "Avdeling"

msgid "usr_EMAIL_DELIVERY"
msgstr "E-post levering"

msgid "usr_ERR_OCCURRED_CREATING"
msgstr "En feil oppsto under oppretting av kontoen."

msgid "usr_ERR_OCCURRED_DELETING"
msgstr "En feil oppsto under forsøk på å slette brukeren."

msgid "usr_ERR_OCCURRED_LOCKING"
msgstr "(en) Err occurred locking"

msgid "usr_ERR_OCCURRED_MODIFYING_PASSWORD"
msgstr "En feil oppsto under oppdateringen av passordet"

msgid "usr_FIRSTNAME"
msgstr "fornavn"

msgid "usr_FIRSTPAGE_DESC"
msgstr "  <a class=\"button-like\" href=\"useraccounts?page=0&page_stack=&next=next\">Legg til brukerkonto</a> \n\n  <p> Du kan endre, låse eller fjerne kontoer eller nullstille kontoens passord ved å klikke på tilhørende kommando ved siden av kontoen. </p>\n\n  <p> Hvis kontoen er markert som låst, betyr det at brukerens passord må nullstilles. Merk at nyopprettede kontoer automatisk er låst inntil passordet endres. </p>\n\n  "

msgid "usr_FORM_TITLE"
msgstr "Opprett, endre, eller fjerne brukerkontoer"

msgid "usr_FORWARDING_ADDRESS"
msgstr "Videresendingsadresse"

msgid "usr_FORWARD_EMAIL"
msgstr "Videresend e-post til adressen nedenfor"

msgid "usr_GROUP_MEMBERSHIPS"
msgstr "Gruppemedlemskap"

msgid "usr_INTERMEDIATE_PASSWORD_DESCRIPTION"
msgstr "(en)The password strength is set to <strong>%2</strong> which means it must be composed of at least %1 characters with uppercase and lowercase letters and must pass a dictionary check."

msgid "usr_LABEL_IPSECRW_DOWNLOAD"
msgstr "Last ned digitalt sertifikat til IPSec klient"

msgid "usr_LASTNAME"
msgstr "etternavn"

msgid "usr_LOCK"
msgstr "Lås"

msgid "usr_LOCKED_ACCOUNT"
msgstr "Kontoen til brukeren \"%1\" er låst."

msgid "usr_LOCK_ACCOUNT"
msgstr "(en) Lock account"

msgid "usr_LOCK_ACCOUNT_TITLE"
msgstr "Lås brukerkonto"

msgid "usr_LOCK_DESC"
msgstr "Du er i ferd med å låse brukerkontoen"

msgid "usr_LOCK_DESC2"
msgstr " Brukerkontoen vil bli låst. Det betyr at brukeren ikke kan logge på, eller hente e-post. Mottatt e-post vil fortsatt lagres og eller videresendes til en ekstern adresse, som spesifisert. Kontoen kan aktiveres i fremtiden ved å sette et nytt passord. Gjeldende passord vil ikke bli beholdt.   Er du sikker på at du vil låse kontoen? "

msgid "usr_MAX_user_NAME_LENGTH_ERROR"
msgstr "(en) Max user name length error"

msgid "usr_MEMBER"
msgstr "Medlem?"

msgid "usr_MODIFY_ADMIN_TITLE"
msgstr "Endre admin kontoen"

msgid "usr_NEW_SYSTEM_PASSWORD"
msgstr "Nytt systempassord"

msgid "usr_NEW_SYSTEM_PASSWORD_VERIFY"
msgstr "Nytt systempassord (bekreft)"

msgid "usr_NONE_PASSWORD_DESCRIPTION"
msgstr "(en)The password strength is set to <strong>%2</strong> which means it must be composed of at least %1 characters."

msgid "usr_NORMAL_PASSWORD_DESCRIPTION"
msgstr "(en)The password strength is set to <strong>%2</strong> which means it must be composed of at least %1 characters with uppercase and lowercase letters."

msgid "usr_NO_SUCH_USER"
msgstr "Feil: brukerkontoen \"%1\" eksisterer ikke."

msgid "usr_NO_USER_ACCOUNTS"
msgstr "Det er ingen brukerkontoer på systemet."

msgid "usr_P2_TITLE"
msgstr "Opprett eller endre"

msgid "usr_PASSWORD_CHANGE_SUCCEEDED"
msgstr "Passordet for brukeren \"%1\" er endret."

msgid "usr_PASSWORD_WIKI"
msgstr "(en)If you want to know more about passwords, then please refer to the <a href='https://wiki.koozali.org/SME_Server:Documentation:Administration_Manual:Chapter9#Changing_User_Passwords'>Wiki</a>"

msgid "usr_PHONE_NUMBER"
msgstr "Telefonnummer"

msgid "usr_PSEUDONYM_CLASH"
msgstr "Feil: Pseudonymet \"%1\" er allerede i bruk av den eksiterende brukerkontoen \"%2\". For å diffrensiere, legg til initialer til feltet."

msgid "usr_REMOVE_ACCOUNT_TITLE"
msgstr "Fjern brukerkonto"

msgid "usr_REMOVE_DESC"
msgstr "Du er i ferd med å fjerne brukerkontoen"

msgid "usr_REMOVE_DESC2"
msgstr " Alle filer tilhørende brukerkontoen vil bli slettet. Det gjelder også e-post til brukerkontoen som ennå ligger på serveren (d.v.s. som enda ikke har blit lastet ned av brukeren) vil bli forkastet.   Er du sikker på at du vil fjerne kontoen? "

msgid "usr_RESET_DESC"
msgstr "Du er i ferdi med å endre passordet for brukerkontoen"

msgid "usr_RESET_DESC2"
msgstr "Skriv inn det nye passordet i feltet nedenfor"

msgid "usr_STREET_ADDRESS"
msgstr "Gateadresse"

msgid "usr_STRONG_PASSWORD_DESCRIPTION"
msgstr "(en)The password strength is set to <strong>%2</strong> which means it must be composed of at least %1 characters with uppercase and lowercase letters, numbers and special characters and must pass a dictionary check."

msgid "usr_SUCCESSFULLY_DELETED_USER"
msgstr "(en) Successfully deleted user"

msgid "usr_SYSTEM_PASSWORD_AUTH_ERROR"
msgstr "Gjeldende passord er feil."

msgid "usr_SYSTEM_PASSWORD_CHANGED"
msgstr "Systempassordet er endret."

msgid "usr_SYSTEM_PASSWORD_DESCRIPTION"
msgstr " Noen tjenester på serverinstallasjonen krever brukernavn og passord (for eksempel denne websiden for server manager programmet). Brukernavnet er alltid admin. Du kan endre systempassordet ved å bruke feltet nedenfor. "

msgid "usr_SYSTEM_PASSWORD_FORM_TITLE"
msgstr "(en) Change system password"

msgid "usr_SYSTEM_PASSWORD_UNPRINTABLES_IN_PASS"
msgstr "Passordet må kun inneholde printbare tegn."

msgid "usr_SYSTEM_PASSWORD_VERIFY_ERROR"
msgstr "De to passordene er ikke like."

msgid "usr_TAINTED_PASSWORD"
msgstr "(en)The new password starts with invalid characters."

