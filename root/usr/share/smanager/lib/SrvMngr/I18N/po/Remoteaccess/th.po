msgid "rma_PASSWORD_LOGIN_PUBLIC"
msgstr "เปิดรับจากทุกที่โดยใช้รหัสผ่าน"

msgid "rma_REMOTE_MANAGEMENT"
msgstr "การจัดการระยะไกล"

msgid "rma_SUBNET_MASK"
msgstr "ซับเน็ตมาสก์"

msgid "rma_SUCCESS"
msgstr "ข้อมูลใหม่ของการตั้งค่า remote access ถูกบันทึกแล้ว"

msgid "rma_TITLE_FTP_ACCESS"
msgstr "การตั้งค่า FTP"

msgid "rma_TITLE_IPSECRW"
msgstr "การตั้งค่าไคลเอนต์ IPSEC (Roadwarrior)"

msgid "rma_TITLE_PPTP"
msgstr "การตั้งค่า PPTP"

msgid "rma_TITLE_SSH"
msgstr "การตั้งค่า Secure Shell"

msgid "rma_TITLE_TELNET_ACCESS"
msgstr "การตั้งค่า Telnet"

msgid "rma_VALIDFROM_DESC"
msgstr " [_1] คุณสามารถเปิดให้โฮสต์จาก remote networks สามารถเข้าถึงเซิร์ฟเวอร์นี้ได้โดยกรอกข้อมูลเครือข่ายเหล่านั้นด้านล่าง Use a subnet mask of 255.255.255.255 to limit the access to the specified host. Any hosts within the specified range will be able to access the server manager using HTTPS. "

msgid "rma_VALIDFROM_TITLE"
msgstr "[_1]"

