msgid "rma_LABEL_SSH_ADMIN"
msgstr "อนุญาตให้ใช้คำสั่งจัดการระบบ (administrative command line) ผ่าน secure shell"

msgid "rma_LABEL_SSH_PASSWORD_ACCESS"
msgstr "อนุญาตให้เข้าถึง secure shell โดยใช้รหัสผ่านแบบ standard"

msgid "rma_LABEL_SSH_PORT"
msgstr "หมายเลขพอร์ท TCP ของการเข้าถึงแบบ secure shell "

msgid "rma_LABEL_TELNET_ACCESS"
msgstr "การเข้าถึงผ่าน telnet"

msgid "rma_NO_ACCESS"
msgstr "ไม่เปิดให้เข้าถึง"

msgid "rma_NO_ENTRIES_YET"
msgstr "ยังไม่มีการกรอกข้อมูล"

msgid "rma_NUMBER_OF_PPTP_CLIENTS_MUST_BE_LESSER_THAN_NUMBER_OF_IP_IN_DHCP_RANGE"
msgstr "(en)The number of pptp clients is greater than the number of reserved IP for DHCP. You should take a smaller number."

msgid "rma_NUM_OF_HOSTS"
msgstr "จำนวนของโฮสท์"

msgid "rma_PASSWORD_LOGIN_PRIVATE"
