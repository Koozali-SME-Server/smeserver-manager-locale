msgid "Printers"
msgstr "Nyomtatók"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "A következő nyomtatót készül eltávolítani:"

msgid "prt_ARE_YOU_SURE"
msgstr "Biztos benne, hogy eltávolítja ezt a nyomtatót?"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "Sikeresen hozzáadott nyomtató:"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "Kérem adja meg a hálózati nyomtató nevét és IP címét"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "Új hálózati nyomtató hozzáadása"

msgid "prt_CREATE_NEW_DESC"
msgstr "Kérem adjon egy egyedi nevet a nyomtatóhoz és egy rövid leírást. A nyomtató neve csak kisbetűket és számokat tartalmazhat, és betűvel kell kezdődnie. Például \"hplaser\", \"epsonlp\", és \"canonbj\" érvényes nevek, de a \"HP Laser Jet\", \"Canon BubbleJet\", és \"HP JetDirect Printer\" helytelen. Kerülje az olyan angol neveket és leírásokat mint \"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\", \"paper\", \"error\" and \"responding\"."

msgid "prt_CREATE_NEW_PRINTER"
msgstr "Új nyomtató hozzáadása"

msgid "prt_CURRENT_LIST"
msgstr "Nyomtatók listája"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "Sikeresen eltávolított nyomtató:"

msgid "prt_ERR_EXISTS"
msgstr "Hiba: Egy létező fiók azonos névvel és típussal: "

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "Hiba: belső hiba a következő nyomtató eltávolítása során:"

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "Hiba: érvénytelen hálózati cím. Nyomtató hozzáadása sikertelen."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "Hiba: érvénytelen hálózati nyomtatónév. Nyomtató hozzáadása sikertelen."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "Hiba: helytelen, vagy hiányzó karakterek a leírásban. A nyomtató hozzáadása sikertelen."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr " Hiba: Helytelen karakterek a nyomtatónévben. A nyomtató neve csak kisbetűket és számokat tartalmazhat, és betűvel kell kezdődnie. Például a \"hplaser\", \"epsonlp\", és \"canonbj\" érvényes nevek. "

msgid "prt_FIRST_USB_PRINTER"
msgstr "Első USB-re kötött nyomtató"

msgid "prt_FORM_TITLE"
msgstr "Nyomtatók hozzáadása vagy eltávolítása"

msgid "prt_HOSTNAME_OR_IP"
msgstr "A hálózati nyomtató neve és IP címe"

msgid "prt_INITIAL_BTN"
msgstr "Nyomtató hozzáadása"

msgid "prt_LOCAL_PRINTER_0"
msgstr "Helyi nyomtató port 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "Helyi nyomtató port 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "Helyi nyomtató port 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "Érvényes névnek és IP címnek kell lennie"

msgid "prt_NET_PRINTER"
msgstr "Hálózati nyomtató ..."

msgid "prt_NO_PRINTERS"
msgstr "Nincsenek nyomtatók hozzáadva a rendszerhez."

msgid "prt_PRINTER_NAME"
msgstr "Nyomtató név"

msgid "prt_REMOTE_ADDRESS"
msgstr "Távoli cím"

msgid "prt_REMOTE_NAME"
msgstr "Távoli név"

msgid "prt_REMOTE_NAME_DESC"
msgstr " Hálózati nyomtató név (állítson be raw-ot ha bizonytalan) "

msgid "prt_REMOVE_PRINTER"
msgstr "Nyomtató eltávolítása"

msgid "prt_SECOND_USB_PRINTER"
msgstr "Második USB-re kötött nyomtató"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "A nyomtató minden spool fájlja törlésre kerül."

