msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "Kas see server kontrollib windowsi töörühma ja domeeni? Jäta see nii nagu on 'Ei' kui mõni teine server seda juba teeb."

msgid "wkg_DESC_ROAM"
msgstr " Kas see server toetab rändprofiile? Jäta see nii nagu on 'Ei'Kui sul puudub kogemus rändprofiilide administreerimisel windowsis või sa pole kindel mida sa teed. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Sisesta serverile nimi mida kasutatakse failide jagamisel Windowsi ja MAC-ga."

msgid "wkg_DESC_WORKGROUP"
msgstr " Sisesta Windowsi töörühma nimi kuhu server peaks kuuluma. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Muuda töörühma seadeid"

msgid "wkg_INVALID_SERVERNAME"
msgstr "Serveri nimi peab algama tähega (upper or lower case), followed by any combination of letters, numbers, underscores and hyphens."

msgid "wkg_INVALID_WORKGROUP"
msgstr "Töörühma nimi peab algama tähega (upper or lower case), followed by any combination of letters, numbers, underscores, periods and hyphens."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "The server and workgroup names match, when compared in lower case. These values must be different in order for filesharing to be turned on."

msgid "wkg_LABEL_PDC"
msgstr "Töörühma ja domeeni kontrollija"

msgid "wkg_LABEL_ROAM"
msgstr "Liikuvad profiilid"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Serveri nimi"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Windowsi töörühm"

msgid "wkg_SUCCESS"
msgstr "Uued töörühma sedistused on salvestatud"
