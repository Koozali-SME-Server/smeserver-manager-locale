msgid "Directory"
msgstr "(en) Directory"

msgid "dir_CITY"
msgstr "Postnr. og by"

msgid "dir_COMPANY"
msgstr "Virksomhedsnavn"

msgid "dir_DEPARTMENT"
msgstr "Afdelingens navn"

msgid "dir_DESCRIPTION"
msgstr "LDAP serveren tilbyder netværket adgang til en liste over bruger- og gruppekonti på serveren, som kan tilgås af LDAP-klienter som Adressebogsfunktionen i Netscape Comunicator. Indstil LDAP klienten til serverens IP addresse, portnummer 389 og parametrene for server rod, der vises nedenfor."

msgid "dir_DESC_DEPARTMENT"
msgstr "Disse felter indeholder de grundlæggende LDAP indstillinger for din organisation. For enhver ny brugerkonto du opretter, vil du blive foranlediget til at indtaste alle disse felter (de kan være forskellige for hver bruger), men værdierne her vil vise sig som grundlæggende indstillinger. Det er bekvemt og gør brugeroprettelsen hurtigere."

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr "Du kan styre adgangen til LDAP. Vælg blandt mulighederne."

msgid "dir_DESC_EXISTING"
msgstr "Du kan lade eksisterende brugerkonti fortsætte som de er, og kun lade ændringerne påvirke fremtidige bruger eller du kan opdatere alle bruger med de nye indstillinger."

msgid "dir_DIRECTORY_ACCESS"
msgstr "Adgang til LDAP"

msgid "dir_EXISTING"
msgstr "Eksisterende brugere"

msgid "dir_FORM_TITLE"
msgstr "Indstilling af LDAPserveren"

msgid "dir_LABEL_ROOT"
msgstr "Server rod"

msgid "dir_LEAVE"
msgstr "Efterlad som de er"

msgid "dir_PHONE"
msgstr "(en) dir_PHONE"

msgid "dir_PHONENUMBER"
msgstr "Telefonnr."

msgid "dir_STREET"
msgstr "Gade og nr."

msgid "dir_SUCCESS"
msgstr "De nye grundlæggende LDAPindstillinger er gemt."

msgid "dir_UPDATE"
msgstr "Opdater med nye indstillinger"

msgid "dom_FORM_TITLE"
msgstr "(en) dom_FORM_TITLE"

