msgid "Port forwarding"
msgstr "(en) Port forwarding"

msgid "pf_ALLOW_HOSTS"
msgstr "Hosts"

msgid "pf_CREATE_RULE"
msgstr "Membuat aturan portforwarding"

msgid "pf_ERR_BADAHOST"
msgstr "This does not appear to be a valid IP address list. ie: 192.168.0.1,192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "Ini tidak tampak sebagai alamat IP. Anda harus menggunakan notasi dotted-quad, dan setiap empat angka tersebut harus lebih kecil dari 256. Contoh : 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "Port haruslah berupa bilangan bulat yang lebih kecil dari 65536."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "Event menghasilkan nilai bukan nol."

msgid "pf_ERR_PORT_COLLISION"
msgstr "ERROR: Port ini atau port range konflik dengan rule yang telah ada. Harap ubah rule ini atau hapus rule lama."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  Anda dapat menggunakan panel ini untuk mengubah aturan aturan firewall seperti membuka port tertentu pada server ini dan meneruskannya pada port lain di host yang lain. Dengan melakukan hal tersebut akan mengijinkan lalulintas masuk untuk secara langsung mengakses host pribadi dalam jaringan lokal anda. \n\n  <p> PERINGATAN: Penyalahgunaan dari fitur ini dapat secara serius mengancam keamanan dari jaringan anda. Jangan gunakan fitur ini dengan enteng, atau tanpa mengerti benar akibat dari melakukan hal ini. </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Konfigurasi Port Forwarding"

msgid "pf_IN_SERVERONLY"
msgstr "Server ini berada dapal mode server-saja dan portforwarding tidak dimungkinkan."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Alamat IP host tujuan"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Port tujuan (boleh lebih dari satu)"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protokol"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Port asal"

msgid "pf_NO_FORWARDS"
msgstr "Saat ini tidak ada port yang diteruskan dalam sistem"

msgid "pf_RULE_COMMENT"
msgstr "Komentar"

msgid "pf_SHOW_FORWARDS"
msgstr "Dibawah ini anda akan mendapati tabel ringkasan dari aturan portforwaring yang terpasang di server ini. Klik&quot;Hapus&quot; untuk menghapus rule yang bersangkutan."

msgid "pf_SUCCESS"
msgstr "Perubahan aturan penerusan port telah berhasil disimpan."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "Berikut ini ringkasan dari aturan port-forwarding yang akan anda tambahkan. Jika anda puas dengan rule tersebut, klik tombol &quot;Tambah&quot;. Jika tidak, klik tombol &quot;Batal&quot;."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "Berikut ini ringkasan dari aturan port-forwarding yang akan anda hapus. Jika anda yakin anda ingin menghapus rule tersebut, klik tombol &quot;Hapus&quot;. Jika tidak, klik tombol &quot;Batal&quot;."

