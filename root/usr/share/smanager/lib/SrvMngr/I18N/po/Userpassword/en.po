msgid "NO_SUCH_USER"
msgstr "There does not appear to be any such user"

msgid "pwd_ACCOUNT_PASSWORD_CHANGE"
msgstr "Change account password"

msgid "pwd_DESCRIPTION"
msgstr "To change your account password, please fill out the following form. You will need to provide the name of your account, your old password, and your desired new password. (You must type the new password twice.)If you cannot change your password because you have forgotten the old one, your local system administrator can reset your password using the <EM>server manager</EM>."

msgid "pwd_DESCRIPTION_RESET"
msgstr "To reset your account password, please fill out the following form. You will need to provide your desired new password. (You must type it twice.)In cas of problem, your local system administrator can reset your password using the <EM>server manager</EM>."

msgid "pwd_ERROR_PASSWORD_CHANGE"
msgstr "An error occurred while attempting to change your password. Please make sure that the old password entered is correct. Old and new passwords should be different."

msgid "pwd_ERR_OCCURRED_MODIFYING_PASSWORD"
msgstr "Err occurred modifying password"

msgid "pwd_FIELDS_REQUIRED"
msgstr "All fields are required"

msgid "pwd_INTERMEDIATE_PASSWORD_DESCRIPTION"
msgstr "The password must be composed of at least [_1] characters with uppercase and lowercase letters and must pass a dictionary check."

msgid "pwd_INVALID_REQUEST"
msgstr "Invalid request"

msgid "pwd_NONE_PASSWORD_DESCRIPTION"
msgstr "The password must be composed of at least [_1] characters."

msgid "pwd_NORMAL_PASSWORD_DESCRIPTION"
msgstr "The password must be composed of at least [_1] characters with uppercase and lowercase letters."

msgid "pwd_OK_FOR_RESET"
msgstr "Ok for reset"

msgid "pwd_PASSWORD_CHANGE"
msgstr "Change Password"

msgid "pwd_PASSWORD_CHANGE_SUCCESS"
msgstr "Your password has been successfully changed."

msgid "pwd_PASSWORD_INVALID_CHARS"
msgstr "The password you entered contained invalid characters."

msgid "pwd_PASSWORD_NEW"
msgstr "New password:"

msgid "pwd_PASSWORD_OLD"
msgstr "Old password:"

msgid "pwd_PASSWORD_OLD_INVALID_CHARS"
msgstr "The old password you entered contained invalid characters."

msgid "pwd_PASSWORD_RESET"
msgstr "Reset password"

msgid "pwd_PASSWORD_VERIFY_ERROR"
msgstr "The new passwords you entered did not match."

msgid "pwd_PASSWORD_VERIFY_NEW"
msgstr "New password (verify):"

msgid "pwd_PASSWORD_WIKI"
msgstr "If you want to know more about passwords, then please refer to the <a href='https://wiki.koozali.org/SME_Server:Documentation:Administration_Manual:Chapter9#Changing_User_Passwords'>Wiki</a>"

msgid "pwd_STRONG_PASSWORD_DESCRIPTION"
msgstr "The password must be composed of at least [_1] characters with uppercase and lowercase letters, numbers and special characters and must pass a dictionary check."

msgid "pwd_TAINTED_PASSWORD"
msgstr "The new password starts with invalid characters."

msgid "pwd_TAINTED_USER"
msgstr "The account name \"[_1]\" contains invalid characters."

msgid "pwd_YOUR_ACCOUNT"
msgstr "Your account:"
