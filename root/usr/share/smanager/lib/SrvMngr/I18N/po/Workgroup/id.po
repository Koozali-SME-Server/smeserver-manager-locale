msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "Jadikan server ini sebagai pengendali workgroup dan domain dalam jaringan Windows anda? Anda harus memilih Tidak jika telah ada server lain yang melakukan tugas ini dalam network anda."

msgid "wkg_DESC_ROAM"
msgstr " Jadikan server ini mendukung roaming profiles? Anda sebaiknya membiarkan kepada nilai default yaitu Tidak kecuali anda memiliki pengalaman mengelola Windows roaming profile berbasis server dan mengetahui dan mengetahui bahwa fitur ini diperlukan. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Ketik nama yang akan digunakan server ini untuk Windows dan Macintosh file sharing."

msgid "wkg_DESC_WORKGROUP"
msgstr " Isi nama dari Windows workgroup dimana server ini harus tampak. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Ubah setting workgroup"

msgid "wkg_INVALID_SERVERNAME"
msgstr "Nama server harus dimulai dengan sebuah huruf (huruf besar atau huruf kecil), diikuti dengan kombinasi apa saja dari huruf, angka, garis bawah, titik dan strip."

msgid "wkg_INVALID_WORKGROUP"
msgstr "Nama workgroup harus dimulai dengan sebuah huruf (huruf besar atau huruf kecil), diikuti dengan kombinasi apa saja dari huruf, angka, garis bawah, titik dan strip."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "Nama server dan workgroup sama, ketika dibandingkan dengan menjadikan semua huruf kecil. Keduanya harus berbeda supaya filesharing dapat diaktifkan."

msgid "wkg_LABEL_PDC"
msgstr "Pengendali Workgroup dan Domain"

msgid "wkg_LABEL_ROAM"
msgstr "Roaming profiles"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Nama Server"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Workgroup Windows "

msgid "wkg_SUCCESS"
msgstr "Perubahan setting workgroup telah disimpan."
