msgid "Workgroup"
msgstr "Werkgroep"

msgid "wkg_DESC_PDC"
msgstr "Moet deze server dienst doen als werkgroep en domein controller in uw Windows netwerk? Kies de optie Nee indien een andere server deze rol reeds vervult in uw netwerk."

msgid "wkg_DESC_ROAM"
msgstr " Moet deze server roaming profiles ondersteunen? Kies de standaardoptie Nee tenzij u ervaring hebt in het beheren van server gebaseerde roaming profiles en weet dat deze optie vereist is. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Geef de naam in die de server moet gebruiken voor bestandsdeling onder Windows en Macintosh."

msgid "wkg_DESC_WORKGROUP"
msgstr " Geef de naam in van de Windows werkgroep waarin deze server moet verschijnen. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Werkgroep instellingen wijzigen"

msgid "wkg_INVALID_SERVERNAME"
msgstr "De servernaam moet beginnen met een letter (kleine of hoofdletter), gevolgd door een combinatie van letters, cijfers, liggende streepjes, punten en koppeltekens."

msgid "wkg_INVALID_WORKGROUP"
msgstr "De werkgroepnaam moet beginnen met een letter (kleine of hoofdletter), gevolgd door een combinatie van letters, cijfers, lage streepjes, punten en koppeltekens."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "Vergeleken in kleine letters komen de server- en werkgroepnamen overeen. Deze namen moeten verschillend zijn om bestandsdeling in te kunnen schakelen."

msgid "wkg_LABEL_PDC"
msgstr "Werkgroep en domein controller"

msgid "wkg_LABEL_ROAM"
msgstr "Roaming profiles"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Servernaam"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Windows werkgroep"

msgid "wkg_SUCCESS"
msgstr "De nieuwe werkgroepinstellingen zijn opgeslagen"
