msgid "hos_ETHERNET_ADDRESS"
msgstr "Fizicni naslov"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "Fizicni naslov je opcija in povzroci povezavo DHCP streznika, da staticno dodeljuje lokalni IP naslov racunalniku s tem fizicnim naslovom. Ce ga vpisemo, mora biti v obliki \"AA:BB:CC:DD:EE:FF\" , ter vsebovati samo stevilke 0-9 in crke A-F."

msgid "hos_FORM_TITLE"
msgstr "Imena gostiteljev in naslovi"

msgid "hos_HOSTNAME"
msgstr "Ime racunalnika"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Napaka: nepricakovani znaki so v imenu racunalnika: \"%1.%2\". Ime racunalnika sme vsebovati samo crke, stevilke, pomisljaje in se morajo zacetiz crko ali stevilko."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Ime racunalnika mora vsebovati crke, stevilke, vezaje in se mora zaceti s crko ali stevilko."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Napaka: ime racunalnika %1 ze obstaja %2"

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Napaka: nepricakovani znaki so v imenu racunalnika: \"%1.%2\". Ime racunalnika sme vsebovati samo crke, stevilke, pomisljaje in se morajo zacetiz crko ali stevilko."

msgid "hos_HOSTTYPE"
msgstr "Lokacija"

msgid "hos_LOCAL_IP"
msgstr "Lokalni IP"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "Lokalni IP naslov je IP naslov drugega racunalnika v lokalnem omrezju. Prosimo vpisite veljaven IP naslov v obliki \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Prosim vpisite naslednje podrobnosti za lokalen racunalnik:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Spremeni ime gostitelja"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Prosimo vpisite naslednje podrobnosti za oddaljeni racunalnik:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Ste tik pred tem, da odstranite ime racunalnika \"%1.%2\".   Ste prepricani, da zelite odstraniti to ime racunalnika? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Odstrani ime gostitelja"

