msgid "Directory"
msgstr "(en) Directory"

msgid "dir_CITY"
msgstr "默认的城市"

msgid "dir_COMPANY"
msgstr "默认的公司"

msgid "dir_DEPARTMENT"
msgstr "默认的部门"

msgid "dir_DESCRIPTION"
msgstr "LDAP 服务器提供了在服务器上的用户帐户和群组的可用列表，并且可以通过使用一个LDAP客户端（如Netscape Communicator的地址簿功能）来访问。使用服务器的本地IP，端口号389来设置LDAP客户端，服务器的根参数如下。"

msgid "dir_DESC_DEPARTMENT"
msgstr "这些字段是LDAP的默认值。当您创建了一个新的用户账号，您将会被提示输入所有这些字段（每个用户可能不一样），但是在此处设置的值将会被视为默认值。这样可以方便快速地创建用户账号。"

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr "您可以控制对LDAP目录的访问：“私有”设置只允许从本地网络访问，“公开”设置允许从互联网的任何地方访问。"

msgid "dir_DESC_EXISTING"
msgstr "您既可以让已存在的用户保持原样、让新用户使用上述默认值，也可以将上述默认值应用到所有已存在用户。"

msgid "dir_DIRECTORY_ACCESS"
msgstr "LDAP 目录访问"

msgid "dir_EXISTING"
msgstr "已存在的用户"

msgid "dir_FORM_TITLE"
msgstr "改变LDAP目录设置"

msgid "dir_LABEL_ROOT"
msgstr "Server root"

msgid "dir_LEAVE"
msgstr "保持原样"

msgid "dir_PHONE"
msgstr "(en) dir_PHONE"

msgid "dir_PHONENUMBER"
msgstr "默认的电话号码"

msgid "dir_STREET"
msgstr "默认的街道地址"

msgid "dir_SUCCESS"
msgstr "LDAP 默认设置已被保存。"

msgid "dir_UPDATE"
msgstr "更新默认值"

msgid "dom_FORM_TITLE"
msgstr "(en) dom_FORM_TITLE"

