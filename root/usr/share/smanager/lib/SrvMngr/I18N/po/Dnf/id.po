msgid "Groups"
msgstr "(en) Groups"

msgid "Packages"
msgstr "(en) Packages"

msgid "Start"
msgstr "(en) Start"

msgid "yum_1DAILY"
msgstr "Setiap hari"

msgid "yum_2WEEKLY"
msgstr "Setiap minggu"

msgid "yum_3MONTHLY"
msgstr "Setiap bulan"

msgid "yum_AutoInstallUpdates"
msgstr "(en) Autoinstallupdates"

msgid "yum_BUTTON_CONFIGURATION"
msgstr "Ubah pengaturan penginstal perangkat lunak"

msgid "yum_BUTTON_INSTALL_AVAILABLE"
msgstr "Instal perangkat lunak tambahan"

msgid "yum_BUTTON_INSTALL_UPDATES"
msgstr "Daftar pembaruan yang tersedia"

msgid "yum_BUTTON_REMOVE"
msgstr "Hapus perangkat lunak yang terinstal"

msgid "yum_DESC_AVAILABLE_GROUPS"
msgstr "Anda dapat memilih grup perangkat lunak untuk diinstall pada daftar dibawah."

msgid "yum_DESC_AVAILABLE_PACKAGES"
msgstr "Anda juga dapat memilih paket individual untuk diinstall dari daftar dibawah."

msgid "yum_DESC_AVAILABLE_UPDATES"
msgstr "Update dibawah ini tersedia untuk sistem anda. Secara umum, semua update harus anda install. Jika ada update yang tidak ingin anda install, jangan pilih dari daftar dibawah ini."

msgid "yum_DESC_ENABLED_REPOSITORIES"
msgstr "Installer perangkat lunak dapat memasang perangkat lunak dari repositori yang dibolehkan. Untuk membolehkan repositori, pilih dari daftar. Untuk men-disable repository, hapus dari daftar. Secara default, hanya perangkat lunak yang stabil dan sudah di test tersedia untuk instalasi."

msgid "yum_DESC_INSTALLED_GROUPS"
msgstr "Anda dapat memilih kelompok perangkat lunak untuk dihapus dari daftar dibawah."

msgid "yum_DESC_INSTALLED_PACKAGES"
msgstr "Anda juga dapat memilih paket individu yang ingin anda hapus dari daftar dibawah."

msgid "yum_DESC_UPDATES_AVAILABLE"
msgstr "Tersedia update untuk sistem anda. Update ini harus diinstall secepat mungkin."

msgid "yum_DESC_UPTODATE"
msgstr "Semua update telah dipasang."

msgid "yum_DESC_YUM_AUTOINSTALLUPDATES"
msgstr "(en)If enabled this will take precedence over the simple check for updates notification and predownload features. Instead it will install the available updates from enabled repositories. For more information refer to yum and yum-cron manual page."

msgid "yum_DESC_YUM_DELTARPMPROCESS"
msgstr "(en)A deltarpm contains the difference between an old and a new version of a rpm, which can save bandwith. The drawback is that update operations consume considerably more CPU cycles"

msgid "yum_DESC_YUM_PACKAGEFUNCTIONS"
msgstr "Installer perangkat lunak dapat mengatur kelompok dari paket-paket yang terhubung atau paket secara individu. Secara default, hanya kelompok dari paket yang ditampilkan. Jika anda ingin mengatur paket individu, bolehkan pilihan ini. Ini hanya boleh dilakukan oleh administrator yang berpengalaman."

msgid "yum_DeltaRpmProcess"
msgstr "(en) Deltarpmprocess"

msgid "yum_DownloadOnly"
msgstr "(en) Downloadonly"

msgid "yum_ERROR_UPDATING_CONFIGURATION"
msgstr "(en) Error updating configuration"

msgid "yum_FORM_TITLE"
msgstr "Penginstal perangkat lunak"

msgid "yum_HEADER_AVAILABLE_SOFTWARE"
msgstr "Software berikut ini tersedia untuk diinstall pada sistem anda. Anda sebaiknya menginstall perangkat lunak tambahan pada sistem ini hanya jika anda menyadari konsekwensinya."

msgid "yum_HEADER_INSTALLED_SOFTWARE"
msgstr "Perangkat lunak dibawah ini terpasang dalam sistem ini. Sebaiknya anda hanya menghapus perangkat lunak dari sistem ini hanya jika anda menyadari konsekuensinya."

msgid "yum_HEADER_POSTUPGRADE_REQUIRED"
msgstr " Sistem harus di rekonfigurasi setelah menambah atau menghapus perangkat lunak, atau melakukan update. <p> Silakan klik tombol Reconfigure dibawah halaman ini untuk memulai proses rekonfigurasi. <b>Akan dilakukan reboot server secara otomatis sebagai bagian dari proses rekonfigurasi</b> </p> "

msgid "yum_INSTALL_SOFTWARE"
msgstr "Install"

msgid "yum_INSTALL_UPDATES"
msgstr "Install update yang dipilih"

msgid "yum_LABEL_AVAILABLE_GROUPS"
msgstr "Grup tersedia"

msgid "yum_LABEL_AVAILABLE_PACKAGES"
msgstr "Paket tersedia"

msgid "yum_LABEL_AVAILABLE_UPDATES"
msgstr "Update tersedia"

msgid "yum_LABEL_ENABLED_REPOSITORIES"
msgstr "Repositori yang dibolehkan"

msgid "yum_LABEL_INSTALLED_GROUPS"
msgstr "Grup terpasang"

msgid "yum_LABEL_INSTALLED_PACKAGES"
msgstr "Paket terpasang"

msgid "yum_LABEL_YUM_AUTOINSTALLUPDATES"
msgstr "Install updates secara otomatis"

msgid "yum_LABEL_YUM_DELTARPMPROCESS"
msgstr "Pembaruan Delta RPM"

msgid "yum_LABEL_YUM_DOWNLOADONLY"
msgstr "Detail personal di-update"

msgid "yum_LABEL_YUM_DOWNLOADONLY_DESCRIPTION"
msgstr "(en)The rpm updates can be downloaded during the night, this will ease and give faster the dnf update process (only enabled repositories will be used)."

msgid "yum_LABEL_YUM_PACKAGEFUNCTIONS"
msgstr "Atur paket individu"

msgid "yum_LABEL_YUM_STATUS"
msgstr "Mutakhirkan "

msgid "yum_MULTI_SELECT"
msgstr "(en) <strong>Ctrl/Cmd-click</strong> toggles individual items and <strong>Shift-click</strong> selects ranges.\n<br /><strong>Case-insensitive</strong> search unless you enter a <strong>regex</strong> in <i>/pattern/flags</i> form (e.g. /maria.*client/i).."

msgid "yum_Please_Wait_-_dnf_Running"
msgstr "Harap Tunggu - dnf Sedang Berjalan"

msgid "yum_SUCCESS"
msgstr "Setting yang baru telah disimpan."

msgid "yum_UPDATE_SUCCESS"
msgstr "(en)The requested changes have been successfully implemented."

msgid "yum_check4updates"
msgstr "(en) Check4updates"

