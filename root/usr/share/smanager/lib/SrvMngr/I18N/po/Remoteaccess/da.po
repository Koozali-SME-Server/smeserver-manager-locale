msgid "rma_VALIDFROM_DESC"
msgstr " [_1] Det er muligt, at tillade værter på fjerne netværker adgang til Serverstyringen, ved at tilføje disse netværker her. Enhver vært indenfor det angivne område vil være i stand til at få adgang til Serverstyringen ved at bruge HTTPS. Brug subnetmaske 255.255.255.255 for at begrænse adgangen til en bestemt vært. "

msgid "rma_VALIDFROM_TITLE"
msgstr "[_1]"

