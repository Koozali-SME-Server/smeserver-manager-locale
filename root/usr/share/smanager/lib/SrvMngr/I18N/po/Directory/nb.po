msgid "Directory"
msgstr "(en) Directory"

msgid "dir_CITY"
msgstr "Forhåndsvalgt by"

msgid "dir_COMPANY"
msgstr "Forhåndsvalgt firma"

msgid "dir_DEPARTMENT"
msgstr "Forhåndsvalgt avdeling"

msgid "dir_DESCRIPTION"
msgstr "LDAP serveren tilbyr en liste over brukerkontoer og grupper på serveren som er tilgjenglig over nettverket, og kan nås med en LDAP klient som adresseboken i Netscape Communicator. Sett opp LDAP klienten med den lokale IP adressen til serveren, port 389, og server root parameterene som vist nedenfor."

msgid "dir_DESC_DEPARTMENT"
msgstr "Disse feldtene er LDAP standard for din organisasjon. Hver gang du oppretter en ny bruker vil du bli bedt om å fylle ut disse feltene(de kan være ulike for alle brukere). Det du fyller inn her vil komme ferdigutfylt når du oppretter ny bruker."

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr "Du kan kontrollere tilgangen til din LDAP mappe: Privat tillater kun tilgang fra det lokale nettverket, og Offentlig tillater tilgang fra hvor som helst på internett."

msgid "dir_DESC_EXISTING"
msgstr "Du kan la de eksisterende brukerne være som de er, og bruke forhåndsvalgene over kun på nye brukere, eller du kan bruke forhåndsvalgene over også på eksisterende brukere."

msgid "dir_DIRECTORY_ACCESS"
msgstr "LDAP mappetilgang"

msgid "dir_EXISTING"
msgstr "Eksisterende brukere"

msgid "dir_FORM_TITLE"
msgstr "Endre LDAP mappe instillingene"

msgid "dir_LABEL_ROOT"
msgstr "Server root"

msgid "dir_LEAVE"
msgstr "La de være som de er"

msgid "dir_PHONENUMBER"
msgstr "Forhåndsvalgt telefonnummer"

msgid "dir_STREET"
msgstr "Forhåndsvalgt gateadresse"

msgid "dir_SUCCESS"
msgstr "De nye forhåndsinnstilte LDAP innstillingene er lagret."

msgid "dir_UPDATE"
msgstr "Oppdater med nye forhåndsinnstillinger"
