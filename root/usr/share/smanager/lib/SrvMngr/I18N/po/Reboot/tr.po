msgid "Reboot or shutdown"
msgstr "(en) Reboot or shutdown"

msgid "rbo_DESCRIPTION"
msgstr " Bu sayfadan sistemi kapatabilir, yeniden başlatabilir veya yeniden yapılandırabilirsiniz. Bilgisayarın kapatma düğmesine basmadan önce kapatma işlemini seçmelisiniz. Bu işlemlerin tamamlanması birkaç dakika alabilir. perform düğmesine bastığınız zaman işlem hemen başlatılacaktır! "

msgid "rbo_DESC_REBOOT"
msgstr "Sunucunuzun yeniden başlatma süreci başlamıştır."

msgid "rbo_DESC_RECONFIGURE"
msgstr "Sunucunuz, sistem yeniden yapılandırılması ve yeniden başlatma sürecine başlamıştır."

msgid "rbo_DESC_SHUTDOWN"
msgstr "Sunucunuz kapanma sürecine başlamıştır. Bu sürecin tamamlanması birkaç dakika sürebilir, süreç tamamlandıktan sonra bilgisayarınızı kapatma düğmesinden kapatabilirsiniz."

msgid "rbo_FORM_TITLE"
msgstr "Kapatma veya Yeniden Başlatma"

msgid "rbo_LABEL_REBOOT"
msgstr "Kapatma, Yeniden Başlatma veya Yeniden Yapılandırma seçiniz."

msgid "rbo_REBOOT"
msgstr "Yeniden Başlat"

msgid "rbo_REBOOT_SUCCEEDED"
msgstr "Yeniden başlatma istemi, başarıyla gerçekleşti."

msgid "rbo_RECONFIGURE_SUCCEEDED"
msgstr "Yeniden yapılandırıma istemi başarıyla gerçekleşti."

msgid "rbo_SHUTDOWN_SUCCEEDED"
msgstr "(en) Shutdown request initiated successfully."

