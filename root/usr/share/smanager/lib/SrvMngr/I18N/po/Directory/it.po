msgid "Directory"
msgstr "Rubrica"

msgid "dir_CITY"
msgstr "Default Città"

msgid "dir_COMPANY"
msgstr "Default Azienda"

msgid "dir_DEPARTMENT"
msgstr "Default Ufficio"

msgid "dir_DESCRIPTION"
msgstr "Il server LDAP fornisce un elenco in rete degli utenti e gruppi sul server cui è possibile accedere utilizzando un client LDAP quale la Rubrica delle popolari suite Internet. Impostare il client LDAP con l'indirizzo locale del server, la porta 389 e la server root sottostante."

msgid "dir_DESC_DEPARTMENT"
msgstr "Questi campi contengono i valori di default per l'azienda. Creando un nuovo utente verrà richiesto di riempire tutti questi campi (possono essere diversi per ogni utente), ma i valori impostati in questa pagina verranno utilizzati come default velocizzando la creazione di nuovi utenti."

msgid "dir_DESC_DIRECTORY_ACCESS"
msgstr "E' possibile limitare l'accesso alla rubrica LDAP: accesso privato abilita soltanto le reti locali, accesso pubblico permette l'accesso dall'intera Internet."

msgid "dir_DESC_EXISTING"
msgstr "E' possibile mantenere le impostazioni attuali per gli utenti creati e usare i default soprastanti solo per nuovi utenti oppure applicare i nuovi default anche a tutti gli utenti preesistenti."

msgid "dir_DIRECTORY_ACCESS"
msgstr "Accesso rubrica LDAP"

msgid "dir_EXISTING"
msgstr "Utenti preesistenti"

msgid "dir_FORM_TITLE"
msgstr "Cambia impostazioni rubrica LDAP"

msgid "dir_LABEL_ROOT"
msgstr "Root LDAP server"

msgid "dir_LEAVE"
msgstr "Mantenere le impostazioni attuali"

msgid "dir_PHONE"
msgstr "(en) dir_PHONE"

msgid "dir_PHONENUMBER"
msgstr "Default Telefono"

msgid "dir_STREET"
msgstr "Default Indirizzo"

msgid "dir_SUCCESS"
msgstr "Nuove impostazioni default LDAP salvate."

msgid "dir_UPDATE"
msgstr "Aggiornare con i nuovi defaults"

msgid "dom_FORM_TITLE"
msgstr "(en) dom_FORM_TITLE"
