msgid "pse_MODIFY_PSEUDONYM"
msgstr "Wijzig pseudoniem"

msgid "pse_MODIFY_SUCCEEDED"
msgstr "Pseudoniem is met succes gewijzigd"

msgid "pse_NAME_IN_USE"
msgstr "Fout: Deze naam is reeds in gebruik. U kan geen pseudoniem toevoegen met deze naam."

msgid "pse_NOT_A_PSEUDONYM"
msgstr "Deze account is geen pseudoniem"

msgid "pse_PSEUDONYM"
msgstr "Pseudoniem"

msgid "pse_PSEUDONYM_INVALID_DOMAIN"
msgstr "Dit domein wordt niet op deze server gehost"

msgid "pse_PSEUDONYM_INVALID_SAMEACCT"
msgstr "Een pseudoniem kan niet naar dezelfde account verwijzen"

msgid "pse_PSEUDONYM_NAME"
msgstr "Pseudoniem naam"

msgid "pse_REMOVE_PSEUDONYM"
msgstr "Pseudoniem verwijderen"

msgid "pse_REMOVE_SUCCEEDED"
msgstr "Pseudoniem is met succes verwijderd"

msgid "pse_SELECT_ACCOUNT"
msgstr "Selecteer een account of groep"

msgid "pse_SELECT_INTERNAL"
msgstr "Alleen lokaal netwerk"

msgid "pse_TITLE_CREATE"
msgstr "Pseudoniem toevoegen"

msgid "pse_USER_OR_GROUP"
msgstr "Gebruiker of groep"

msgid "pse_VALID_PSEUDONYM_NAMES"
msgstr " Een pseudoniem mag alleen kleine letters, cijfers, punten, koppeltekens en lage streepjes bevatten en moet met een kleine letter of cijfer beginnen. Bijvoorbeeld \"sales\", \"john.holland\", \"123\" en \"email-administrator\" zijn geldige pseudoniemen, maar \"Jan Smit\" en \"Henry Miller\" niet. U kan ook e-mail aliassen aanmaken voor accounts en (virtuele) domeinen die geldig zijn op deze server. Bijvoorbeeld \"fred@virtualdomain.com\" kan worden doorgestuurd naar \"mary\" (of naar een andere geldige gebruikersaccount). "
