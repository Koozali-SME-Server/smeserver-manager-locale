msgid "Local networks"
msgstr "Yerel ağlar"

msgid "ln_ADD_DESC"
msgstr " Parametrelerin formatı #.#.#.# (her # işareti 0 ile 255 arasında bir sayıyı gösterir) şeklinde olmalıdır. Sunucunuz network adresini geçerli kılmak içinalt ağ maskesinin sonunu sıfır ile değiştirecektir.Ek ağ ulaşmanızı sağlayan \"Router\" IP adresi, sunucunuzun ağ adresi aralığında yer almalıdır. "

msgid "ln_ADD_TITLE"
msgstr "Yerel ağ ekle"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "Ağ oluşturulurken hata meydana geldi."

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "Ağ silinirken hata oluştu."

msgid "ln_FIRSTPAGE_DESC"
msgstr " Güvenlik sebepleri nedeniyle bu sunucudaki bazı servisler sadece yerel ağ balantısıyla yönetilebilirr. Bu hizmetlere erişimi, ek ağlara da verebilmeniz için aşağıdaki listeye ek ağları tanımlamanız gerekmektedir. Çoğu kurulum bu listeyi boş bırakır. Ağ ekle "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "Geçersiz IP adresi"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Geçersiz alt ağ maskesi"

msgid "ln_LOCAL NETWORKS"
msgstr "Yerel ağlar"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Ağ ekle"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "Hata: ağ [_1] (mevcut ağ [_2] ve alt ağ maskesi [_3]) zaten eklenmiş. Ağ eklenemedi."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "Hata: ağ [_1] (yerel ağ [_2] ve alt ağ maskesi [_3]) yerel olarak kullanımda. Ağ eklenemedi."

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "Hata: yönlendirme [_1] yerel ağ tarafından erişilemez. Ağ eklenemedi."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Etki alanı sayısı"

msgid "ln_REMOVE_DESC"
msgstr "Aşağıdaki yerel ağı silmek üzeresiniz."

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "Silmeye çalıştığınız ağda yapılantırılmış alan adı sunucular tespit edildi. Varsayılan oalrak onalar da silinecektir. Bunun olmasını istemiyorsanız seçme kutusunu işaretleyin. Bu ağ bağlı sunucular bundan sonra yerel olarak tanınmayacaklardır ve ağ silindikten sonra erişilemeyebilirler."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "Ağdaki alan adını sil"

msgid "ln_REMOVE_TITLE"
msgstr "Yerel ağ sil"

msgid "ln_SUBNET_MASK"
msgstr "Alt ağ maskesi"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "Ağ [_1]/[_2] , yönlendirme [_3] başarıyla eklendi. Sunucunuz [_4] den [_5] kadar olan toplam [_6] IP adresine yerel erişim hizmeti tanıyacaktır."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "  Ağ [_1]/[_2] , yönlendirme [_3] başarıyla eklendi. \n\n  <p> Sunucunuz [_1] den [_2] kadar olan toplam [_3] IP adresine yerel erişim hizmeti tanıyacaktır. </p>\n\n  <p> Dikkat: ProFTPd FTP sunucusu bu standart olmayan alt ağ maskesini kullanamaz. Bunun yerine standart <b>[_1]</b> alt ağ maskesini kullanacaktır. </p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "Ağ [_1]/[_2] , yönlendirme [_3] başarıyla silindi."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "Ağ [_1]/[_2] , yönlendirme [_3] başarıyla eklendi. Sunucunuz [_4] IP adresine yerel erişim yetkisi tanıyacaktır."
