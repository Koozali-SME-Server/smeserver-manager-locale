msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Lägg till domän"

msgid "dom_CONTENT"
msgstr "i-bay"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "Som webbplats kan du välja den primära webbplatsen eller valfri i-bay för innehåll."

msgid "dom_CREATE_TITLE"
msgstr "Skapa en ny domän"

msgid "dom_CURRENT_DOMAINS"
msgstr "Aktuell lista över domäner"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Om denna server inte har Internetåtkomst eller om du har specifika krav på DNS-uppslagning, ange DNS-serverns IP-adresser här. Dessa fält bör lämnas tomma om du inte har särskilda skäl för att konfigurera andra DNS-servrar. De bör inte ange adressen för din ISP's DNS-servrar här, eftersom denna server klarar av att slå upp alla Internet DNS-namn utan denna extra konfiguration."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr " Företagets DNS-inställningar "

msgid "dom_DESC_NAMESERVERS"
msgstr "Du kan välja om denna domän slås upp lokalt, skickas till företagets DNS-servrar eller slås upp av DNS-servrarna på Internet. Det förvalda är korrekt för de flesta nätverk."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Ändra företagets DNS-inställningar"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Fel: Ogiltigt eller saknat tecken i domänbeskrivningen [_1]. Skapade inte en ny domän."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Fel: Domänen [_1] används redan. Skapade inte en ny domän."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Fel: Ogiltigt eller saknat tecken i domännamnet [_1]. Domännamnet måste innehålla en eller flera bokstäver, siffror, punkter eller minustecken. Skapade inte en ny domän."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Fel: internt fel vid radering av den domänen [_1]."

msgid "dom_FORM_DESCRIPTION"
msgstr " När du skapar en domän kommer din server att kunna ta emot e-post för denna domän men också kunna vara värd för en webbplats för denna domän.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Lägg till domän</a> "

msgid "dom_FORM_TITLE"
msgstr "Hantera domäner"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Primär företags DNS-server"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Sekundär företags DNS-server"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Domänens DNS-servrar"

msgid "dom_MODIFY_TITLE"
msgstr "Ändra domän"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Fel: [_1] är inte en existerande domän."

msgid "dom_PRIMARY_SITE"
msgstr "primär plats"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  Du håller på att radera den domänen [_1] ([_2]). \n\n  <p> <b>Är du säker på att du vill ta bort denna domän?</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Radera domän"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Skapat den nya domänen [_1]. Din webb-server startas nu om. Länkarna på denna sida kommer att vara inaktiva tills dess att webb-serverns omstart är klar."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Domänen [_1] är raderad. Din webbserver startas nu om. Länkarna på denna sida är inaktiva tills webbserverns omstart är klar."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Domänen ändrad [_1]. Din webb-server startas nu om. Länkarna på denna sina är inaktiva tills webb-serverns omstart är klar."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Fel: Domänen [_1] är ditt systems domännamn. Du kan inte ha en domän med samma namn. Skapade inte en ny domän."

msgid "dom_corporate"
msgstr "Företagets DNS-servrar"

msgid "dom_internet"
msgstr "Internets DNS-servrar"

msgid "dom_localhost"
msgstr "Lokal uppslagning"

