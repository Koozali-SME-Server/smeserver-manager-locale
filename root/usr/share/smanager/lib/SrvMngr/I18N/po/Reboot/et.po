msgid "Reboot or shutdown"
msgstr "(en) Reboot or shutdown"

msgid "rbo_DESCRIPTION"
msgstr " You can reboot, shut down your server or perform a full system reconfiguration from this screen. You must perform a shutdown before switching the power off. All of these functions take several minutes to complete. When you click perform the operation will be initiated immediately, so be ready! "

msgid "rbo_DESC_REBOOT"
msgstr "Serveris alustati taaskäivitamise protsessi."

msgid "rbo_DESC_RECONFIGURE"
msgstr "Serveris alagatati kogu süsteemi ümber seadistamine ja taaskäivitamine."

msgid "rbo_DESC_SHUTDOWN"
msgstr "Serveris algatati sulgemis protsess. See võib võtta mõne minuti, pärast seda võid toite välja lülitada."

msgid "rbo_FORM_TITLE"
msgstr "Sulgemine või taaskäivitamine"

msgid "rbo_LABEL_REBOOT"
msgstr "Vali sulgemine, taaskäivitamine või ümber seadistamine"

msgid "rbo_REBOOT"
msgstr "Taaskäivita"

msgid "rbo_REBOOT_SUCCEEDED"
msgstr "Taaskäivitamine alustati edukalt."

msgid "rbo_RECONFIGURE_SUCCEEDED"
msgstr "Ümber seadistamise protsess algatati edukalt."

msgid "rbo_SHUTDOWN_SUCCEEDED"
msgstr "(en) Shutdown request initiated successfully."

