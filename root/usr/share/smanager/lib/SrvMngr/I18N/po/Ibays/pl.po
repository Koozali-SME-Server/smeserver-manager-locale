msgstr "Uruchamiaj dynamiczną zawartość (CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "Nie udało się utworzyć nowego konta dla %1(czy już istnieje?)"

msgid "iba_CANT_FIND_IBAY"
msgstr "Nie udało się znaleźć konta dla %1(czy istnieje?)"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "Internet (nie wymagaj hasła)"

