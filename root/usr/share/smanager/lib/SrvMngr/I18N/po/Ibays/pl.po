msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "  Dodaj magazyn \n\n   Możesz usunąć każdy magazyn lub zresetować hasło klikając w odpowiednie polecenie w obok magazynu. Jeśli magazyn pojawi się na czerwono, oznacza to, że hasło nie zostało zmienione z domyślnej wartości i powinny zostać zmienione.\n\n  "

msgid "iba_FORM_TITLE"
msgstr "Utwórz, modyfikuj lub usuń magazyn"

msgid "iba_HTTPS_Only"
msgstr "Wymuś bezpieczne połączenia"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "Hasła nie zgadzają się."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Sieć lokalna (nie wymaga hasła)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "Sieć lokalna (wymagaj hasła)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "Nazwa magazynu \"%1\" jest za długa. Maksymalna długość wynosi %1 znaków."

msgid "iba_NAME_FIELD_DESC"
msgstr "Nazwa magazynu informacji powinna zawierać tylko małe litery, cyrfry, myślniki i podkreślniki oraz powinna zaczynać się od małej litery. Na przykład \"dane\", \"faktury\" i \"dokumenty.2009\" są poprawnymi nazwamy, ale \"11wnioski\", \"Dane klientów\" i \"Ważne!dokumenty\" nie są poprawne. Nazwa magazynu jest ograniczona do %1 znaków."

msgid "iba_NAME_LABEL"
msgstr "Nazwa magazynu"

msgid "iba_NONE"
msgstr "Brak dostępu"

msgid "iba_NO_IBAYS"
msgstr "Nie ma żadnych obecnie skonfigurowanych magazynów."

msgid "iba_PASSWORD_DESC"
msgstr "Masz zamiar zmienić hasło dla magzynu %1."

msgid "iba_PUBLIC_ACCESS"
msgstr "Dostęp powszechny przez sieć web lub anonimowy ftp"

msgid "iba_REMOVE_DESC"
msgstr "  Zamierzasz usunąć magazyn \"%1\" (%2). \n\n   Wszystkie dane należące do tego magazynu zostaną usunięte. \n\n   Czy jesteś pewien, że chcesz usunąć ten magazyn danych? \n\n  "

msgid "iba_REMOVE_TITLE"
msgstr "Usuń magazyn informacji"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "Pomyślnie utworzono magazyn."

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "Pomyślnie usunięto magazyn."

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "Pomyślnie zmodyfikowano magazyn."

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "Pomyślnie zresetowano hasło."

msgid "iba_USER_ACCESS"
msgstr "Dostęp użytkowników przez udostępnianie lub ftp"

msgid "iba_VHOST_MESSAGE"
msgstr " Poniższe wirtualne domeny używały tego magazynu, jako głównego, który zostanie zmieniony do głównej witryny sieci Web (możesz zmienić go na inny w późniejszym czasie): %1 "

