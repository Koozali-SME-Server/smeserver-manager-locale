msgid "iba_ACCOUNT_EXISTS"
msgstr "Konto \"%1\" jest obecnym kontem %2."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " Konto „%1” koliduje ze szczegółami pseudonimu %2 dla konta „%3”.  %4 to pseudonim dla %5. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "Magazyn \"%1\" zawiera nieprawidłowe znaki. Nazwa magazynu musi zaczynać się od małej litery i zawierać tylko litery, cyfry i łączniki."

msgid "iba_ADD_IBAY"
msgstr "Dodaj i-bay"

