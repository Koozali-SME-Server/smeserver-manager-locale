msgid "DELETE_ERROR"
msgstr "(en) DELETE_ERROR"

msgid "grp_ACCOUNT_CONFLICT"
msgstr "Error: the group \"%1\" can't be created because there is already a %2 account of that name."

msgid "grp_CREATED_GROUP"
msgstr "Successfully created user group"

msgid "grp_CREATE_ERROR"
msgstr "An error occurred while creating user group."

msgid "grp_CURRENT_LIST"
msgstr "Current list of User Groups\n\n  "

msgid "grp_DELETED_GROUP"
msgstr "Successfully removed user group"

msgid "grp_DELETE_DESCRIPTION"
msgstr " You are about to remove the user group \"%1\" "

msgid "grp_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "grp_FORM_TITLE"
msgstr "Create, modify, or remove user groups"

msgid "grp_GROUP_DESC"
msgstr "Brief Description/Windows Group Alias"

msgid "grp_GROUP_DESC_EXPL"
msgstr "Input a brief group description in the field below. This field also designates the group name viewable by Windows clients."

msgid "grp_GROUP_HAS_MEMBERS"
msgstr "This group contains the following members:"

msgid "grp_GROUP_NAMING"
msgstr " The group name should contain only lower-case letters, numbers, hyphens, periods, and underscores, and should start with a lower-case letter. For example \"sales\", \"beta5\", and \"reseller_partners\" are all valid group names, but \"3rd-event\", \"Marketing Team\" and \"lost&found\" are not. "

msgid "grp_GROUP_TOO_LONG"
msgstr "Error: group name is too long.The maximum is %1 characters."

msgid "grp_IBAYS_WILL_BE_CHANGED"
msgstr "The following information bays were assigned to this group and will be changed to the Administrator group (you can change them to something else afterward):"

msgid "grp_MODIFIED_GROUP"
msgstr "Successfully modifed user group"

msgid "grp_MODIFY_ERROR"
msgstr "An error occurred while modifying user group."

msgid "grp_NOT_A_GROUP"
msgstr "Error: That is not an existing group account."

msgid "grp_NO_MEMBERS"
msgstr "Error: no members in group. Did not create new group."
