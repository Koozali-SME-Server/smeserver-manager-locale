msgid "LOG_LIVESTREAM"
msgstr "(en) Live stream"

msgid "log_END_DESC"
msgstr "Bemærk at det kan tage noget tid at oprette denne visning."

msgid "log_ERR_NOEXIST_FILE"
msgstr "(en) Err noexist file"

msgid "log_ERR_NOOPEN_FILE"
msgstr "(en) Err noopen file"

msgid "log_FILENAME_ERROR"
msgstr " Fejl under angivelse af logfilnavn.\n\n  <p>Ugyldig rapporttype \"[_1]\".</p>\n\n  "

msgid "log_FILTER_PATTERN_DESC"
msgstr " Du har mulighed for at specificere et filtermønster, så kun linjer fra logfilen, der indeholder det angivne mønster vises. Efterlader du feltet tomt vises alle logfilens linjer. Bemærk at denne mulighed ikke benyttes, når du henter logfilen.\n\n  "

msgid "log_FILTER_PATTERN_HINT"
msgstr "(en) The pattern is case insensitive, but enclosing it in \"/\" will result in it being treated as a regex."

msgid "log_FILTER_PATTERN_LABEL"
msgstr "Mønster til filtrering (mulig)"

msgid "log_FIRSTPAGE_DESC"
msgstr " Dette panel tillader dig at vise eller hente logfiler, dannet af tjenester, der kører på din server. "

msgid "log_FORM_TITLE"
msgstr "Vis logfiler"

msgid "log_HIGHLIGHT_HEADER"
msgstr "Fremhæver linjer der passer med: \"[_1]\"."

msgid "log_LOG_FILE_EMPTY"
msgstr "Logfil \"[_1]\" er tom!"

msgid "log_LOG_FILE_SELECT_DESC"
msgstr "Vælg hvilken logfil du vil se"

msgid "log_MATCH_HEADER"
msgstr "Viser linjer der passer med: \"[_1]\"."

msgid "log_MATCH_PATTERN_DESC"
msgstr " Du har også muligheden for, at angive et fremhævelsesmønster, til at fremhæve linjer fra logfilen med fed, når de passer med det angivne fremhævelsesmønster. Fremhævelsesmønstret tilføres alle linjer som passer med filtermønstret. Bemærk at denne mulighed ikke benyttes, når du henter logfilen.\n\n  "

msgid "log_MATCH_PATTERN_LABEL"
msgstr "Fremhævelsesmønster (muligt)"

msgid "log_NO_MATCHING_LINES"
msgstr "Ingen passende linjer at vise."

msgid "log_OP_DESC"
msgstr " Du må vælge mellem, at vise logfiler i din browser eller at hente logfilen til din computer. Er logfilen specielt stor, kan du hente logfilen i stedet for at vise den i browseren, idet det kan være et problem for nogle browsere at vise meget store filer.\n\n  "

msgid "log_OP_LABEL"
msgstr "Handling"

msgid "log_REFRESH"
msgstr "Genopfrisk logfil"

msgid "log_VIEW"
msgstr "Vis logfil"

msgid "log_VIEWING_TIME"
msgstr "Vist [_1]."

