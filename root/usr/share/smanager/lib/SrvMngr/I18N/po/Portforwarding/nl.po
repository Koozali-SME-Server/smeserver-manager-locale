msgid "Port forwarding"
msgstr "Poort doorzending"

msgid "pf_ALLOW_HOSTS"
msgstr "Hosts toestaan"

msgid "pf_CREATE_RULE"
msgstr "Poort-doorzendregel toevoegen"

msgid "pf_ERR_BADAHOST"
msgstr "Dit lijkt geen valide IP adres lijst te zijn. B.v. 192.168.0.1,192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "Dit blijkt geen IP adres te zijn. U dient de #.#.#.# notatie aan te houden waarbij elk # een getal onder de 256 dient te zijn. Bijv.: 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "De poorten dienen een positieve integer waarde te zijn kleiner dan 65536."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "Gebeurtenis retourneert een niet-nul waarde."

msgid "pf_ERR_PORT_COLLISION"
msgstr "FOUT: Deze poort of poort bereik conflicteert met een bestaande regel. Alstublieft deze nieuwe regel wijzigen of de bestaande regel verwijderen."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  Dit scherm kan worden gebruikt voor het wijzigen van de firewall regels zoals het openen van een specifieke poort op deze server en het doorzenden naar een andere poort op een andere computer. Indien geconfigureerd heeft inkomend verkeer direct toegang tot een systeem op het LAN. \n\n  <p> WAARSCHUWING: Verkeerd gebruik van deze optie kan de veiligheid van het netwerk ernstig schaden. Gebruik deze mogelijkheid niet luchthartig en zonder de strekking en gevolgen volledig te begrijpen. </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Configureer poort doorzenden"

msgid "pf_IN_SERVERONLY"
msgstr "Deze server staat momenteel in de enkel server modus en poort-doorzenden is alleen mogelijk naar de server zelf."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Doel-host IP adres"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Doel-poort(en)"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protocol"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Bron-poort(en)"

msgid "pf_NO_FORWARDS"
msgstr "Er zijn momenteel geen poort-doorzendregels aanwezig op dit systeem."

msgid "pf_RULE_COMMENT"
msgstr "Regel Commentaar"

msgid "pf_SHOW_FORWARDS"
msgstr "Onderstaand vindt u een overzichtstabel met de actuele poort-doorzendregels zoals geconfigureerd op deze server. Klik op de &quot;Verwijderen&quot; link op de corresponderende regel te verwijderen."

msgid "pf_SUCCESS"
msgstr "Poort-doorzendregel is met succes gewijzigd."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "Het volgende somt de poort-doorzendregel op welke u op het punt staat toe te voegen. Indien u tevreden bent met deze regel klik op de &quot;Toevoegen&quot; knop. Bent u niet tevreden klik dan op de &quot;Annuleren&quot; knop."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "Het volgende somt de poort-doorzendregel op welke u op het punt staat te verwijderen. Indien u zeker bent dat u deze regel wilt verwijderen, klik u op de &quot;Verwijderen&quot; knop. Bent u niet zeker, klik dan op de &quot;Annuleren&quot; knop."

