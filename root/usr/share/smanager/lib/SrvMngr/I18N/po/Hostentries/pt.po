msgid "Hostnames and addresses"
msgstr "Hosts e endereços"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "O endereço está contido na faixa dinâmica do DHCP"

msgid "hos_ADD_HOSTNAME"
msgstr " Adicionar nomes de host "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Criar ou modificar o nome de host"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Lista atual de nome de hosts para %1"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Ocorreu erro quando criava nome de host."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Ocorreu erro quando eliminava nome de host."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Ocorreu erro quando modificava nome de host."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Erro: IP não pode ser IP do servidor ou IP do gateway."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Erro: Este endereço IP não está em nenhuma rede local."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Endereço ethernet"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "O endereço ethernet é opicional e faz com que o servidor DHCP atar estaticamente o endereço IP local ao computador com esse endereço ethernet. Se especificado, tem que estar no formato \"AA:BB:CC:DD:EE:FF\" e conter somente números de 0-9 e letras de A-F."

msgid "hos_FORM_TITLE"
msgstr "Nomes de host e endereços"

msgid "hos_HOSTNAME"
msgstr "Nome de host"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Erro: caracteres inesperados no nome de host: \"%1.%2\". O nome de hoste deve conter somente letras, números, e hifens e tem que iniciar com uma letra ou um número."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "O nome de host não tem que conter somente letras, números, e hifens, e tem que iniciar com uma letra ou número."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Erro: conta %1 é um nome de host %2 existente."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Erro: caracteres inesperados no nome de host: \"%1.%2\". O nome de hoste deve conter somente letras, números, e hifens e tem que iniciar com uma letra ou um número."

msgid "hos_HOSTTYPE"
msgstr "Localização"

msgid "hos_LOCAL_IP"
msgstr "IP local"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "O endereço IP local é o endereço de uma outra máquina na rede local. Favor entrar com um endereço IP válido no formato \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Favor entrar com os seguintes detalhes adicionais para o host local:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Modificar nome do host"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Favor entrar com os seguintes detalhes adicionais para o host remoto:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Voce estar prestes a remover um nome de host \"%1.%2\".   Voce tem certeza que deseja remover este nome de host? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Remover nome do host"

