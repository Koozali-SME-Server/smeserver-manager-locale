msgid "Reboot or shutdown"
msgstr "(en) Reboot or shutdown"

msgid "rbo_DESCRIPTION"
msgstr " Du kan starta om, stänga av eller utföra en fullständig omkonfigurering av systemet från denna skärm. Du måste genomföra en avstängning före det att du stänger av strömmen. Alla dessa funktioner tar flera minuter att genomföra. När du klickar på Verkställ kommer funktionen att påbörjas omedelbart, var beredd! "

msgid "rbo_DESC_REBOOT"
msgstr "Din server har initierat omstartsprocessen."

msgid "rbo_DESC_RECONFIGURE"
msgstr "Din server har initierat en fullständig omkonfigurering och omstart av systemet."

msgid "rbo_DESC_SHUTDOWN"
msgstr "Din server har initierat en avstängningsprocess. Processen kommer pågå i flera minuter och därefter kan du stänga av strömmen."

msgid "rbo_FORM_TITLE"
msgstr "Stäng av eller starta om"

msgid "rbo_LABEL_REBOOT"
msgstr "Välj Avstängning, Omstart eller Omkonfigurering"

msgid "rbo_REBOOT"
msgstr "Starta om"

msgid "rbo_REBOOT_SUCCEEDED"
msgstr "Omstart initierad."

msgid "rbo_RECONFIGURE_SUCCEEDED"
msgstr "Omkonfigureringsbegäran har initierats."

msgid "rbo_SHUTDOWN_SUCCEEDED"
msgstr "(en) Shutdown request initiated successfully."

