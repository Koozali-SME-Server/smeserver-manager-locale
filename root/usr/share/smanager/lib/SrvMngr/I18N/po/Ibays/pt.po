msgid "iba_ACCOUNT_EXISTS"
msgstr "A conta \"%1\" é uma conta do tipo %2 já existente."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " A conta \"%1\" conflita com detalhes do apelido para a conta \"%3\" do tipo %2. %1 é um apelido para %3. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "O nome de i-bay \"%1\" contem caracteres inválidos. Nome de I-bay tem que iniciar com letra minúscula e conter somente letras minúsculas, números e hifens."

msgid "iba_ADD_IBAY"
msgstr "Adicionar i-bay"

msgid "iba_ADD_TITLE"
msgstr "Criar ou modificar um i-bay"

msgid "iba_ALLOW_DYNAMIC_CONTENT"
msgstr "Conteúdo de execução dinâmica (CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "Incapaz de criar conta para %1 (isto já existe?)"

msgid "iba_CANT_FIND_IBAY"
msgstr "Incapaz de encontrar conta para %1 (isto não existe?)"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "Toda a Internet (não requer senha)"

msgid "iba_ENTIRE_INTERNET_PASSWORD"
msgstr "Toda a Internet (requer senha)"

msgid "iba_ENTIRE_INTERNET_PASSWORD_REMOTE"
msgstr "Toda a Internet (requer senha para rede externa)"

msgid "iba_ERROR_WHILE_CREATING_IBAY"
msgstr "Um erro ocoreu quando criava o compartilhamento."

msgid "iba_ERROR_WHILE_DELETING_IBAY"
msgstr "Um erro ocorreu enquanto eliminava o compartilhamento."

msgid "iba_ERROR_WHILE_MODIFYING_IBAY"
msgstr "Ocorreu um erro quando modificava a i-bay."

msgid "iba_ERROR_WHILE_RESETTING_PASSWORD"
msgstr "Erro enquanto resetava senha."

msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "  Adicionar i-bay \n\n   Voce pode remover qualquer informação do compartilhamento ou resetar a senha clicando no comando correspondente próximo ao compartilhamento. Se o compartilhamento estiver em vermelho, isto significa que a senha ainda não foi definida, e deverá ser trocada tão logo possível. \n\n  "

msgid "iba_FORM_TITLE"
msgstr "Criar, modificar ou remover compartilhamentos"

msgid "iba_HTTPS_Only"
msgstr "Forçar conexões seguras"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "As senhas que você entrou não são iguais."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Rede local (não requer senha)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "Rede local (requer senha)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "O nome do i-bay \"%1\" é muito longo. O máximo é de %1 caracteres."

msgid "iba_NAME_FIELD_DESC"
msgstr "O nome do compartilhamento deverá conter somente letras minúsculas números, pontos, hífens e sublinhado, e deverá iniciar com letra minúscula. Por exemplo \"joao\", \"intra\", e \"cust3.prj12\" são todos nomes válidos, mas \"3associados\", \"Joao Silva\" e \"Parceiros!Comerciais\" não são. O tamanho do nome está limitado a %1 caracteres."

msgid "iba_NAME_LABEL"
msgstr "Nome do compartilhamento"

msgid "iba_NONE"
msgstr "Sem acesso"

msgid "iba_NO_IBAYS"
msgstr "Não existe nenhum compartilhamento configurado."

msgid "iba_PASSWORD_DESC"
msgstr "Você está prestes a trocar a senha do compartilhamento %1."

msgid "iba_PUBLIC_ACCESS"
msgstr "Acesso público via web ou ftp anônimo"

msgid "iba_REMOVE_DESC"
msgstr "  Você está prestes a remover o compartilhamento \"%1\" (%2). \n\n   Todos os arquivos pertencentes a este compartilhamento serão apagados. \n\n   Você tem certeza que deseja remover este compartilhamento? \n\n  "

msgid "iba_REMOVE_TITLE"
msgstr "Remover compartilhamento"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "Compartilhamento criado com sucesso."

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "Compartilhamento eliminado com sucesso."

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "Compartilhamento modificado com sucesso."

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "Senha resetada com sucesso."

msgid "iba_USER_ACCESS"
msgstr "Acesso do usuário via compartilhamento de arquivos ou ftp"

msgid "iba_VHOST_MESSAGE"
msgstr " Os seguinte domínios virtuais estavam usando este compartilhamento como seu conteúdo e serão mudados para o web site primário (você pode mudá-los para outro local mais tarde):\n\n  <ul>%1</ul> "

msgid "iba_WARG"
msgstr "Escrever = admin, Ler = grupo"

msgid "iba_WGRE"
msgstr "Escrever = grupo, Ler = todos"

msgid "iba_WGRG"
msgstr "Escrever = grupo, Ler = grupo"
