msgid "dom_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this domain ?"

msgid "dom_ADD_DOMAIN"
msgstr "Aggiungi dominio"

msgid "dom_CONTENT"
msgstr "I-bay per %1"

msgid "dom_CONTENT_FIELD_DESCRIPTION"
msgstr "Per il sito web, è possibile selezionare il sito principale o qualsiasi i-bay."

msgid "dom_CREATE_TITLE"
msgstr "Crea nuovo dominio"

msgid "dom_CURRENT_DOMAINS"
msgstr "Elenco attuale dei domini"

msgid "dom_DESC_CORPORATE_DNS"
msgstr "Se il server non ha accesso ad Internet o la risoluzione dei nomi è affidata ad altri server, inserire gli indirizzi IP dei server DNS nei campi sottostanti. Si consiglia di lasciarli vuoti e non inserire gli indirizzi dei DNS del provider perché il server è in grado di risolvere direttamente tutti i nomi di dominio Internet senza necessità di ulteriori configurazioni."

msgid "dom_DESC_CORPORATE_DNS_CURRENT"
msgstr " Configurazione DNS "

msgid "dom_DESC_NAMESERVERS"
msgstr "E' possibile scegliere se il dominio verrà risolto localmente, passato al server DNS aziendale o risolto dai server DNS Internet. Nella maggior parte dei casi si consiglia di lasciare il valore di default."

msgid "dom_DOMAINS_PAGE_CORPORATE_DNS"
msgstr "Modifica le impostazioni DNS aziendali"

msgid "dom_DOMAIN_DESCRIPTION_VALIDATION_ERROR"
msgstr "Errore: carattere inaspettato o mancante nella descrizione %1. Dominio non creato."

msgid "dom_DOMAIN_IN_USE_ERROR"
msgstr "Errore: dominio %1 già in uso. Dominio non creato."

msgid "dom_DOMAIN_NAME_VALIDATION_ERROR"
msgstr "Errore: carattere inaspettato o mancante nel nome di dominio %1. Il nome può contenere uno o più lettere, numeri, punti e segni meno (trattino). Dominio non creato."

msgid "dom_ERROR_CREATING_DOMAIN"
msgstr "(en) Error creating domain"

msgid "dom_ERROR_MODIFYING_DOMAIN"
msgstr "(en) Error modifying domain"

msgid "dom_ERROR_UPDATING"
msgstr "(en) Error updating"

msgid "dom_ERROR_WHILE_REMOVING_DOMAIN"
msgstr "Errore: problema interno durante la rimozione del dominio %1."

msgid "dom_FORM_DESCRIPTION"
msgstr " Creando un dominio, il server potrà ricevere e-mail per quel dominio e potrà anche ospitare il sito web di quel dominio.\n\n  <p><a class=\"button-like\" href=\"domains?page=0&page_stack=&next=next&wherenext=domains_page_create\">Aggiungi dominio</a> "

msgid "dom_FORM_TITLE"
msgstr "Gestione domini"

msgid "dom_LABEL_CORPORATE_DNS_PRIMARY"
msgstr "Server DNS primario"

msgid "dom_LABEL_CORPORATE_DNS_SECONDARY"
msgstr "Server DNS secondario"

msgid "dom_LABEL_NAMESERVERS"
msgstr "Server DNS per il dominio"

msgid "dom_MODIFY_TITLE"
msgstr "Modifica dominio"

msgid "dom_NONEXISTENT_DOMAIN_ERROR"
msgstr "Errore: %1 non è un dominio esistente."

msgid "dom_PRIMARY_SITE"
msgstr "Sito principale"

msgid "dom_REMOVE_DESCRIPTION"
msgstr "  Sta per essere rimosso il dominio %1 (%2). \n\n  <p> <b>Siete sicuri di voler rimuovere questo dominio ?</b> </p>\n\n  "

msgid "dom_REMOVE_TITLE"
msgstr "Rimuovi dominio"

msgid "dom_SUCCESSFULLY_CREATED"
msgstr "Dominio %1 creato con successo. Riavvio del server web in corso. I link su questa pagina rimarranno inattivi fino al completamento dell'operazione."

msgid "dom_SUCCESSFULLY_DELETED"
msgstr "Dominio %1 eliminato con successo. Riavvio del server web in corso. I link su questa pagina rimarranno inattivi fino al completamento dell'operazione."

msgid "dom_SUCCESSFULLY_MODIFIED"
msgstr "Dominio %1 modificato con successo. Riavvio del server web in corso. I link su questa pagina rimarranno inattivi fino al completamento dell'operazione."

msgid "dom_SYSTEM_DOMAIN_ERROR"
msgstr "Errore: dominio %1 è il dominio di sistema. Impossibile creare un dominio con lo stesso nome. Dominio non creato."

msgid "dom_corporate"
msgstr "Server DNS aziendale"

msgid "dom_internet"
msgstr "Server DNS Internet"

msgid "dom_localhost"
msgstr "Risolvi localmente"

