msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "Ez a szerver munkacsoport és tartományvezérlőként működjön a Windows hálózatban? Hagyja ezt a beállítást Nem -en ha egy másik szerver végzi ezt a szerepkört a hálózatban."

msgid "wkg_DESC_ROAM"
msgstr " Támogassa a szerver a mozgó profilok használatát? Hagyja ezt a beállítást Nem -en hacsak van tapasztalata a szerveren tárolt Windows mozgó profilok adminisztrálásában és tudja, hogy erre a funkcióra szükség van. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Írja be azt a nevet, amit a szerver a Windows és Macintosh fájlmegosztáshoz használjon."

msgid "wkg_DESC_WORKGROUP"
msgstr " Írja be annak a Windows munkacsoportnak a nevét amelyben ennek a szervernek meg kell jelennie. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Munkacsoport beállítások változtatása"

msgid "wkg_INVALID_SERVERNAME"
msgstr "A szerver nevének (kis vagy nagy) betűvel kell kezdődnie, ezt követheti bármilyen kombinációban betű, szám, aláhúzás, pont és kötőjel."

msgid "wkg_INVALID_WORKGROUP"
msgstr "A munkacsoport nevének (kis vagy nagy) betűvel kell kezdődnie, ezt követheti bármilyen kombinációban betű, szám, aláhúzás, pont és kötőjel."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "A szerver és a munkacsoport neve kisbetűsen összehasonlítva megegyezik. Ahhoz, hogy a fájlmegosztás működjön ezeknek különbözőeknek kell lenniük."

msgid "wkg_LABEL_PDC"
msgstr "Munkacsoport és tartományvezérlő"

msgid "wkg_LABEL_ROAM"
msgstr "Mozgó profilok"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Szerver név"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Windows munkacsoport"

msgid "wkg_SUCCESS"
msgstr "Az új munkacsoport beállítások lementődtek"
