msgid "Reboot or shutdown"
msgstr "(en) Reboot or shutdown"

msgid "rbo_DESCRIPTION"
msgstr " Du kan genstarte, lukke serveren ned eller foretage en omkonfigurering af serveren fra dette skærmbillede. Du skal gennemføre \"Luk ned\"-proceduren før du tager strømmen. Alle funktioner kan vare adskillige minutter. Når du klikker på Udfør starter udførelsen af dit valg, så vær varsom! "

msgid "rbo_DESC_REBOOT"
msgstr "Serveren har iværksat en genstart."

msgid "rbo_DESC_RECONFIGURE"
msgstr "Din server har iværksat en komplet system omkonfiguration efterfulgt af en genstart."

msgid "rbo_DESC_SHUTDOWN"
msgstr "Din Server har iværksat en nedlukning. Processen kan tage adskillige minutter, hvorefter du kan slukke for strømmen."

msgid "rbo_FORM_TITLE"
msgstr "Luk ned eller genstart"

msgid "rbo_LABEL_REBOOT"
msgstr "Vælg Sluk, Genstart eller Omkonfigurér"

msgid "rbo_REBOOT"
msgstr "Genstart"

msgid "rbo_REBOOT_SUCCEEDED"
msgstr "Genstart iværksættes."

msgid "rbo_RECONFIGURE_SUCCEEDED"
msgstr "Omkonfiguration iværksættes."

msgid "rbo_SHUTDOWN_SUCCEEDED"
msgstr "(en) Shutdown request initiated successfully."

