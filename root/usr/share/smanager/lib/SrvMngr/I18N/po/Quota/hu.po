msgstr "jelenleg van:"

msgid "quo_CURRENT_USAGE"
msgstr "Jelenlegi kihasználtság (MB)"

msgid "quo_CURRENT_USAGE_AND_SETTINGS"
msgstr "Jelenlegi kvóta kihasználtság és beállítások"

msgid "quo_ERR_HARD_LT_SOFT"
msgstr "Hiba: az abszolút határ értékének nagyobbnak kell lennie mint a türelmi korlát értékének."

msgid "quo_ERR_MODIFYING"
msgstr "Hiba történt a felhasználó módosításakor."

msgid "quo_ERR_NOT_A_USER_ACCT"
msgstr "Hiba: ez a fiók nem felhasználói fiók:"

msgid "quo_ERR_NO_SUCH_ACCT"
msgstr "Hiba: nincs ilyen nevű fiók:"

msgid "quo_FILES"
msgstr "fájl"

msgid "quo_FORM_TITLE"
msgstr "Felhasználói fiók kvótájának létrehozása, módosítása vagy eltávolítása."

msgid "quo_HARD_VAL_MUST_BE_NUMBER"
msgstr "Hiba: az abszolút korlátozás értékének egész számnak kell lennie, opcionálisan kiegészítve a K, M, vagy G utótagokkal."

msgid "quo_INSTRUCTIONS"
msgstr "A kvótát egész számként adja meg, opcionálisan kiegészítve a 'K' mint kilobájt, 'M' mint megabájt, vagy 'G' mint gigabájt utótagokkal. Ha nem ad meg utótagot, akkor az automatikusan megabájtnak minősül. A 0 beállítás bármelyik határértéknél kikapcsolja a korlátozást az adott felhasználónak."

msgid "quo_LIMIT_WITH_GRACE"
msgstr "Türelmi határ"

msgid "quo_LIMIT_WITH_GRACE_MB"
msgstr "Türelmi határ (MB)"

msgid "quo_MEGABYTES"
msgstr "megabájtot"

msgid "quo_MODIFY_USER_TITLE"
msgstr "Felhasználói kvóta módosítása"

msgid "quo_OCCUPYING"
msgstr "amely lefoglal:"

msgid "quo_QUOTA_DESC"
msgstr " A felhasználó neve melletti \"Módosítás\" gombra kattintva fájlrendszer kvótát állíthat be. Ha a felhasználó tárhelyének mérete eléri a \"türelmi határt\", figyelmeztető üzenetet kap. Ha a felhasználó túllépi ezt a türelmi határt, vagy eléri az abszolút határt, nem tud több fájlt lementeni és nem tud e-mailt fogadni. A 0 érték megadása bármely határértéknél kikapcsolja az adott felhasználói határértéket. Minden felhasználó tárhelyébe beleszámít a felhasználó home könyvtára, az e-mail fiókja és a felhasználó bármely adattárban tárolt fájljai. "

msgid "quo_SOFT_VAL_MUST_BE_NUMBER"
msgstr "Hiba: a korlátozás türelmi idővel értékének egész számnak kell lennie, opcionálisan kiegészítve a K, M, vagy G utótagokkal."

msgid "quo_SUCCESSFULLY_MODIFIED"
msgstr "A következő felhasználói fiók kvótája sikeresen módosult:"

msgid "quo_USER"
msgstr "Felhasználó:"

