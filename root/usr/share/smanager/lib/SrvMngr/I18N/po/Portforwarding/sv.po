msgid "Port forwarding"
msgstr "(en) Port forwarding"

msgid "pf_ALLOW_HOSTS"
msgstr "Tillåtna värdar"

msgid "pf_CREATE_RULE"
msgstr "Skapa regel för vidarebefordran av post"

msgid "pf_ERR_BADAHOST"
msgstr "Detta verkar inte vara en giltig lista över IP-adresser exvis: 192.168.0.1,192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "Detta verkar inte vara en IP-adress. Du måste använda fyra grupper av tal med punkt emellan och varje tal av de fyra måste vara mindre än 256. exvis: 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "Portarna måste vara av ett positivt heltal mindre än 65536."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "Händelsen returnerade ett värde skilt från noll."

msgid "pf_ERR_PORT_COLLISION"
msgstr "Fel: Denna port eller portintervall har en konflikt med en befintlig regel. Ändra denna nya regel eller radera den gamla regeln."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  Du kan använda denna panel för att modifiera dina brandväggsregler för att öppna en angiven port på denna server och vidarebefordra den till en annan port på en annan värd. Genom att göra detta tillåts inkommande trafik åtkomst direkt till en privat värd på ditt LAN. \n\n  <p> Varning: Felaktig användning av denna inställning kan allvarligt hota säkerheten på ditt nätverk. Använd inte denna möjlighet lättvindligt eller utan att du förstår innebörden av dina åtgärder. </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Konfigurera vidarebefordran av port"

msgid "pf_IN_SERVERONLY"
msgstr "Denna server är för närvarande i endast servermod och vidarebefordran av port är endast möjligt till localhost."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Mottagande värds IP-adress"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Mottagarport(ar)"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protokoll"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Källport(ar)"

msgid "pf_NO_FORWARDS"
msgstr "Det finns för närvarande inga portar som vidarebefordras på systemet."

msgid "pf_RULE_COMMENT"
msgstr "Kommentar"

msgid "pf_SHOW_FORWARDS"
msgstr "Nedan finner du en tabell som summerar de nuvarande reglerna för vidarebefordran av post på denna server. Klicka på &quot;Radera&quot;-länken för radering av aktuell regel."

msgid "pf_SUCCESS"
msgstr "Din ändring av regeln för vidarebefordran av port har sparats."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "Följande summerar den regel för vidarebefordran av port som du håller på att skapa. Om du är nöjd med regeln, klicka på &quot;Lägg till&quot;-knappen. Om du inte är nöjd, klicka på &quot;Avbryt&quot;-knappen."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "Följande summerar den regel för vidarebefordran av port som du håller på att radera. om du är säker på att du vill radera denna regel, klicka på &quot;Radera&quot;-knappen. Om inte, klicka på &quot;Avbryt&quot;-knappen."

