msgid "Hostnames and addresses"
msgstr "Ονόματα κεντρικών υπολογιστών και διευθύνσεις"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "Η διεύθυνση βρίσκεται είναι εντός της περιοχής δυναμικών διευθύνσεων που έχουν εκχωρηθεί στον DHCP"

msgid "hos_ADD_HOSTNAME"
msgstr " Προσθήκη δικτυακής ονομασίας Η/Υ "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Δημιουργία ή τροποποίηση δικτυακής ονομασίας Η/Υ"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Τρέχουσα λίστα δικτυακών ονομασιών Η/Υ για τον %1"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Παρουσιάσθηκε σφάλμα κατά τη δημιουργία της δικτυακής ονομασίας Η/Υ."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Παρουσιάσθηκε σφάλμα κατά τη διαγραφή της δικτυακής ονομασίας Η/Υ."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Παρουσιάσθηκε σφάλμα κατά την τροποποίηση της δικτυακής ονομασίας Η/Υ."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Σφάλμα: Η διεύθυνση IP δεν μπορεί να είναι ίδια με αυτή του διακομιστή ή της πύλης."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Σφάλμα: Αυτή η διεύθυνση IP δεν είναι σε κανένα από τα τοπικά μας δίκτυα."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Διεύθυνση Ethernet"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "Η διεύθυνση ethernet είναι προαιρετική και έχει ως αποτέλεσμα ο διακομιστής DHCP να συνδέει στατικά την τοπική διεύθυνση IP με τον υπολογιστή που έχει τη συγκεκριμένη διεύθυνση ethernet. Εάν ορισθεί, πρέπει να είναι της μορφής \"AA:BB:CC:DD:EE:FF\" και πρέπει να περιέχει μόνο αριθμούς από 0-9 και γράμματα από A-F."

msgid "hos_FORM_TITLE"
msgstr "Ονόματα κεντρικών υπολογιστών και διευθύνσεις"

msgid "hos_HOSTNAME"
msgstr "Δικτυακή ονομασία Η/Υ"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Σφάλμα: μη αναμενόμενος χαρακτήρας στη δικτυακή ονομασία Η/Υ: \"%1.%2\". Η δικτυακή ονομασία Η/Υ μπορεί να περιλαμβάνει μόνο γράμματα, αριθμούς και παύλες και πρέπει να ξεκινάει με γράμμα ή αριθμό."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Η δικτυακή ονομασία Η/Υ πρέπει να περιλαμβάνει μόνο γράμματα, αριθμούς και παύλες και πρέπει να ξεκινάει με γράμμα ή αριθμό."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Σφάλμα: Η ονομασία του λογαριασμού %1 υφίσταται και είναι δικτυακή ονομασία Η/Υ τύπου %2."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Σφάλμα: μη αναμενόμενος χαρακτήρας στη δικτυακή ονομασία Η/Υ: \"%1.%2\". Η δικτυακή ονομασία Η/Υ μπορεί να περιλαμβάνει μόνο γράμματα, αριθμούς και παύλες και πρέπει να ξεκινάει με γράμμα ή αριθμό."

msgid "hos_HOSTTYPE"
msgstr "Τοποθεσία"

msgid "hos_LOCAL_IP"
msgstr "Τοπική IP"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "Η Τοπική διεύθυνση IP είναι η διεύθυνση IP ενός άλλου μηχανήματος στο τοπικό δίκτυο. Παρακαλώ εισάγετε μία έγκυρη διεύθυνση IP της μορφής \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Παρακαλώ εισάγετε τις ακόλουθες πρόσθετες λεπτομέρειες για ένα τοπικό Η/Υ:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Τροποποίηση ονόματος κεντρικού υπολογιστή"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Παρακαλώ εισάγετε τις ακόλουθες επιπλέον λεπτομέρειες για ένα απομακρυσμένο Η/Υ:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Πρόκειται να διαγράψετε τη δικτυακή ονομασία \"%1.%2\".   Είστε σίγουροι ότι θέλετε να τη διαγράψετε; "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Αφαίρεση ονόματος κεντρικού υπολογιστή"

