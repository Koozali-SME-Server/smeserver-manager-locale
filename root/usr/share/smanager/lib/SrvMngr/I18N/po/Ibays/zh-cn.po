msgid "iba_ACCOUNT_EXISTS"
msgstr "账号\"[_1]\" 是已存在的[_2]账号。"

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " 账号 \"[_1]\"与[_2] 账号 \"[_3]\"的署名有冲突. [_1]是[_3]的署名。 "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "i-bay名称\"[_1]\" 包含无效字符。i-bay名称必须以小写字母开头，并且只能包含小写字母、数字和连接符。"

msgid "iba_ADD_IBAY"
msgstr "添加 i-bay"

msgid "iba_ADD_TITLE"
msgstr "创建或修改i-bay"

msgid "iba_ALLOW_DYNAMIC_CONTENT"
msgstr "执行动态内容(CGI, PHP, SSI)"

msgid "iba_CANT_CREATE_IBAY"
msgstr "无法为[_1]创建新账号（请确认其是否已经存在？）"

msgid "iba_CANT_FIND_IBAY"
msgstr "无法找到[_1]的账号（请确认其是否存在？）"

msgid "iba_ENTIRE_INTERNET_NO_PASSWORD"
msgstr "外部网络（无需密码）"

msgid "iba_ENTIRE_INTERNET_PASSWORD"
msgstr "外部网络（需要密码）"

msgid "iba_ENTIRE_INTERNET_PASSWORD_REMOTE"
msgstr "整个网络（本地网络以外需要密码）"

msgid "iba_ERROR_WHILE_CREATING_IBAY"
msgstr "创建信息港时出错。"

msgid "iba_ERROR_WHILE_DELETING_IBAY"
msgstr "删除信息港时发生错误。"

msgid "iba_ERROR_WHILE_MODIFYING_IBAY"
msgstr "修改信息港时发生错误。"

msgid "iba_ERROR_WHILE_RESETTING_PASSWORD"
msgstr "密码重置时发生错误。"

msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "  添加信息港 \n\n  您可以移除任何信息港或点击信息港边相应的命令来重置其密码。如果信息港显示为红色，则表示其密码为默认，没有修改过，因此应该尽快修改。\n\n  "

msgid "iba_FORM_TITLE"
msgstr "创建、修改或删除i-bay"

msgid "iba_HTTPS_Only"
msgstr "强制安全连接"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "两次密码不相匹配。"

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "本地网络（无需密码）"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "本地网络（需要密码）"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "i-bay名称\"[_1]\"太长，最大为[_1]个字符。"

msgid "iba_NAME_FIELD_DESC"
msgstr "i-bay名称只能包含小写字母、数字、句点、连接符和下划线，并且要以小写字母开头。例如\"johnson\"、\"intra\"和\"cust3.prj12\"是有效名称，但是\"3associates\"、 \"John Smith\" 和\"Bus!Partner\"是无效的。该名称的长度限制为 [_1] 个字符。"

msgid "iba_NAME_LABEL"
msgstr "i-bay名称"

msgid "iba_NONE"
msgstr "无法访问"

msgid "iba_NO_IBAYS"
msgstr "当前尚未配置信息港。"

msgid "iba_PASSWORD_DESC"
msgstr "将要修改信息港[_1]的密码。"

msgid "iba_PUBLIC_ACCESS"
msgstr "通过web或匿名FTP来公开访问"

msgid "iba_REMOVE_DESC"
msgstr "  您正要删除i-bay \"[_1]\" ([_2]). \n\n   此i-bay的所有文件都将被删除。 \n\n   是否真的要删除此i-bay？ \n\n  "

msgid "iba_REMOVE_TITLE"
msgstr "删除i-bay"

msgid "iba_SUCCESSFULLY_CREATED_IBAY"
msgstr "信息港创建成功。"

msgid "iba_SUCCESSFULLY_DELETED_IBAY"
msgstr "信息港删除成功。"

msgid "iba_SUCCESSFULLY_MODIFIED_IBAY"
msgstr "信息港修改成功。"

msgid "iba_SUCCESSFULLY_RESET_PASSWORD"
msgstr "密码重置成功。"

msgid "iba_USER_ACCESS"
msgstr "用户通过文件共享或FTP来访问"

msgid "iba_VHOST_MESSAGE"
msgstr " 下面的虚拟域将使用此信息港作为其内容，它将被当做主web站点（可以稍后修改它们）: [_1] "

msgid "iba_WARG"
msgstr "写入 = 管理员，读取 = 群"

msgid "iba_WGRE"
msgstr "写入 = 群组，读取 = 任何人"

msgid "iba_WGRG"
msgstr "写入=群，读取=群"

