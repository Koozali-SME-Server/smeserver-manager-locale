msgid "Local networks"
msgstr "Redes locais"

msgid "ln_ADD_DESC"
msgstr " Cada parametro tem que está na forma #.#.#.# (cada # é um número entre 0 e 255). O software do servidor irá zerar a parte final (identificador de host) do endereço de rede de acordo com a máscara de rede, para certificar que o endereço de rede e válido.  \"Router\" deverá ser o endereço IP do roteador de sua rede local pelo qual a rede adicional será alcançada. "

msgid "ln_ADD_TITLE"
msgstr "Adicionar uma rede local"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "Ocorreu um erro enquanto criava a rede."

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "Um erro ocorreu enquanto eliminava a rede."

msgid "ln_FIRSTPAGE_DESC"
msgstr " Por razões de segurança, vários serviços em seu servidor estão disponíveis somente para sua rede local. Entretando você pode garantir esses privilégios de acesso da rede local local para redes externas, listando-as abaixo. A maioria das instalações deveriam deixar esta lista em branco. Adicionar rede "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "Endereço de IP inválido"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Máscara de subrede inválida"

msgid "ln_LOCAL NETWORKS"
msgstr "Redes locais"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Adicionar rede"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "Erro: rede [_1] (derivada da rede [_2] e máscara de rede [_3]) já foi adicionada. Nova rede não adicionada."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "Erro: rede [_1] (derivada da rede [_2] e máscara de rede [_3]) já é considerada local. Nova rede não adicionada."

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "Erro: endereço de roteador [_1] não está acessível da rede local. Rede não adicionada."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Número de hosts"

msgid "ln_REMOVE_DESC"
msgstr "Voce está prestes a remover a seguinte rede local."

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "Hosts detectados na rede que voce esta prestes a eliminar. Por padrão, eles tambem serão eliminados. Desmarque essa caixa se por alguma razão voce não quer que isso aconteça. Note que eles não irão ser tratados como hosts locais e não poderão ser nem acessados depois que a rede for eliminada."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "Eliminat hosts na rede"

msgid "ln_REMOVE_TITLE"
msgstr "Remover rede local"

msgid "ln_SUBNET_MASK"
msgstr "Máscara de subrede"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "Rede adicionada com sucesso [_1]/[_2] rotear via [_3]. Seu servidor irá garantir privilegios de acesso local para [_4] endereços IP na faixa de [_5] à [_6]."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "  Rede adicionada com sucesso [_1]/[_2] rotear via [_3]. \n\n  <p> Seu servidor irá garantir privilegios de acesso local para [_1] endereços IP na faixa de [_2] à [_3]. </p>\n\n  <p> Aviso: o servidor FTP ProFTP não pode manusear essas máscaras de rede não -padrão. A especificação simples <b>[_1]</b> será usada. </p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "Remoção da rede com sucesso [_1]/[_2] rotear via [_3]."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "Rede adicionada com sucesso [_1]/[_2] rotear via [_3]. Seu servidor irá garantir privilégios de acesso local para o endereço IP [_4]."
