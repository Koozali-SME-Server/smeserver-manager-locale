msgid "Port forwarding"
msgstr "Port forwarding"

msgid "pf_ALLOW_HOSTS"
msgstr "Host ammessi"

msgid "pf_CREATE_RULE"
msgstr "Crea regola di port-forwarding"

msgid "pf_ERR_BADAHOST"
msgstr "Questo non sembra essere un indirizzo IP. Esempio: 192.168.0.1,192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "Questo non sembra essere un indirizzo IP. Deve essere utilizzata la notazione dotted-quad e ognuno dei 4 numeri deve essere minore di 256. Esempio: 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "Le porte devono essere un intero positivo minore di 65536."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "L'evento ha restituito un valore non nullo."

msgid "pf_ERR_PORT_COLLISION"
msgstr "Errore: Questa porta o range di porte è in conflitto con una regola esistente. Modificare questa regola o rimuovere la vecchia regola."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr "  Utilizzando questo pannello è possibile modificare le regole del firewall per aprire una porta specifica su questo server e inoltrare il traffico ad un'altra porta su un altro server. Sarà possibile accedere direttamente ad un server privato sulla rete locale. \n\n  <p> ATTENZIONE: l'uso improprio di questa funzione potrebbe compromettere seriamente la sicurezza della rete. Non utilizzare questa funzione con superficialità o senza comprenderne pienamente le implicazioni sulla sicurezza. </p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Configurazione Port Forwarding"

msgid "pf_IN_SERVERONLY"
msgstr "Il server è in modalità serveronly. Il port-forwarding è possibile soltanto verso localhost."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Indirizzo IP Destinazione"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Porta/e Destinazione"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protocollo"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Porta/e Sorgente"

msgid "pf_NO_FORWARDS"
msgstr "Non ci sono port-forwarding configurati nel sistema."

msgid "pf_RULE_COMMENT"
msgstr "Commento"

msgid "pf_SHOW_FORWARDS"
msgstr "La tabella riassume le regole di port-forwarding installate sul server. Fare clic sul link &quot;Rimuovi&quot; per rimuovere la regola corrispondente."

msgid "pf_SUCCESS"
msgstr "Modifiche alle regole di port forwarding salvate con successo."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "La tabella seguente mostra la regola di port-forwarding che sta per essere aggiunta. Se la regola appare corretta, fare clic sul pulsante &quot;Aggiungi&quot;. In caso contrario, fare clic sul pulsante &quot;Annulla&quot;."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "La tabella seguente mostra la regola di port-forwarding che sta per essere rimossa. Se siete sicuri di voler rimuovere la regola, fare clic sul pulsante &quot;Rimuovi&quot;. In caso contrario, fare clic sul pulsante &quot;Annulla&quot;."

