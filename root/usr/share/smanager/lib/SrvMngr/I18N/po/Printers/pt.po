msgid "Printers"
msgstr "Impressoras"

msgid "prt_ABOUT_TO_REMOVE"
msgstr "Voce está prestes a remover a impressora:"

msgid "prt_ARE_YOU_SURE"
msgstr "Voce tem certeza que desaja remover essa impressora?"

msgid "prt_CREATED_SUCCESSFULLY"
msgstr "Impressora criada com sucesso:"

msgid "prt_CREATE_NETWORK_DESC"
msgstr "Favor entrar com endereço e nome da impressora de rede"

msgid "prt_CREATE_NETWORK_PRINTER"
msgstr "Criar nova impressora de rede"

msgid "prt_CREATE_NEW_DESC"
msgstr "Favor escolher um nome único para a impressora e digitar uma breve descrição. O nome da impressora deve conter somente letras minúsculas e números, e deve inciciar com letra minúscula. Por exemplo \"hplaser\", \"epsonlp\", e \"canonbj\" são nomes válidos, mas \"HP Laser Jet\", \"Canon BubbleJet\", e \"HP JetDirect Printer\" não são. Evite nomes e descrições que contenham estes termos, \"offline\", \"disabled\", \"down\", \"off\", \"waiting\", \"jam\", \"paper\", \"error\" e \"responding\"."

msgid "prt_CREATE_NEW_PRINTER"
msgstr "Criar uma nova impressora"

msgid "prt_CURRENT_LIST"
msgstr "Lista atual de impressoras"

msgid "prt_DELETED_SUCCESSFULLY"
msgstr "Impressora removida com sucesso:"

msgid "prt_ERR_EXISTS"
msgstr "Erro: Uma conta com o mesmo nome já existe:"

msgid "prt_ERR_INTERNAL_FAILURE"
msgstr "Erro: falha interna enquanto removia a impressora:"

msgid "prt_ERR_INVALID_ADDRESS"
msgstr "Erro: endereço de rede inválido. Nova impressora não criada."

msgid "prt_ERR_INVALID_REMOTE_NAME"
msgstr "Erro: nome de impressora de rede iválido. Nova impressora não criada."

msgid "prt_ERR_UNEXPECTED_DESC"
msgstr "Erro: caracter inespedado ou ausente na descrição. Nova impressora não criada."

msgid "prt_ERR_UNEXPECTED_NAME"
msgstr " Erro: carecter inesperado no nome da impressora.\n\n  <p>O nome da impressora somente deve conter letras minúsculas e números, e deve iniciar com letra minúscula. Por exemplo \"hplaser\", \"epsonlp\", e \"canonbj\" são nomes válidos.</p>\n\n  "

msgid "prt_FIRST_USB_PRINTER"
msgstr "Primeira impressora USB acoplada"

msgid "prt_FORM_TITLE"
msgstr "Adicionar ou remover impressoras"

msgid "prt_HOSTNAME_OR_IP"
msgstr "Nome de host ou endereço IP da impressora de rede"

msgid "prt_INITIAL_BTN"
msgstr "Adicionar impressora"

msgid "prt_LOCAL_PRINTER_0"
msgstr "Impressora local porta 0 (LPT1)"

msgid "prt_LOCAL_PRINTER_1"
msgstr "Impressora local porta 1 (LPT2)"

msgid "prt_LOCAL_PRINTER_2"
msgstr "Impressora local porta 2 (LPT3)"

msgid "prt_MUST_BE_VALID_HOSTNAME_OR_IP"
msgstr "Tem que ser um endereço IP ou nome de host válido"

msgid "prt_NET_PRINTER"
msgstr "Impressora de rede ..."

msgid "prt_NO_PRINTERS"
msgstr "Não existem impressoras no sistema."

msgid "prt_PRINTER_NAME"
msgstr "Nome da impressora"

msgid "prt_REMOTE_ADDRESS"
msgstr "Endereço remoto"

msgid "prt_REMOTE_NAME"
msgstr "Nome remoto"

msgid "prt_REMOTE_NAME_DESC"
msgstr " Nome da impressora de rede (na dúvida entre raw) "

msgid "prt_REMOVE_PRINTER"
msgstr "Remover impressora"

msgid "prt_SECOND_USB_PRINTER"
msgstr "Segunda impressora USB acoplada"

msgid "prt_SPOOL_FILE_WARNING"
msgstr "Todos os arquivos da lista dessa impressora vão ser romovidos."

