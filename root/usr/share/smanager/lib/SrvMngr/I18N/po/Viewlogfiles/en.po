msgid "LOG_LIVESTREAM"
msgstr "Live stream"

msgid "log_END_DESC"
msgstr "Please note that it may take quite some time to generate these\nreports."

msgid "log_ERR_NOEXIST_FILE"
msgstr "Err noexist file"

msgid "log_ERR_NOOPEN_FILE"
msgstr "Err noopen file"

msgid "log_FILENAME_ERROR"
msgstr "Error while specifying log file name.\n<p>Invalid report type \"[_1]\".</p>"

msgid "log_FILTER_PATTERN_DESC"
msgstr "You may optionally specify a filter pattern to display only the\nlines from the log file which match this pattern. If you leave\nthis field blank, all available lines of the log file will be\ndisplayed. Note that this option is not used if you download the\nlogfile."

msgid "log_FILTER_PATTERN_HINT"
msgstr "The pattern is case insensitive, but enclosing it in \"/\" will result in it being treated as a regex."

msgid "log_FILTER_PATTERN_LABEL"
msgstr "Filter Pattern (optional)"

msgid "log_FIRSTPAGE_DESC"
msgstr "This panel allows you to view or download the log files generated\nby the services running on your server."

msgid "log_FORM_TITLE"
msgstr "View log files"

msgid "log_HIGHLIGHT_HEADER"
msgstr "Highlighting lines matching: \"[_1]\"."

msgid "log_LOG_FILE_EMPTY"
msgstr "Log file \"[_1]\" is empty!"

msgid "log_LOG_FILE_SELECT_DESC"
msgstr "Choose a log file to view"

msgid "log_MATCH_HEADER"
msgstr "Displaying lines matching: \"[_1]\"."

msgid "log_MATCH_PATTERN_DESC"
msgstr "You may also optionally specify a highlight pattern to be highlighted in the log file. The\nhighlight pattern is applied to any lines which have already\nmatched the filter pattern. Note that this option is not used if\nyou download the logfile."

msgid "log_MATCH_PATTERN_LABEL"
msgstr "Highlight Pattern (optional)"

msgid "log_NO_MATCHING_LINES"
msgstr "No matching lines displayed."

msgid "log_OP_DESC"
msgstr "You must choose between viewing the logfile in your browser, or\ndownloading the logfile to your computer. If the logfile is\nparticularly large, you may wish to download it instead of\nattempting to open it in your browser, as this is a problem for\nsome web browsers."

msgid "log_OP_LABEL"
msgstr "Operation"

msgid "log_REFRESH"
msgstr "Refresh this logfile"

msgid "log_VIEW"
msgstr "View log file"

msgid "log_VIEWING_TIME"
msgstr "Viewed at [_1]."
