msgid "Workgroup"
msgstr "Arbeitsgruppe"

msgid "wkg_DESC_PDC"
msgstr "Soll dieser Server als primärer Domänen-Controller für Ihr Windows-Netzwerk arbeiten? Sie sollten dies auf Nein belassen, wenn ein anderer Server in Ihrem Netzwerk bereits mit dieser Rolle arbeitet."

msgid "wkg_DESC_ROAM"
msgstr " Sollen servergespeicherte Benutzerprofile zur Verfügung gestellt werden? Sie sollten diese Einstellung auf Nein belassen, es sei denn, daß Sie über fundierte Kenntnisse mit Windows und servergespeicherten Benutzerprofilen verfügen und Sie wissen, daß Sie diese Funktion benötigen. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Geben Sie den Namen an, den dieser Server für Windows und Macintosh Dateifreigaben benutzen soll."

msgid "wkg_DESC_WORKGROUP"
msgstr " Geben Sie den Windows-Arbeitsgruppennamen an, mit dem dieser Server in einem Windows-Netzwerk unter \"Netzwerkumgebung\" erscheinen soll. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Arbeitsgruppen-Einstellungen ändern"

msgid "wkg_INVALID_SERVERNAME"
msgstr "Der Servername muß mit einem Buchstaben (Groß- oder Kleinschreibung) beginnen und darf nur Buchstaben, Nummern, Unterstriche und Bindestriche enthalten."

msgid "wkg_INVALID_WORKGROUP"
msgstr "Der Arbeitsgruppenname muß mit einem Buchstaben (Groß- oder Kleinschreibung) beginnen und darf nur Buchstaben, Zahlen, Unterstriche, Bindestriche und Punkte enthalten."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "Der Server- und Arbeitsgruppenname stimmen beim Vergleich in Kleinbuchstaben überein. Die Namen müssen jedoch unterschiedlich sein, um Verzeichnisfreigaben zu ermöglichen."

msgid "wkg_LABEL_PDC"
msgstr "Arbeitsgruppe und Primärer Domänen-Controller"

msgid "wkg_LABEL_ROAM"
msgstr "Servergespeicherte Benutzerprofile"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Servername"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Windows-Arbeitsgruppe"

msgid "wkg_SUCCESS"
msgstr "Die neuen Arbeitsgruppen-Einstellungen wurden gespeichert."
