msgid "iba_ACCOUNT_EXISTS"
msgstr "A conta \"%1\" é uma conta do tipo %2 já existente."

msgid "iba_ACCT_CLASHES_WITH_PSEUDONYM"
msgstr " A conta \"%1\" conflita com detalhes do pseudonimo para a conta \"%3\" do tipo %2. %1 é um pseudonimo para %3. "

msgid "iba_ACCT_NAME_HAS_INVALID_CHARS"
msgstr "O nome de compartilhamento \"%1\" contém caracteres inválidos. O nome do compartilhamento tem que iniciar com letra minúscula e conter somente letras minúsculas, números e hifens."

