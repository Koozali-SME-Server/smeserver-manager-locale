msgid "iba_ERR_INTERNAL_FAILURE"
msgstr "(en) Err internal failure"

msgid "iba_FIRSTPAGE_DESC"
msgstr "  Adicionar compartilhamento \n\n   Você pode remover qualquer pasta ou resetar a senha clicando no comando correspondente próximo ao compartilhamento. Se o compartilhamento estiver em vermelho, isto significa que a senha ainda não foi definida, e deverá ser trocada tão logo possível. \n\n  "

msgid "iba_FORM_TITLE"
msgstr "Criar, modificar ou remover pastas"

msgid "iba_HTTPS_Only"
msgstr "Forçar uso de conexões seguras"

msgid "iba_IBAY_PASSWD_VERIFY_ERROR"
msgstr "As senhas que você entrou não são iguais."

msgid "iba_LOCAL_NETWORK_NO_PASSWORD"
msgstr "Rede local (não requer senha)"

msgid "iba_LOCAL_NETWORK_PASSWORD"
msgstr "Rede local (requer senha)"

msgid "iba_MAX_IBAY_NAME_LENGTH_ERROR"
msgstr "O nome do compartilhamento \"%1\" é muito longo. O máximo é de %1 caracteres."

msgid "iba_NAME_FIELD_DESC"
msgstr "O nome do compartilhamento deverá conter somente letras minúsculas, números, pontos, hífens e sublinhado e deverá iniciar com letra minúscula. Por exemplo \"joao\", \"intra\", e \"cust3.prj12\" são todos nomes válidos, mas \"3associados\", \"Joao Silva\" e \"Parceiros!Comerciais\" não são. O tamanho do nome está limitado a %1 caracteres."

msgid "iba_NAME_LABEL"
msgstr "Nome da pasta"

msgid "iba_NONE"
msgstr "Sem acesso"

msgid "iba_NO_IBAYS"
msgstr "Não existe nenhuma pasta configurada."

msgid "iba_PASSWORD_DESC"
