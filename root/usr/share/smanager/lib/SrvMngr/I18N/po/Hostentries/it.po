msgid "Hostnames and addresses"
msgstr "Nomi host ed indirizzi"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "L'indirizzo è compreso nel range dinamico assegnato dal DHCP"

msgid "hos_ADD_HOSTNAME"
msgstr " Aggiungi host "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Crea o modifica nome host"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Lista dei nomi host per [_1]"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Errore durante la creazione dell'host."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Errore durante la cancellazione dell'host."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Errore durante la modifica dell'host."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Errore: l'IP non può essere quello del server o del Gateway."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Errore: Questo indirizzo IP non è in nessuna delle reti locali."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Indirizzo Ethernet"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "L'indirizzo ethernet è opzionale e permette al server DHCP di assegnare staticamente l'indirizzo IP locale al computer con questo indirizzo ethernet. Se specificato, deve avere il formato \"AA:BB:CC:DD:EE:FF\" e può contenere solo i numeri 0-9 e le lettere A-F."

msgid "hos_FORM_TITLE"
msgstr "Nomi host e indirizzi"

msgid "hos_HOSTNAME"
msgstr "Nome host"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Errore: carattere inaspettato nel nome host: \"[_1].[_2]\". Il nome host può contenere solo lettere, numeri e trattini e deve iniziare con una lettera o un numero."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Il nome host può contenere solo lettere, numeri e trattini e deve iniziare con una lettera o un numero."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Errore: l'account [_1] è un [_2] hostname esistente."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Errore: carattere inaspettato nel nome host: \"[_1].[_2]\". Il nome host può contenere solo lettere, numeri e trattini e deve iniziare con una lettera o un numero."

msgid "hos_HOSTTYPE"
msgstr "Posizione"

msgid "hos_LOCAL_IP"
msgstr "IP Locale"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "L'indirizzo IP Locale è l'indirizzo IP di un'altra macchina della rete locale. Inserire un IP valido nel formato \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Inserire i seguenti dettagli addizionali per un host locale:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Modifica il nome host"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Inserire i seguenti dettagli addizionali per un host remoto:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Sta per essere rimosso il nome host \"[_1].[_2]\".   Siete sicuri di voler rimuovere questo host ? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Rimuovi il nome host"

