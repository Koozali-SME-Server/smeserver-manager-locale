msgid "Port forwarding"
msgstr "Renvoi de port"

msgid "pf_ALLOW_HOSTS"
msgstr "Hôtes autorisés"

msgid "pf_CREATE_RULE"
msgstr "Créer une règle de renvoi de port"

msgid "pf_ERR_BADAHOST"
msgstr "Vous devez utiliser une syntaxe valide pour désigner une liste d'adresses IP, ie: 192.168.0.1, 192.168.1.1/24"

msgid "pf_ERR_BADIP"
msgstr "Cela ne semble pas être une adresse IP. Vous devez utiliser un format d'adresse de quatre blocs de chiffres séparés par des points, chacun des nombres devant être inférieur à 256. Par exemple : 192.168.0.5"

msgid "pf_ERR_BADPORT"
msgstr "Le numéro de port doit être un nombre entier inférieur à 65536."

msgid "pf_ERR_NONZERO_RETURN_EVENT"
msgstr "Cette action a retourné une valeur de retour non nulle."

msgid "pf_ERR_PORT_COLLISION"
msgstr "ERREUR : ce port ou cet intervalle de ports entre en conflit avec une règle existante. Veuillez modifier cette règle ou supprimer l'ancienne."

msgid "pf_FIRST_PAGE_DESCRIPTION"
msgstr " Cette page va vous permettre de modifier les règles de votre pare-feu afin d'ouvrir un port spécifique de ce serveur et de le transférer à un autre port sur une autre machine. Ceci permettra au trafic entrant d'accéder directement à un hôte de votre réseau privé.\n\n  <p>ATTENTION : une mauvaise utilisation de cette fonctionnalité peut compromettre gravement la sécurité de votre réseau. N'utilisez pas cette fonction à la légère ou sans être pleinement conscient des conséquences de votre acte.</p>\n\n  "

msgid "pf_FORM_TITLE"
msgstr "Configuration du renvoi de port"

msgid "pf_IN_SERVERONLY"
msgstr "Ce serveur est actuellement configuré en mode \"serveur uniquement\" et le renvoi de port n'est possible que pour ce serveur (localhost)."

msgid "pf_LABEL_DESTINATION_HOST"
msgstr "Adresse IP de l'hôte de destination"

msgid "pf_LABEL_DESTINATION_PORT"
msgstr "Port(s) de destination"

msgid "pf_LABEL_PROTOCOL"
msgstr "Protocole"

msgid "pf_LABEL_SOURCE_PORT"
msgstr "Port(s) source"

msgid "pf_NO_FORWARDS"
msgstr "Aucun renvoi de port n'est actuellement défini sur le serveur."

msgid "pf_RULE_COMMENT"
msgstr "Commentaire sur la règle"

msgid "pf_SHOW_FORWARDS"
msgstr "Le tableau ci-dessous résume les règles de renvoi de port actuellement définies sur ce serveur. Cliquez sur le lien \"Supprimer\" pour retirer la règle correspondante."

msgid "pf_SUCCESS"
msgstr "Les modifications apportées aux règles de renvoi de port ont été enregistrées avec succès."

msgid "pf_SUMMARY_ADD_DESC"
msgstr "Le tableau ci-dessous résume les règles de renvoi de port que vous êtes sur le point d'ajouter. Si ces règles vous conviennent, cliquez sur le bouton \"Ajouter\". Dans le cas contraire, cliquez sur le bouton \"Annuler\"."

msgid "pf_SUMMARY_REMOVE_DESC"
msgstr "Le tableau ci-dessous résume la règle de renvoi de port que vous êtes sur le point de supprimer. Si vous voulez vraiment retirer la règle, cliquez sur le bouton \"Supprimer\". Dans le cas contraire, cliquez sur le bouton \"Annuler\"."

# --- obsolete: no longer present in the English source ---
#~ msgid "pf_CREATE_PAGE_DESCRIPTION"
#~ msgstr " Veuillez indiquer le protocole, le port à renvoyer, l'hôte de destination et le port de cet hôte vers lequel vous souhaitez appliquer le renvoi. Si vous voulez indiquer un intervalle de ports, tapez les limites inférieure et supérieure des ports séparées par un trait d'union. Le port de destination peut être vide : ainsi, le pare-feu utilisera la même valeur que pour le port source.\n\n  "
#~ msgid "pf_ERR_CANNOT_REMOVE_NORULE"
#~ msgstr "Impossible de supprimer une règle inexistante."
