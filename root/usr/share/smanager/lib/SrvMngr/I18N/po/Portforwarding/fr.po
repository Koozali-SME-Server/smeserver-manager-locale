#~ msgstr "Cette règle a déjà été créée, il est impossible de l'ajouter à nouveau."
#~ msgid "pf_ERR_NO_MASQ_RECORD"
#~ msgstr "Impossible de récupérer l'enregistrement du pare-feu dans la base de données de configuration."
#~ msgid "pf_ERR_UNSUPPORTED_MODE"
#~ msgstr "Mode non pris en charge."
