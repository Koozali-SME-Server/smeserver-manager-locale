msgid "Groups"
msgstr "(en) Groups"

msgid "Packages"
msgstr "(en) Packages"

msgid "Start"
msgstr "(en) Start"

msgid "yum_1DAILY"
msgstr "Daglig"

msgid "yum_2WEEKLY"
msgstr "Ukentlig"

msgid "yum_3MONTHLY"
msgstr "Måndelig"

msgid "yum_AutoInstallUpdates"
msgstr "(en) Autoinstallupdates"

msgid "yum_BUTTON_CONFIGURATION"
msgstr "Endre innstillinger for programvareinstallasjon"

msgid "yum_BUTTON_INSTALL_AVAILABLE"
msgstr "Installer ekstra programvare"

msgid "yum_BUTTON_INSTALL_UPDATES"
msgstr "List tilgjengelige oppdateringer"

msgid "yum_BUTTON_REMOVE"
msgstr "Fjern installert programvare"

msgid "yum_DESC_AVAILABLE_GROUPS"
msgstr "Du kan velge programvaregrupper å installere fra i listen nedenfor."

msgid "yum_DESC_AVAILABLE_PACKAGES"
msgstr "Du kan også velge individuelle pakker å innstallere fra listen nedenfor."

msgid "yum_DESC_AVAILABLE_UPDATES"
msgstr "Følgende oppdatering er tilgjenglig for ditt system. Du bør normalt installere alle tilgjenglige oppdateringer. Dersom det er oppdateringer du ikke ønsker å installere, fjerner du merkingen i listen nedenfor."

msgid "yum_DESC_ENABLED_REPOSITORIES"
msgstr "Programvare installereren kan bare installere programvare fra valgte kilder. For å velge en kilde, merker du den i listen. for å velge bort, avmerker du den i listen. Som standard er bare stabil, testet programvare tilgjenglig for installasjon."

msgid "yum_DESC_INSTALLED_GROUPS"
msgstr "Du kan velge programvaregrupper fra listen nedenfor."

msgid "yum_DESC_INSTALLED_PACKAGES"
msgstr "Du kan også velge individuelle pakker du ønser å fjerne fra listen nedenfor."

msgid "yum_DESC_UPDATES_AVAILABLE"
msgstr "Det er oppdateringer tilgjenglig for ditt system. Disse oppdateringene bør installeres så snart som mulig."

msgid "yum_DESC_UPTODATE"
msgstr "Alle oppdateringer er installert."

msgid "yum_DESC_YUM_AUTOINSTALLUPDATES"
msgstr "(en)If enabled this will take precedence over the simple check for updates notification and predownload features. Instead it will install the available updates from enabled repositories. For more information refer to yum and yum-cron manual page."

msgid "yum_DESC_YUM_DELTARPMPROCESS"
msgstr "(en)A deltarpm contains the difference between an old and a new version of a rpm, which can save bandwith. The drawback is that update operations consume considerably more CPU cycles"

msgid "yum_DESC_YUM_PACKAGEFUNCTIONS"
msgstr "Programvare installereren kan administrere grupper av sammenhengende pakker eller individuelle pakker. Som standard blir bare grupper av pakker vist. Dersom du ønsker å administrere individuelle pakker, må du slå på dette valget. Det bør bare gjøres av erfarne systemadministratorer."

msgid "yum_DeltaRpmProcess"
msgstr "(en) Deltarpmprocess"

msgid "yum_DownloadOnly"
msgstr "(en) Downloadonly"

msgid "yum_ERROR_UPDATING_CONFIGURATION"
msgstr "(en) Error updating configuration"

msgid "yum_FORM_TITLE"
msgstr "Programvareinstallasjonsprogram"

msgid "yum_HEADER_AVAILABLE_SOFTWARE"
msgstr "Følgende programvare er tilgjenglig for å installeres på ditt system. Du bør bare installere ekstra programvare hvis du er klar over konsekvensene ved å gjøre det."

msgid "yum_HEADER_INSTALLED_SOFTWARE"
msgstr "Følgende programvare er installert på ditt system. Du bør bare fjerne programvare dersom du er klar over konsekvensene med å gjøre det."

msgid "yum_HEADER_POSTUPGRADE_REQUIRED"
msgstr " Systemet trenger å bli rekonfigurert etter å ha lagt til eller fjernet programvare, eller installert oppdateringer. <p> Vennligst klikk på Rekonfigurer knappen på bunnen av denne siden for å starte rekonfigureringsprosessen. <b>En automatisk omstart vil bli satt i gang som en del av rekonfigureringsprosessen</b> </p> "

msgid "yum_INSTALL_SOFTWARE"
msgstr "Installer"

msgid "yum_INSTALL_UPDATES"
msgstr "Installer valgte oppdateringer"

msgid "yum_LABEL_AVAILABLE_GROUPS"
msgstr "Tilgjenglige grupper"

msgid "yum_LABEL_AVAILABLE_PACKAGES"
msgstr "Tilgjenglige pakker"

msgid "yum_LABEL_AVAILABLE_UPDATES"
msgstr "Oppdateringer tilgjenglig"

msgid "yum_LABEL_ENABLED_REPOSITORIES"
msgstr "Mulige kilder"

msgid "yum_LABEL_INSTALLED_GROUPS"
msgstr "Installerte grupper"

msgid "yum_LABEL_INSTALLED_PACKAGES"
msgstr "Installerte pakker"

msgid "yum_LABEL_YUM_AUTOINSTALLUPDATES"
msgstr "Automatisk installer oppdateringer"

msgid "yum_LABEL_YUM_DELTARPMPROCESS"
msgstr "Delta RPM-oppdatering"

msgid "yum_LABEL_YUM_DOWNLOADONLY"
msgstr "Personlige detaljer oppdatert"

msgid "yum_LABEL_YUM_DOWNLOADONLY_DESCRIPTION"
msgstr "(en)The rpm updates can be downloaded during the night, this will ease and give faster the dnf update process (only enabled repositories will be used)."

msgid "yum_LABEL_YUM_PACKAGEFUNCTIONS"
msgstr "Administrer individuelle pakker"

msgid "yum_LABEL_YUM_STATUS"
msgstr "Kontroller for opptateringer"

msgid "yum_MULTI_SELECT"
msgstr "(en) <strong>Ctrl/Cmd-click</strong> toggles individual items and <strong>Shift-click</strong> selects ranges.\n<br /><strong>Case-insensitive</strong> search unless you enter a <strong>regex</strong> in <i>/pattern/flags</i> form (e.g. /maria.*client/i).."

msgid "yum_Please_Wait_-_dnf_Running"
msgstr "Vennligst vent – dnf kjører"

msgid "yum_SUCCESS"
msgstr "De nye innstillingene er lagret."

msgid "yum_UPDATE_SUCCESS"
msgstr "(en)The requested changes have been successfully implemented."

msgid "yum_check4updates"
msgstr "(en) Check4updates"

