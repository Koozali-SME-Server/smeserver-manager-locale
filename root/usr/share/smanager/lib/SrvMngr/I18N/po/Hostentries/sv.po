msgid "Hostnames and addresses"
msgstr "Värdnamn och adresser"

msgid "hos_ABOUT_TO_REMOVE"
msgstr "(en)Are you sure you wish to remove this hostname?"

msgid "hos_ADDR_IN_DHCP_RANGE"
msgstr "Adressen är innanför det av DHCP tilldelade dynamiska intervallet"

msgid "hos_ADD_HOSTNAME"
msgstr " Lägg till värdnamn "

msgid "hos_CREATE_OR_MODIFY_SUCCEEDED"
msgstr "(en) Create or modify succeeded"

msgid "hos_CREATE_TITLE"
msgstr "Skapa eller modifiera värdnamn"

msgid "hos_CREATE_TYPE"
msgstr "(en) Create type"

msgid "hos_CURRENT_HOSTNAMES_FOR_LOCAL_DOMAIN"
msgstr "Aktuell lista över värdnamn för [_1]"

msgid "hos_ERROR_CREATING_HOST"
msgstr "(en) Error creating host"

msgid "hos_ERROR_MODIFYING_HOST"
msgstr "(en) Error modifying host"

msgid "hos_ERROR_WHILE_CREATING_HOST"
msgstr "Ett fel inträffade vid skapandet av värdnamn."

msgid "hos_ERROR_WHILE_DELETING_HOST"
msgstr "Ett fel inträffade vid radering av värdnamnet."

msgid "hos_ERROR_WHILE_MODIFYING_HOST"
msgstr "Ett fel inträffade vid ändring av värdnamnet."

msgid "hos_ERROR_WHILE_REMOVING_HOST"
msgstr "(en) Error while removing host"

msgid "hos_ERR_IP_IS_LOCAL_OR_GATEWAY"
msgstr "Fel: IP kan inte vara samma IP som för server eller gateway."

msgid "hos_ERR_IP_NOT_LOCAL"
msgstr "Fel: Denna IP-adress finns inte på något av våra lokala nätverk."

msgid "hos_ETHERNET_ADDRESS"
msgstr "Ethernetadress"

msgid "hos_ETHERNET_ADDRESS_DESCRIPTION"
msgstr "Ethernetadressen är frivillig och gör så att DHCP-servern statiskt binder en lokal IP-adress till datorn med denna ethernetadress. Om angiven, så måste den vara i formatet \"AA:BB:CC:DD:EE:FF\" och endast innehålla numren 0-9 och bokstäverna A-F."

msgid "hos_FORM_TITLE"
msgstr "Värdnamn och adresser"

msgid "hos_HOSTNAME"
msgstr "Värdnamn"

msgid "hos_HOSTNAME_COMMENT_ERROR"
msgstr "Fel: Ogiltiga tecken i värdnamnet: \"[_1].[_2]\". Värdnamnet får bara innehålla bokstäver, siffror, bindestreck och måste börja med en bokstav eller en siffra."

msgid "hos_HOSTNAME_DESCRIPTION"
msgstr "Värdnamnet måste innehålla bokstäver, nummer eller bindestreck och måste starta med en bokstav eller siffra."

msgid "hos_HOSTNAME_EXISTS_ERROR"
msgstr "Fel: kontot [_1] är ett befintligt [_2] värdnamn."

msgid "hos_HOSTNAME_IN_USE_ERROR"
msgstr "(en) Hostname in use error"

msgid "hos_HOSTNAME_VALIDATOR_ERROR"
msgstr "Fel: Ogiltiga tecken i värdnamnet: \"[_1].[_2]\". Värdnamnet får bara innehålla bokstäver, siffror, bindestreck och måste börja med en bokstav eller en siffra."

msgid "hos_HOSTTYPE"
msgstr "Placering"

msgid "hos_LOCAL_IP"
msgstr "Lokal IP"

msgid "hos_LOCAL_IP_DESCRIPTION"
msgstr "Den lokala IP-adressen är IP-adressen för en annan dator på det lokala nätverket. Ange en giltig IP-adress i formatet \"aaa.bbb.ccc.ddd\"."

msgid "hos_LOCAL_PAGE_DESCRIPTION"
msgstr "Ange följande kompletterande detaljer för en lokal värd:"

msgid "hos_MODIFY_SUCCEEDED"
msgstr "(en) Modify succeeded"

msgid "hos_MODIFY_TITLE"
msgstr "Ändra värdnamn"

msgid "hos_MODIFY_TYPE"
msgstr "(en) Modify type"

msgid "hos_NONEXISTENT_HOSTNAME_ERROR"
msgstr "(en) Nonexistent hostname error"

msgid "hos_NONEXISTENT_HOST_ERROR"
msgstr "(en) Nonexistent host error"

msgid "hos_REMOTE_PAGE_DESCRIPTION"
msgstr "Ange följande kompletterande detaljer för en fjärrvärd:"

msgid "hos_REMOVE_PAGE_DESCRIPTION"
msgstr " Du håller på att radera värdnamnet \"[_1].[_2]\".   Är du säker på att du vill radera detta värdnamn? "

msgid "hos_REMOVE_SUCCEEDED"
msgstr "(en) Remove succeeded"

msgid "hos_REMOVE_TITLE"
msgstr "Ta bort värdnamn"

