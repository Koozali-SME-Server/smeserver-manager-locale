msgid "Local networks"
msgstr "Lokale netværk"

msgid "ln_ADD_DESC"
msgstr " Hver indtastning skal være i formen #.#.#.# (hvert # er et nummer fra 0 til 255). Serverprogrammet vil nulstille den sidste del (værtsidentifikationen) af netværksadressen i overenstemmelse med subnetmasken, for at sikre at netværksadressen er gyldig.  \"Router\" bør være IP-adressen på den router på lokalnetværket, der giver adgang til det andet netværk. "

msgid "ln_ADD_TITLE"
msgstr "Tilføj et lokalt netværk"

msgid "ln_ERROR_CREATING_NETWORK"
msgstr "Der skete en fejl under oprettelse af netværk."

msgid "ln_ERROR_DELETING_NETWORK"
msgstr "Fejl under sletning af netværk."

msgid "ln_FIRSTPAGE_DESC"
msgstr " Af hensyn til sikkerheden er der kun adgang fra lokalnettet til mange services på serveren. Du kan tildele yderligere netværker tilsvarende adgang ved at tilføje dem til listen nedenfor. De fleste installationer bør efterlade listen tom. Tilføj netværk "

msgid "ln_Failed to find network in Db"
msgstr "(en)Failed to find network in Db"

msgid "ln_INVALID_IP_ADDRESS"
msgstr "Ugyldig IP adresse"

msgid "ln_INVALID_SUBNET_MASK"
msgstr "Ugyldig subnetmaske"

msgid "ln_LOCAL NETWORKS"
msgstr "Lokale netværk"

msgid "ln_LOCALNETWORK_ADD"
msgstr "Tilføj netværk"

msgid "ln_LOCAL_NETWORK_NONE"
msgstr "(en) No Local networks found"

msgid "ln_NETWORK_ALREADY_ADDED"
msgstr "Fejl: Netværket %1 (beregnet fra netadressen %2 og subnetmasken %3) er allerede tilføjet. Netværket blev ikke oprettet."

msgid "ln_NETWORK_ALREADY_LOCAL"
msgstr "Fejl: Netværket %1 (beregnet fra netadressen %2 og subnetmasken %3) ses allerede som en del af det lokale net. Netværket blev ikke oprettet."

msgid "ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK"
msgstr "Fejl: Der er ingen adgang til router-adressen %1 fra lokal-nettet. Netværket blev ikke oprettet."

msgid "ln_NO_SUCH_NETWORK"
msgstr "(en)Network not found in network db"

msgid "ln_NUMBER_OF_HOSTS"
msgstr "Antal værter"

msgid "ln_REMOVE_DESC"
msgstr "Du er ved at fjerne følgende lokale netværk."

msgid "ln_REMOVE_HOSTS_DESC"
msgstr "Der er registreret lokale værter på det netværk, du er ved at fjerne. I udgangspunkt fjernes også disse. Fjern fluebenet, hvis du ikke ønsker dette, men bemærk, at de ikke vil blive behandlet som lokale og måske er de ikke engang er tilgængelige, hvis netværket fjernes."

msgid "ln_REMOVE_HOSTS_LABEL"
msgstr "Fjern værter på netværket"

msgid "ln_REMOVE_TITLE"
msgstr "Fjern lokalt netværk"

msgid "ln_SUBNET_MASK"
msgstr "Subnetmaske"

msgid "ln_SUCCESS_NETWORK_RANGE"
msgstr "Netværket er tilføjet %1/%2 via router %3. Serveren vil tildele lokal adgangsret til %4 IP-adresser i området %5 til %6."

msgid "ln_SUCCESS_NONSTANDARD_RANGE"
msgstr "  Netværket er tilføjet %1/%2 via router %3. \n\n  <p> Serveren vil tildele lokal adgangsret til %1 IP-adresser i området %2 til %3. </p>\n\n  <p> Advarsel: ProFTPd FTP-server kan ikke håndtere denne ikke-standard subnetmaske. <b>%1</b> vil blive brugt i stedet for. </p>\n\n  "

msgid "ln_SUCCESS_REMOVED_NETWORK"
msgstr "Netværket %1/%2 via router %3 blev fjernet."

msgid "ln_SUCCESS_SINGLE_ADDRESS"
msgstr "Netværket er tilføjet %1/%2 via router %3. De nedenfor nævnte IP adresser har adgang til serveren svarende til adgangen fra lokalnet %4."
