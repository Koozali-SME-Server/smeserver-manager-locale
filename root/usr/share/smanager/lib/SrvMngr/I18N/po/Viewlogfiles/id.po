msgid "LOG_LIVESTREAM"
msgstr "(en) Live stream"

msgid "log_END_DESC"
msgstr "Harap diingat bahwa diperlukan waktu untuk membuat laporan-laporan tersebut."

msgid "log_ERR_NOEXIST_FILE"
msgstr "(en) Err noexist file"

msgid "log_ERR_NOOPEN_FILE"
msgstr "(en) Err noopen file"

msgid "log_FILENAME_ERROR"
msgstr " Error saat menentukan nama log file.\n\n  <p>Jenis laporan invalid \"[_1]\".</p>\n\n  "

msgid "log_FILTER_PATTERN_DESC"
msgstr " Anda dapat secara opsional menentukan sebuah pattern filter untuk menampilkan hanya baris -baris dari log file yang cocok dengan pattern ini. Jika anda membiarkan field ini kosong, semua baris dari log file akan ditampilkan. Harap catat bahwa pilihan ini tidak berlaku jika anda mendownload logfile tersebut.\n\n  "

msgid "log_FILTER_PATTERN_HINT"
msgstr "(en) The pattern is case insensitive, but enclosing it in \"/\" will result in it being treated as a regex."

msgid "log_FILTER_PATTERN_LABEL"
msgstr "Filter Pattern (opsional)"

msgid "log_FIRSTPAGE_DESC"
msgstr " Panel ini berfungsi untuk melihat atau men-download log file yang dibuat oleh layanan yang berjalan di server anda. "

msgid "log_FORM_TITLE"
msgstr "Lihat file log"

msgid "log_HIGHLIGHT_HEADER"
msgstr "Menyoroti baris yang cocok dengan : \"[_1]\"."

msgid "log_LOG_FILE_EMPTY"
msgstr "Log file \"[_1]\" kosong!"

msgid "log_LOG_FILE_SELECT_DESC"
msgstr "Pilih sebuah log file untuk dilihat"

msgid "log_MATCH_HEADER"
msgstr "Menampilkan baris yang matching: \"[_1]\"."

msgid "log_MATCH_PATTERN_DESC"
msgstr " Anda juga dapat secara opsional menentukan sebuat highlight pattern untuk menandai dengan menebalkan baris-bari dimana log file cocok dengan highlight pattern. Highlight pattern diterapkan pada setiap baris yang cocok dengan filter pattern. Harap catat bahwa pilihan ini tidak berlaku jika anda mendownload logfile tersebut.\n\n  "

msgid "log_MATCH_PATTERN_LABEL"
msgstr "Highlight Pattern (opsional)"

msgid "log_NO_MATCHING_LINES"
msgstr "Tidak ada baris yang cocok yang ditampilkan"

msgid "log_OP_DESC"
msgstr " Anda harus memilih antara melihat logfile di penjelajah web anda, atau mendownload logfile ke komputer anda. Jika logfile berukuran besar, mungkin anda ingin mendownloadnya daripada mencoba membukanya di penjelajah web anda, karena ini bermasalah untuk beberapa jenis web browser.\n\n  "

msgid "log_OP_LABEL"
msgstr "Operasi"

msgid "log_REFRESH"
msgstr "Refresh logfile ini"

msgid "log_VIEW"
msgstr "Lihat log file"

msgid "log_VIEWING_TIME"
msgstr "Dilihat pada [_1]."

