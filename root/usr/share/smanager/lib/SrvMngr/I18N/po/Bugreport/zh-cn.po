msgid "bugr_ALTERED_EVENTS"
msgstr "(en)A list of SME events that have been altered on your server from a base install"

msgid "bugr_ALTERED_TEMPLATES"
msgstr "(en)A list of SME templates that have been altered on your server from a base install"

msgid "bugr_AWARE_SME"
msgstr "(en)You are probaly aware that SME server is developed and supported by a collaborative community of volunteers from all over the world. While SME server is free to download and use, maintaining the infrastructure behind the project (eg. hosting the forums and wiki, providing repositories and build servers etc.) costs real money in the real world."

msgid "bugr_CONSIDER_DONATING"
msgstr "(en)Please consider donating to the project by clicking on the image link below:"

msgid "bugr_CREATE_REPORT"
msgstr "创建配置报告"

msgid "bugr_DESCRIPTION"
msgstr "(en) Description"

msgid "bugr_DONATING"
msgstr "(en)Have you considered donating?"

msgid "bugr_DO_NOT_PANIC"
msgstr "别慌！"

msgid "bugr_Download this report"
msgstr "(en)Download this report !"

msgid "bugr_FOLLOWING_REPORT_MIGHT_HELP"
msgstr "(en)It will also help if you provide some vital information on the configuration of your SME-server in your bug report. By clicking on the \"Create configuration report\" button below, you can create and download a text file containing this information. Please attach this file to your bug report as well."

msgid "bugr_FORM_TITLE"
msgstr "(en)Report a Bug"

msgid "bugr_INSTALLED_RPMS"
msgstr "(en)A list of additional RPMs installed on your server"

msgid "bugr_KERNEL_AND_ARCH"
msgstr "当前内核版本和架构"

msgid "bugr_PLEASE_REPORT_HERE"
msgstr "为了帮助开发者排障和修复问题，请下载一份文本模板，填好后粘贴在bug报告里"

msgid "bugr_PREVIOUS_SERVER_MODE"
msgstr "(en)Previous server mode"

msgid "bugr_PRIVACY"
msgstr "(en)No privacy related data (ie. users, passwords, IP addresses) will be included in the report."

msgid "bugr_REPORT_CONTENT"
msgstr "报告将包含如下信息"

msgid "bugr_SERVER_MODE"
msgstr "服务器模式"

msgid "bugr_SME_EXPERIENCE"
msgstr "很显然，没有软件没有bug，您可能在SME-server安装时碰到问题而进入此页。"

msgid "bugr_SME_VERSION"
msgstr "(en)Koozali SME Server version"

msgid "bugr_THANK_YOU"
msgstr "(en)Thank you for your support!"

msgid "bugr_USE_TEMPLATE"
msgstr "(en)Please refer to the following link on how to report efficiency a bug and use its template"

msgid "bugr_YOUR_HELP"
msgstr "(en)In very much the same way you need us to address your current issue, we need YOUR help to keep this project alive!"

msgid "bugr_YUM_REPOS"
msgstr "(en)A list of additional software repositories configured on your server"

