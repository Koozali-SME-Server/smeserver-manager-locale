msgid "Workgroup"
msgstr "(en) Workgroup"

msgid "wkg_DESC_PDC"
msgstr "Skal denne server fungere som arbejdsgruppe- eller domænecontroller på dit Windowsnetværk? Du skal vælge Nej hvis en anden server udfylder denne rolle på netværket."

msgid "wkg_DESC_ROAM"
msgstr " Skal denne server understøtte roaming profiles? Du bør efterlade indstillingen på Nej, medmindre du har erfaring med at administrere serverbaserede Windows roaming profiles og ved, at denne funktion er påkrævet. "

msgid "wkg_DESC_SERVERNAME"
msgstr "Indtast det navn som serveren skal bruge til Windows og Macintosh fildeling."

msgid "wkg_DESC_WORKGROUP"
msgstr " Angiv den Windows arbejdsgruppe som serveren skal være synlig i. "

msgid "wkg_ERROR_UPDATING"
msgstr "(en) An error has occurred while updating the workgroup"

msgid "wkg_FORM_TITLE"
msgstr "Arbejdsgruppe indstillinger"

msgid "wkg_INVALID_SERVERNAME"
msgstr "Servernavnet skal starte med et (stort eller lille) bogstav fulgt af en kombination af bogstaver, tal, bindestreger og understregningskoder."

msgid "wkg_INVALID_WORKGROUP"
msgstr "Arbejdsgruppenavnet skal starte med et (stort eller lille) bogstav fulgt af en kombination af bogstaver, tal, bindestreger, punktum og understregningskoder."

msgid "wkg_INVALID_WORKGROUP_MATCHES_SERVERNAME"
msgstr "Server og arbejdsgruppenavne stemmer overens, når de sammenlignes som små bogstaver. Disse værdier skal være forskellige for at fildelingen kan slås til."

msgid "wkg_LABEL_PDC"
msgstr "Arbejdsgruppe- eller domænecontroller"

msgid "wkg_LABEL_ROAM"
msgstr "Roaming profiles"

msgid "wkg_LABEL_SERVERNAME"
msgstr "Servernavn"

msgid "wkg_LABEL_WORKGROUP"
msgstr "Windows arbejdsgruppe"

msgid "wkg_SUCCESS"
msgstr "De nye arbejdsgruppeindstillinger er gemt"
