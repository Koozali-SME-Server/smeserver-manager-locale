msgstr "网络打印机的主机名或者IP地址"

msgctxt "'prt_prt_REMOTE_NAME_DESC"
msgid "Network printer name (enter raw if not sure)"
msgstr "网络打印机名称（如果不确定请输入raw）"

msgctxt "'prt_prt_REMOVE_PRINTER"
