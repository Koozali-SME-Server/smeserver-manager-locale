msgctxt "bac_WORKSTN_FULL_BACKUP_EVERYDAY"
msgid "Full backup sessions (new backup set) are allowed everyday"
msgstr "Fulde (nye) sikkerhedskopisæt er tilladt dagligt"

msgctxt "bac_WORKSTN_FULL_BACKUP_DAY"
