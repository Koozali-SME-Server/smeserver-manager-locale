msgstr "Maret"

msgctxt "dat_APRIL"
msgid "April"
msgstr "April"

msgctxt "dat_MAY"
msgid "May"
msgstr "Mei"

msgctxt "dat_JUNE"
msgid "June"
msgstr "Juni"

msgctxt "dat_JULY"
msgid "July"
msgstr "Juli"

msgctxt "dat_AUGUST"
msgid "August"
msgstr "Agustus"

msgctxt "dat_SEPTEMBER"
msgid "September"
