'dir_FORM_TITLE' => 'Zmień ustawienia katalogu LDAP',
'dir_LABEL_ROOT' => 'Główny serwer',
'dir_DESCRIPTION' => 'Serwer LDAP, umożliwia zarządzanie w sieci użytkownikami i grupami, zgromadzonych na twoim serwerze. Możesz mieć do nich dostęp za pomocą klienta LDAP, jak Apache Directory Studio lub JXplorer. Skonfiguruj klienta LDAP, za pomocą danych jak lokalny adres IP, numer portu (domyślnie 389), i głównych parametrów serwera pokazanych poniżej.',
'dir_DESC_DIRECTORY_ACCESS' => 'Możesz ustawić dostęp do twojego katalogu LDAP: prywatne, jak dostęp do katalogu tylko z sieci lokalnej, oraz publiczny, który umożliwia dostęp z każdego miejsca za pomocą Internetu.',
'dir_DIRECTORY_ACCESS' => 'Dostęp do katalogu LDAP',
'dir_DESC_DEPARTMENT' => 'Te ustawienia, są domyślnymi dla twojej firmy. Kiedy utworzysz nowe konto użytkownika, możesz wpisać własne ustawienia, jednak te wartości są pokazywane domyślnie. Aby tworzyć szybciej konta użytkowników, ustaw domyślne ustawienia dla katalogu LDAP.',
'dir_DEPARTMENT' => 'Domyślny oddział',
'dir_COMPANY' => 'Domyślna firma',
'dir_STREET' => 'Domyślny adres',
'dir_CITY' => 'Domyślne miasto',
'dir_PHONENUMBER' => 'Domyślny numer telefonu',
'dir_DESC_EXISTING' => 'Możesz zostawić stare dane, dla obecnych użytkowników, używając powyższych tylko dla nowych kont. Możesz także zastosować te ustawienia do wszystkich kont.',
'dir_EXISTING' => 'Dane katalogu dla obecnych użytkowników',
'dir_SUCCESS' => 'Nowe ustawienia katalogu LDAP zostały zapisane.',
'dir_LEAVE' => 'pozostaw',
'dir_UPDATE' => 'zaktualizuj z nowymi ustawieniami',
'dir_Directory' => 'Katalog',
