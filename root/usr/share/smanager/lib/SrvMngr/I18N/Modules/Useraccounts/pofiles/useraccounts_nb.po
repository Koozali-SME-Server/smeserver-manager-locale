msgstr "Passordet for brukeren \"{$acctName}\" er endret."

msgctxt "'usr_usr_LOCK_DESC"
msgid "You are about to lock the user account \"[_1]\" ([_2])"
msgstr "Du er i ferd med å låse brukerkontoen"

