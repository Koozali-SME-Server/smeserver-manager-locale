# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_RECEPTION' => ' 電郵接收 ',
'mai_DESC_STATE_RECEPTION_BUTTON' => ' 修改電郵接收設定 ',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_DELIVERY' => ' 電子郵件傳遞 ',
'mai_DESC_STATE_DELIVERY_BUTTON' => ' 修改電郵傳遞設定 ',
'mai_DESC_STATE_FILTERING_BUTTON' => ' 修改電郵過濾設定 ',
'mai_LABEL_VIRUS_SCAN' => '病毒掃瞄',
'mai_DESC_VIRUS_SCAN' => '您可掃描傳入與傳出郵件中的病毒。倘若啟用掃瞄並偵測到病毒，該電郵將被拒絕並回傳給寄件者。',
'mai_LABEL_SPAM_SCAN' => '垃圾郵件過濾',
'mai_DESC_SPAM_SCAN' => '您可掃瞄電郵中的垃圾郵件。倘若垃圾郵件過濾啟用，每封電郵將被加入X-Spam-Status表頭，此能被用來過濾垃圾郵件。您能調整預設為中度敏感的垃圾郵件檢查敏感度。對於微調控制，您能客製設定垃圾郵件敏感度，然後選擇客製標籤等級，進一步選擇性地拒絕郵件。',
'mai_LABEL_SPAM_SUBJECT' => '垃圾郵件主題字首',
'mai_DESC_SPAM_SUBJECT' => '您可啟用增加標籤到每封電郵的表頭以界定垃圾郵件。此標籤值可於下方定義。',
'mai_LABEL_SPAM_SENSITIVITY' => '垃圾郵件敏感度',
'mai_LABEL_SPAM_TAGLEVEL' => '自訂垃圾郵件標記等級',
'mai_LABEL_SPAM_REJECTLEVEL' => '自訂垃圾郵件拒絕等級',
'mai_LABEL_SPAM_SUBJECTTAG' => '修改垃圾郵件主題',
'mai_LABEL_SORTSPAM' => '整理垃圾郵件到垃圾文件夾',
'mai_VERYHIGH' => '非常高',
'mai_HIGH' => '高',
'mai_MEDIUM' => '中',
'mai_LOW' => '低',
'mai_VERYLOW' => '非常低',
'mai_CUSTOM' => '自訂',
'mai_LABEL_SMARTHOST_SMTPAUTH_STATUS' => '網際網路提供者的SMTP驗證',
'mai_LABEL_SMARTHOST_SMTPAUTH_USERID' => '郵件伺服器使用者id',
'mai_LABEL_SMARTHOST_SMTPAUTH_PASSWD' => '郵件伺服器密碼',
'mai_VALIDATION_SMTPAUTH_NONBLANK' => '倘若啟用SMTP驗證，此區塊不能留白。',
