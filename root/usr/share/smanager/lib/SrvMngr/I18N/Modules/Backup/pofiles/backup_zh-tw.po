msgstr "備份壓縮程度[0-9]"

msgctxt "bac_FULL_ONLY_ON"
msgid "Full backup is allowed on"
msgstr "允許完整備份於"

msgctxt "bac_ERR_INVALID_COMPRESSION"
msgid ""
