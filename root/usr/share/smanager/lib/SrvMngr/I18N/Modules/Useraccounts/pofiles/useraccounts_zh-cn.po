msgstr "此字段不能包含空白字符"

msgctxt "usr_UNACCEPTABLE_CHARS"
msgid ""
"This field must contain only letters, numbers, dots, hypens and underscores "
"and start with a letter"
msgstr "此地段只能包含字母、数字、句点、连接符和下划线，并且要以字母开头。"

