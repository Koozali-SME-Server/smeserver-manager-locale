# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_SUCCESS' => 'La nueva configuración de e-mail ha sido guardada.',
'mai_NEVER' => 'nunca',
'mai_EVERY5MIN' => 'Cada 5 minutos',
'mai_EVERY15MIN' => 'Cada 15 minutos',
'mai_EVERY30MIN' => 'Cada 30 minutos',
'mai_EVERYHOUR' => 'Cada hora',
'mai_EVERY2HRS' => 'Cada 2 horas',
'mai_STANDARD' => 'Estándar (SMTP)',
'mai_ETRN' => 'ETRN (SMTP con solicitud del cliente)',
'mai_DEFAULT' => 'Predeterminado',
'mai_SPECIFY_BELOW' => 'Especificar a continuación',
'mai_MULTIDROP' => 'multi-drop',
'mai_LABEL_MODE' => 'Modo de recuperación del e-mail',
'mai_DESC_MODE' => 'El modo de recuperación del e-mail se puede configurar en Estándar (para conexiones dedicadas de Internet), ETRN (recomendado para conexiones telefónicas) o multi-drop (para conexiones telefónicas si su proveedor de Internet no admite ETRN). Tenga en cuenta que el modo multi-drop es la única opción disponible cuando el servidor está configurado en el modo servidor privado y puerta de enlace.',
'mai_LABEL_DELEGATE' => 'Dirección del servidor de correo interno',
'mai_DESC_DELEGATE' => ' Delegación de servidores de correo Su sistema incorpora un servidor de e-mail completamente equipado con todas las funciones. Sin embargo, si por alguna razón desea delegar el procesamiento de e-mail a otro sistema, especifique aquí la dirección IP del servidor delegado. Para una operación normal, deje este campo en blanco. ',
'mai_LABEL_SECONDARY' => 'Servidor de correo secundario',
'mai_DESC_SECONDARY' => ' Configuración de ETRN o multi-drop Para ETRN o multi-drop, especifique el nombre o dirección IP del servidor de correo secundario. (Si utiliza la configuración de e-mail estándar, este campo se puede dejar en blanco). ',
'mai_DESC_FETCH_PERIOD' => 'Para ETRN o multi-drop, usted puede controlar la frecuencia con la que este servidor se comunicará con su servidor de e-mail secundario para traer e-mail. Conexiones más frecuentes significará recibir más rápidamente el e-mail, pero también puede aumentar la frecuencia del envío de datos por Internet, con un posible incremento de los costos telefónicos o de acceso a Internet.',
'mai_LABEL_FETCH_PERIOD' => 'Durante las horas de trabajo (8:00 AM a 6:00 PM) en los días laborales',
'mai_LABEL_FETCH_PERIOD_NIGHTS' => 'Fuera del horario de trabajo (6:00 PM a 8:00 AM) en los días laborales',
'mai_LABEL_FETCH_PERIOD_WEEKENDS' => 'Durante el fin de semana',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_POP_ACCOUNT' => 'Para e-mail multi-drop, especifique la cuenta y la contraseña del usuario POP. (Si utiliza e-mail estándar o ETRN, estos campos se pueden dejar en blanco). Además, para multi-drop, puede utilizar el método de clasificación de correo predeterminado o especificar un encabezado de mensaje en particular que se utilizará como clasificador del correo.',
'mai_LABEL_POP_PASS' => 'Contraseña de usuario POP (para multi-drop)',
'mai_LABEL_POP_ACCOUNT' => 'Cuenta de usuario POP (para multi-drop)',
'mai_LABEL_SORT_METHOD' => 'Método de clasificación (para multi-drop)',
'mai_LABEL_SORT_HEADER' => 'Encabezado de clasificación (para multi-drop)',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_LABEL_FETCH_PROTO' => 'Protocolo (para multi-drop)',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_LABEL_FETCH_SECURE' => 'Túnel sobre SSL (para multi-drop)',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_AUTO' => 'Automático',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_ENABLED_BOTH' => 'Permitir ambos HTTP y HTTPS',
'mai_ENABLED_SECURE_ONLY' => 'Permitir HTTPS (seguro)',
'mai_ONLY_LOCAL_NETWORK_SSL' => 'Permitir acceso sólo desde redes locales',
'mai_INSECURE_POP3' => 'Permitir ambos POP3 y POP3S',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_ALLOW_PRIVATE' => 'Permitir privado',
'mai_SECURE_POP3' => 'Permitir acceso privado y público (POP3S seguro)',
'mai_INSECURE_IMAP' => 'Permitir ambos IMAP y IMAPS',
'mai_SECURE_IMAP' => 'Permitir acceso privado y público (IMAPS seguro)',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_INSECURE_SMTP' => 'Permitir ambos SMTP y SSMTP',
'mai_SECURE_SMTP' => 'Permitir SSMTP (seguro)',
'mai_LABEL_POP_ACCESS_CONTROL' => 'Acceso a servidor POP3',
'mai_LABEL_IMAP_ACCESS_CONTROL' => 'Acceso a servidor IMAP',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_LABEL_SMTP_AUTH_CONTROL' => 'Autenticación SMTP',
'mai_FORWARD_TO_ADMIN' => 'Enviar al administrador',
'mai_FORWARD_TO' => 'Enviar a',
'mai_RETURN_TO_SENDER' => 'Rechazar',
'mai_LABEL_UNKNOWN' => 'E-mail a usuarios desconocidos',
'mai_DESC_UNKNOWN' => ' Usuarios Desconocidos Seleccionando Rechazar (opción recomendada) configurará al servidor para que acepte solamente mensajes para direcciones de email válidas (por ejemplo usuarios, grupos, seudónimos). Serán rechazados los correos para otras direcciones. ',
'mai_LABEL_SMARTHOST' => 'Dirección del servidor de correo del proveedor de Internet',
'mai_DESC_SMARTHOST' => ' Servidor SMTP El servidor puede entregar los mensajes salientes directamente a su destino (lo cual se recomienda en la mayoría de los casos) o puede entregarlos a través del servidor SMTP de su proveedor de Internet (lo cual se recomienda si tiene una conexión poco confiable a Internet o utiliza un servicio de Internet residencial). Si utiliza el servidor SMTP de su proveedor de Internet, especifique a continuación su nombre de host o dirección IP. De lo contrario, deje este campo en blanco. ',
'mai_INVALID_SMARTHOST' => 'El nombre de smarthost que escribió no es un nombre de dominio de Internet válido y no está en blanco',
'mai_DESC_POP_ACCESS_CONTROL' => 'Usted puede controlar el acceso al servidor POP3. La opción \'Permitir acceso privado\' permite el acceso POP3 sólo desde la red local. La opción POP3S puede emplearse para proveer acceso externo cifrado a su servidor POP3. Le recomendamos dejar esta opción en \'Permitir acceso privado\' a menos que usted tenga razones específicas para seleccionar otra opción.',
'mai_DESC_IMAP_ACCESS_CONTROL' => 'Usted puede controlar el acceso al servidor IMAP. La opción \'Permitir acceso privado\' permite el acceso IMAP sólo desde la red local. La opción IMAPS puede emplearse para proveer acceso externo cifrado a su servidor IMAP. Le recomendamos dejar esta opción en \'Permitir acceso privado\' a menos que usted tenga razones específicas para seleccionar otra opción.',
'mai_DESC_SMTP_AUTH_CONTROL' => ' You can provide authenticated access to your SMTP server, or set it to Disabled. The SSMTP setting requires all users to use SSL/TLS authentication. The SMTP and SSMTP option additionally allows STARTTLS to be used to ensure secure authentication. ',
'mai_DESC_WEBMAIL' => 'Usted puede habilitar o deshabilitar el webmail en este sistema. El webmail le permite a los usuarios el acceso a sus correos a través de un navegador web común, dirigiendo el navegador a la dirección https://[_1]/webmail, e iniciando una sesión en su cuenta.',
'mai_LABEL_WEBMAIL' => 'Acceso webmail',
'mai_LABEL_BLOCK_EXECUTABLE_CONTENT' => 'Bloqueo de contenido ejecutable',
'mai_LABEL_CONTENT_TO_BLOCK' => 'Contenido a ser bloqueado',
'mai_DESC_BLOCK_EXECUTABLE_CONTENT' => 'Usted puede bloquear contenido ejecutable en los archivos adjuntos de e-mail seleccionando el tipo de archivo adjunto ejecutable que desea bloquear. Los e-mails con este tipo de archivos adjuntos serán devueltos automáticamente al remitente.',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_UNACCEPTABLE_CHARS' => 'Este campo requiere una dirección de e-mail válido, el cual debe incluir el símbolo @ y un nombre de dominio.',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_ACCESS' => ' Acceso a e-mail ',
'mai_DESC_STATE_ACCESS_BUTTON' => ' Cambiar configuración de acceso al e-mail ',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_RECEPTION' => ' Recepción de e-mail ',
'mai_DESC_STATE_RECEPTION_BUTTON' => ' Cambiar configuración de recepción de e-mail ',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_DELIVERY' => ' Entrega de e-mail ',
'mai_DESC_STATE_DELIVERY_BUTTON' => ' Cambiar configuración de entrega de e-mail ',
'mai_DESC_STATE_FILTERING_BUTTON' => ' Cambiar configuración de filtros de e-mail ',
'mai_LABEL_VIRUS_SCAN' => 'Exploración de virus',
'mai_DESC_VIRUS_SCAN' => 'Puede analizar el e-mail entrante y saliente en busca de virus. Si el análisis detecta algún virus, el e-mail será rechazado y devuelto al remitente.',
'mai_LABEL_SPAM_SCAN' => 'Filtrado de Spam',
'mai_DESC_SPAM_SCAN' => 'Puede analizar el e-mail en busca de spam. Si el filtrado del Spam está habilitado, un encabezado X-Spam-Status: es agregado a cada mensaje, el cual puede ser usado para filtrado de spam. Usted puede ajustar la sensibilidad del proceso de detección de Spam desde su valor por defecto medio. Para una fina granularidad del control, se puede fijar la sensibilidad a Personalizado, para luego seleccionar el nivel de etiquetado y opcionalmente un nivel a partir del cual el mensaje será rechazo.',
'mai_LABEL_SPAM_SUBJECT' => 'Prefijo en el Asunto de SPAM',
'mai_DESC_SPAM_SUBJECT' => 'Puede habilitarlo para añadir una etiqueta en el asunto de cada mensaje que sea clasificado como SPAM. El valor para esta etiqueta puede ser definido debajo.',
'mai_LABEL_SPAM_SENSITIVITY' => 'Sensibilidad al SPAM',
'mai_LABEL_SPAM_TAGLEVEL' => 'Nivel de etiquetado personalizado',
'mai_LABEL_SPAM_REJECTLEVEL' => 'Nivel de rechazo personalizado',
'mai_LABEL_SPAM_SUBJECTTAG' => 'Modificar el asunto de los mensajes de spam',
'mai_LABEL_SORTSPAM' => 'Colocar spam en la carpeta junkmail',
'mai_VERYHIGH' => 'Muy alto',
'mai_HIGH' => 'Alto',
'mai_MEDIUM' => 'Medio',
'mai_LOW' => 'Bajo',
'mai_VERYLOW' => 'Muy bajo',
'mai_CUSTOM' => 'Personalizado',
'mai_LABEL_SMARTHOST_SMTPAUTH_STATUS' => 'Autenticación SMTP requerida por el proveedor de Internet',
'mai_LABEL_SMARTHOST_SMTPAUTH_USERID' => 'Id de usuario del servidor de correo',
'mai_LABEL_SMARTHOST_SMTPAUTH_PASSWD' => 'Contraseña del servidor de correo',
'mai_VALIDATION_SMTPAUTH_NONBLANK' => 'Este campo no puede quedar en blanco si está habilitada la Autenticación SMTP.',
'mai_TITLE_DELEGATE' => 'Delegar servidores de correo',
'mai_TITLE_SECONDARY' => 'Configuración de ETRN o multidrop',
'mai_TITLE_UNKNOWN' => 'Usuarios desconocidos',
'mai_TITLE_SMARTHOST' => 'Servidor SMTP',
'mai_INVALID_DELEGATE' => '(en)The delegate host name you entered is not a valid IP Address and is not blank',
'mai_ACC_panel_action_was_successful' => 'La configuración de acceso al correo electrónico se guardó correctamente',
'mai_DEL_panel_action_was_successful' => 'La configuración de entrega de correo electrónico se guardó correctamente',
'mai_FIL_panel_action_was_successful' => 'La configuración de filtrado de correo electrónico se guardó correctamente',
'mai_REC_panel_action_was_successful' => 'La configuración de recepción de correo electrónico se guardó correctamente',
'mai_SMTP_port_authenticate' => '(en)Smtp port %u allow client to authenticate:',
'mai_SMTP_port_(25)' => '(en)Smtp port (25) main purpose is to receive emails from another server, starttls is always offered, but auth if offered is only if starttls is also used by client.',
'mai_SMTP_Submission' => '(en)Smtp submission port (587) will require starttls, then authenticate to send.',
'mai_SMTPS_port_(465)' => '(en)Smtps port (465) will require implicit ssl/tls then authenticate to send.',
'mai_SMTPS_SSL/TLS' => '(en)Smtps ssl/tls auth: port %u status:',
'mai_Submission_port' => 'Estado del puerto de envío %u:',
'mai_LABEL_SMARTHOST_SMTPAUTH_PEERPORT' => '(en)Peer Port of Internet provider\'s mail server',
'mai_DESC_PEERPORT' => '(en)Usually 25, 587 or 467. If empty will assume 25.',
