msgstr "Nuova password di sistema"

msgctxt "'usr_usr_NEW_SYSTEM_PASSWORD_VERIFY"
msgid "New system password (verify)"
msgstr "Nuova password di sistema (verifica)"

msgctxt "'usr_usr_LABEL_IPSECRW_DOWNLOAD"
