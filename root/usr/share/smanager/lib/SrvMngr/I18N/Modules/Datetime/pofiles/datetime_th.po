msgctxt "'dat_dat_MAY"
msgid "May"
msgstr "พฤษภาคม"

msgctxt "'dat_dat_JUNE"
msgid "June"
msgstr "มิถุนายน"

msgctxt "'dat_dat_JULY"
msgid "July"
msgstr "กรกฎาคม"

msgctxt "'dat_dat_AUGUST"
msgid "August"
msgstr "สิงหาคม"

msgctxt "'dat_dat_SEPTEMBER"
msgid "September"
msgstr "กันยายน"

msgctxt "'dat_dat_OCTOBER"
msgid "October"
msgstr "ตุลาคม"

msgctxt "'dat_dat_NOVEMBER"
msgid "November"
