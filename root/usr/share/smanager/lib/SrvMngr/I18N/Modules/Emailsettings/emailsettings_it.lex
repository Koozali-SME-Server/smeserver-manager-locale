'mai_NEVER' => 'Mai',
'mai_EVERY5MIN' => 'Ogni 5 minuti',
'mai_EVERY15MIN' => 'Ogni 15 minuti',
'mai_EVERY30MIN' => 'Ogni 30 minuti',
'mai_EVERYHOUR' => 'Ogni ora',
'mai_EVERY2HRS' => 'Ogni 2 ore',
'mai_STANDARD' => 'Standard (SMTP)',
'mai_ETRN' => 'ETRN (SMTP su richiesta)',
'mai_DEFAULT' => 'Predefinito',
'mai_SPECIFY_BELOW' => 'Specificare',
'mai_MULTIDROP' => 'multi-drop',
'mai_LABEL_MODE' => 'Modalità scaricamento e-mail',
'mai_DESC_MODE' => 'La gestione e-mail può essere standard (per connessioni Internet dedicate), ETRN (raccomandato per connessioni dialup), o multi-drop (per connessioni dialup se l\'Internet provider non supporta ETRN).',
'mai_LABEL_DELEGATE' => 'Indirizzo del mail server interno',
'mai_DESC_DELEGATE' => ' Mail server delegato Il server SME include un e-mail server completo. Se per qualunque ragione è preferibile/necessario delegare la gestione della posta a un altro sistema, specificare l\'indirizzo IP del server delegato. Normalmente questo campo deve rimanere vuoto. ',
'mai_LABEL_SECONDARY' => 'Mail server secondario',
'mai_DESC_SECONDARY' => ' Impostazioni ETRN o multi-drop Per ETRN o multi-drop, specificare il nome host o l\'indirizzo IP del mail server secondario. (In caso di impostazioni standard, questo campo può rimanere vuoto). ',
'mai_DESC_FETCH_PERIOD' => 'Per ETRN o multi-drop, impostare la frequenza con cui il server contatta il mail server secondario per scaricare la posta. Connessioni più frequenti permettono di ricevere la posta più tempestivamente, ma aumenta il numero di collegamenti ad Internet, con la possibilità di maggiori costi telefonici.',
'mai_LABEL_FETCH_PERIOD' => 'Orario ufficio (8:00-18:00 Lun-Ven)',
'mai_LABEL_FETCH_PERIOD_NIGHTS' => 'Fuori orario ufficio (18:00-8:00 Lun-Ven)',
'mai_LABEL_FETCH_PERIOD_WEEKENDS' => 'Weekend (Sab-Dom)',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_POP_ACCOUNT' => 'Per multi-drop, specificare username e password dell\'account POP. (In caso di e-mail standard o ETRN, questi campi possono essere vuoti) Inoltre, nel multi-drop, è possibile usare il sistema di distribuzione standard oppure specificare un particolare header da usare per la distribuzione.',
'mai_LABEL_POP_PASS' => 'POP password (multi-drop)',
'mai_LABEL_POP_ACCOUNT' => 'POP username (multi-drop)',
'mai_LABEL_SORT_METHOD' => 'Selezionare il metodo di distribuzione (multi-drop)',
'mai_LABEL_SORT_HEADER' => 'Selezionare l\'header di distribuzione (multi-drop)',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_LABEL_FETCH_PROTO' => 'Protocollo (for multi-drop)',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_LABEL_FETCH_SECURE' => 'Tunnel su SSL (per multi-drop)',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_AUTO' => 'Automatico',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_ENABLED_BOTH' => 'Abilitato sia HTTP che HTTPS',
'mai_ENABLED_SECURE_ONLY' => 'Abilitato HTTPS (accesso sicuro)',
'mai_ONLY_LOCAL_NETWORK_SSL' => 'Abilitato HTTPS (secure) dalle reti locali.',
'mai_INSECURE_POP3' => 'Accesso POP3 e POP3S',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_ALLOW_PRIVATE' => 'Accesso privato',
'mai_SECURE_POP3' => 'Accesso privato e pubblico (POP3S sicuro)',
'mai_INSECURE_IMAP' => 'Accesso IMAP e IMAPS',
'mai_SECURE_IMAP' => 'Accesso privato e pubblico (IMAPS sicuro)',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_INSECURE_SMTP' => 'Accesso SMTP e SSMTP',
'mai_SECURE_SMTP' => 'Accesso SSMTP (sicuro)',
'mai_LABEL_POP_ACCESS_CONTROL' => 'Accesso server POP3',
'mai_LABEL_IMAP_ACCESS_CONTROL' => 'Accesso server IMAP',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_LABEL_SMTP_AUTH_CONTROL' => 'Autenticazione SMTP',
'mai_FORWARD_TO_ADMIN' => 'Invia all\'amministratore',
'mai_FORWARD_TO' => 'Invia a',
'mai_RETURN_TO_SENDER' => 'Rifiuta',
'mai_LABEL_UNKNOWN' => 'Posta ad utenti sconosciuti',
'mai_DESC_UNKNOWN' => ' Utenti sconosciuti Selezionando Rifiuta (impostazione raccomandata) il server accetterà mail solo per indirizzi validi (utenti, gruppi e pseudonimi). Posta destinata ad altri indirizzi verrà rifiutata. ',
'mai_LABEL_SMARTHOST' => 'Indirizzo del mail server del provider Internet',
'mai_DESC_SMARTHOST' => ' Server SMTP Il server può consegnare i messaggi in uscita direttamente a destinazione (raccomandato nella maggior parte dei casi) oppure consegnarli attraverso il server SMTP del provider (raccomandato in caso di connessione inaffidabile o ADSL di tipo residenziale, IP dinamico, etc). Se si utilizza il server SMTP del provider, specificare il nome host o l\'indirizzo IP sotto. Altrimenti lasciare vuoto. ',
'mai_INVALID_SMARTHOST' => 'Il nome host (smarthost) immesso non è valido e non è vuoto',
'mai_DESC_POP_ACCESS_CONTROL' => 'Selezionare l\'accesso al server POP3. L\'impostazione \'Accesso privato\' consente l\'accesso POP3 solo dalla rete locale. Il protocollo POP3S può essere utilizzato per accedere in maniera sicura dall\'esterno (Internet). L\'impostazione consigliata è \'Accesso privato\' a meno di specifiche esigenze.',
'mai_DESC_IMAP_ACCESS_CONTROL' => 'Selezionare l\'accesso al server IMAP. L\'impostazione \'Accesso privato\' consente l\'accesso IMAP solo dalla rete locale. Il protocollo IMAPS può essere utilizzato per accedere in maniera sicura dall\'esterno (Internet). L\'impostazione consigliata è \'Accesso privato\' a meno di specifiche esigenze.',
'mai_DESC_SMTP_AUTH_CONTROL' => ' Si può fornire accesso autenticato al server SMTP, o impostarlo su Disabilitato. L\'impostazione SSMTP richiede che tutti gli utenti utilizzino l\'autenticazione SSL/TLS. Le opzioni SMTP e SSMTP consentono in più di utilizzare STARTTLS per l\'autenticazione sicura. ',
'mai_DESC_WEBMAIL' => 'La webmail può essere abilitata oppure disabilitata. La webmail permette agli utenti di accedere alla loro posta utilizzando un normale browser web, indicando l\'indirizzo https://[_1]/webmail e accedendo con il proprio username e password.',
'mai_LABEL_WEBMAIL' => 'Accesso Webmail',
'mai_LABEL_BLOCK_EXECUTABLE_CONTENT' => 'Blocca allegati eseguibili',
'mai_LABEL_CONTENT_TO_BLOCK' => 'Blocca allegati',
'mai_DESC_BLOCK_EXECUTABLE_CONTENT' => 'E\' possibile bloccare allegati eseguibili contenuti nell\'e-mail, selezionando i tipi di allegati. Le e-mail contenenti allegati dei tipi selezionati verranno automaticamente rispedite al mittente.',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_UNACCEPTABLE_CHARS' => 'Questo campo richiede un indirizzo e-mail che deve includere il simbolo @ e un nome di dominio.',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_ACCESS' => ' Accesso E-mail ',
'mai_DESC_STATE_ACCESS_BUTTON' => ' Cambia configurazione accesso e-mail ',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_RECEPTION' => ' Ricezione E-mail ',
'mai_DESC_STATE_RECEPTION_BUTTON' => ' Cambia configurazione ricezione e-mail ',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_DELIVERY' => ' Distribuzione E-mail ',
'mai_DESC_STATE_DELIVERY_BUTTON' => ' Cambia configurazione distribuzione e-mail ',
'mai_DESC_STATE_FILTERING_BUTTON' => ' Cambia configurazione scansione e-mail ',
'mai_LABEL_VIRUS_SCAN' => 'Scansione Virus',
'mai_DESC_VIRUS_SCAN' => 'E\' possibile scansionare le e-mail per individuare eventuali messaggi infetti (contenenti virus).',
'mai_LABEL_SPAM_SCAN' => 'Filtro Antispam',
'mai_DESC_SPAM_SCAN' => 'E\' possibile controllare le e-mail per individuare lo spam. Se il filtro antispam è abilitato, verrà aggiunto un header X-Spam-Status ad ogni messaggio, che permettarà di separare la posta valida dallo spam. E\' possibile regolare la sensibilità del processo di rilevamento dello Spam, di default è medio. Sensibilità alta potrebbe contrassegnare come spam mail valide. Per un controllo fine è possibile selezionare sensibilità Personalizzato e poi scegliere il livello a cui i messaggi vengono contrassegnati come spam e il livello a cui vengono rifiutati.',
'mai_LABEL_SPAM_SUBJECT' => 'Tag per le e-mail riconosciute come SPAM',
'mai_DESC_SPAM_SUBJECT' => 'Abilitare per aggiungere un tag all\'oggetto della e-mail riconosciuta come SPAM. Il contenuto del tag è definito di seguito.',
'mai_LABEL_SPAM_SENSITIVITY' => 'Sensibilità Antispam',
'mai_LABEL_SPAM_TAGLEVEL' => 'Livello contrassegno spam Personalizzato',
'mai_LABEL_SPAM_REJECTLEVEL' => 'Livello rifiuto spam Personalizzato',
'mai_LABEL_SPAM_SUBJECTTAG' => 'Modifica il subject dei messaggi spam',
'mai_LABEL_SORTSPAM' => 'Sposta lo spam all\'interno della cartella junkmail',
'mai_VERYHIGH' => 'Molto alto',
'mai_HIGH' => 'Alto',
'mai_MEDIUM' => 'Medio',
'mai_LOW' => 'Basso',
'mai_VERYLOW' => 'Molto basso',
'mai_CUSTOM' => 'Personalizzato',
'mai_LABEL_SMARTHOST_SMTPAUTH_STATUS' => 'Autenticazione SMTP per provider internet',
'mai_LABEL_SMARTHOST_SMTPAUTH_USERID' => 'User id del server di posta',
'mai_LABEL_SMARTHOST_SMTPAUTH_PASSWD' => 'Password del server di posta',
'mai_VALIDATION_SMTPAUTH_NONBLANK' => 'Questo campo non può essere lasciato vuoto se l\'autenticazione SMTP è abilitata.',
'mai_TITLE_DELEGATE' => 'Delega i server di posta',
'mai_TITLE_SECONDARY' => 'Impostazioni ETRN o multi-drop',
'mai_TITLE_UNKNOWN' => 'Utenti sconosciuti',
'mai_TITLE_SMARTHOST' => 'Server SMTP',
'mai_INVALID_DELEGATE' => '(en)The delegate host name you entered is not a valid IP Address and is not blank',
'mai_ACC_panel_action_was_successful' => 'Impostazioni di accesso e-mail salvate correttamente',
