'mai_FORM_TITLE' => 'E-Mail Einstellungen',
'E-mail' => 'E-Mail',
'mai_SUCCESS' => 'Die neuen E-Mail Einstellungen wurden gespeichert.',
'mai_NEVER' => 'niemals',
'mai_EVERY5MIN' => 'Alle 5 Minuten',
'mai_EVERY15MIN' => 'Alle 15 Minuten',
'mai_EVERY30MIN' => 'Alle 30 Minuten',
'mai_EVERYHOUR' => 'Jede Stunde',
'mai_EVERY2HRS' => 'Alle 2 Stunden',
'mai_STANDARD' => 'Standard (SMTP)',
'mai_ETRN' => 'ETRN (SMTP mit Client-Abfrage)',
'mai_DEFAULT' => 'Vorgabe',
'mai_SPECIFY_BELOW' => 'Unten angeben',
'mai_MULTIDROP' => 'Mehrfachabwurf',
'mai_LABEL_MODE' => 'E-Mail Abrufmodus',
'mai_DESC_MODE' => 'Der E-Mail Empfangsmodus kann auf Standard (für kontinuierliche Internetverbindung), ETRN (empfohlen für Einwahlverbindungen) oder Multidrop (für Einwahlverbindungen wenn ETRN von Ihrem Internet Provider nicht unterstützt wird) eingestellt werden. Beachten Sie, dass der Multidrop Mode nur zur Verfügung steht, wenn Ihr Server im Modus Privater Server und Gateway läuft.',
'mai_LABEL_DELEGATE' => 'Adresse des internen Mailservers',
'mai_DESC_DELEGATE' => ' Externer Mailserver Ihr Server verfügt über einen kompletten E-Mail Server mit allen Funktionen. Jedoch kann es aus verschieden Gründen notwendig sein, die Mailserver-Funktion eines anderen Mailserver zu nutzen. Geben Sie hierfür die IP Adresse des externen Mailservers unten an. Für eine normale Installation lassen Sie bitte das Feld leer. ',
'mai_LABEL_SECONDARY' => 'Sekundärer Mailserver',
'mai_DESC_SECONDARY' => ' Einstellungen für ETRN oder Multidrop Geben Sie für ETRN oder Multidrop den Hostnamen oder die IP-Adresse Ihres sekundären Mailservers an. (Wenn Sie die Standard E-Mail Einstellungen verwenden, kann dieses Feld leer bleiben.) ',
'mai_DESC_FETCH_PERIOD' => 'Für ETRN oder Multidrop können Sie hier einstellen, wie oft dieser Server Ihren sekundären E-Mail Server die Mails kontaktiert. Je öfter die Verbindung augenommen wird, desto schneller erhalten Sie Ihre E-Mails, aber Sie sollten bedenken, daß hierfür mehr Datenverkehr entsteht und Sie eventuell höhere Internetkosten haben.',
'mai_LABEL_FETCH_PERIOD' => 'Während den Bürozeiten (8:00 Uhr bis 18:00 Uhr) an Wochentagen',
'mai_LABEL_FETCH_PERIOD_NIGHTS' => 'Außerhalb der Bürozeiten (18:00 Uhr bis 08:00 Uhr) an Wochentagen',
'mai_LABEL_FETCH_PERIOD_WEEKENDS' => 'Während des Wochenendes',
'mai_DESC_POP_ACCOUNT' => 'Für Multidrop von E-Mails geben Sie bitte das POP Benutzerkonto sowie das Passwort an. (Wenn Sie Standard oder ETRN E-Mail verwenden kann dieses Feld leer bleiben.) Für Multidrop können Sie auch angeben, ob Sie die Standard Mail Sortiermethode verwenden wollen, oder Sie definieren spezielle Nachrichtenheader für die Sortierung der Mails.',
'mai_LABEL_POP_PASS' => 'POP Benutzerpasswort (für Multidrop)',
'mai_LABEL_POP_ACCOUNT' => 'POP Benutzerkonto (für Multidrop)',
'mai_LABEL_SORT_METHOD' => 'Wählen Sie die Sortiermethode (für Multidrop)',
'mai_LABEL_SORT_HEADER' => 'Wählen Sie einen Nachrichtenheader (für Multidrop)',
'mai_LABEL_FETCH_PROTO' => 'Protokoll (für Multi-Drop)',
'mai_LABEL_FETCH_SECURE' => 'Tunnel über SSL (für Multi-Drop)',
'mai_AUTO' => 'Automatisch',
'mai_ENABLED_BOTH' => 'Sowohl HTTP als auch HTTPS erlauben',
'mai_ENABLED_SECURE_ONLY' => 'HTTPS (sicherer Zugang) erlauben',
'mai_ONLY_LOCAL_NETWORK_SSL' => 'HTTPS (sicherer Zugang) vom lokalen Netzwerk erlauben',
'mai_INSECURE_POP3' => 'Sowohl POP3 als auch POP3S erlauben',
'mai_ALLOW_PRIVATE' => 'Lokal erlauben',
'mai_SECURE_POP3' => 'Lokal und öffentlich erlauben (Secure POP3S)',
'mai_INSECURE_IMAP' => 'Sowohl IMAP als auch IMAPS erlauben',
'mai_SECURE_IMAP' => 'Lokal und öffentlich erlauben (Secure IMAPS)',
'mai_INSECURE_SMTP' => 'Sowohl SMTP als auch SSMTP erlauben',
'mai_SECURE_SMTP' => 'Nur SSMTP (Secure) erlauben',
'mai_LABEL_POP_ACCESS_CONTROL' => 'POP3 Server Zugang',
'mai_LABEL_IMAP_ACCESS_CONTROL' => 'IMAP Server Zugang',
'mai_LABEL_SMTP_AUTH_CONTROL' => 'SMTP Authentifizierung',
'mai_FORWARD_TO_ADMIN' => 'An den Administrator schicken',
'mai_FORWARD_TO' => 'Senden an',
'mai_RETURN_TO_SENDER' => 'Ablehnen',
'mai_LABEL_UNKNOWN' => 'E-Mail an unbekannte Benutzer',
'mai_DESC_UNKNOWN' => ' Unbekannte Benutzer Das Auswählen von Ablehnen (empfohlene Einstellung) konfiguriert den Server so, dass er nur E-Mails für gültige E-Mail Adressen (zum Beispiel Benutzer, Gruppen, Pseudonyme) annimmt. E-Mails für andere Adressen werden abgelehnt. ',
'mai_LABEL_SMARTHOST' => 'Adresse des E-Mail Servers Ihres Internet Providers',
'mai_DESC_SMARTHOST' => ' SMTP Server Der Server kann ausgehende E-Mails direkt selbst an den Empfänger versenden (in den meisten Fällen empfohlen) oder aber über den SMTP Server Ihres Internet Providers (empfohlen bei einer unzuverlässigen Internet-Verbindung oder bei Einwahlverbindung). Wenn Sie den SMTP Server Ihres Internet Providers verwenden, geben Sie den Hostnamen oder die IP-Adresse unten ein. Ansonsten lassen Sie das Feld leer. ',
'mai_INVALID_SMARTHOST' => 'Der Smart Host-Name, den Sie eingegeben haben, ist kein gültiger Internet-Domänenname und auch nicht leer',
'mai_DESC_POP_ACCESS_CONTROL' => 'Sie können den Zugang zu Ihrem POP3-Server einstellen. Die Einstellung \'Zugang nur von lokalen Netzwerken\' erlaubt den POP3-Zugang nur über lokales Netzwerk(e). Die POP3S-Einstellung ermöglicht verschlüsselten externen Zugriff auf Ihren POP3-Server. Wir empfehlen die Einstellung \'Zugang nur von lokalen Netzwerken\' nur in begründeten Fällen zu ändern.',
'mai_DESC_IMAP_ACCESS_CONTROL' => 'Sie können den Zugang zu ihren IMAP-Server einstellen. Die Einstellung \'Zugang nur von lokalen Netzwerken\' erlaubt der Zugang nur über lokales Netzwerk(e). Die IMAPS-Einstellung ermöglicht den verschlüsselten externen Zugriff auf Ihren IMAP-Server. Wir empfehlen die \'Zugang nur von lokalem Netzwerk\' nur zu ändern, wenn Sie besondere Gründe haben.',
'mai_DESC_SMTP_AUTH_CONTROL' => ' Sie können authentifizierten Zugriff auf den SMTP-Server bereitstellen oder deaktivieren. Die SSMTP Einstellung erfordert von allen Benutzer eine SSL/TLS-Authentifizierung. Die Auswahl SMTP und SSMTP lässt zusätzlich STARTTLS zu, was eine sichere Authentifizierung gewährleistet. ',
'mai_DESC_WEBMAIL' => 'Sie können Webmail auf diesem System aktivieren oder deaktivieren. Webmail erlaubt den Benutzern, ihre E-Mails mit einem normalen Webbrowser über https://[_1]/webmail und Anmeldung auf Ihrem Konto einzusehen.',
'mai_LABEL_WEBMAIL' => 'Webmail Zugang',
'mai_LABEL_BLOCK_EXECUTABLE_CONTENT' => 'Ausführbare Dateianhänge blockieren',
'mai_LABEL_CONTENT_TO_BLOCK' => 'Zu blockierender Inhalt',
'mai_DESC_BLOCK_EXECUTABLE_CONTENT' => 'Sie können ausführbare Inhalte in E-Mail Anhängen blockieren, indem Sie die zu blockierenden ausführbaren Typen markieren. E-Mail mit diesen angehängten Dateitypen werden automatisch an den Sender zurückgesandt.',
'mai_UNACCEPTABLE_CHARS' => 'Dieses Feld erfordert eine gültige E-Mail-Adresse, die das @ Symbol und einen Domänennamen enthalten muß.',
'mai_DESC_STATE_ACCESS' => ' E-Mail Zugang ',
'mai_DESC_STATE_ACCESS_BUTTON' => ' Einstellungen für E-Mail-Zugang ändern ',
'mai_DESC_STATE_RECEPTION' => ' E-Mail Empfang ',
'mai_DESC_STATE_RECEPTION_BUTTON' => ' Einstellungen für E-Mail-Empfang ändern ',
'mai_DESC_STATE_DELIVERY' => ' E-Mail Auslieferung ',
'mai_DESC_STATE_DELIVERY_BUTTON' => ' Einstellungen für E-Mail-Auslieferung ändern ',
'mai_DESC_STATE_FILTERING_BUTTON' => ' Einstellungen für E-Mail-Filter ändern ',
'mai_LABEL_VIRUS_SCAN' => 'Viren-Scanner',
'mai_DESC_VIRUS_SCAN' => 'Ein- und ausgehende E-Mails können nach Viren durchsucht werden. Wenn die Viruserkennung eingeschaltet ist und ein Virus gefunden wird, wird die E-Mail abgewiesen und an den Absender zurückgeschickt.',
'mai_LABEL_SPAM_SCAN' => 'Spam-Filter',
'mai_DESC_SPAM_SCAN' => 'E-Mails können nach Spam gefiltert werden. Bei Einschalten des Spam-Filters wird jeder E-Mail ein Header mit X-Spam-Status hinzugefügt, der für das Filtern von Spam benutzt werden kann. Die Sensibilität, mit der der Filter E-Mails als Spam einstuft, ist auf Mittel voreingestellt. Zur Feineinstellung kann die Empfindlichkeit auf Spezifisch mit spezifischem Tagging Level geändert werden, und optional ein Level, bei der eine E-Mail abgewiesen wird.',
'mai_LABEL_SPAM_SUBJECT' => 'SPAM-Kennzeichnung in der Betreffzeile',
'mai_DESC_SPAM_SUBJECT' => 'Sie können ein Kennzeichen zur E-Mail-Betreffzeile hinzu fügen, das die E-Mail als SPAM eingestuft ist. Die Eingabe dieses Kennzeichens erfolgt unten.',
'mai_LABEL_SPAM_SENSITIVITY' => 'Spam Sensibilität',
'mai_LABEL_SPAM_TAGLEVEL' => 'Spezifische Spam-Einstellungen',
'mai_LABEL_SPAM_REJECTLEVEL' => 'Spezifische Einstellung zur Mail-Abweisung',
'mai_LABEL_SPAM_SUBJECTTAG' => 'Spam Nachricht Betreff verändern',
'mai_LABEL_SORTSPAM' => 'Spam in den Junkmail-Ordner verschieben',
'mai_VERYHIGH' => 'Sehr hoch',
'mai_HIGH' => 'Hoch',
'mai_MEDIUM' => 'Mittel',
'mai_LOW' => 'Niedrig',
'mai_VERYLOW' => 'Sehr niedrig',
'mai_CUSTOM' => 'Spezifische Einstellung',
'mai_LABEL_SMARTHOST_SMTPAUTH_STATUS' => 'SMTP Anmeldung beim Internet-Provider',
'mai_LABEL_SMARTHOST_SMTPAUTH_USERID' => 'Mail-Server Benutzer-ID',
'mai_LABEL_SMARTHOST_SMTPAUTH_PASSWD' => 'Mail-Server Kennwort',
'mai_VALIDATION_SMTPAUTH_NONBLANK' => 'Dieses Feld darf nicht leer sein, wenn SMTP Authentifizierung aktiviert ist.',
