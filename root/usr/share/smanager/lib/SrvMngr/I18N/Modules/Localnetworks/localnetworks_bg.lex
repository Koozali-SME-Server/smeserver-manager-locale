# ORPHANED (no longer in localnetworks_en.lex; kept for reference, commented out by lex-to-po.pl): 'ln_Local networks' => 'локални мрежи',
'ln_FIRSTPAGE_DESC' => ' По причини, свързани с информационната сигурност, редица услуги на Вашия сървър са достъпни само в локалната мрежа. Обаче Вие можете да предоставите тези права за локален достъп и за допълнителни мрежи като го добавите по-долу. При повечето конфигурации този списък трябва да остане празен. Добави мрежа ',
'ln_ADD_TITLE' => 'Добавяне на локална мрежа',
'ln_ADD_DESC' => ' Всеки параметър трябва да бъде във формат #.#.#.# (всеки # е число 0 до 255). Софтуерът на сървъра ще нулира крайната (идентификатора за машина) част на мрежвия адрес според маската за подмрежа, за да осигури, че мрежовия адрес е валиден. "Маршрутизатор" трябва да бъде IP адреса на маршрутизатора на локалната мрежа през който допълнителната мрежа се достига. ',
# ORPHANED (no longer in localnetworks_en.lex; kept for reference, commented out by lex-to-po.pl): 'ln_NETWORK_ADDRESS' => 'Адрес на мрежата',
'ln_SUBNET_MASK' => 'Маска на подмрежа',
'ln_INVALID_IP_ADDRESS' => 'Некоректен IP адрес',
'ln_INVALID_SUBNET_MASK' => 'Некоректна маска на подмрежа',
'ln_REMOVE_TITLE' => 'Премахване на локална мрежа',
'ln_REMOVE_DESC' => 'Вие ще премахнете следните локални мрежи.',
# ORPHANED (no longer in localnetworks_en.lex; kept for reference, commented out by lex-to-po.pl): 'ln_REMOVE_CONFIRM' => 'Сигурни ли сте, че искате да премахнете тази мрежа?',
# ORPHANED (no longer in localnetworks_en.lex; kept for reference, commented out by lex-to-po.pl): 'ln_DEFAULT' => 'по подразбиране',
'ln_NUMBER_OF_HOSTS' => 'брой машини',
'ln_NOT_ACCESSIBLE_FROM_LOCAL_NETWORK' => 'Грешка: адресът на маршрутизатора [_1] не е достъпен от локална мрежа. Мрежата не бе добавена.',
'ln_NETWORK_ALREADY_LOCAL' => 'Грешка: мрежата [_1] (резултат от мрежов адрес [_2] и маска за подмрежа [_3]) вече се счита за локална. Мрежата не бе добавена.',
'ln_NETWORK_ALREADY_ADDED' => 'Грешка: мрежата [_1] (резултат от мрежов адрес [_2] и маска за подмрежа [_3]) вече е била добавена. Не беше добавяна мрежа отново.',
'ln_ERROR_CREATING_NETWORK' => 'Възникна грешка при създаването на мрежа.',
# ORPHANED (no longer in localnetworks_en.lex; kept for reference, commented out by lex-to-po.pl): 'ln_SUCCESS' => 'Успешно добавяне на мрежа [_1]/[_2] през маршрутизатор [_3].',
'ln_SUCCESS_SINGLE_ADDRESS' => 'Успешно добавяне на мрежа [_1]/[_2] през маршрутизатор [_3]. Вашият сървър ще предостави права за локален достъп на един IP адрес [_4].',
'ln_SUCCESS_NETWORK_RANGE' => 'Успешно добавяне на мрежа [_1]/[_2] през маршрутизатор [_3]. Вашият сървър ще предостави права за локален достъп на [_4] IP адреса в обхвата [_5] до [_6].',
'ln_SUCCESS_NONSTANDARD_RANGE' => '  Успешно добавяне на мрежа [_1]/[_2] през маршрутизатор [_3]. <p> Вашият сървър ще предостави права за локален достъп на [_1] IP адреса в обхвата [_2] до [_3]. </p> <p> Внимание: Сървърът ProFTPd FTP не може да работи с тази нестандартна маска на подмрежа. Вместо това ще бъде използвана по-простата спецификация <b>[_1]</b>.</p> ',
'ln_SUCCESS_REMOVED_NETWORK' => 'Успешно премахване на мрежа [_1]/[_2] през маршрутизатор [_3].',
'ln_ERROR_DELETING_NETWORK' => 'Възникна грешка при изтриването на мрежата.',
# ORPHANED (no longer in localnetworks_en.lex; kept for reference, commented out by lex-to-po.pl): 'ln_NO_ADDITIONAL_NETWORKS' => 'Няма допълнителни мрежи',
'ln_REMOVE_HOSTS_DESC' => 'Бяха открити локални машини, конфигурирани в мрежата, която смятате да премахнете. По подразбиране те също ще бъдат премахнати. Махнете отметката тук, ако по някаква причина не желаете това да се случи. Имайте предвид, че те няма да бъдат третирани като локални, и може даже да не са достъпни след премахването на мрежата.',
'ln_REMOVE_HOSTS_LABEL' => 'Премахване на машини от мрежата',
'ln_LOCAL NETWORKS' => 'Локални мрежи',
'Local networks' => 'Локални мрежи',
'ln_LOCALNETWORK_ADD' => 'Добавяне на мрежа',
'ln_NO_SUCH_NETWORK' => '(en)Network not found in network db',
