msgstr "A számnak 1-nek, vagy annál nagyobbnak kell lennie."

msgctxt "bac_ERR_INVALID_FILES_IN_SET_NUMBER"
msgid ""
"This number must be 1 or greater. First backup in set is <b>full</b> others "
