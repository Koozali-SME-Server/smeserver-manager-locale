msgctxt "FM_NONBLANK"
msgid "This field must not be left blank"
msgstr "To polje je obvezen vnos"

msgctxt "FM_INTEGER"
msgid "This field must contain a positive integer"
msgstr "To polje lahko vsebuje le celo pozitivno tevilo"

