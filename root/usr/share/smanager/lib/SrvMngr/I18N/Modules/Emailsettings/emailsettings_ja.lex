# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_SUCCESS' => '(en)The new e-mail settings have been saved.',
'mai_NEVER' => 'まったくそうではありません',
'mai_EVERY5MIN' => '5分ごと',
'mai_EVERY15MIN' => '15分ごと',
'mai_EVERY30MIN' => '30分ごと',
'mai_EVERYHOUR' => '1時間ごと',
'mai_EVERY2HRS' => '2時間ごと',
'mai_STANDARD' => '標準（SMTP）',
'mai_ETRN' => 'ETRN（クライアント要求付きSMTP）',
'mai_DEFAULT' => 'デフォルト',
'mai_SPECIFY_BELOW' => '以下で指定してください',
'mai_MULTIDROP' => 'multi-drop',
'mai_LABEL_MODE' => 'メール取得モード',
'mai_DESC_MODE' => '(en)The e-mail retrieval mode can be set to standard (for dedicated Internet connections), ETRN (recommended for dialup connections), or multi-drop (for dialup connections if ETRN is not supported by your Internet provider). Note that multi-drop mode is the only option available when the server is configured in private server and gateway mode.',
'mai_LABEL_DELEGATE' => 'Address of internal mail server',
'mai_DESC_DELEGATE' => ' Delegate mail servers Your server includes a complete, full-featured e-mail server. However, if for some reason you wish to delegate e-mail processing to another system, specify the IP address of the delegate system here. For normal operation, leave this field blank. ',
'mai_LABEL_SECONDARY' => 'セカンダリメールサーバー',
'mai_DESC_SECONDARY' => ' ETRN or multi-drop settings For ETRN or multi-drop, specify the hostname or IP address of your secondary mail server. (If using the standard e-mail setup, this field can be left blank.) ',
'mai_DESC_FETCH_PERIOD' => '(en)For ETRN or multi-drop, you can control how frequently this server contacts your secondary e-mail server to fetch e-mail. More frequent connections mean that you receive your e-mail more quickly, but also cause Internet requests to be sent more often, possibly increasing your phone and Internet charges.',
'mai_LABEL_FETCH_PERIOD' => '(en)During office hours (8:00 AM to 6:00 PM) on weekdays',
'mai_LABEL_FETCH_PERIOD_NIGHTS' => '(en)Outside office hours (6:00 PM to 8:00 AM) on weekdays',
'mai_LABEL_FETCH_PERIOD_WEEKENDS' => '週末中',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_POP_ACCOUNT' => '(en)For multi-drop e-mail, specify the POP user account and password. (If using standard or ETRN e-mail, these fields can be blank.) Also, for multi-drop, you can either use the default mail sorting method, or you can specify a particular message header to use for mail sorting.',
'mai_LABEL_POP_PASS' => 'POPユーザーパスワード（マルチドロップ用）',
'mai_LABEL_POP_ACCOUNT' => 'POPユーザーアカウント（マルチドロップ用）',
'mai_LABEL_SORT_METHOD' => '並べ替え方法を選択（マルチドロップ用）',
'mai_LABEL_SORT_HEADER' => '並べ替えヘッダーを選択（複数ドロップ用）',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_LABEL_FETCH_PROTO' => 'プロトコル（マルチドロップ用）',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_LABEL_FETCH_SECURE' => 'SSL経由のトンネル（マルチドロップ用）',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_AUTO' => 'Automatic',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_ENABLED_BOTH' => 'HTTP と HTTPS の両方を許可',
'mai_ENABLED_SECURE_ONLY' => 'HTTPS（安全）を許可',
'mai_ONLY_LOCAL_NETWORK_SSL' => '(en)Allow HTTPS (secure) from local networks',
'mai_INSECURE_POP3' => 'POP3 と POP3S の両方を許可',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_ALLOW_PRIVATE' => 'プライベートを許可',
'mai_SECURE_POP3' => '(en)Allow private and public (secure POP3S)',
'mai_INSECURE_IMAP' => 'IMAP と IMAPS の両方を許可',
'mai_SECURE_IMAP' => '(en)Allow private and public (secure IMAPS)',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_INSECURE_SMTP' => 'SMTP と SSMTP の両方を許可',
'mai_SECURE_SMTP' => 'SSMTP（セキュア）を許可',
'mai_LABEL_POP_ACCESS_CONTROL' => 'POP3サーバーへのアクセス',
'mai_LABEL_IMAP_ACCESS_CONTROL' => 'IMAPサーバーアクセス',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_LABEL_SMTP_AUTH_CONTROL' => 'SMTP認証',
'mai_FORWARD_TO_ADMIN' => '管理者に送信',
'mai_FORWARD_TO' => '送信先',
'mai_RETURN_TO_SENDER' => '拒絶',
'mai_LABEL_UNKNOWN' => '不明なユーザーへのメール',
'mai_DESC_UNKNOWN' => ' Unknown Users Selecting Reject (recommended setting) will configure the server to only accept mail for valid email addresses (for example users, groups, pseudonyms). Mail for other addresses will be rejected. ',
'mai_LABEL_SMARTHOST' => '(en)Address of Internet provider\'s mail server',
'mai_DESC_SMARTHOST' => ' SMTP server The server can deliver outgoing messages directly to their destination (recommended in most cases) or can deliver them via your Internet provider\'s SMTP server (recommended if you have an unreliable Internet connection or are using a residential Internet service). If using your Internet provider\'s SMTP server, specify its hostname or IP address below. Otherwise leave this field blank. ',
'mai_INVALID_SMARTHOST' => '(en)The smarthost name you entered is not a valid internet domain name and is not blank',
'mai_DESC_POP_ACCESS_CONTROL' => '(en)You can control POP3 server access. The setting \'Allow access only from local networks\' allows POP3 access only from your local network(s). The POP3S setting can be used to provide encrypted external access to your POP3 server. We recommend leaving this setting \'Allow access only from local networks\' unless you have a specific reason to do otherwise.',
'mai_DESC_IMAP_ACCESS_CONTROL' => '(en)You can control IMAP server access. The setting \'Allow access only from local networks\' allows IMAP access only from your local network(s). The IMAPS setting can be used to provide encrypted external access to your IMAP server. We recommend leaving this setting \'Allow access only from local networks\' unless you have a specific reason to do otherwise.',
'mai_DESC_SMTP_AUTH_CONTROL' => ' You can provide authenticated access to your SMTP server, or set it to Disabled. The SSMTP setting requires all users to use SSL/TLS authentication. The SMTP and SSMTP option additionally allows STARTTLS to be used to ensure secure authentication. ',
'mai_DESC_WEBMAIL' => 'You can enable or disable webmail on this system. Webmail allows users to access their mail through a regular web browser by pointing the browser to https://[_1]/webmail, and logging in to their account.',
'mai_LABEL_WEBMAIL' => 'ウェブメールへのアクセス',
'mai_LABEL_BLOCK_EXECUTABLE_CONTENT' => '実行可能コンテンツのブロック',
'mai_LABEL_CONTENT_TO_BLOCK' => 'ブロックするコンテンツ',
'mai_DESC_BLOCK_EXECUTABLE_CONTENT' => '(en)You can block executable content in e-mail attachments by highlighting the executable attachment types you wish to block. E-mail containing these attachment types will be automatically returned to the sender.',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_UNACCEPTABLE_CHARS' => '(en)This field requires a valid e-mail address, which must include the @ symbol and a domain name.',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_ACCESS' => 'メールアクセス',
'mai_DESC_STATE_ACCESS_BUTTON' => 'メールアクセス設定を変更',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_RECEPTION' => 'メール受信',
'mai_DESC_STATE_RECEPTION_BUTTON' => 'メール受信設定の変更',
# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_DESC_STATE_DELIVERY' => 'メール配信',
'mai_DESC_STATE_DELIVERY_BUTTON' => 'メール配信設定を変更',
'mai_DESC_STATE_FILTERING_BUTTON' => 'メールフィルタリング設定を変更',
'mai_LABEL_VIRUS_SCAN' => 'ウイルススキャン',
'mai_DESC_VIRUS_SCAN' => '(en)You can scan incoming and outgoing e-mail for viruses. If scanning is enabled and a virus is detected, the e-mail will be rejected and returned to the sender.',
'mai_LABEL_SPAM_SCAN' => 'スパムフィルタリング',
'mai_DESC_SPAM_SCAN' => '(en)You can scan e-mail for spam. If Spam filtering is enabled, an X-Spam-Status: header is added to each message, which can be used for filtering spam. You can adjust the sensitivity of the Spam detection process from the default of medium. For fine-grained control, you can set the Spam sensitivity to Custom and then choose a custom tagging level, and optionally a level at which to reject the message.',
'mai_LABEL_SPAM_SUBJECT' => '迷惑メール件名プレフィックス',
'mai_DESC_SPAM_SUBJECT' => '(en)You can enable to add a tag to the subject of each message that is classified as SPAM. The value for this tag can be defined below.',
'mai_LABEL_SPAM_SENSITIVITY' => 'スパム感度',
'mai_LABEL_SPAM_TAGLEVEL' => 'カスタムスパムタグ付けレベル',
'mai_LABEL_SPAM_REJECTLEVEL' => 'カスタムスパム拒否レベル',
'mai_LABEL_SPAM_SUBJECTTAG' => 'スパムメッセージの件名を変更',
'mai_LABEL_SORTSPAM' => 'スパムを迷惑メールフォルダーに振り分ける',
'mai_VERYHIGH' => '非常に高い',
'mai_HIGH' => '高い',
'mai_MEDIUM' => '中',
'mai_LOW' => '低い',
'mai_VERYLOW' => '非常に低い',
'mai_CUSTOM' => 'カスタム',
'mai_LABEL_SMARTHOST_SMTPAUTH_STATUS' => 'インターネットプロバイダーのSMTP認証',
'mai_LABEL_SMARTHOST_SMTPAUTH_USERID' => 'メールサーバーのユーザーID',
'mai_LABEL_SMARTHOST_SMTPAUTH_PASSWD' => 'メールサーバーのパスワード',
'mai_VALIDATION_SMTPAUTH_NONBLANK' => 'This field cannot be left blank if SMTP Authentication is enabled.',
'mai_TITLE_DELEGATE' => 'メールサーバーを委任',
'mai_TITLE_SECONDARY' => 'ETRNまたはマルチドロップ設定',
'mai_TITLE_UNKNOWN' => '不明なユーザー',
'mai_TITLE_SMARTHOST' => 'SMTPサーバー',
'mai_INVALID_DELEGATE' => '(en)The delegate host name you entered is not a valid IP Address and is not blank',
'mai_ACC_panel_action_was_successful' => 'メールアクセス設定が正常に保存されました',
'mai_DEL_panel_action_was_successful' => 'メール配信設定が正常に保存されました',
'mai_FIL_panel_action_was_successful' => 'メールフィルタリング設定が正常に保存されました',
'mai_REC_panel_action_was_successful' => 'メール受信設定が正常に保存されました',
'mai_SMTP_port_authenticate' => '(en)Smtp port %u allow client to authenticate:',
'mai_SMTP_port_(25)' => '(en)Smtp port (25) main purpose is to receive emails from another server, starttls is always offered, but auth if offered is only if starttls is also used by client.',
'mai_SMTP_Submission' => '(en)Smtp submission port (587) will require starttls, then authenticate to send.',
'mai_SMTPS_port_(465)' => '(en)Smtps port (465) will require implicit ssl/tls then authenticate to send.',
'mai_SMTPS_SSL/TLS' => '(en)Smtps ssl/tls auth: port %u status:',
'mai_Submission_port' => '送信ポート %u のステータス:',
'mai_LABEL_SMARTHOST_SMTPAUTH_PEERPORT' => '(en)Peer Port of Internet provider\'s mail server',
'mai_DESC_PEERPORT' => '(en)Usually 25, 587 or 467. If empty will assume 25.',
