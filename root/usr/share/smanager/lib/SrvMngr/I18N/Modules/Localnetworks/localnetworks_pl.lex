'ln_INVALID_IP_ADDRESS' => 'Nieprawidłowy adres IP',
'ln_INVALID_SUBNET_MASK' => 'Nieprawidłowa maska podsieci',
'ln_REMOVE_TITLE' => 'Usuń sieć lokalną',
'ln_REMOVE_DESC' => '(en)You are about to remove the following local network.',
