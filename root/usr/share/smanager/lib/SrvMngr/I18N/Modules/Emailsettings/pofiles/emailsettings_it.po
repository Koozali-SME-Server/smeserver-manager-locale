msgid "Standard (SMTP)"
msgstr "Standard (SMTP)"

msgctxt "'mai_mai_ETRN"
msgid "ETRN (SMTP with client request)"
msgstr "ETRN (SMTP su richiesta)"

msgctxt "'mai_mai_DEFAULT"
msgid "Default"
msgstr "Default"

msgctxt "'mai_mai_SPECIFY_BELOW"
