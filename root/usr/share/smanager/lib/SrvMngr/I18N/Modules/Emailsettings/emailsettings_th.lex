'mai_ACC_panel_action_was_successful' => 'บันทึกการตั้งค่าการเข้าถึงอีเมลเรียบร้อยแล้ว',
'mai_DEL_panel_action_was_successful' => 'บันทึกการตั้งค่าการส่งอีเมลเรียบร้อยแล้ว',
