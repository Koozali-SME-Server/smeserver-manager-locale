'mai_CUSTOM' => 'Poljubna',
'mai_LABEL_SMARTHOST_SMTPAUTH_STATUS' => 'SMTP avtentikacija za ISP',
'mai_LABEL_SMARTHOST_SMTPAUTH_USERID' => 'Uporabnisko ime za uporabnika',
'mai_LABEL_SMARTHOST_SMTPAUTH_PASSWD' => 'Geslo za mail streznik',
