'mai_DESC_STATE_DELIVERY' => ' Dostava E-mail(a) ',
'mai_DESC_STATE_DELIVERY_BUTTON' => ' Spremeni dostavo e-mail(a) ',
'mai_DESC_STATE_FILTERING_BUTTON' => ' Spremeni filtriranje e-mail(a) ',
'mai_LABEL_VIRUS_SCAN' => 'Ciscenje virusov',
'mai_DESC_VIRUS_SCAN' => 'E-mail lahko preiscete ce vsebuje virus in ga nato zavrnete ali posljete v karanteno.',
'mai_LABEL_SPAM_SCAN' => 'Spam filtriranje',
'mai_DESC_SPAM_SCAN' => 'E-mail lahko preičete če vsebuje spam. Ce je spam filtriranje omogoceno, doda streznik v glavo sporocila vrstico: X-Spam-Status, ki jo nato uporabimo za filtriranje spam-a. Obcutljivost spam filtra lahko nastavljamo med privzeto in srednjo. Ce zelimo nastavitev natancneje definirati, imamo moznost izbirate nivoja pri katerem bo streznik zavrnil sporocilo, kot spam.',
'mai_LABEL_SPAM_SUBJECT' => 'SPAM subject prefix',
'mai_DESC_SPAM_SUBJECT' => 'You can enable to add a tag to the subject of each message that is classified as SPAM. The value for this tag can be defined below.',
'mai_LABEL_SPAM_SENSITIVITY' => 'Obcutljivost za spam',
'mai_LABEL_SPAM_TAGLEVEL' => 'Nivo po zelji',
'mai_LABEL_SPAM_REJECTLEVEL' => 'Nivo za zavrnitev sporocila',
'mai_LABEL_SPAM_SUBJECTTAG' => 'Spremeni zadevo sporocil oznacenih za spam',
'mai_LABEL_SORTSPAM' => 'Premekni spam v junkmail mapo',
'mai_VERYHIGH' => 'Zelo visoka',
'mai_HIGH' => 'Visoka',
'mai_MEDIUM' => 'Srednja',
'mai_LOW' => 'Nizka',
