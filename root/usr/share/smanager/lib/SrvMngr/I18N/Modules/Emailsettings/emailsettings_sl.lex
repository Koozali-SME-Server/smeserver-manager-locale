'mai_NEVER' => 'nikoli',
'mai_EVERY5MIN' => 'vsakih 5 minut',
'mai_EVERY15MIN' => 'vsakih 15 minut',
'mai_EVERY30MIN' => 'vsakih 30 minut',
'mai_EVERYHOUR' => 'Vsako uro',
'mai_EVERY2HRS' => 'Vsaki 2 uri',
'mai_STANDARD' => 'Standardno (SMTP)',
'mai_ETRN' => 'ETRN (SMTP z zahtevkom odjemalca)',
