'quo_LIMIT_WITH_GRACE_MB' => '寬限期(MB)',
'quo_ABS_LIMIT' => '底限',
'quo_ABS_LIMIT_MB' => '底限(MB)',
'quo_CURRENT_USAGE' => '目前用量(MB)',
