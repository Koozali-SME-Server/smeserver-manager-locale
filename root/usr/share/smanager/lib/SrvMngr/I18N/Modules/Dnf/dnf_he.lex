'yum_1DAILY' => 'יומי',
'yum_2WEEKLY' => 'שבועי',
'yum_3MONTHLY' => 'Monthly',
'yum_LABEL_YUM_DELTARPMPROCESS' => 'עדכון דלתא סל״ד',
'yum_LABEL_YUM_DOWNLOADONLY' => 'הפרטים האישיים עודכנו',
'yum_BUTTON_CONFIGURATION' => 'שנה את הגדרות מתקין התוכנה',
'yum_BUTTON_INSTALL_AVAILABLE' => 'התקן תוכנות נוספות',
'yum_BUTTON_INSTALL_UPDATES' => 'הצג עדכונים זמינים',
'yum_BUTTON_REMOVE' => 'הסר תוכנה מותקנת',
'yum_DESC_YUM_AUTOINSTALLUPDATES' => '(en)If enabled this will take precedence over the simple check for updates notification and predownload features. Instead it will install the available updates from enabled repositories. For more information refer to yum and yum-cron manual page.',
'yum_DESC_YUM_DELTARPMPROCESS' => '(en)A deltarpm contains the difference between an old and a new version of a rpm, which can save bandwith. The drawback is that update operations consume considerably more CPU cycles',
'yum_FORM_TITLE' => 'מתקין תוכנה',
'yum_LABEL_YUM_DOWNLOADONLY_DESCRIPTION' => '(en)The rpm updates can be downloaded during the night, this will ease and give faster the dnf update process (only enabled repositories will be used).',
'yum_Please_Wait_-_dnf_Running' => 'אנא המתן - dnf פועל',
'yum_UPDATE_SUCCESS' => '(en)The requested changes have been successfully implemented.',
