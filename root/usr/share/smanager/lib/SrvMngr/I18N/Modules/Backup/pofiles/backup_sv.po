msgstr "timmar."

msgctxt "bac_ERR_NO_FULL_BACKUP"
msgid "Aborting restore because needed full backup is missing or unreadable."
msgstr ""
"Avbryter återställning eftersom den fullständiga backup som krävs saknas "
