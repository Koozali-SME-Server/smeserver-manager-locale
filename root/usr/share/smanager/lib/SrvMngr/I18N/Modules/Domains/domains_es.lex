'dom_FORM_TITLE' => 'Administrar dominios',
'dom_FORM_DESCRIPTION' => ' <p>Cuando crea un dominio, el servidor queda habilitado para recibir correo electrónico para ese dominio y también puede alojar un sitio web para ese dominio.</p>

  <p><a class="button-like" href="domains?page=0&page_stack=&next=next&wherenext=domains_page_create">Agregar dominio</a> ',
