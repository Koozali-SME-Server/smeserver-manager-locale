'mai_EVERY15MIN' => 'Iga 15 minuti järel',
'mai_EVERY30MIN' => 'Iga 30 minuti järel',
'mai_EVERYHOUR' => 'Iga tunni järel',
'mai_EVERY2HRS' => 'Iga 2 tunni järel',
'mai_STANDARD' => 'Standard (SMTP)',
'mai_ETRN' => 'ETRN (SMTP with client request)',
