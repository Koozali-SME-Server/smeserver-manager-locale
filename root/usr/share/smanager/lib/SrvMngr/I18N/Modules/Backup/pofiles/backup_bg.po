msgctxt "bac_DOW"
msgid "Sunday Monday Tuesday Wednesday Thursday Friday Saturday Everyday"
msgstr "Неделя Понеделник Вторник Сряда Четвъртък Петък Събота Ежедневно"

msgctxt "bac_CONFIGURATION_TO_BE_DONE"
