'mai_CUSTOM' => 'Customizado',
'mai_LABEL_SMARTHOST_SMTPAUTH_STATUS' => 'Autenticação SMTP no provedor de Internet',
'mai_LABEL_SMARTHOST_SMTPAUTH_USERID' => 'ID de usuário para servidor de correio',
'mai_LABEL_SMARTHOST_SMTPAUTH_PASSWD' => 'Senha para servidor de correio',
'mai_VALIDATION_SMTPAUTH_NONBLANK' => 'Este campo não pode ficar em branco se a autenticação do SMTP estiver habilitada.',
