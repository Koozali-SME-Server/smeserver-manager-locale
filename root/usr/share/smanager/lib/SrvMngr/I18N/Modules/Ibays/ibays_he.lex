# ORPHANED (no longer in ibays_en.lex; kept for reference, commented out by lex-to-po.pl): 'iba_PUBLIC_ACCESS_DESCRIPTION' => 'מצב גישה פומבית "password required outside local network"אינו נתמך על ידי רכיב שרת הFTP. במידה וזהו המצב שנבחר, שרת הFTP ידרוש סיסמא גם מתוך הרשת וגם מחוצה לה עבור i-bay זה.',
'iba_ALLOW_DYNAMIC_CONTENT' => 'החרגה של תוכן דינמי (CGI, PHP, SSI)',
