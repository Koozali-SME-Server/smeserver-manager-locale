# ORPHANED (no longer in emailsettings_en.lex; kept for reference, commented out by lex-to-po.pl): 'mai_UNACCEPTABLE_CHARS' => 'Това поле изисква въвеждането на валиден адреса за електронна поща, който трябва да включва символа @ и име на домейн.',
'mai_VALIDATION_SMTPAUTH_NONBLANK' => 'Това поле не може да бъде оставено празно ако е включена SMTP автентикацията.',
'mai_VERYHIGH' => 'Много висока',
'mai_VERYLOW' => 'много ниско',
'mai_E-Mail' => 'Имейл',
