'pwd_DESCRIPTION' => ' Para cambiar la contraseña de su cuenta, complete el siguiente formulario. Deberá proporcionar el nombre de su cuenta y escribir su antigua y nueva contraseña. (Debe escribir dos veces la nueva contraseña). Si no puede cambiar la contraseña porque olvidó la antigua, el administrador del sistema local puede restablecer su contraseña mediante el administrador de servidor. ',
'pwd_TAINTED_USER' => '(en)The account name "[_1]" contains invalid characters.',
'pwd_TAINTED_PASSWORD' => '(en)The new password starts with invalid characters.',
'pwd_FIELDS_REQUIRED' => 'Todos los campos son obligatorios',
'pwd_ERROR_PASSWORD_CHANGE' => '(en)An error occurred while attempting to change your password. Please make sure that the old password entered is correct. Old and new passwords should be different.',
'pwd_PASSWORD_CHANGE' => 'Cambiar contraseña',
# ORPHANED (no longer in userpassword_en.lex; kept for reference, commented out by lex-to-po.pl): 'pwd_RESET_PASSWORD_TITLE' => 'Restablecer contraseña de usuario',
'pwd_ACCOUNT_PASSWORD_CHANGE' => 'Cambiar contraseña de la cuenta',
'pwd_PASSWORD_VERIFY_NEW' => 'Nueva contraseña (verificar):',
'pwd_PASSWORD_NEW' => 'Nueva contraseña:',
'pwd_PASSWORD_OLD' => 'Contraseña actual:',
'pwd_PASSWORD_RESET' => 'Restablecer contraseña',
