msgstr "maart"

msgctxt "dat_APRIL"
msgid "April"
msgstr "april"

msgctxt "dat_MAY"
msgid "May"
msgstr "mei"

msgctxt "dat_JUNE"
msgid "June"
msgstr "juni"

msgctxt "dat_JULY"
msgid "July"
